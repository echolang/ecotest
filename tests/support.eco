/**
 * Test helpers: the summaries of caught failures, and environment variables set for the rest of
 * one test process.
 */

#[if: os == windows]
// the CRT has no setenv; _putenv_s with an empty value removes the variable
internal extern {
    function _putenv_s as c_putenv_s(ptr<const uint8> $name, ptr<const uint8> $value) : int32;
}
#[else]
internal extern {
    function setenv as c_setenv(ptr<const uint8> $name, ptr<const uint8> $value, int32 $overwrite) : int32;
    function unsetenv as c_unsetenv(ptr<const uint8> $name) : int32;
}
#[end]

/**
 * The summaries of what `$body` failed, in order.
 */
internal function summaries(function<void()> $body) : array<string>
{
    array<string> $out = [];
    foreach (ecotest::caught($body) as const &$failure) {
        $out[] = $failure->summary;
    }
    return $out;
}

/**
 * Sets `$name` for the rest of this test's process.
 */
internal function setVar(const string& $name, const string& $value) : void
{
#[if: os == windows]
    int32 $done = c_putenv_s($name->cstr(), $value->cstr());
#[else]
    int32 $done = c_setenv($name->cstr(), $value->cstr(), 1);
#[end]
}

/**
 * Removes `$name` for the rest of this test's process.
 */
internal function unsetVar(const string& $name) : void
{
#[if: os == windows]
    int32 $done = c_putenv_s($name->cstr(), ''->cstr());
#[else]
    int32 $done = c_unsetenv($name->cstr());
#[end]
}

/**
 * The event lines `$body` writes, read from a file of its own. The session's state is put back
 * afterwards, so a body may hold failures, report them or run cleanups without ending the test.
 */
internal function eventsOf(function<void()> $body) : array<string>
{
    ecotest::Session::start();
    // not a TempDir: the body may run the cleanups, which would take it away
    int32 $pid = std::env::pid();
    int64 $stamp = std::time::timestamp::now()->unix_nanos();
    $path = std::env::join(std::env::tmp(), "ecotest-events-{$pid}-{$stamp}.jsonl");

    string $kept = ecotest::Session::$events;
    int32 $soft = ecotest::Session::$soft;
    ecotest::Session::$events = $path;

    $body();

    ecotest::Session::$events = $kept;
    ecotest::Session::$soft = $soft;
    ecotest::Session::$reported = false;
    ecotest::Session::$held->clear();

    $text = std::io::readfile($path)->or('');
    $gone = std::io::remove($path);
    return str::lines($text)->owned();
}
