use ecotest::{expect, protocol};

test the_key_is_echocs_coverage_file_rule
{
    expect(protocol::key('mylib/date.eco::parses_iso'))->is('mylib_date.eco__parses_iso');
    expect(protocol::key('a b-c.d_e'))->is('a_b-c.d_e');
}

test every_event_carries_the_version
{
    $lines = eventsOf(function() : void {
        ecotest::note('hi');
    });
    expect($lines[0])->starts('{"v":1,"type":"note"');
}

test a_service_variable_is_upper_case
{
    expect(protocol::serviceVar('api'))->is('ECOTEST_API_URL');
    expect(protocol::serviceVar('my-db.2'))->is('ECOTEST_MY_DB_2_URL');
}

test every_kind_has_a_word
{
    expect(protocol::Kind::of('fail'))->some(.fail);
    expect(protocol::Kind::of('crash'))->some(.crash);
    expect(protocol::Kind::of('skip'))->some(.skip);
    expect(protocol::Kind::of('note'))->some(.note);
    expect(protocol::Kind::of('metric'))->some(.metric);
    expect(protocol::Kind::of('bench'))->some(.bench);
    expect(protocol::Kind::of('checks'))->some(.checks);
    expect(protocol::Kind::of('snapshot-new'))->some(.snapshotNew);
    expect(protocol::Kind::of('snapshot-updated'))->some(.snapshotUpdated);
}

test an_unknown_word_is_no_kind
{
    expect(protocol::Kind::of('nope'))->none();
    protocol::Kind $fail = .fail;
    expect("{$fail}")->is('fail');
}

test the_version_is_the_manifests
{
    expect(ecotest::version())->is('0.3.0');
}
