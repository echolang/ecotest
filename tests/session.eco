/**
 * The session's quiet paths: no event file, a file that cannot be opened, a needed variable that is
 * set, the seed from the environment, and the crash hook for a stop no check reported.
 */

use ecotest::{expect, Session, Seed, Tally};

test without_an_event_file_nothing_is_written
{
    Session::start();
    string $kept = Session::$events;

    Session::$events = '';
    Session::write('{"type":"note"}');
    Session::$events = $kept;
}

test a_line_for_a_file_that_cannot_open_is_dropped
{
    Session::append('/dev/null/not-a-dir/events.jsonl', 'lost');
}

test a_session_outside_the_tool_writes_nowhere
{
    unsetVar('ECOTEST_RUN_DIR');
    Session::$started = false;
    Session::$events = '';

    Session::start();

    expect(Session::$events)->empty();
}

test a_tally_without_a_path_writes_nothing
{
    Tally $t = Tally();
    $t->checks = 3;
    $t->flush();

    expect($t->flushed)->no();
}

test a_set_variable_is_handed_back
{
    setVar('ECOTEST_PROBE', 'here');

    expect(ecotest::needs(env: 'ECOTEST_PROBE'))->is('here');
}

test the_seed_comes_from_the_environment
{
    setVar('ECOTEST_SEED', '42');
    expect(Seed::pick())->is(42);

    setVar('ECOTEST_SEED', 'not a number');
    expect(Seed::pick())->isNot(42);

    unsetVar('ECOTEST_SEED');
    expect(Seed::pick())->above(0);
}

#[tests: expects death]
test a_plain_die_after_a_check_is_recorded_as_a_crash
{
    expect(1)->is(1);
    die('not a check');
}

#[tests: expects death]
test a_failure_keeps_the_context_it_was_raised_in
{
    $at = ecotest::context('row 4');
    expect(1)->is(2);
}
