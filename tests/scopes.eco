use ecotest::expect;
use ecotest::Session;

test a_passing_soft_scope_does_not_fail
{
    $all = ecotest::soft();
    expect(1)->is(1);
    expect('a')->is('a');
}

#[tests: expects death]
test a_soft_scope_fails_at_its_end
{
    $all = ecotest::soft();
    expect(1)->is(2);
    expect('a')->is('b');
}

test context_leaves_with_its_value
{
    {
        $at = ecotest::context('row 1');
        expect(Session::$context->count())->is(1);
    }

    expect(Session::$context->empty())->yes();
}

test contexts_stack
{
    $outer = ecotest::context('file a');
    $inner = ecotest::context('row 2');

    expect(Session::$context)->is(['file a', 'row 2']);
}

test a_missing_variable_skips
{
    $url = ecotest::needs(env: 'ECOTEST_NEVER_SET_ANYWHERE');
    expect($url)->is('unreachable');
}

test leaving_a_scope_that_is_not_open_is_fine
{
    Session::leaveSoft();
    $none = Session::leaveCaught();
    expect($none)->empty();
}

#[tests: expects death]
test an_inner_soft_scope_merges_into_the_outer
{
    $outer = ecotest::soft();
    {
        $inner = ecotest::soft();
        expect(1)->is(2);
    }
    expect('a')->is('b');
}

test caught_leaves_an_enclosing_scopes_failures_alone
{
    $outer = ecotest::caught(function() : void {
        expect(1)->is(2);
        $inner = ecotest::caught(function() : void { expect('a')->is('b'); });
        expect($inner->count())->is(1);
    });

    expect($outer->count())->is(1);
    expect($outer[0]->summary)->is('expected 2, got 1');
}

test a_failure_names_the_step_it_failed_in
{
    $before = ecotest::caught(function() : void {
        expect(1)->is(2);
    });
    expect($before[0]->context)->empty();

    ecotest::step('an admin publishes a post');
    $at = ecotest::context('row 2');
    $failed = ecotest::caught(function() : void {
        expect(1)->is(2);
    });
    expect($failed[0]->context)->is(["step 'an admin publishes a post'", 'row 2']);
    expect("{$failed[0]}")->has("\n  in step 'an admin publishes a post'\n  in row 2");

    ecotest::step('the list shows it first');
    expect(Session::scopes()[0])->is("step 'the list shows it first'");
}
