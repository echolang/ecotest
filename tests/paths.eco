use ecotest::expect;

test absolute_paths_start_at_a_root
{
    expect(std::fs::path('/x')->is_absolute())->yes();
    expect(std::fs::path('x/y')->is_absolute())->no();
    expect(std::fs::path('')->is_absolute())->no();
}

test a_path_has_a_dir_a_base_and_a_stem
{
    expect(std::fs::path('/a/b/c.eco')->dirname()->string())->is('/a/b');
    expect(std::fs::path('/c.eco')->dirname()->string())->is('/');
    expect(std::fs::path('c.eco')->dirname()->string())->is('.');
    expect(std::fs::path('/a/b/c.eco')->basename())->is('c.eco');
    expect(std::fs::path('c.eco')->basename())->is('c.eco');
    expect(std::fs::path('/a/b/c.test.eco')->stem())->is('c.test');
    expect(std::fs::path('/a/Makefile')->stem())->is('Makefile');
    expect(std::fs::path('/a/.env')->stem())->is('.env');
}

test a_path_below_a_base_reads_relative
{
    expect(expect(std::fs::path('/p/tests/a.eco')->relative('/p'))->some()->string())->is('tests/a.eco');
    expect(expect(std::fs::path('/p/tests/a.eco')->relative('/p/'))->some()->string())->is('tests/a.eco');
    expect(std::fs::path('/q/a.eco')->relative('/p'))->none();
    expect(std::fs::path('/p')->relative('/p'))->none();
    expect(std::fs::path('/pp/a.eco')->relative('/p'))->none();
}

test join_keeps_absolute_paths
{
    expect(('/base' / '/abs')->string())->is('/abs');
    expect(std::fs::path('/base')->join('')->string())->is('/base');
    expect(('/base' / 'rel')->string())->is('/base/rel');
}

test mkdir_makes_every_missing_level
{
    $dir = ecotest::TempDir();
    $deep = $dir->path / 'a' / 'b';

    expect(std::fs::mkdir($deep, recursive: true))->ok(true);
    expect(std::fs::mkdir($deep, recursive: true))->ok(true);
    expect(std::fs::exists($deep)->or(false))->yes();

    $file = $dir->write('file', 'x');
    expect(std::fs::mkdir($file / 'below', recursive: true))->fails();
}

#[if: os == windows]
test windows_paths_know_drives_and_shares
{
    expect(std::fs::path('C:\\x')->is_absolute())->yes();
    expect(std::fs::path('C:\\a\\b.eco')->dirname()->string())->is('C:\\a');
}
#[end]
