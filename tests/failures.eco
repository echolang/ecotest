/**
 * What every check says when it fails, caught in process so the message itself is checked.
 */

use ecotest::{expect, Calls, Ran};

test number_failures_name_both_values
{
    $got = summaries(function() : void {
        expect(1)->is(2)->isNot(1)->above(5)->below(0)->between(2, 3);
    });

    expect($got)->is([
        'expected 2, got 1',
        'expected anything but 1',
        'expected more than 5, got 1',
        'expected less than 0, got 1',
        'expected 2 to 3, got 1',
    ]);
}

test unsigned_failures_name_both_values
{
    usize $one = 1;
    expect($one)->below(2);

    $got = summaries(function() : void {
        usize $n = 1;
        expect($n)->is(2)->isNot(1)->above(5)->below(0)->between(2, 3);
    });

    expect($got)->is([
        'expected 2, got 1',
        'expected anything but 1',
        'expected more than 5, got 1',
        'expected less than 0, got 1',
        'expected 2 to 3, got 1',
    ]);
}

test float_failures_name_both_values
{
    $got = summaries(function() : void {
        expect(1.5)->is(2.5)->isNot(1.5)->above(5.0)->below(0.0)->between(2.0, 3.0)->near(1.0, $within: 0.25);
    });

    expect($got)->is([
        'expected 2.5, got 1.5',
        'expected anything but 1.5',
        'expected more than 5, got 1.5',
        'expected less than 0, got 1.5',
        'expected 2 to 3, got 1.5',
        'expected 1 within 0.25, got 1.5 (off by 0.5)',
    ]);
}

test bool_failures_say_what_was_wanted
{
    $got = summaries(function() : void {
        expect(false)->yes()->yes(says: 'ready');
        expect(true)->no()->no(says: 'done');
    });

    expect($got)->is([
        'expected true',
        'expected ready to be true',
        'expected false',
        'expected done to be false',
    ]);
}

test text_failures_quote_the_text
{
    $got = summaries(function() : void {
        expect('abc')->isNot('abc')->has('x')->lacks('b')->starts('x')->ends('x')->empty()->length(9);
    });

    expect($got)->is([
        "expected anything but 'abc'",
        "expected 'abc' to contain 'x'",
        "expected 'abc' not to contain 'b'",
        "expected 'abc' to start with 'x'",
        "expected 'abc' to end with 'x'",
        "expected empty text, got 'abc'",
        'expected 9 bytes, got 3',
    ]);
}

test list_failures_point_at_the_item
{
    $got = summaries(function() : void {
        expect([1, 2, 3])->is([1, 2])->is([1, 2, 3, 4])->is([1, 5, 3]);
        expect([1, 2, 3])->size(2)->empty()->has(9)->lacks(2)->sorted();
        expect([3, 1])->sorted();
        array<int64> $two = [1, 2];
        expect($two)->all((const int64& $n) : bool => $n > 1)->all((const int64& $n) : bool => $n > 1, says: 'big');
        expect($two)->any((const int64& $n) : bool => $n > 5)->any((const int64& $n) : bool => $n > 5, says: 'huge');
        expect([1, 2, 2])->same([2, 1, 3]);
        expect([1, 2, 2])->same([2, 1]);
    });

    expect($got)->is([
        'expected 2 items, got 3: extra items from index 2',
        'expected 4 items, got 3: missing items from index 3',
        'lists differ at index 1: expected 5, got 2',
        'expected 2 items, got 3',
        'expected no items, got 3',
        'expected the list to contain 9',
        'expected the list not to contain 2, found at index 1',
        'expected ascending order, item 1 comes before item 0',
        'item 0 failed the test',
        'item 0 is not big',
        'no item passed the test',
        'no item is huge',
        'expected the same items in any order, 3 is missing',
        'expected the same items in any order, 2 is extra',
    ]);
}

test a_long_list_is_cut_in_the_report
{
    array<int64> $many = [];
    for (int64 $i = 0; $i < 200; $i++) {
        $many[] = $i;
    }

    $failures = ecotest::caught(function() : void {
        expect($many)->is([]);
    });

    expect($failures->count())->is(1);
    expect($failures[0]->actual)->starts('[0, 1, 2, ')->ends(', ...]');
    expect($failures[0]->actual->size())->below(140);
}

test map_failures_name_the_key
{
    map<string, int64> $m = ['a' => 1];

    $got = summaries(function() : void {
        map<string, int64> $inner = ['a' => 1];
        expect($inner)->has(key: 'b')->at('b', 1)->at('a', 2)->size(3)->empty()->is(['a' => 2, 'c' => 3]);
    });

    expect($got)->is([
        'expected key b',
        'expected key b',
        'at a: expected 2, got 1',
        'expected 3 keys, got 1',
        'expected no keys, got 1',
        'maps differ (- missing, + extra, ~ changed)',
    ]);
    expect($m)->has(key: 'a')->at('a', 1);
}

test result_failures_name_the_error
{
    $got = summaries(function() : void {
        expect(parse(''))->ok(1);
        expect(parse('1'))->ok(2)->fails(.bad);
        expect(parse('x'))->fails(.empty);
    });

    expect($got)->is([
        'expected ok 1, got error empty',
        'expected ok 2, got ok 1',
        'expected error bad, got ok',
        'expected error empty, got error bad',
    ]);
}

#[tests: expects death]
test result_fails_without_a_value_stops_on_ok
{
    $e = expect(parse('1'))->fails();
}

test status_failures_name_the_error
{
    $got = summaries(function() : void {
        expect(check(true))->fails(.bad);
        expect(check(false))->fails(.empty);
    });

    expect($got)->is([
        'expected error bad, got success',
        'expected error empty, got error bad',
    ]);
}

#[tests: expects death]
test status_fails_without_a_value_stops_on_success
{
    $e = expect(check(true))->fails();
}

test nullable_failures_say_what_came
{
    $got = summaries(function() : void {
        expect(find(false))->some(3);
        expect(find(true))->some(4)->none();
    });

    expect($got)->is([
        'expected 3, got null',
        'expected 4, got 3',
        'expected null, got a value',
    ]);
}

test value_failures_show_the_values
{
    $got = summaries(function() : void {
        expect(value: Point(1, 2))->is(Point(2, 2))->isNot(Point(1, 2));
        expect(value: Point(1, 2))->satisfies((const Point& $p) : bool => $p->x > 5);
        expect(value: Point(1, 2))->satisfies((const Point& $p) : bool => $p->x > 5, says: 'far right');
    });

    expect($got)->is([
        'expected Point(2, 2), got Point(1, 2)',
        'expected anything but Point(1, 2)',
        'Point(1, 2) failed the test',
        'expected far right, got Point(1, 2)',
    ]);
}

test call_failures_count_the_calls
{
    $calls = Calls<string>();
    $calls->record('a');

    $got = summaries(function() : void {
        expect($calls)->times(2)->never()->nth(3, 'a')->nth(0, 'b')->with('z');
    });

    expect($got)->is([
        'expected 2 calls, got 1',
        'expected no calls, got 1',
        'expected a call number 3, only 1 were made',
        'call 0: expected b, got a',
        'expected a call with z among 1 calls',
    ]);
}

test a_run_failure_shows_both_streams
{
    $failures = ecotest::caught(function() : void {
        expect(Ran('tool', 2, 'out', 'err'))->exits(0);
        expect(Ran('tool', null, '', 'only err'))->succeeds();
        expect(Ran('tool', 1, 'only out', ''))->exits(0);
    });

    expect($failures->count())->is(3);
    expect($failures[0]->summary)->is('expected tool to exit 0, got exit 2');
    expect($failures[0]->detail)->is("stdout:\n  out\nstderr:\n  err");
    expect($failures[1]->summary)->is('expected tool to exit 0, got a signal');
    expect($failures[1]->detail)->is("stderr:\n  only err");
    expect($failures[2]->detail)->is("stdout:\n  only out");
}

test multi_line_text_failures_carry_a_diff
{
    $failures = ecotest::caught(function() : void {
        expect("a\nb")->is("a\nc");
    });

    expect($failures->count())->is(1);
    expect($failures[0]->summary)->is('text differs');
    expect($failures[0]->detail)->has('- c')->has('+ b');
}

test a_status_error_is_handed_back
{
    $e = expect(check(false))->fails();
    expect(value: $e)->is(.bad);
}

test a_fake_never_called_passes_never
{
    $calls = Calls<string>();
    expect($calls)->never()->times(0);
}
