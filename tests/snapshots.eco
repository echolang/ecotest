/**
 * Snapshot files against a temp directory: written, matched, changed, updated, refused.
 */

use ecotest::{expect, Snapshot, TempDir, Batch};

test a_snapshot_needs_the_test_identity
{
    unsetVar('ECHO_TEST_NAME');

    $got = summaries(function() : void {
        expect('x')->snapshot();
    });

    expect($got)->is(['snapshots need ECHO_TEST_FILE and ECHO_TEST_NAME, which echoc test sets']);
}

test ci_refuses_to_write_a_new_snapshot
{
    $dir = TempDir();
    setVar('ECHO_TEST_FILE', $dir->file('case.eco'));
    setVar('ECOTEST_CI', '1');

    $got = summaries(function() : void {
        expect('x')->snapshot();
    });

    expect($got->count())->is(1);
    expect($got[0])->endsWith('does not exist, and ECOTEST_CI forbids writing it');
    expect($dir->read('__snapshots__/case/ci_refuses_to_write_a_new_snapshot.1.snap'))->none();
}

test a_snapshot_is_new_then_matched_then_changed_then_updated
{
    $dir = TempDir();
    setVar('ECHO_TEST_FILE', $dir->file('case.eco'));
    setVar('ECHO_TEST_NAME', 'shows');
    string $stored = '__snapshots__/case/shows.1.snap';

    expect('one')->snapshot();
    expect($dir->read($stored))->some('one');

    Snapshot::$taken = 0;
    expect('one')->snapshot();

    Snapshot::$taken = 0;
    setVar('ECOTEST_UPDATE', '0');
    $changed = ecotest::caught(function() : void {
        expect('two')->snapshot();
    });
    expect($changed->count())->is(1);
    expect($changed[0]->summary)->is('snapshot shows.1 changed');
    expect($changed[0]->detail)->has('- one')->has('+ two')->has('ECOTEST_UPDATE=1');

    Snapshot::$taken = 0;
    setVar('ECOTEST_UPDATE', '1');
    expect('two')->snapshot();
    expect($dir->read($stored))->some('two');
}

test a_file_without_an_extension_names_its_folder_whole
{
    $dir = TempDir();
    setVar('ECHO_TEST_FILE', $dir->file('plain'));
    setVar('ECHO_TEST_NAME', 'n');

    expect('v')->snapshot();
    expect($dir->read('__snapshots__/plain/n.1.snap'))->some('v');
}

test a_snapshot_that_cannot_be_written_fails
{
    setVar('ECHO_TEST_FILE', '/dev/null/case.eco');
    setVar('ECHO_TEST_NAME', 'x');

    $got = summaries(function() : void {
        expect('v')->snapshot();
    });

    expect($got->count())->is(1);
    expect($got[0])->startsWith('cannot write snapshot /dev/null/__snapshots__/case/x.1.snap');
}

test a_bare_file_name_sits_in_the_current_directory
{
    setVar('ECHO_TEST_FILE', 'bare.eco');
    setVar('ECHO_TEST_NAME', 'x');
    setVar('ECOTEST_CI', '1');

    $got = summaries(function() : void {
        expect('v')->snapshot();
    });

    expect($got[0])->startsWith('snapshot ./__snapshots__/bare/x.1.snap does not exist');
}

test an_update_that_cannot_be_written_fails
{
    $dir = TempDir();
    setVar('ECHO_TEST_FILE', $dir->file('case.eco'));
    setVar('ECHO_TEST_NAME', 'locked');

    expect('one')->snapshot();
    expect(ecotest::run('chmod', ['444', $dir->file('__snapshots__/case/locked.1.snap')]))->succeeds();

    Snapshot::$taken = 0;
    setVar('ECOTEST_UPDATE', '1');
    $got = summaries(function() : void {
        expect('two')->snapshot();
    });

    expect($got->count())->is(1);
    expect($got[0])->startsWith('cannot write snapshot ');
}

test a_bench_stops_growing_its_batch_at_the_ceiling
{
    Batch::$ceiling = 4;
    ecotest::bench('nothing', function() : void {
    }, budget: std::time::duration::millis(1));
    expect(Batch::$ceiling)->is(4);
}
