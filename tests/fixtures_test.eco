use ecotest::expect;
use ecotest::{TempDir, Calls};

test a_temp_dir_holds_files_and_goes_away
{
    string $where = '';
    {
        $dir = TempDir();
        $where = $dir->path;
        $file = $dir->write('a.txt', 'hello');
        expect($dir->read('a.txt'))->ok('hello');
        expect(std::fs::exists($file))->ok(true);
    }

    expect(std::fs::exists($where))->ok(false);
}

test calls_are_recorded_and_checked
{
    $calls = Calls<string>();
    $notify = function(string $who) : void {
        $calls->record($who);
    };

    $notify('ada');
    $notify('bob');

    expect($calls)->times(2)->nth(0, 'ada')->with('bob');
}

test eventually_waits_for_a_condition
{
    int64 $start = std::time::timestamp::now()->unix_millis();
    ecotest::eventually(() : bool => std::time::timestamp::now()->unix_millis() - $start >= 20);
}

#[tests: expects death]
test eventually_gives_up
{
    ecotest::eventually(() : bool => false, within: .millis(30));
}

test a_program_runs_and_is_checked
{
    $ran = ecotest::run('echo', ['hello']);
    expect($ran)->succeeds()->stdout()->is("hello\n");
    expect($ran)->stderr()->empty();
    expect($ran->code)->some(0);
}

#[tests: expects death]
test a_wrong_exit_code_fails
{
    expect(ecotest::run('false'))->exits(0);
}

test notes_and_metrics_are_recorded
{
    ecotest::note('ran against the fixture set');
    ecotest::metric('rows', 12);
    expect(true)->yes();
}

test a_bench_records_its_numbers
{
    // the sum is the closure's own: a captured local would only change the closure's copy
    ecotest::bench('add', function() : void {
        int64 $sum = 0;
        for (int64 $i = 0; $i < 100; $i++) {
            $sum = $sum + $i;
        }
    }, budget: .millis(20));
}

test a_snapshot_is_written_then_matched
{
    expect("line one\nline two")->snapshot();
}

#[if: os != windows]
test a_program_past_its_timeout_is_killed
{
    $ran = ecotest::run('sleep', ['10'], timeout: .millis(100));

    expect($ran->timedOut)->yes();
    expect($ran->code)->none();

    $got = summaries(function() : void {
        $late = ecotest::run('sleep', ['10'], timeout: .millis(50));
        expect($late)->exits(0);
    });
    expect($got[0])->is('expected sleep 10 to exit 0, got a timeout');
}

test a_program_reads_its_input_environment_and_directory
{
    $dir = ecotest::TempDir();
    $ran = ecotest::run(
        'sh',
        ['-c', 'cat; echo "$ECOTEST_PROBE"; pwd'],
        input: "hello\n",
        env: ['ECOTEST_PROBE' => 'set'],
        dir: $dir->path
    );

    expect($ran)->succeeds()->stdout()->starts("hello\nset\n");
}

test a_failed_run_shows_the_end_of_what_it_printed
{
    $failed = ecotest::caught(function() : void {
        $ran = ecotest::run('sh', ['-c', 'for i in $(seq 1 50); do echo "line $i"; done; exit 3']);
        expect($ran)->succeeds();
    });

    expect($failed[0]->detail)->has('line 50')->lacks('line 1\n');
}
#[end]
