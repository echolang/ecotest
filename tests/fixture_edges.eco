/**
 * Fixtures off their happy path: nested temp files, a directory already gone, programs that cannot
 * start or die by signal, and waits on their defaults.
 */

use ecotest::{expect, TempDir};

test a_temp_dir_removes_what_is_nested_in_it
{
    string $path = '';
    {
        $dir = TempDir();
        $path = $dir->path;
        $made = std::io::mkdir($dir->file('sub'));
        $dir->write('sub/inner.txt', 'x');
        expect($dir->read('missing.txt'))->fails();
    }

    expect(std::io::exists($path)->or(false))->no();
}

test a_temp_dir_already_gone_is_fine
{
    $dir = TempDir();
    $gone = std::io::rmdir($dir->path);
}

#[tests: expects death]
test a_temp_dir_that_cannot_be_made_stops
{
    // no directory can be made under a file; Windows reads TEMP and TMP, not TMPDIR
    $holder = TempDir();
    $file = $holder->write('file', 'x');
    setVar('TMPDIR', $file);
    setVar('TEMP', $file);
    setVar('TMP', $file);
    $dir = TempDir();
}

#[tests: expects death]
test a_temp_file_that_cannot_be_written_stops
{
    $dir = TempDir();
    $dir->write('missing/x.txt', 'x');
}

#[tests: expects death]
test a_program_that_cannot_start_stops
{
    $ran = ecotest::run('/nonexistent/ecotest-program');
}

#[if: os != windows]
// windows has no signals: a killed process still ends with a code
test a_signalled_program_has_no_exit_code
{
    $ran = ecotest::run('sh', ['-c', 'kill -9 $$']);

    expect($ran->code)->none();
}
#[end]

test eventually_on_its_defaults
{
    ecotest::eventually(() : bool => true);
}

test eventually_reports_when_it_gives_up
{
    $got = summaries(function() : void {
        ecotest::eventually(() : bool => false, within: .millis(20));
    });

    expect($got->count())->is(1);
    expect($got[0])->starts('not ready after 20 ms');
}
