/**
 * Every generator, driven by answers given by hand: answer 0 is always the simplest value.
 */

use ecotest::{expect, gen, Draws, Gen, Pair, Random};


/**
 * The value `$g` makes from the answers `$choices`.
 */
function made<T>(const Gen<T>& $g, array<uint64> $choices) : T
{
    $d = Draws(replay: $choices);
    return $g->draw($d);
}

test ints_step_away_from_zero_on_alternating_sides
{
    $g = gen::ints(-100, 100);
    expect(made($g, [0]))->is(0);
    expect(made($g, [1]))->is(1);
    expect(made($g, [2]))->is(-1);
    expect(made($g, [3]))->is(2);
    expect(made($g, [200]))->is(-100);
    expect(made($g, [999]))->is(-100);
    expect($g->show(7))->is('7');
}

test ints_start_at_the_end_of_their_range_nearest_zero
{
    expect(made(gen::ints(5, 100), [0]))->is(5);
    expect(made(gen::ints(5, 100), [3]))->is(8);
    expect(made(gen::ints(-100, -5), [0]))->is(-5);
    expect(made(gen::ints(-100, -5), [1]))->is(-6);
    expect(made(gen::ints(-2, 10), [4]))->is(-2);
    expect(made(gen::ints(-2, 10), [5]))->is(3);
    expect(made(gen::ints(3, 3), []))->is(3);
}

test ints_cover_the_whole_range
{
    $g = gen::ints(-9223372036854775807 - 1, 9223372036854775807);
    expect(made($g, [18446744073709551615]))->is(-9223372036854775807 - 1);
    expect(made($g, [18446744073709551613]))->is(9223372036854775807);
}

test floats_stay_in_their_range
{
    ecotest::forAll(gen::floats(2.0, 10.0), (const float64& $v) : bool => $v >= 2.0 && $v < 10.0);
    ecotest::forAll(gen::floats(-10.0, -2.0), (const float64& $v) : bool => $v >= -10.0 && $v < -2.0);
    ecotest::forAll(gen::floats(0.25, 0.75), (const float64& $v) : bool => $v >= 0.25 && $v < 0.75);
    ecotest::forAll(gen::floats(-1.5, 2.5), (const float64& $v) : bool => $v >= -1.5 && $v < 2.5);
    ecotest::forAll(gen::floats(-100000000000000000000.0, 100000000000000000000.0), (const float64& $v) : bool => $v >= -100000000000000000000.0 && $v < 100000000000000000000.0);
    expect(made(gen::floats(-3.0, 3.0), [0, 0]))->is(0.0);
    expect(made(gen::floats(2.0, 10.0), [0, 0]))->is(2.0);
    expect(gen::floats(0.0, 1.0)->show(0.5))->is('0.5');
}

test bools_start_at_false
{
    $g = gen::bools();
    expect(made($g, [0]))->no();
    expect(made($g, [1]))->yes();
    expect($g->show(true))->is('true');
    expect($g->show(false))->is('false');
}

test text_is_made_of_whole_characters
{
    expect(made(gen::text(alphabet: '', max: 5), [1, 0, 1, 0]))->empty();
    expect(made(gen::text(alphabet: 'ab'), [1, 1, 1, 0, 0]))->is('ba');
    expect(made(gen::text(alphabet: 'äö€'), [1, 2, 1, 0, 0]))->is('€ä');
    expect(gen::text()->show("a'b"))->is("'a\\'b'");

    ecotest::forAll(gen::text(alphabet: 'aä€😀'), (const string& $s) => str::is_utf8($s));
}

test lists_grow_one_answer_at_a_time
{
    $g = gen::lists(gen::ints(0, 9), max: 2);
    array<int64> $none = [];

    expect(made($g, [0]))->is($none);
    expect(made($g, [1, 5, 0]))->is([5]);
    expect(made($g, [1, 1, 1, 2]))->is([1, 2]);
    expect($g->show([1, 2]))->is('[1, 2]');
}

test pick_starts_at_the_first_item
{
    array<string> $letters = ['a', 'b', 'c'];
    $g = gen::pick($letters);

    expect(made($g, [0]))->is('a');
    expect(made($g, [2]))->is('c');
    expect(made($g, [9]))->is('c');
    expect($g->show('b'))->is("'b'");
}

#[tests: expects death]
test pick_needs_an_item
{
    array<string> $none = [];
    $g = gen::pick($none);
}

test pairs_draw_the_first_side_first
{
    $g = gen::pairs(gen::bools(), gen::ints(0, 9));
    $p = made($g, [1, 3]);

    expect($p->first)->yes();
    expect($p->second)->is(3);
    expect($g->show(Pair<bool, int64>(true, 3)))->is('(true, 3)');
}

test mapped_values_are_made_from_their_source
{
    $g = gen::map(gen::ints(0, 9), (const int64& $n) : string => "n{$n}");

    expect(made($g, [3]))->is('n3');
    expect($g->show('n3'))->is("'n3'");
}

test a_replay_past_its_answers_draws_zero
{
    $d = Draws(replay: [5]);
    expect($d->draw(9))->is(5);
    expect($d->draw(9))->is(0);
    expect($d->used)->is([5, 0]);
}

test recording_keeps_every_answer
{
    $d = Draws(record: Random(11));
    $v = gen::lists(gen::ints(0, 9))->draw($d);
    $again = made(gen::lists(gen::ints(0, 9)), $d->used);

    expect($again)->is($v);
}
