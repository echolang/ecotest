namespace ecotest::cli;

use ecotest::protocol;

/**
 * One service from `ecotest.json`: the command that starts it, how to tell it is ready, the URL
 * tests reach it at, and extra environment.
 */
public struct ServiceSpec
{
    public string $name;
    public array<string> $command;
    public Readiness $ready;

    /**
     * The URL tests reach the service at, empty when they are not handed one.
     */
    public string $url;

    /**
     * The extra environment the service starts with, by variable name, in the order given.
     */
    public ordered_map<string, string> $env;

    /**
     * The variable tests read the URL from: `ECOTEST_<NAME>_URL`, by `protocol::serviceVar`.
     */
    public const function variable() : string
    {
        return protocol::serviceVar($this->name);
    }

    /**
     * `ECOTEST_<NAME>_<suffix>`: `READY` and `READY_MS` carry an http ready check to ecotest-http,
     * which makes it before the first request.
     */
    public const function variable(const string& $suffix) : string
    {
        return protocol::serviceVar($this->name, $suffix);
    }
}
