namespace ecotest::cli;

/**
 * The lines changed since a git ref, read from `git diff -U0`: added and modified lines per file,
 * paths relative to the repository root.
 */
public struct GitDiff
{
    public array<ChangedFile> $files = [];

    /**
     * The changed lines in the text of a `git diff -U0`.
     */
    public constructor(parsing: const string& $text)
    {
        $file = '';

        foreach (str::lines($text) as const &$raw) {
            $line = string($raw);

            if ($line->starts('+++ ')) {
                $file = '';
                if ($line->starts('+++ b/')) {
                    // clone: a string made from a str::lines part does not keep $text alive, and
                    // the path outlives it once git's output is dropped
                    $file = $line->sub(6, $line->size() - 6)->clone();
                    $this->files[] = ChangedFile($file);
                }
                continue;
            }

            if (!$line->starts('@@ ') || $file->empty()) {
                continue;
            }

            // @@ -a,b +c,d @@: lines c .. c+d-1 are new; d defaults to 1
            usize $plus = $line->find('+');
            usize $end = $line->find(' ', $plus);
            $span = $line->sub($plus + 1, $end - $plus - 1);

            int64 $start = 0;
            int64 $count = 1;
            usize $comma = $span->find(',');
            if ($comma < $span->size()) {
                $start = str::int($span->sub(0, $comma)) ?? 0;
                $count = str::int($span->sub($comma + 1, $span->size() - $comma - 1)) ?? 0;
            } else {
                $start = str::int($span) ?? 0;
            }

            ChangedFile& $changed = $this->files[$this->files->count() - 1];
            for (int64 $k = 0; $k < $count; $k++) {
                $changed->lines[] = $start + $k;
            }
        }
    }

    /**
     * Changed lines that have code, and of those, lines that ran.
     */
    public const function coverage(const array<FileCoverage>& $files) : Ratio
    {
        $r = Ratio();

        foreach ($files as const &$file) {
            foreach ($this->files as const &$changed) {
                if (!Coverage::sameFile($changed->path, $file->file)) {
                    continue;
                }

                foreach ($changed->lines as const &$line) {
                    if ($file->lines->has($line)) {
                        $r->total++;
                        if ($file->lines->get($line) > 0) {
                            $r->hit++;
                        }
                    }
                }
            }
        }

        return $r;
    }

    /**
     * The diff of the working tree in `$dir` against `$ref`, from the program `$git`, or why git
     * gave none: it could not start, or it refused with what it said.
     */
    public static function since(const string& $git, const string& $dir, const string& $ref) : result<GitDiff, GitError>
    {
        $diff = std::process::command($git, ['diff', '-U0', '--no-color', $ref, '--']);
        $diff->dir($dir);
        $o = guard $diff->output() else ($e) {
            return .error(.cannotRun($git, $e));
        };
        if (!$o->status->success()) {
            // git's usage text can run long; its first line names the problem
            $said = str::trim($o->stderr);
            usize $end = $said->find('\n');
            if ($end < $said->size()) {
                $said = str::trim($said->sub(0, $end));
            }
            return .error(.refused($ref, $o->status, $said));
        }

        return .ok(GitDiff(parsing: $o->stdout));
    }
}
