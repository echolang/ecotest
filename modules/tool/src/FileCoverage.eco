namespace ecotest::cli;

/**
 * Coverage of one source file: hits per line, per branch edge and per function, merged over every
 * test of the run.
 */
public struct FileCoverage
{
    public const string $module;

    /**
     * The path from the module's directory, as reports name it.
     */
    public const string $file;

    /**
     * The absolute path, which tells files of two modules apart.
     */
    public const string $path;

    /**
     * The source as it was when the run measured it, and its fingerprint. Empty until the run's
     * coverage report is measured: a stored run is shown and checked against these, not against
     * whatever the file holds today.
     */
    public string $source = '';
    public string $hash = '';
    public map<int64, uint64> $lines = [];
    public array<BranchSite> $branches = [];
    public array<FunctionSite> $functions = [];

    public constructor(const string& $module, const string& $file, const string& $path)
    {
        $this->module = $module;
        $this->file = $file;
        $this->path = $path;
    }

    /**
     * Lines that have code, and lines of those that ran.
     */
    public const function lineTotals() : Ratio
    {
        $r = Ratio();
        foreach ($this->lines as $line => const &$hits) {
            $r->total++;
            if ($hits > 0) {
                $r->hit++;
            }
        }
        return $r;
    }

    /**
     * Branch edges, and edges of those taken.
     */
    public const function branchTotals() : Ratio
    {
        $r = Ratio();
        foreach ($this->branches as const &$branch) {
            $r->total++;
            if ($branch->hits > 0) {
                $r->hit++;
            }
        }
        return $r;
    }

    /**
     * Functions, and functions of those called.
     */
    public const function functionTotals() : Ratio
    {
        $r = Ratio();
        foreach ($this->functions as const &$function) {
            $r->total++;
            if ($function->hits > 0) {
                $r->hit++;
            }
        }
        return $r;
    }

    /**
     * Where in `$files` the up to `$n` files with lines that never ran are, least covered first.
     */
    public static function worst(const array<FileCoverage>& $files, usize $n) : array<usize>
    {
        // each file's lines are totalled once, not on every comparison, and no file is copied
        array<Ranked> $missing = [];
        for (usize $i = 0; $i < $files->count(); $i++) {
            $r = $files[$i]->lineTotals();
            if ($r->hit < $r->total) {
                $missing[] = Ranked($r->percent() ?? 0.0, $i);
            }
        }
        $missing->sort(key: (const Ranked& $f) : float64 => $f->percent);

        array<usize> $out = [];
        foreach ($missing as const &$f) {
            if ($out->count() < $n) {
                $out[] = $f->index;
            }
        }
        return $out;
    }

    /**
     * The line numbers with code that never ran, ascending.
     */
    public const function missedLines() : array<int64>
    {
        array<int64> $out = [];
        foreach ($this->lines as $line => const &$hits) {
            if ($hits == 0) {
                $out[] = $line;
            }
        }
        $out->sort();
        return $out;
    }

    /**
     * Every line with code, ascending.
     */
    public const function codeLines() : array<int64>
    {
        $out = $this->lines->keys();
        $out->sort();
        return $out;
    }

    /**
     * `missedLines()` folded into ranges: `12-15, 20`.
     */
    public const function missedRanges() : string
    {
        $missed = $this->missedLines();
        $out = '';
        usize $i = 0;

        while ($i < $missed->count()) {
            int64 $from = $missed[$i];
            int64 $to = $from;
            while ($i + 1 < $missed->count() && $missed[$i + 1] == $to + 1) {
                $i++;
                $to = $missed[$i];
            }

            if (!$out->empty()) {
                $out->append(', ');
            }
            if ($from == $to) {
                $out->append("{$from}");
            } else {
                $out->append("{$from}-{$to}");
            }
            $i++;
        }

        return $out;
    }
}

/**
 * A file's place in the list it came from, and its line percentage.
 */
private struct Ranked
{
    public float64 $percent;
    public usize $index;
}
