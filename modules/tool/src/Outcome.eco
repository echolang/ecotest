namespace ecotest::cli;

/**
 * How a test ended, after ecotest's events are read: a skip that exited 0 is a skip, and a test
 * whose passes disagree is flaky. Backed by the word reports use, which `"{$outcome}"` prints.
 */
public enum Outcome : string
{
    case pass = 'pass';
    case fail = 'fail';
    case skip = 'skip';
    case timeout = 'timeout';
    case signal = 'signal';
    case flaky = 'flaky';

    /**
     * The outcome a report row's `status` names. Anything unknown reads as a failure.
     */
    public static function of(const string& $status) : Outcome
    {
        if ($status == 'pass') {
            return .pass;
        }
        if ($status == 'timeout') {
            return .timeout;
        }
        if ($status == 'signal') {
            return .signal;
        }
        if ($status == 'skip') {
            return .skip;
        }
        return .fail;
    }

    /**
     * True for the outcomes that fail a run.
     */
    public const function broken() : bool
    {
        return $this == Outcome::fail || $this == Outcome::timeout || $this == Outcome::signal;
    }

    /**
     * The group a report lists the outcome in: `failed`, `flaky`, `skip` or `pass`.
     */
    public const function group() : string
    {
        return match ($this) {
            .pass => 'pass',
            .fail => 'failed',
            .skip => 'skip',
            .timeout => 'failed',
            .signal => 'failed',
            .flaky => 'flaky',
        };
    }
}

namespace str;

/**
 * The word reports use for `$outcome`: `pass`, `fail`, `timeout` and so on.
 */
public function from(ecotest::cli::Outcome $outcome) : string
{
    return $outcome->value();
}

/**
 * The word for `$outcome`, laid out by the format `$spec`, as in `"{$outcome:<9}"`.
 */
public function from(ecotest::cli::Outcome $outcome, const string& $spec) : string
{
    return from($outcome->value(), $spec);
}
