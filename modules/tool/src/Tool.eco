namespace ecotest::cli;

use ecotest::cli::{doc, files, history, html, junit, lcov, markdown, pretty, runjson, terminal, text};

/**
 * The commands of the ecotest tool, behind the argument parsing in `main`. Runs live under
 * `.ecotest/run-<millis>/` in the project, beside its manifest, with `history.jsonl` beside them:
 * outside echoc's build directory, so `echoc clean` keeps the history and no module name can
 * collide with it. Every path and every program the tool starts is relative to the project echoc
 * runs in.
 */
public class Tool
{
    /**
     * How echoc is run on the module under test, which is where runs and the history live too.
     */
    public Invocation $echoc = Invocation();
    public string $git = 'git';

    /**
     * Whether `run` writes `report.html` into the run directory. Off unless asked for.
     */
    public bool $html = false;

    public array<string> $modules = [];
    public array<string> $exclude = [];
    public string $since = '';
    public string $format = '';
    public Gates $gates = Gates();
    public Services $services = Services();

    /**
     * Live progress and the styled summary, or plain text. Simple unless the command line says.
     */
    public Style $style = .simple;

    /**
     * Where live progress is drawn, stderr from the command line. None draws nothing live.
     */
    public command::CLIContext? $live = null;

    /**
     * Whether `ecotest.json` was read already. Its excludes and services append, so a second read
     * would list everything twice.
     */
    private bool $configured = false;

    /**
     * The stream the summary goes to, stdout from the command line. None prints it plain.
     */
    public command::CLIContext? $page = null;

    /**
     * Where runs and the history live.
     */
    public const function root() : string
    {
        return std::env::join($this->echoc->project, '.ecotest');
    }

    /**
     * Reads `ecotest.json` beside the manifest, when there is one: coverage excludes, modules and
     * thresholds, and the services to start. Flags given on the command line win. Only the first
     * call reads it, so `affected` can configure before it hands over to `run`.
     */
    public function configure() : void
    {
        if ($this->configured) {
            return;
        }
        $this->configured = true;

        // no ecotest.json is no configuration, and so is an empty one
        $text = guard doc::read(std::env::join($this->echoc->project, 'ecotest.json')) else {
            return;
        };
        if ($text->empty()) {
            return;
        }

        $doc = guard json::parse($text) else ($e) {
            std::io::println("ecotest: ecotest.json does not parse: {$e->message()}");
            return;
        };

        $cov = doc::object($doc, 'coverage');
        if ($cov->isObject()) {
            foreach (doc::list($cov, 'exclude') as const &$pattern) {
                $this->exclude[] = $pattern->asStr() ?? '';
            }
            if ($this->modules->empty()) {
                foreach (doc::list($cov, 'modules') as const &$name) {
                    $this->modules[] = $name->asStr() ?? '';
                }
            }
            if ($this->gates->minLines == null) {
                $this->gates->minLines = doc::decimal($cov, 'min');
            }
        }

        $this->services->configure(doc::list($doc, 'services'));
    }

    /**
     * `ecotest run`: runs every pass, reports, writes the run directory and applies the gates.
     */
    public function run() : int32
    {
        $this->configure();

        int64 $stamp = std::time::timestamp::now()->unix_millis();
        $dir = std::env::join($this->root(), "run-{$stamp}");
        guard files::mkdirs($dir) else ($e) {
            std::io::println("ecotest: cannot write {$dir}: {$e}");
            return 1;
        };

        guard $this->services->start($dir, $this->echoc->project) else ($e) {
            std::io::println("ecotest: {$e}");
            $this->services->stop();
            return 1;
        };

        $runner = Runner();
        $runner->seed = $stamp as uint64;
        $runner->env = $this->services->env;
        $view = $this->liveView($dir);
        $runner->view = $view;

        $ran = $runner->run($this->echoc, $dir);
        $this->services->stop();

        guard $ran else ($e) {
            std::io::println("ecotest: {$e}");
            return 1;
        };

        // a watched run was folded as its rows arrived; otherwise it is read back from the directory
        $watched = guard $view else {
            return $this->finish($dir, Run(readFrom: $dir));
        };
        $watched->run->settle();
        return $this->finish($dir, $watched->run);
    }

    /**
     * `ecotest report`: renders a stored run in `$format`, the terminal summary by default.
     */
    public function report(const string& $given) : int32
    {
        $this->configure();

        string $dir = $given;
        if ($dir->empty()) {
            $newest = guard files::latest($this->root()) else {
                std::io::println('ecotest: no run yet; run `ecotest` first');
                return 1;
            };
            $dir = $newest;
        }

        $run = Run(readFrom: $dir);
        array<FileCoverage> $files = [];
        $totals = $this->measure($dir, $run, $files);
        // a stored run is shown with the verdict it got, not judged again: the gates only mark the
        // coverage
        $verdict = Verdict(storedIn: $dir, run: $run, gates: $this->gates);

        if ($this->format == 'md') {
            std::io::print(markdown::render($run, $files, $totals, $verdict));
        } else if ($this->format == 'junit') {
            std::io::print(junit::render($run));
        } else if ($this->format == 'lcov') {
            std::io::print(lcov::render($files));
        } else if ($this->format == 'html') {
            std::io::print(html::render($run, $files, $totals, $verdict));
        } else if ($this->format == 'json') {
            std::io::print(runjson::render($run, $files, $totals, $verdict));
        } else {
            std::io::print($this->summary($run, $files, $totals, $verdict, '', ''));
        }

        return 0;
    }

    /**
     * `ecotest history`: trends over the last runs.
     */
    public const function history() : int32
    {
        std::io::print(history::render(std::env::join($this->root(), 'history.jsonl'), 15));
        return 0;
    }

    /**
     * `ecotest api`: the public functions and methods the newest run with coverage never called.
     */
    public function api() : int32
    {
        $this->configure();

        $uncovered = 'ecotest: the newest run has no coverage; run `ecotest --coverage` first';
        $dir = guard files::latest($this->root()) else {
            std::io::println($uncovered);
            return 1;
        };
        $c = guard $this->coverageOf($dir) else {
            std::io::println($uncovered);
            return 1;
        };

        // `build` needs somewhere to put a library's binary before it will print; the run keeps it
        $decls = $this->echoc->command(['build', '-p', 'decls', '-o', std::env::join($dir, 'decls-bin')]);
        $o = guard $decls->output() else {
            std::io::println("ecotest: cannot run {$this->echoc->program}");
            return 1;
        };
        $doc = guard json::parse($o->stdout) else {
            std::io::println('ecotest: echoc -p decls did not answer with JSON');
            return 1;
        };

        usize $total = 0;
        array<string> $untested = [];

        foreach (doc::list($doc, 'modules') as const &$module) {
            $name = doc::text($module, 'name');
            if (!$c->reports($name)) {
                continue;
            }

            foreach (doc::list($module, 'declarations') as const &$decl) {
                array<json::Value> $callables = [];
                $kind = doc::text($decl, 'kind');

                if ($kind == 'function') {
                    $callables[] = $decl;
                } else {
                    foreach (doc::list($decl, 'methods') as const &$m) {
                        $callables[] = $m;
                    }
                    foreach (doc::list($decl, 'constructors') as const &$k) {
                        $callables[] = $k;
                    }
                }

                foreach ($callables as const &$fn) {
                    if (doc::text($fn, 'visibility') != 'public') {
                        continue;
                    }

                    $file = doc::text($fn, 'file');
                    int64 $line = doc::number($fn, 'line');
                    if ($c->excluded($file)) {
                        continue;
                    }

                    $was = guard $c->called($file, $line) else {
                        continue;
                    };

                    $total++;
                    if (!$was) {
                        $qualified = doc::text($fn, 'qualified');
                        $untested[] = "{$qualified}  {$file}:{$line}";
                    }
                }
            }
        }

        usize $tested = $total - $untested->count();
        $r = Ratio($tested, $total);
        std::io::println("public api  {$tested} of {$total} called by a test ({$r})");
        foreach ($untested as const &$line) {
            std::io::println("  never called: {$line}");
        }

        return 0;
    }

    /**
     * `ecotest who <file:line>`: the tests that ran a line in the newest run with coverage.
     */
    public function who(const string& $spec) : int32
    {
        usize $colon = text::last($spec, 58);

        if ($colon == $spec->size()) {
            std::io::println('ecotest: expected <file:line>, for example src/date.eco:42');
            return 2;
        }

        $file = $spec->sub(0, $colon);
        int64 $line = guard str::int($spec->sub($colon + 1, $spec->size() - $colon - 1)) else {
            std::io::println('ecotest: expected <file:line>, for example src/date.eco:42');
            return 2;
        };

        $this->configure();
        $c = guard $this->newest() else {
            std::io::println('ecotest: the newest run has no coverage; run `ecotest --coverage` first');
            return 1;
        };

        $ids = $c->testsAt($file, $line);
        if ($ids->empty()) {
            std::io::println("no test ran {$file}:{$line}");
            return 0;
        }

        foreach ($ids as const &$id) {
            std::io::println($id);
        }
        return 0;
    }

    /**
     * `ecotest affected --since <ref>`: runs only the tests that covered a line changed since the
     * ref, as the newest run with coverage saw them.
     */
    public function affected() : int32
    {
        $this->configure();
        $c = guard $this->newest() else {
            std::io::println('ecotest: needs a run with coverage to know which tests touch what; run `ecotest --coverage` first');
            return 1;
        };

        $diff = guard GitDiff::since($this->git, $this->echoc->project, $this->since) else ($e) {
            std::io::println("ecotest: {$e}");
            return 1;
        };

        array<string> $names = [];
        map<string, bool> $named = [];

        foreach ($diff->files as const &$changed) {
            foreach ($changed->lines as const &$line) {
                foreach ($c->testsAt($changed->path, $line) as const &$id) {
                    // an id without `::` has no test name to filter on; sub() would underflow
                    usize $sep = $id->find('::');
                    if ($sep >= $id->size()) {
                        continue;
                    }
                    $name = $id->sub($sep + 2, $id->size() - $sep - 2);
                    if (!$named->has($name)) {
                        $named->set($name, true);
                        $names[] = $name;
                    }
                }
            }
        }

        if ($names->empty()) {
            std::io::println("ecotest: no test covers a line changed since {$this->since}");
            return 0;
        }

        usize $count = $names->count();
        std::io::println("ecotest: {$count} tests touch lines changed since {$this->since}");
        foreach ($names as const &$name) {
            $this->echoc->forwarded[] = '--filter';
            $this->echoc->forwarded[] = $name;
        }

        return $this->run();
    }

    /**
     * Judges, renders and stores `$run`, finished in `$dir`. Returns the process exit code: 1 when
     * the run is red or one of its reports could not be written.
     */
    private const function finish(const string& $dir, const Run& $run) : int32
    {
        array<FileCoverage> $files = [];
        $totals = $this->measure($dir, $run, $files);

        $diff = $this->changed($files);
        $verdict = $this->gates->check($run, $totals, $diff);

        // every report is attempted, each rendered as it is written; one that could not be written
        // fails the run once it is shown
        usize $unwritten = 0;
        Tool::store(std::env::join($dir, 'run.json'), runjson::render($run, $files, $totals, $verdict), $unwritten);
        Tool::store(std::env::join($dir, 'summary.md'), markdown::render($run, $files, $totals, $verdict), $unwritten);
        Tool::store(std::env::join($dir, 'junit.xml'), junit::render($run), $unwritten);
        if (!$files->empty()) {
            Tool::store(std::env::join($dir, 'lcov.info'), lcov::render($files), $unwritten);
        }

        $report = '';
        if ($this->html) {
            $report = std::env::join($dir, 'report.html');
            Tool::store($report, html::render($run, $files, $totals, $verdict), $unwritten);
        }

        // a run the history misses is still a run: said, but not failed
        $historyPath = std::env::join($this->root(), 'history.jsonl');
        $kept = history::append($historyPath, $dir, $run, $totals);
        if ($kept->failed()) {
            std::io::println("ecotest: cannot write {$historyPath}: {$kept->failure()}");
        }

        if (!$run->green()) {
            std::io::print($this->services->tails($dir, 12));
        }

        std::io::print($this->summary($run, $files, $totals, $verdict, $this->diffText($diff), $report));

        if (!$verdict->green || $unwritten > 0) {
            return 1;
        }
        return 0;
    }

    /**
     * Writes the report `$text` to `$path`, or says why not and counts it in `$unwritten`.
     */
    private static function store(const string& $path, const string& $text, usize& $unwritten) : void
    {
        guard files::write($path, $text) else ($e) {
            std::io::println("ecotest: cannot write {$path}: {$e}");
            $unwritten++;
            return;
        };
    }

    /**
     * Fills `$files` from the coverage of `$run`, kept in `$dir`, and answers its totals, or null
     * when the run has no coverage.
     */
    private const function measure(const string& $dir, const Run& $run, array<FileCoverage>& $files) : Totals?
    {
        $c = guard $this->scoped($dir, $run) else {
            return null;
        };

        $files = $c->files();
        return Coverage::totals($files);
    }

    /**
     * The coverage of the lines changed since `--since`, or null without a ref, coverage, or an
     * answer from git.
     */
    private const function changed(const array<FileCoverage>& $files) : Ratio?
    {
        if ($this->since->empty() || $files->empty()) {
            return null;
        }

        $d = guard GitDiff::since($this->git, $this->echoc->project, $this->since) else ($e) {
            std::io::println("ecotest: no diff coverage: {$e}");
            return null;
        };

        return $d->coverage($files);
    }

    /**
     * How much of the changed code ran, or nothing without a diff.
     */
    private const function diffText(Ratio? $diff) : string
    {
        $d = guard $diff else {
            return '';
        };

        return "{$d} of {$d->total} changed lines with code ran since {$this->since}";
    }

    /**
     * The summary the terminal gets: styled when the page takes it, plain otherwise. `$diff` and
     * `$report` are left out when empty.
     */
    private const function summary(const Run& $run, const array<FileCoverage>& $files, Totals? $totals, const Verdict& $verdict, const string& $diff, const string& $report) : string
    {
        $look = guard $this->look() else {
            return terminal::render($run, $files, $totals, $verdict, $diff, $report);
        };

        return pretty::render($look, $run, $files, $totals, $verdict, $diff, $report);
    }

    /**
     * The look of the styled summary, or null when the page is printed plain.
     */
    private const function look() : Look?
    {
        command::CLIContext $page = guard $this->page else {
            return null;
        };

        if (!$this->style->styled($page->caps)) {
            return null;
        }
        return Look($page->caps);
    }

    /**
     * The view that watches the run in `$dir` live, or null when echoc writes its own listing.
     */
    private const function liveView(const string& $dir) : LiveView?
    {
        command::CLIContext $live = guard $this->live else {
            return null;
        };

        if (!$this->style->live($live->caps)) {
            return null;
        }
        $view = LiveView($live);
        $view->run = Run($dir);
        return $view;
    }

    /**
     * The coverage of the newest run with this tool's module scope and excludes, or null when
     * there is no run or it has no coverage.
     */
    private const function newest() : Coverage?
    {
        $dir = guard files::latest($this->root()) else {
            return null;
        };

        return $this->coverageOf($dir);
    }

    /**
     * The coverage of run `$dir` with this tool's module scope and excludes, or null.
     */
    private const function coverageOf(const string& $dir) : Coverage?
    {
        return $this->scoped($dir, Run(readFrom: $dir));
    }

    /**
     * The coverage of `$run`, kept in `$dir`, with this tool's module scope and excludes, or null.
     */
    private const function scoped(const string& $dir, const Run& $run) : Coverage?
    {
        $c = guard Coverage::load($dir) else {
            return null;
        };
        $c->exclude = $this->exclude;
        foreach ($this->modules as const &$name) {
            $c->modules->set($name, true);
        }

        // the modules whose tests ran are the ones under test; --coverage-module adds to them
        foreach ($run->tests as const &$test) {
            $c->modules->set($test->module, true);
        }

        return $c;
    }
}
