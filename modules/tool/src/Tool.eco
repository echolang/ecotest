namespace ecotest::cli;

/**
 * The commands of the ecotest tool, behind the argument parsing in `Cli`. Runs live under
 * `.ecotest/run-<millis>/` in the project, beside its manifest, with `history.jsonl` beside them:
 * outside echoc's build directory, so `echoc clean` keeps the history and no module name can
 * collide with it. Every path and every program the tool starts is relative to `project`.
 */
public class Tool
{
    public string $project = '.';
    public string $echoc = 'echoc';
    public string $git = 'git';
    public string $buildDir = 'ecobuild';
    public bool $coverage = false;

    /**
     * Whether `run` writes `report.html` into the run directory. Off unless asked for.
     */
    public bool $html = false;

    public usize $repeat = 1;
    public array<string> $forwarded = [];
    public array<string> $modules = [];
    public array<string> $exclude = [];
    public string $since = '';
    public string $format = '';
    public Gates $gates = Gates();
    public Services $services = Services();

    /**
     * Live progress and the styled summary, or plain text. Simple unless the command line says.
     */
    public Style $style = .simple;

    /**
     * Where live progress is drawn, stderr from the command line. None draws nothing live.
     */
    public command::CLIContext? $live = null;

    /**
     * The stream the summary goes to, stdout from the command line. None prints it plain.
     */
    public command::CLIContext? $page = null;

    /**
     * Where runs and the history live.
     */
    public const function root() : string
    {
        return std::env::join($this->project, '.ecotest');
    }

    /**
     * Reads `ecotest.json` beside the manifest, when there is one: coverage excludes, modules and
     * thresholds, and the services to start. Flags given on the command line win.
     */
    public function configure() : void
    {
        string $text = Doc::read(std::env::join($this->project, 'ecotest.json'));
        if ($text->empty()) {
            return;
        }

        json::Value $doc = guard json::parse($text) else ($e) {
            std::io::println("ecotest: ecotest.json does not parse: {$e->message()}");
            return;
        };

        json::Value $cov = Doc::object($doc, 'coverage');
        if ($cov->isObject()) {
            foreach (Doc::list($cov, 'exclude') as const &$pattern) {
                $this->exclude[] = $pattern->asStr() ?? '';
            }
            if ($this->modules->empty()) {
                foreach (Doc::list($cov, 'modules') as const &$name) {
                    $this->modules[] = $name->asStr() ?? '';
                }
            }
            if ($this->gates->minLines < 0.0) {
                $this->gates->minLines = Doc::decimal($cov, 'min', -1.0);
            }
        }

        $this->services->configure(Doc::list($doc, 'services'));
    }

    /**
     * `ecotest run`: runs every pass, reports, writes the run directory and applies the gates.
     */
    public function run() : int32
    {
        $this->configure();

        int64 $stamp = std::time::timestamp::now()->unix_millis();
        string $dir = std::env::join($this->root(), "run-{$stamp}");
        Files::mkdirs($dir);

        if (!$this->services->start($dir, $this->project)) {
            $this->services->stop();
            return 1;
        }

        Runner $runner = Runner();
        $runner->project = $this->project;
        $runner->echoc = $this->echoc;
        $runner->buildDir = $this->buildDir;
        $runner->coverage = $this->coverage;
        $runner->repeat = $this->repeat;
        $runner->forwarded = $this->forwarded;
        $runner->seed = $stamp as uint64;
        $runner->envNames = $this->services->envNames;
        $runner->envValues = $this->services->envValues;
        LiveView? $view = $this->liveView($dir);
        $runner->view = $view;

        bool $ran = $runner->run($dir);
        $this->services->stop();

        if (!$ran) {
            return 1;
        }

        // a watched run was folded as its rows arrived; otherwise it is read back from the directory
        LiveView $watched = guard $view else {
            return $this->finish($dir, Run::load($dir));
        };
        $watched->run->settle();
        return $this->finish($dir, $watched->run);
    }

    /**
     * `ecotest report`: renders a stored run in `$format`, the terminal summary by default.
     */
    public function report(const string& $given) : int32
    {
        $this->configure();

        string $dir = $given;
        if ($dir->empty()) {
            $dir = Files::latest($this->root());
        }
        if ($dir->empty()) {
            std::io::println('ecotest: no run yet; run `ecotest run` first');
            return 1;
        }

        Run $run = Run::load($dir);
        array<FileCoverage> $files = [];
        array<Ratio> $totals = [];
        $this->measure($dir, $run, $files, $totals);
        // a stored run is shown, not judged again: the gates only mark the coverage
        Verdict $verdict = Verdict::of($run, $this->gates, []);

        if ($this->format == 'md') {
            std::io::print(MarkdownReport::render($run, $files, $totals, $verdict));
        } else if ($this->format == 'junit') {
            std::io::print(JunitReport::render($run));
        } else if ($this->format == 'lcov') {
            std::io::print(LcovReport::render($files));
        } else if ($this->format == 'html') {
            std::io::print(HtmlReport::render($run, $files, $totals, $verdict));
        } else if ($this->format == 'json') {
            std::io::print(JsonReport::render($run, $files, $totals, $verdict));
        } else {
            std::io::print($this->summary($run, $files, $totals, $verdict, '', ''));
        }

        return 0;
    }

    /**
     * `ecotest history`: trends over the last runs.
     */
    public function history() : int32
    {
        std::io::print(History::render(std::env::join($this->root(), 'history.jsonl'), 15));
        return 0;
    }

    /**
     * `ecotest api`: the public functions and methods the newest run with coverage never called.
     */
    public function api() : int32
    {
        $this->configure();

        string $dir = Files::latest($this->root());
        Coverage $c = guard $this->coverageOf($dir) else {
            std::io::println('ecotest: the newest run has no coverage; run `ecotest run --coverage` first');
            return 1;
        };

        // `build` needs somewhere to put a library's binary before it will print; the run keeps it
        array<string> $args = ['build', '-p', 'decls', '-o', std::env::join($dir, 'decls-bin')];
        if ($this->buildDir != 'ecobuild') {
            $args[] = '--build-dir';
            $args[] = $this->buildDir;
        }

        std::process::command $decls = std::process::command($this->echoc, $args);
        $decls->dir($this->project);
        result<std::process::output, std::io::ioerror> $ran = $decls->output();
        if ($ran->failed()) {
            std::io::println("ecotest: cannot run {$this->echoc}");
            return 1;
        }

        std::process::output $o = $ran->unwrap();
        json::Value $doc = guard json::parse($o->stdout) else {
            std::io::println('ecotest: echoc -p decls did not answer with JSON');
            return 1;
        };

        usize $total = 0;
        array<string> $untested = [];

        foreach (Doc::list($doc, 'modules') as const &$module) {
            string $name = Doc::text($module, 'name');
            if (!$c->reports($name)) {
                continue;
            }

            foreach (Doc::list($module, 'declarations') as const &$decl) {
                array<json::Value> $callables = [];
                string $kind = Doc::text($decl, 'kind');

                if ($kind == 'function') {
                    $callables[] = $decl;
                } else {
                    foreach (Doc::list($decl, 'methods') as const &$m) {
                        $callables[] = $m;
                    }
                    foreach (Doc::list($decl, 'constructors') as const &$k) {
                        $callables[] = $k;
                    }
                }

                foreach ($callables as const &$fn) {
                    if (Doc::text($fn, 'visibility') != 'public') {
                        continue;
                    }

                    string $file = Doc::text($fn, 'file');
                    int64 $line = Doc::number($fn, 'line');
                    if ($c->excluded($file)) {
                        continue;
                    }

                    bool $was = guard $c->called($file, $line) else {
                        continue;
                    };

                    $total++;
                    if (!$was) {
                        string $qualified = Doc::text($fn, 'qualified');
                        $untested[] = "{$qualified}  {$file}:{$line}";
                    }
                }
            }
        }

        usize $tested = $total - $untested->count();
        Ratio $r = Ratio($tested, $total);
        string $pct = $r->shown();
        std::io::println("public api  {$tested} of {$total} called by a test ({$pct})");
        foreach ($untested as const &$line) {
            std::io::println("  never called: {$line}");
        }

        return 0;
    }

    /**
     * `ecotest who <file:line>`: the tests that ran a line in the newest run with coverage.
     */
    public function who(const string& $spec) : int32
    {
        usize $colon = $spec->size();
        for (usize $i = 0; $i < $spec->size(); $i++) {
            if ($spec->byte($i) == 58) {
                $colon = $i;
            }
        }

        if ($colon == $spec->size()) {
            std::io::println('ecotest: expected <file:line>, for example src/date.eco:42');
            return 2;
        }

        string $file = $spec->sub(0, $colon);
        int64 $line = str::int($spec->sub($colon + 1, $spec->size() - $colon - 1)) ?? 0;

        Coverage $c = guard $this->coverageOf(Files::latest($this->root())) else {
            std::io::println('ecotest: the newest run has no coverage; run `ecotest run --coverage` first');
            return 1;
        };

        array<string> $ids = $c->testsAt($file, $line);
        if ($ids->empty()) {
            std::io::println("no test ran {$file}:{$line}");
            return 0;
        }

        foreach ($ids as const &$id) {
            std::io::println($id);
        }
        return 0;
    }

    /**
     * `ecotest affected --since <ref>`: runs only the tests that covered a line changed since the
     * ref, as the newest run with coverage saw them.
     */
    public function affected() : int32
    {
        Coverage $c = guard $this->coverageOf(Files::latest($this->root())) else {
            std::io::println('ecotest: needs a run with coverage to know which tests touch what; run `ecotest run --coverage` first');
            return 1;
        };

        GitDiff $diff = guard GitDiff::since($this->git, $this->project, $this->since) else {
            std::io::println("ecotest: git diff {$this->since} failed");
            return 1;
        };

        array<string> $names = [];

        for (usize $i = 0; $i < $diff->files->count(); $i++) {
            foreach ($diff->lines[$i] as const &$line) {
                foreach ($c->testsAt($diff->files[$i], $line) as const &$id) {
                    usize $sep = $id->find('::');
                    string $name = $id->sub($sep + 2, $id->size() - $sep - 2);
                    bool $seen = false;
                    foreach ($names as const &$n) {
                        if ($n == $name) {
                            $seen = true;
                        }
                    }
                    if (!$seen) {
                        $names[] = $name;
                    }
                }
            }
        }

        if ($names->empty()) {
            std::io::println("ecotest: no test covers a line changed since {$this->since}");
            return 0;
        }

        usize $count = $names->count();
        std::io::println("ecotest: {$count} tests touch lines changed since {$this->since}");
        foreach ($names as const &$name) {
            $this->forwarded[] = '--filter';
            $this->forwarded[] = $name;
        }

        return $this->run();
    }

    /**
     * Judges, renders and stores `$run`, finished in `$dir`. Returns the process exit code.
     */
    private function finish(const string& $dir, const Run& $run) : int32
    {
        array<FileCoverage> $files = [];
        array<Ratio> $totals = [];
        $this->measure($dir, $run, $files, $totals);

        Ratio? $diff = $this->changed($files);
        Verdict $verdict = $this->gates->check($run, $totals, $diff);

        Files::write(std::env::join($dir, 'run.json'), JsonReport::render($run, $files, $totals, $verdict));
        Files::write(std::env::join($dir, 'summary.md'), MarkdownReport::render($run, $files, $totals, $verdict));
        Files::write(std::env::join($dir, 'junit.xml'), JunitReport::render($run));
        if (!$files->empty()) {
            Files::write(std::env::join($dir, 'lcov.info'), LcovReport::render($files));
        }

        string $report = '';
        if ($this->html) {
            $report = std::env::join($dir, 'report.html');
            Files::write($report, HtmlReport::render($run, $files, $totals, $verdict));
        }

        History::append(std::env::join($this->root(), 'history.jsonl'), $dir, $run, $totals);

        if (!$run->green()) {
            std::io::print($this->services->tails($dir, 12));
        }

        std::io::print($this->summary($run, $files, $totals, $verdict, $this->diffText($diff), $report));

        if (!$verdict->green) {
            return 1;
        }
        return 0;
    }

    /**
     * Fills `$files` and `$totals` from the coverage of `$run`, kept in `$dir`, when it has any.
     */
    private const function measure(const string& $dir, const Run& $run, array<FileCoverage>& $files, array<Ratio>& $totals) : void
    {
        Coverage $c = guard $this->scoped($dir, $run) else {
            return;
        };

        $files = $c->files();
        $totals = $c->totals($files);
    }

    /**
     * The coverage of the lines changed since `--since`, or null without a ref, coverage, or an
     * answer from git.
     */
    private const function changed(const array<FileCoverage>& $files) : Ratio?
    {
        if ($this->since->empty() || $files->empty()) {
            return null;
        }

        GitDiff $d = guard GitDiff::since($this->git, $this->project, $this->since) else {
            return null;
        };

        return $d->coverage($files);
    }

    /**
     * How much of the changed code ran, or nothing without a diff.
     */
    private const function diffText(Ratio? $diff) : string
    {
        Ratio $d = guard $diff else {
            return '';
        };

        string $pct = $d->shown();
        return "{$pct} of {$d->total} changed lines with code ran since {$this->since}";
    }

    /**
     * The summary the terminal gets: styled when the page takes it, plain otherwise. `$diff` and
     * `$report` are left out when empty.
     */
    private const function summary(const Run& $run, const array<FileCoverage>& $files, const array<Ratio>& $totals, const Verdict& $verdict, const string& $diff, const string& $report) : string
    {
        Look $look = guard $this->look() else {
            return TerminalReport::render($run, $files, $totals, $verdict, $diff, $report);
        };

        return PrettyReport::render($look, $run, $files, $totals, $verdict, $diff, $report);
    }

    /**
     * The look of the styled summary, or null when the page is printed plain.
     */
    private const function look() : Look?
    {
        command::CLIContext $page = guard $this->page else {
            return null;
        };

        if (!$this->style->styled($page->caps)) {
            return null;
        }
        return Look($page->caps);
    }

    /**
     * The view that watches the run in `$dir` live, or null when echoc writes its own listing.
     */
    private const function liveView(const string& $dir) : LiveView?
    {
        command::CLIContext $live = guard $this->live else {
            return null;
        };

        if (!$this->style->live($live->caps)) {
            return null;
        }
        LiveView $view = LiveView($live);
        $view->run = Run($dir);
        return $view;
    }

    /**
     * The coverage of run `$dir` with this tool's module scope and excludes, or null.
     */
    private const function coverageOf(const string& $dir) : Coverage?
    {
        if ($dir->empty()) {
            return null;
        }

        return $this->scoped($dir, Run::load($dir));
    }

    /**
     * The coverage of `$run`, kept in `$dir`, with this tool's module scope and excludes, or null.
     */
    private const function scoped(const string& $dir, const Run& $run) : Coverage?
    {
        Coverage $c = guard Coverage::load($dir) else {
            return null;
        };
        $c->exclude = $this->exclude;
        $c->modules = $this->modules;

        // the modules whose tests ran are the ones under test; --coverage-module adds to them
        foreach ($run->tests as const &$test) {
            if (!$c->reports($test->module)) {
                $c->modules[] = $test->module;
            }
        }

        return $c;
    }
}
