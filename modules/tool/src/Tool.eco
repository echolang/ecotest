namespace ecotest::cli;

use ecotest::protocol;
use ecotest::cli::{doc, files, history, html, junit, lcov, markdown, pretty, queries, runjson, terminal};

/**
 * The commands of the ecotest tool, behind the argument parsing in `main`. Runs live under
 * `.ecotest/run-<millis>/` in the project, beside its manifest, with `history.jsonl` beside them:
 * outside echoc's build directory, so `echoc clean` keeps the history and no module name can
 * collide with it. Every path and every program the tool starts is relative to the project echoc
 * runs in. The queries over stored coverage (`who`, `api`, `affected`) live in `queries`.
 */
public class Tool
{
    /**
     * How echoc is run on the module under test, which is where runs and the history live too.
     */
    public Invocation $echoc = Invocation();
    public string $git = 'git';

    /**
     * Whether `run` writes `report.html` into the run directory. Off unless asked for.
     */
    public bool $html = false;

    public array<string> $modules = [];
    public array<string> $exclude = [];
    public string $since = '';
    public Format $format = .terminal;
    public Gates $gates = Gates();
    public Services $services = Services();

    /**
     * The seed handed to the tests, or null to take `ECOTEST_SEED`, or else the clock.
     */
    public uint64? $seed = null;

    /**
     * How many finished runs are kept; older ones are removed after each run.
     */
    public usize $keep = 20;

    /**
     * Live progress and the styled summary, or plain text. Simple unless the command line says.
     */
    public Style $style = .simple;

    /**
     * Where live progress is drawn, stderr from the command line. None draws nothing live.
     */
    public command::CLIContext? $live = null;

    /**
     * Whether `ecotest.json` was read already. Its excludes and services append, so a second read
     * would list everything twice.
     */
    private bool $configured = false;

    /**
     * The stream the summary goes to, stdout from the command line. None prints it plain.
     */
    public command::CLIContext? $page = null;

    /**
     * Where runs and the history live.
     */
    public const function root() : string
    {
        return std::env::join($this->echoc->project, '.ecotest');
    }

    /**
     * The runs of this project.
     */
    public const function store() : Store
    {
        return Store($this->root());
    }

    /**
     * Reads `ecotest.json` beside the manifest, when there is one: coverage excludes, modules and
     * thresholds, and the services to start. Flags given on the command line win. Only the first
     * call reads it, so `affected` can configure before it hands over to `run`. A file that does
     * not parse, or a threshold that is not a percentage, is refused.
     */
    public function configure() : status<ConfigError>
    {
        if ($this->configured) {
            return .ok;
        }
        $this->configured = true;

        $path = std::env::join($this->echoc->project, 'ecotest.json');
        // no ecotest.json is no configuration, and so is an empty one
        $text = guard doc::read($path) else {
            return .ok;
        };
        if (str::trim($text)->empty()) {
            return .ok;
        }

        $doc = guard json::parse($text) else ($e) {
            return .error(.malformed($path, $e));
        };

        $cov = doc::object($doc, 'coverage');
        if ($cov->isObject()) {
            foreach (doc::list($cov, 'exclude') as const &$pattern) {
                $this->exclude[] = $pattern->asStr() ?? '';
            }
            if ($this->modules->empty()) {
                foreach (doc::list($cov, 'modules') as const &$name) {
                    $this->modules[] = $name->asStr() ?? '';
                }
            }
            if ($this->gates->minLines == null && $cov->get('min') != null) {
                $min = guard doc::decimal($cov, 'min') else {
                    return .error(.badValue($path, 'coverage.min', 'a percentage from 0 to 100'));
                };
                if ($min < 0.0 || $min > 100.0) {
                    return .error(.badValue($path, 'coverage.min', 'a percentage from 0 to 100'));
                }
                $this->gates->minLines = $min;
            }
        }

        $this->services->configure(doc::list($doc, 'services'));
        return .ok;
    }

    /**
     * True when this run runs only some tests: filtered, or a target named.
     */
    public const function filtered() : bool
    {
        foreach ($this->echoc->forwarded as const &$word) {
            if ($word == '--filter' || $word == '--target') {
                return true;
            }
        }
        return false;
    }

    /**
     * The seed this run hands the tests: the one given, else `ECOTEST_SEED` from the environment,
     * else `$stamp`.
     */
    public const function seedFor(uint64 $stamp) : uint64
    {
        if ($this->seed != null) {
            return $this->seed ?? $stamp;
        }
        $inherited = string(std::env::var(protocol::SEED, ''));
        return str::uint($inherited) ?? $stamp;
    }

    /**
     * `ecotest run`: runs every pass, reports, writes the run directory and applies the gates.
     * Exits 2 for a configuration that cannot be used and 130 when interrupted, leaving the run
     * unfinished.
     */
    public function run() : int32
    {
        guard $this->configure() else ($e) {
            files::warn("{$e}");
            return 2;
        };

        $store = $this->store();
        $dir = guard $store->create() else ($e) {
            files::warn("{$e}");
            return 1;
        };

        guard $this->services->start($dir, $this->echoc->project) else ($e) {
            files::warn("{$e}");
            $this->services->stop();
            return 1;
        };

        $run = Run($dir);
        uint64 $seed = $this->seedFor(std::time::timestamp::now()->unix_millis() as uint64);
        $run->seed = "{$seed}";
        $run->filtered = $this->filtered();

        $runner = Runner();
        $runner->seed = $seed;
        $runner->env = $this->services->env;
        $runner->view = $this->liveView();

        $ran = $runner->run($this->echoc, $dir, $run);
        $this->services->stop();

        guard $ran else ($e) {
            int32 $code = Tool::failedWith($e);
            if ($code == 130) {
                files::warn("interrupted; {$dir} is left unfinished");
            } else {
                files::warn("{$e}");
            }
            return $code;
        };

        $run->settle();
        return $this->finish($dir, $run, $store);
    }

    /**
     * The exit code for a run that could not finish: 130 when interrupted, 1 otherwise.
     */
    private static function failedWith(const RunError& $e) : int32
    {
        return match ($e) {
            .interrupted => 130,
            .cannotRun($echoc, $cause) => 1,
            .cannotWrite($path, $cause) => 1,
            .cannotKeep($path, $cause) => 1,
        };
    }

    /**
     * `ecotest report`: renders a stored run in `$format`, the terminal summary by default. A run
     * that is not there, or did not finish, is refused.
     */
    public function report(const string& $given) : int32
    {
        $dir = guard $this->store()->open($given) else ($e) {
            files::warn("{$e}");
            return 1;
        };

        $run = Run(readFrom: $dir);
        $kept = CoverageReport::load($dir);
        array<FileCoverage> $files = [];
        Totals? $totals = null;
        if ($kept != null) {
            CoverageReport $r = guard $kept;
            $totals = $r->totals();
            $files = mv $r->files;
        }

        // a stored run is shown with the verdict it got, not judged again: the gates only mark the
        // coverage
        $verdict = Verdict(storedIn: $dir, run: $run, gates: $this->gates);

        match ($this->format) {
            .md => {
                std::io::print(markdown::render($run, $files, $totals, $verdict));
            },
            .junit => {
                std::io::print(junit::render($run, $verdict));
            },
            .lcov => {
                std::io::print(lcov::render($files));
            },
            .html => {
                std::io::print(html::render($run, $files, $totals, $verdict));
            },
            .json => {
                std::io::print(runjson::render($run, $files, $totals, $verdict));
            },
            .terminal => {
                std::io::print($this->summary($run, $files, $totals, $verdict, '', ''));
            },
        };

        return 0;
    }

    /**
     * `ecotest history`: trends over the last runs.
     */
    public const function history() : int32
    {
        std::io::print(history::render(std::env::join($this->root(), 'history.jsonl'), 15));
        return 0;
    }

    /**
     * `ecotest api`: the public functions and methods the last run with coverage never called.
     */
    public function api() : int32
    {
        guard $this->configure() else ($e) {
            files::warn("{$e}");
            return 2;
        };
        return queries::api($this);
    }

    /**
     * `ecotest who <file:line>`: the tests that ran a line in the last run with coverage.
     */
    public function who(const string& $spec) : int32
    {
        guard $this->configure() else ($e) {
            files::warn("{$e}");
            return 2;
        };
        return queries::who($this, $spec);
    }

    /**
     * `ecotest affected --since <ref>`: runs only the tests that covered a line changed since the
     * ref, as the last run with coverage saw them.
     */
    public function affected() : int32
    {
        guard $this->configure() else ($e) {
            files::warn("{$e}");
            return 2;
        };

        $selection = guard queries::select($this) else ($e) {
            files::warn("{$e}");
            return 1;
        };

        if ($selection->everything) {
            return $this->run();
        }

        if ($selection->names->empty()) {
            std::io::println("no test covers a line changed since {$this->since}");
            return 0;
        }

        foreach ($selection->ids as const &$id) {
            std::io::println($id);
        }
        // echoc filters by name, so a test of the same name in another file runs too
        foreach ($selection->names as const &$name) {
            $this->echoc->forwarded[] = '--filter';
            $this->echoc->forwarded[] = $name;
        }

        return $this->run();
    }

    /**
     * The coverage scope of `$run`: the modules asked for, and the modules whose tests ran, which
     * is the module under test and never the libraries it uses.
     */
    public const function scope(const Run& $run) : Scope
    {
        $s = Scope();
        $s->exclude = $this->exclude;
        foreach ($this->modules as const &$name) {
            $s->modules->set($name, true);
        }
        foreach ($run->tests as const &$test) {
            $s->modules->set($test->module, true);
        }
        return $s;
    }

    /**
     * Judges, renders and stores `$run`, finished in `$dir`. `run.json` goes last, marking the run
     * finished; then a run of the whole suite with coverage becomes the one the queries read, and
     * old runs are pruned. Returns the process exit code: 1 when the run is red or one of its
     * reports could not be written.
     */
    private function finish(const string& $dir, const Run& $run, Store& $store) : int32
    {
        usize $unwritten = 0;
        string $why = 'the run measured no coverage (add --coverage)';
        array<FileCoverage> $files = [];
        Totals? $totals = null;

        if ($this->echoc->coverage) {
            $why = 'echoc stopped before the tests';
            $loaded = Coverage::load($dir, $run);
            if ($loaded->failed()) {
                $e = $loaded->failure();
                $why = "{$e}";
                files::warn("no coverage: {$why}");
            } else {
                Coverage? $found = $loaded->unwrap();
                if ($found != null) {
                    Coverage $c = guard $found;
                    $r = CoverageReport::measure($c, $this->scope($run));
                    Tool::store(std::env::join($dir, 'coverage.json'), $r->json(), $unwritten);
                    $totals = $r->totals();
                    $files = mv $r->files;
                }
            }
        }

        $diff = $this->changed($files, $totals != null, $why);
        $verdict = $this->gates->check($run, $totals, $why, $diff);

        // every report is attempted, each rendered as it is written; one that could not be written
        // fails the run once it is shown
        Tool::store(std::env::join($dir, 'summary.md'), markdown::render($run, $files, $totals, $verdict), $unwritten);
        Tool::store(std::env::join($dir, 'junit.xml'), junit::render($run, $verdict), $unwritten);
        if (!$files->empty()) {
            Tool::store(std::env::join($dir, 'lcov.info'), lcov::render($files), $unwritten);
        }

        $report = '';
        if ($this->html) {
            $report = std::env::join($dir, 'report.html');
            Tool::store($report, html::render($run, $files, $totals, $verdict), $unwritten);
        }

        // a run the history misses is still a run: said, but not failed
        $historyPath = std::env::join($this->root(), 'history.jsonl');
        $kept = history::append($historyPath, $dir, $run, $totals);
        if ($kept->failed()) {
            files::warn("cannot write {$historyPath}: {$kept->failure()}");
        }

        // written whole and last: a run without it never finished
        $runJson = std::env::join($dir, 'run.json');
        $sealed = files::seal($runJson, runjson::render($run, $files, $totals, $verdict));
        if ($sealed->failed()) {
            files::warn("cannot write {$runJson}: {$sealed->failure()}");
            $unwritten++;
        }

        if ($totals != null && !$run->filtered && $run->stopped()->empty()) {
            $pointed = $store->point($dir);
            if ($pointed->failed()) {
                files::warn("{$pointed->failure()}");
            }
        }
        $pruned = $store->prune($this->keep, $dir);

        if (!$run->green()) {
            std::io::eprint($this->services->tails($dir, 12));
        }

        std::io::print($this->summary($run, $files, $totals, $verdict, $this->diffText($diff), $report));

        if (!$verdict->green || $unwritten > 0) {
            return 1;
        }
        return 0;
    }

    /**
     * Writes the report `$text` to `$path`, or says why not and counts it in `$unwritten`.
     */
    private static function store(const string& $path, const string& $text, usize& $unwritten) : void
    {
        guard files::write($path, $text) else ($e) {
            files::warn("cannot write {$path}: {$e}");
            $unwritten++;
            return;
        };
    }

    /**
     * How much of the code changed since `--since` ran: off without a ref, unmeasured without
     * coverage (for the reason `$why`) or without an answer from git.
     */
    private const function changed(const array<FileCoverage>& $files, bool $covered, const string& $why) : DiffMeasure
    {
        if ($this->since->empty()) {
            return .off;
        }
        if (!$covered) {
            return .unmeasured($why);
        }

        $d = guard GitDiff::since($this->git, $this->echoc->project, $this->since) else ($e) {
            return .unmeasured("{$e}");
        };

        return .measured($d->coverage($files));
    }

    /**
     * How much of the changed code ran, or why that is not known, or nothing without a ref.
     */
    private const function diffText(const DiffMeasure& $diff) : string
    {
        return match ($diff) {
            .off => '',
            .measured($d) => "{$d} of {$d->total} changed lines with code ran since {$this->since}",
            .unmeasured($reason) => "not measured: {$reason}",
        };
    }

    /**
     * The summary the terminal gets: styled when the page takes it, plain otherwise. `$diff` and
     * `$report` are left out when empty.
     */
    private const function summary(const Run& $run, const array<FileCoverage>& $files, Totals? $totals, const Verdict& $verdict, const string& $diff, const string& $report) : string
    {
        $look = guard $this->look() else {
            return terminal::render($run, $files, $totals, $verdict, $diff, $report);
        };

        return pretty::render($look, $run, $files, $totals, $verdict, $diff, $report);
    }

    /**
     * The look of the styled summary, or null when the page is printed plain.
     */
    private const function look() : Look?
    {
        command::CLIContext $page = guard $this->page else {
            return null;
        };

        if (!$this->style->styled($page->caps)) {
            return null;
        }
        return Look($page->caps);
    }

    /**
     * The view that watches the run live, or null when echoc writes its own listing.
     */
    private const function liveView() : LiveView?
    {
        command::CLIContext $live = guard $this->live else {
            return null;
        };

        if (!$this->style->live($live->caps)) {
            return null;
        }
        return LiveView($live);
    }
}
