/**
 * Path patterns for coverage excludes: `*` matches inside one directory, `**` across them, every
 * other byte matches itself.
 */

namespace ecotest::cli::glob;

/**
 * True when `$path` matches `$pattern` in full.
 */
public function matches(const string& $pattern, const string& $path) : bool
{
    return from($pattern, 0, $path, 0);
}

/**
 * Matches the pattern from `$p` against the path from `$s`.
 */
private function from(const string& $pattern, usize $p, const string& $path, usize $s) : bool
{
    while ($p < $pattern->size()) {
        uint8 $c = $pattern->byte($p);

        if ($c == 42) {
            $deep = $p + 1 < $pattern->size() && $pattern->byte($p + 1) == 42;
            usize $next = $p + 1;
            if ($deep) {
                $next = $p + 2;
                // `**/` also matches no directory at all
                if ($next < $pattern->size() && $pattern->byte($next) == 47 && from($pattern, $next + 1, $path, $s)) {
                    return true;
                }
            }

            for (usize $k = $s; $k <= $path->size(); $k++) {
                if (from($pattern, $next, $path, $k)) {
                    return true;
                }
                if ($k < $path->size() && !$deep && $path->byte($k) == 47) {
                    return false;
                }
            }
            return false;
        }

        if ($s >= $path->size() || $path->byte($s) != $c) {
            return false;
        }

        $p++;
        $s++;
    }

    return $s == $path->size();
}
