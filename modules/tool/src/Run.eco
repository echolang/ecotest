namespace ecotest::cli;

use ecotest::{paths, protocol};
use ecotest::cli::doc;

/**
 * The version of echoc's report rows this tool reads.
 */
public const int64 REPORT_VERSION = 2;

/**
 * One ecotest run, folded from what its passes left in the run directory: `pass-N/report.jsonl`
 * from echoc, `pass-N/echoc.json` with how echoc ended, and `pass-N/events/*.jsonl` from the tests.
 * A run being watched folds the same rows as they arrive, so a stored run renders later exactly as
 * it did live.
 */
public class Run
{
    public const string $dir;
    public string $version = '';
    public int64 $wallMs = 0;

    /**
     * The seed the tests were handed as `ECOTEST_SEED`, so a failure replays.
     */
    public string $seed = '';

    /**
     * True when the run ran only some tests: filtered, or a target named. Its coverage is not the
     * suite's, so the queries never read it.
     */
    public bool $filtered = false;

    /**
     * Every pass so far, in order.
     */
    public array<Pass> $passes = [];
    public array<TestRecord> $tests = [];

    /**
     * Where each test's record sits in `tests`, by id.
     */
    private map<string, usize> $index = [];

    /**
     * The same places, by the file-name form of the id.
     */
    private map<string, usize> $byKey = [];

    /**
     * An empty run kept in `$dir`, filled as its rows arrive.
     */
    public constructor(const string& $dir)
    {
        $this->dir = $dir;
    }

    /**
     * The run stored in `$dir`, with every pass found there read in order.
     */
    public constructor(readFrom: const string& $dir)
    {
        $this->dir = $dir;

        usize $pass = 1;
        while (true) {
            $passDir = std::env::join($dir, "pass-{$pass}");
            $there = std::io::exists($passDir)->or(false);
            if (!$there) {
                break;
            }

            $this->absorb($passDir);
            $pass++;
        }

        $this->settle();
        $this->recall();
    }

    /**
     * Takes what the tool knew when the run finished, kept in its `run.json`: the seed, and whether
     * it was filtered.
     */
    private function recall() : void
    {
        $kept = guard doc::read(std::env::join($this->dir, 'run.json')) else {
            return;
        };
        $facts = guard json::parse($kept) else {
            return;
        };
        $this->seed = doc::text($facts, 'seed');
        $this->filtered = doc::object($facts, 'filtered')->asBool() ?? false;
    }

    /**
     * Starts the next pass, kept in `$passDir`: the rows folded from now on belong to it.
     */
    public function begin(const string& $passDir) : void
    {
        $this->passes[] = Pass($passDir);
    }

    /**
     * Reads one stored pass: echoc's report rows with each test's events, then how echoc ended.
     */
    public function absorb(const string& $passDir) : void
    {
        $this->begin($passDir);

        // the test a row folded into is for the live view; reading back needs only the fold
        foreach (doc::lines(doc::read(std::env::join($passDir, 'report.jsonl')) ?? '') as const &$row) {
            $folded = $this->fold($row);
        }

        // a pass stored before echoc's exit was kept has none, and is judged on its rows
        $exit = guard doc::read(std::env::join($passDir, 'echoc.json')) else {
            return;
        };
        $parsed = guard json::parse($exit) else {
            return;
        };
        $this->exited(PassExit(doc::small($parsed, 'exit'), doc::small($parsed, 'signal')));
    }

    /**
     * How echoc ended the current pass.
     */
    public function exited(PassExit $exit) : void
    {
        if ($this->passes->empty()) {
            return;
        }
        $this->passes[$this->passes->count() - 1]->exit = $exit;
    }

    /**
     * Folds one of echoc's report rows into the current pass: the run starting, a test finishing
     * with the events it wrote, or the end. Answers the test a test row is about.
     */
    public function fold(const json::Value& $row) : TestRecord?
    {
        // a row before any pass began belongs to none
        if ($this->passes->empty()) {
            return null;
        }

        Pass& $pass = $this->passes[$this->passes->count() - 1];
        $type = doc::text($row, 'type');

        int64 $v = doc::number($row, 'v');
        if ($v != REPORT_VERSION) {
            if ($pass->refused->empty()) {
                int64 $known = REPORT_VERSION;
                $pass->refused = "echoc's report is version {$v}; this ecotest reads version {$known}";
            }
            return null;
        }

        if ($type == 'run') {
            $this->version = doc::text($row, 'version');
            $pass->reached = true;
            $pass->selected = doc::number($row, 'selected');
            return null;
        }

        if ($type == 'end') {
            $this->wallMs = $this->wallMs + doc::number($row, 'ms');
            $pass->ended = true;
            return null;
        }

        if ($type != 'test') {
            return null;
        }

        $pass->rows++;
        $test = $this->find(doc::text($row, 'id'));
        $test->module = doc::text($row, 'module');
        $test->file = paths::relative(doc::text($row, 'file'), Run::projectOf($this->dir));
        $test->name = doc::text($row, 'name');
        $test->group = doc::text($row, 'group');
        $test->output = doc::text($row, 'output');

        // the last pass's events describe the last pass's failure, skip and assertions, and a note
        // or a bench every pass wrote is reported once
        $test->events = Events();
        $events = std::env::join(std::env::join($pass->dir, 'events'), "{$test->key}.jsonl");
        // a test that wrote nothing through ecotest has no events file
        foreach (doc::lines(doc::read($events) ?? '') as const &$event) {
            $test->events->apply($event);
        }

        $crash = doc::object($row, 'failure');
        if ($crash->isObject()) {
            $test->events->crashed($crash);
        }

        Outcome $outcome = .of(doc::text($row, 'status'));
        // a test that skips itself exits cleanly, so echoc calls the pass a pass
        if ($test->events->skipped) {
            $outcome = .skip;
        }
        if ($outcome != Outcome::pass && $outcome != Outcome::skip) {
            $pass->failing = true;
        }

        $test->attempts[] = Attempt($outcome, doc::number($row, 'ms'), $test->events->fault);
        return $test;
    }

    /**
     * The record whose id has the file-name form `$key`, or null.
     */
    public const function keyed(const string& $key) : TestRecord?
    {
        if (!$this->byKey->has($key)) {
            return null;
        }
        return $this->tests[$this->byKey->get($key)];
    }

    /**
     * The record for `$id`, made on first sight so tests keep the order echoc ran them in.
     */
    public function find(const string& $id) : TestRecord
    {
        if ($this->index->has($id)) {
            return $this->tests[$this->index->get($id)];
        }

        $test = TestRecord($id);
        $this->index->set($id, $this->tests->count());
        $this->byKey->set($test->key, $this->tests->count());
        $this->tests[] = $test;
        return $test;
    }

    /**
     * The project a run directory belongs to: what holds its `.ecotest`, or the working directory
     * for a run kept anywhere else.
     */
    public static function projectOf(const string& $dir) : string
    {
        $parts = paths::split($dir);
        for (usize $i = $parts->count(); $i > 0; $i--) {
            if ($parts[$i - 1] != '.ecotest') {
                continue;
            }

            string $out = paths::root($dir);
            for (usize $k = 0; $k + 1 < $i; $k++) {
                if ($out->empty()) {
                    $out = $parts[$k];
                } else {
                    $out = std::env::join($out, $parts[$k]);
                }
            }
            return $out;
        }

        return std::env::cwd();
    }

    /**
     * Settles every test's outcome from its passes and events.
     */
    public function settle() : void
    {
        foreach ($this->tests as &$test) {
            $test->settle();
        }
    }

    /**
     * How many tests ended with each outcome, and how many there are.
     */
    public const function counts() : Counts
    {
        $c = Counts();
        foreach ($this->tests as const &$test) {
            match ($test->outcome) {
                .pass => {
                    $c->pass++;
                },
                .fail => {
                    $c->fail++;
                },
                .skip => {
                    $c->skip++;
                },
                .flaky => {
                    $c->flaky++;
                },
                .timeout => {
                    $c->timeout++;
                },
                .signal => {
                    $c->signal++;
                },
            };
        }
        $c->total = $this->tests->count();
        return $c;
    }

    /**
     * The wall time of every pass together, in seconds.
     */
    public const function seconds() : float64
    {
        return ($this->wallMs as float64) / 1000.0;
    }

    /**
     * The duration `$percent` of the tests finished within, in milliseconds, or 0 without tests.
     */
    public const function percentile(usize $percent) : int64
    {
        if ($this->tests->empty()) {
            return 0;
        }

        $ms = arr::room<int64>($this->tests->count());
        foreach ($this->tests as const &$test) {
            $ms[] = $test->ms();
        }
        $ms->sort();
        return $ms[($ms->count() * $percent) / 100];
    }

    /**
     * The `$n` slowest tests, slowest first.
     */
    public const function slowest(usize $n) : array<TestRecord>
    {
        array<TestRecord> $byTime = $this->tests;
        $byTime->sort(by: (const TestRecord& $a, const TestRecord& $b) : ordering => $b->ms() <=> $a->ms());
        $byTime->truncate($n);
        return $byTime;
    }

    /**
     * How many assertions the tests made through ecotest.
     */
    public const function assertions() : int64
    {
        int64 $n = 0;
        foreach ($this->tests as const &$test) {
            $n = $n + $test->events->checks;
        }
        return $n;
    }

    /**
     * How many tests used ecotest, so their assertions were counted.
     */
    public const function asserting() : usize
    {
        usize $n = 0;
        foreach ($this->tests as const &$test) {
            if ($test->events->usedEcotest) {
                $n++;
            }
        }
        return $n;
    }

    /**
     * Why passes are incomplete, one line each, naming the pass when there are several. Empty
     * when every pass is whole.
     */
    public const function stopped() : array<string>
    {
        array<string> $out = [];
        for (usize $i = 0; $i < $this->passes->count(); $i++) {
            $reason = guard $this->passes[$i]->stop() else {
                continue;
            };
            if ($this->passes->count() > 1) {
                usize $n = $i + 1;
                $out[] = "pass {$n}: {$reason}";
            } else {
                $out[] = $reason;
            }
        }
        return $out;
    }

    /**
     * True when at least one pass ran, every pass is whole, and no test failed, timed out or was
     * killed. Flaky tests are judged by the gates.
     */
    public const function green() : bool
    {
        if ($this->passes->empty() || !$this->stopped()->empty()) {
            return false;
        }
        foreach ($this->tests as const &$test) {
            if ($test->outcome->broken()) {
                return false;
            }
        }
        return true;
    }
}
