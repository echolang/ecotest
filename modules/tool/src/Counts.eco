namespace ecotest::cli;

/**
 * How a run's tests ended, counted once for every report that shows the tally.
 */
public struct Counts
{
    public usize $pass = 0;
    public usize $fail = 0;
    public usize $skip = 0;
    public usize $flaky = 0;
    public usize $timeout = 0;
    public usize $signal = 0;
    public usize $total = 0;

    /**
     * The tests that failed, timed out or were killed: the ones that fail a run.
     */
    public const function failed() : usize
    {
        return $this->fail + $this->timeout + $this->signal;
    }
}
