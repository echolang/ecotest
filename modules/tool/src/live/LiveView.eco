namespace ecotest::cli;

use ecotest::cli::doc;
use command::element;

/**
 * One pass as it happens, drawn from the rows the runner folds into the run: echoc's output in a
 * short scrolling window under a spinner while the tests compile, then a bar over the tests as
 * their report rows arrive. A passing test scrolls through the window; a broken one is printed
 * above it and stays.
 *
 * On a stream that cannot be redrawn, libcommand writes every row as a plain line instead.
 */
public class LiveView
{
    public command::CLIContext $ctx;
    private const Look $look;

    private element::LogStream $window;
    private element::Spinner? $spin = null;
    private element::Progress? $bar = null;
    private usize $passed = 0;
    private usize $failed = 0;

    /**
     * How many of this pass's tests used ecotest, and the assertions they made: every row folded
     * in, before the bar was drawn or not.
     */
    private usize $asserting = 0;
    private int64 $assertions = 0;

    private std::time::instant $since = std::time::instant::now();

    /**
     * The last test finished since the bar was drawn. The bar moves once per batch of rows.
     */
    private string $latest = '';

    /**
     * Which pass this is, when there are several, for the rows that settle.
     */
    private string $pass = '';

    /**
     * True once a pass began. A row before that belongs to none.
     */
    private bool $begun = false;

    public constructor(command::CLIContext $ctx)
    {
        $this->ctx = $ctx;
        $this->look = Look($ctx->caps);
        // a window nothing was pushed into leaves the screen as it found it
        $this->window = element::LogStream($ctx, 1);
    }

    /**
     * Pass `$pass` of `$passes` starts: the spinner over the compile, with its window.
     */
    public function begin(usize $pass, usize $passes) : void
    {
        $this->begun = true;
        $this->passed = 0;
        $this->failed = 0;
        $this->asserting = 0;
        $this->assertions = 0;
        $this->since = std::time::instant::now();

        $this->pass = '';
        if ($passes > 1) {
            $this->pass = " {$this->look->dot} pass {$pass} of {$passes}";
        }
        $what = "compiling tests{$this->pass}";

        $this->window = element::LogStream($this->ctx, 6);
        $spin = $this->window->spinner();
        $spin->start($what);
        $this->spin = mv $spin;
    }

    /**
     * True while echoc compiles, the only time its output is shown.
     */
    public const function compiling() : bool
    {
        return $this->spin != null;
    }

    /**
     * Lines echoc wrote. Shown while it compiles; once the tests run, the report rows say more.
     */
    public function output(const string& $text) : void
    {
        if ($text->empty() || !$this->compiling()) {
            return;
        }

        $this->window->push($text);
    }

    /**
     * One row of echoc's report, with the test the run folded it into, without drawing the bar:
     * `advance` draws it once for a batch of rows.
     */
    public function take(const json::Value& $row, TestRecord? $folded) : void
    {
        if (!$this->begun) {
            return;
        }

        $type = doc::text($row, 'type');

        if ($type == 'run') {
            $this->started(doc::number($row, 'selected'));
            return;
        }

        if ($type == 'end') {
            $this->close(true);
            return;
        }

        $test = guard $folded else {
            return;
        };
        if ($test->events->usedEcotest) {
            $this->asserting++;
            $this->assertions = $this->assertions + $test->events->checks;
        }
        $this->finished($test);
    }

    /**
     * echoc is gone. Without a run row it never reached the tests, so the spinner fails and its
     * whole log at `$logPath` is printed; without an end row the bar fails where it stopped.
     */
    public function end(const string& $logPath) : void
    {
        $this->close(false);

        element::Spinner $spin = guard $this->spin else {
            return;
        };

        $this->window->close();
        $spin->fail('echoc stopped before any test ran');
        $this->spin = null;

        foreach (str::lines(doc::read($logPath) ?? '') as const &$line) {
            $this->ctx->line(string($line));
        }
    }

    /**
     * The compile is done and `$total` tests are about to run: the spinner settles and the bar
     * takes over in a window of its own.
     */
    private function started(int64 $total) : void
    {
        element::Spinner $spin = guard $this->spin else {
            return;
        };

        $secs = $this->elapsed();
        $spin->succeed("compiled in {$secs:.1f} s{$this->pass}");
        $this->spin = null;
        $this->since = std::time::instant::now();

        $this->window = element::LogStream($this->ctx, 4);
        // the rows printed above the window keep their colour; nothing echoc wrote is pushed here
        $this->window->strip = false;
        $bar = $this->window->progress();
        $bar->start('tests', $total as int32);
        $this->bar = mv $bar;
    }

    /**
     * A test finished, folded with the events it wrote: a pass scrolls through the window, a broken
     * test stays above it with where it stopped, and the bar moves on.
     */
    private function finished(const TestRecord& $test) : void
    {
        if ($this->bar == null) {
            return;
        }

        $outcome = $test->latest();
        $title = $this->look->title($test);

        if ($outcome->broken()) {
            $this->failed++;

            $lines = $this->look->headline($outcome, $title);
            $lines->append($this->stop($test));
            $this->window->print($lines);
        } else {
            $this->passed++;

            int64 $ms = $test->ms();
            // drawn muted behind the window's rail, so the mark carries no colour
            $mark = $this->look->glyph($outcome);
            $pushed = "{$mark} {$title}  {$ms} ms";
            if ($test->events->usedEcotest) {
                $asserted = $this->look->many($test->events->checks, 'assertion');
                $pushed->append(" {$this->look->dot} {$asserted}");
            }
            $this->window->push($pushed);
        }

        $this->latest = $title;
    }

    /**
     * The row under a broken test's headline: where `$events` failed and the first line of what
     * they said. Nothing when they did not fail.
     */
    private const function stop(const TestRecord& $test) : string
    {
        $fault = guard $test->fault() else {
            return '';
        };

        // the summary shows the rest; one row keeps the window's height honest
        usize $cut = $fault->summary->find('\n');
        $message = $fault->summary->sub(0, $cut);
        $where = $this->look->mute("  {$this->look->rail} {$fault->file}:{$fault->line}  {$message}");
        return "\n{$where}";
    }

    /**
     * The bar moves to the tests finished so far, if any finished since it was last drawn.
     */
    public function advance() : void
    {
        element::Progress $bar = guard $this->bar else {
            return;
        };
        if ($this->latest->empty()) {
            return;
        }

        $bar->set(($this->passed + $this->failed) as int32, $this->latest);
        $this->latest = '';
    }

    /**
     * The bar settles with the counts: green when every test of a `$whole` run passed. Otherwise
     * the window goes and one failed row stays, under the failures already printed.
     */
    private function close(bool $whole) : void
    {
        element::Progress $bar = guard $this->bar else {
            return;
        };
        $this->bar = null;
        $this->latest = '';

        $secs = $this->elapsed();
        $summary = "{$this->passed} passed";
        if ($this->failed > 0) {
            $summary->append(" {$this->look->dot} {$this->failed} failed");
        }
        if ($this->asserting > 0) {
            $asserted = $this->look->many($this->assertions, 'assertion');
            $summary->append(" {$this->look->dot} {$asserted}");
        }
        $summary->append(" in {$secs:.1f} s{$this->pass}");

        usize $done = $this->passed + $this->failed;
        $bar->set($done as int32, $summary);

        if ($whole && $this->failed == 0) {
            $bar->finish();
            return;
        }

        $this->window->close();
        $bar->fail();
    }

    /**
     * Seconds since the compile or the tests started.
     */
    private const function elapsed() : float64
    {
        return ($this->since->elapsed()->as_millis() as float64) / 1000.0;
    }
}
