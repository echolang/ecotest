/**
 * Reading fields out of parsed JSON without a guard per field: a missing or mistyped field reads
 * as empty or zero, which is what every report reader here wants. A number that may be absent
 * reads as null.
 */

namespace ecotest::cli::doc;

/**
 * The string at `$key`, or empty.
 */
public function text(const json::Value& $doc, const string& $key) : string
{
    $v = guard $doc->get($key) else {
        return '';
    };
    return $v->asStr() ?? '';
}

/**
 * The integer at `$key`, or 0.
 */
public function number(const json::Value& $doc, const string& $key) : int64
{
    $v = guard $doc->get($key) else {
        return 0;
    };
    return $v->asInt() ?? 0;
}

/**
 * The integer at `$key` as an `int32`, or null when it is missing or not an integer.
 */
public function small(const json::Value& $doc, const string& $key) : int32?
{
    $v = guard $doc->get($key) else {
        return null;
    };
    $n = guard $v->asInt() else {
        return null;
    };
    return $n as int32;
}

/**
 * The number at `$key`, integer or not, or null when it is missing or not a number.
 */
public function decimal(const json::Value& $doc, const string& $key) : float64?
{
    $v = guard $doc->get($key) else {
        return null;
    };
    return $v->asFloat();
}

/**
 * The array at `$key`, or an empty one.
 */
public function list(const json::Value& $doc, const string& $key) : array<json::Value>
{
    array<json::Value> $none = [];
    $v = guard $doc->get($key) else {
        return $none;
    };
    return $v->asArray() ?? $none;
}

/**
 * The object at `$key`, or JSON null.
 */
public function object(const json::Value& $doc, const string& $key) : json::Value
{
    $v = guard $doc->get($key) else {
        return json::nil();
    };
    return $v;
}

/**
 * Every line of `$text` that parses as JSON. A broken line is skipped: a test killed mid-write
 * must not lose the run.
 */
public function lines(const string& $text) : array<json::Value>
{
    array<json::Value> $out = [];

    foreach (str::lines($text) as const &$line) {
        $owned = string($line);
        if (str::trim($owned)->empty()) {
            continue;
        }

        $parsed = guard json::parse($owned) else {
            continue;
        };
        $out[] = mv $parsed;
    }

    return $out;
}

/**
 * The file at `$path`, or null when it is missing or cannot be read.
 */
public function read(const string& $path) : string?
{
    $text = guard std::fs::readfile($path) else {
        return null;
    };
    return $text;
}
