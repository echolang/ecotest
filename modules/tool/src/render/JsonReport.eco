/**
 * The run as one JSON document, `run.json`, for other tools. Versioned by `v`.
 */

namespace ecotest::cli::runjson;

/**
 * The JSON document for `$run`.
 */
public function render(const Run& $run, const array<FileCoverage>& $files, Totals? $totals, const Verdict& $verdict) : string
{
    $doc = json::object();
    $doc['v'] = json::int(1);
    $doc['echoc'] = json::str($run->version);
    $doc['ms'] = json::int($run->wallMs);
    $doc['passes'] = json::int($run->passes as int64);
    $doc['green'] = json::bool($verdict->green);

    $c = $run->counts();
    $counts = json::object();
    $counts['pass'] = json::int($c->pass as int64);
    $counts['fail'] = json::int($c->fail as int64);
    $counts['skip'] = json::int($c->skip as int64);
    $counts['flaky'] = json::int($c->flaky as int64);
    $counts['timeout'] = json::int($c->timeout as int64);
    $counts['signal'] = json::int($c->signal as int64);
    $doc['counts'] = mv $counts;

    $tests = json::arr();
    foreach ($run->tests as const &$test) {
        $t = json::object();
        $t['id'] = json::str($test->id);
        $t['module'] = json::str($test->module);
        $t['file'] = json::str($test->file);
        $t['name'] = json::str($test->name);
        $t['group'] = json::str($test->group);
        $t['outcome'] = json::str($test->outcome->value());
        $t['ms'] = json::int($test->ms());

        $attempts = json::arr();
        foreach ($test->attempts as const &$a) {
            $attempts[] = json::str($a->outcome->value());
        }
        $t['attempts'] = mv $attempts;

        const Events& $events = $test->events;
        if ($events->usedEcotest) {
            $t['checks'] = json::int($events->checks);
        }
        failure($t, $events);
        if (!$events->skipReason->empty()) {
            $t['skip'] = json::str($events->skipReason);
        }
        if (!$events->notes->empty()) {
            $notes = json::arr();
            foreach ($events->notes as const &$note) {
                $notes[] = json::str($note);
            }
            $t['notes'] = mv $notes;
        }
        if (!$events->metrics->empty()) {
            $metrics = json::object();
            foreach ($events->metrics as const &$metric) {
                $metrics[$metric->name] = json::int($metric->value);
            }
            $t['metrics'] = mv $metrics;
        }
        if (!$events->benches->empty()) {
            $benches = json::arr();
            foreach ($events->benches as const &$b) {
                $one = json::object();
                $one['label'] = json::str($b->label);
                $one['p50_ns'] = json::int($b->p50);
                $one['p95_ns'] = json::int($b->p95);
                $one['calls'] = json::int($b->calls);
                $benches[] = mv $one;
            }
            $t['benches'] = mv $benches;
        }

        $tests[] = mv $t;
    }
    $doc['tests'] = mv $tests;

    coverage($doc, $files, $totals);

    $gates = json::arr();
    foreach ($verdict->failed as const &$gate) {
        $gates[] = json::str($gate);
    }
    $doc['failedGates'] = mv $gates;

    return json::pretty($doc);
}

/**
 * Sets `coverage` on the run document `$doc`: the totals and every file, when the run measured
 * coverage.
 */
private function coverage(json::Value& $doc, const array<FileCoverage>& $files, Totals? $totals) : void
{
    $t = guard $totals else {
        return;
    };

    $cov = json::object();
    $cov['lines'] = ratio($t->lines);
    $cov['branches'] = ratio($t->branches);
    $cov['functions'] = ratio($t->functions);

    $perFile = json::arr();
    foreach ($files as const &$file) {
        $f = json::object();
        $f['module'] = json::str($file->module);
        $f['file'] = json::str($file->file);
        $f['lines'] = ratio($file->lineTotals());
        $f['branches'] = ratio($file->branchTotals());
        $f['functions'] = ratio($file->functionTotals());
        $f['missed'] = json::str($file->missedRanges());
        $perFile[] = mv $f;
    }
    $cov['files'] = mv $perFile;
    $doc['coverage'] = mv $cov;
}

/**
 * Sets `failure` on the test object `$t` to `{"summary", "file", "line", "detail", "context"}`
 * when `$events` failed.
 */
private function failure(json::Value& $t, const Events& $events) : void
{
    $f = guard $events->fault else {
        return;
    };

    $v = json::object();
    $v['summary'] = json::str($f->summary);
    $v['file'] = json::str($f->file);
    $v['line'] = json::int($f->line);
    $v['detail'] = json::str($f->detail);
    $context = json::arr();
    foreach ($f->context as const &$scope) {
        $context[] = json::str($scope);
    }
    $v['context'] = mv $context;
    $t['failure'] = mv $v;
}

/**
 * `{"hit": n, "total": n, "percent": p}`.
 */
private function ratio(const Ratio& $r) : json::Value
{
    $v = json::object();
    $v['hit'] = json::int($r->hit as int64);
    $v['total'] = json::int($r->total as int64);
    $v['percent'] = json::float($r->percent());
    return $v;
}
