/**
 * Coverage as an LCOV tracefile, which editors, genhtml and coverage services read.
 */

namespace ecotest::cli::lcov;

/**
 * The tracefile for `$files`.
 */
public function render(const array<FileCoverage>& $files) : string
{
    $out = '';

    foreach ($files as const &$file) {
        $out->append("TN:\nSF:{$file->path}\n");

        foreach ($file->functions as const &$function) {
            $out->append("FN:{$function->line},{$function->name}\n");
        }
        foreach ($file->functions as const &$function) {
            $out->append("FNDA:{$function->hits},{$function->name}\n");
        }

        $fns = $file->functionTotals();
        $out->append("FNF:{$fns->total}\nFNH:{$fns->hit}\n");

        for (usize $i = 0; $i < $file->branches->count(); $i++) {
            const BranchSite& $branch = $file->branches[$i];
            $out->append("BRDA:{$branch->line},0,{$i},{$branch->hits}\n");
        }

        $brs = $file->branchTotals();
        $out->append("BRF:{$brs->total}\nBRH:{$brs->hit}\n");

        foreach ($file->codeLines() as const &$line) {
            uint64 $hits = $file->lines->get($line);
            $out->append("DA:{$line},{$hits}\n");
        }

        $ls = $file->lineTotals();
        $out->append("LF:{$ls->total}\nLH:{$ls->hit}\nend_of_record\n");
    }

    return $out;
}
