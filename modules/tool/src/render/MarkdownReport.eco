/**
 * The run as Markdown, for a CI step summary or a pull request comment.
 */

namespace ecotest::cli::markdown;

use ecotest::cli::text;

/**
 * The Markdown summary of `$run`.
 */
public function render(const Run& $run, const array<FileCoverage>& $files, Totals? $totals, const Verdict& $verdict) : string
{
    $c = $run->counts();

    $word = 'failed';
    if ($verdict->green) {
        $word = 'passed';
    }

    $out = "## Tests {$word}\n\n";
    $out->append('| passed | failed | skipped | flaky | time |\n|---:|---:|---:|---:|---:|\n');
    usize $failed = $c->failed();
    $out->append("| {$c->pass} | {$failed} | {$c->skip} | {$c->flaky} | {$run->wallMs} ms |\n\n");

    coverage($out, $totals);

    foreach ($verdict->stopped as const &$reason) {
        $out->append("- :x: run incomplete: {$reason}\n");
    }
    foreach ($verdict->failed as const &$gate) {
        $out->append("- :x: {$gate}\n");
    }
    if (!$verdict->failed->empty() || !$verdict->stopped->empty()) {
        $out->append('\n');
    }

    listing($out, $run, 'Failures', false);
    listing($out, $run, 'Flaky', true);

    $skipHead = false;
    foreach ($run->tests as const &$test) {
        if ($test->outcome != Outcome::skip) {
            continue;
        }
        if (!$skipHead) {
            $out->append('\n### Skipped\n\n');
            $skipHead = true;
        }
        $out->append("- `{$test->id}`: {$test->events->skipReason}\n");
    }

    return $out;
}

/**
 * A section headed `$heading` listing the broken tests, or the flaky ones when `$flaky`, each with
 * where it stopped. Nothing when there are none.
 */
private function listing(string& $out, const Run& $run, const string& $heading, bool $flaky) : void
{
    $headed = false;
    foreach ($run->tests as const &$test) {
        if ($flaky != ($test->outcome == Outcome::flaky)) {
            continue;
        }
        if (!$flaky && !$test->outcome->broken()) {
            continue;
        }
        if (!$headed) {
            $out->append("### {$heading}\n\n");
            $headed = true;
        }

        $out->append("- **{$test->outcome}** `{$test->id}`");
        if ($flaky) {
            $words = $test->attemptWords();
            $out->append(" ({$words})");
        }
        $fault = guard $test->fault() else {
            $out->append('\n');
            continue;
        };
        if (!$fault->file->empty()) {
            $out->append(" at `{$fault->file}:{$fault->line}`");
        }
        $out->append('\n');
        if (!$fault->summary->empty() || !$fault->detail->empty()) {
            $out->append('  ```\n');
            $out->append(text::indent($fault->summary, 2));
            $out->append('\n');
            if (!$fault->detail->empty()) {
                $out->append(text::indent($fault->detail, 2));
                $out->append('\n');
            }
            $out->append('  ```\n');
        }
    }

    if ($headed) {
        $out->append('\n');
    }
}

/**
 * The coverage line, when the run measured coverage.
 */
private function coverage(string& $out, Totals? $totals) : void
{
    $t = guard $totals else {
        return;
    };

    $out->append("**Coverage:** {$t}\n\n");
}
