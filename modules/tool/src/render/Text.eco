/**
 * Text helpers the reports share.
 */

namespace ecotest::cli::text;

/**
 * How many bytes of a line a report shows before cutting.
 */
internal const usize WIDTH = 120;

/**
 * `$text` with every line indented by `$by` spaces.
 */
public function indent(const string& $text, usize $by) : string
{
    $pad = str::repeat(' ', $by);
    $out = '';
    $first = true;

    foreach (str::split($text, '\n') as const &$line) {
        if (!$first) {
            $out->append('\n');
        }
        $first = false;
        $out->append($pad);
        $out->append(string($line));
    }

    return $out;
}

/**
 * `$text` cut to `WIDTH` bytes, with `...` where it was cut.
 */
public function cut(const string& $text) : string
{
    if ($text->size() <= WIDTH) {
        return $text;
    }

    $out = $text->sub(0, WIDTH);
    $out->append('...');
    return $out;
}

/**
 * `$n` and the word that fits it.
 */
public function plural(usize $n, const string& $one, const string& $many) : string
{
    if ($n == 1) {
        return "{$n} {$one}";
    }
    return "{$n} {$many}";
}

/**
 * Where the last `$byte` in `$text` is, or its size when there is none.
 */
public function last(const string& $text, uint8 $byte) : usize
{
    usize $at = $text->size();
    for (usize $i = 0; $i < $text->size(); $i++) {
        if ($text->byte($i) == $byte) {
            $at = $i;
        }
    }
    return $at;
}
