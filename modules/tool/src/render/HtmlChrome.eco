/**
 * The self-contained HTML report's script and CSS.
 */

namespace ecotest::cli::html;

/**
 * The theme, set before the page paints: a remembered pick, else the viewer's preference. Then,
 * once the page is there, the theme button, the outcome filters and opening the source a link
 * points at.
 */
internal function script() : string
{
    return '<script>
(function(){
var app=document.getElementById("top");
function theme(t){app.classList.remove("theme-dark","theme-light");app.classList.add("theme-"+t);}
var saved=null;
try{saved=localStorage.getItem("ecotest-theme");}catch(e){}
if(saved==="light"||saved==="dark"){theme(saved);}else if(window.matchMedia&&window.matchMedia("(prefers-color-scheme: light)").matches){theme("light");}
document.addEventListener("DOMContentLoaded",function(){
document.getElementById("themebtn").addEventListener("click",function(){
var t=app.classList.contains("theme-light")?"dark":"light";
theme(t);
try{localStorage.setItem("ecotest-theme",t);}catch(e){}
});
var table=document.getElementById("tests-table");
var heading=document.getElementById("tests-heading");
var buttons=document.querySelectorAll("[data-filter]");
buttons.forEach(function(b){
if(b.tagName!=="BUTTON"){return;}
b.addEventListener("click",function(){
var f=b.getAttribute("data-filter");
table.setAttribute("data-filter",f);
var shown=0;
table.querySelectorAll("tbody tr").forEach(function(r){if(f==="all"||r.getAttribute("data-group")===f){shown++;}});
heading.textContent=b.getAttribute("data-label")+(shown?"":": none");
buttons.forEach(function(o){
if(o.tagName!=="BUTTON"){return;}
var on=o.getAttribute("data-filter")===f;
o.classList.toggle("on",on);
if(o.classList.contains("chip")){o.setAttribute("aria-pressed",on?"true":"false");}
});
});
});
function reveal(){
var id=decodeURIComponent(location.hash.slice(1));
var d=id?document.getElementById(id):null;
if(d&&d.tagName==="DETAILS"){d.open=true;}
}
window.addEventListener("hashchange",reveal);
reveal();
});
})();
</script>';
}

/**
 * The page's styles, dark and light.
 */
internal function style() : string
{
    return '<style>
body{margin:0;background:#06080c}
.app{--brand:#008efc;--sans:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;background:var(--bg);color:var(--text);font-family:var(--sans);line-height:1.5;-webkit-font-smoothing:antialiased;min-height:100vh;display:flex;flex-direction:column}
.app *,.app *::before,.app *::after{box-sizing:border-box}
.theme-dark{--bg:#06080c;--band:#080b11;--code:#0a0e15;--code-line:rgba(255,255,255,.09);--meta:rgba(10,14,21,.8)}
.theme-light{--bg:#ffffff;--band:#f8fafc;--code:#0f172a;--code-line:#0f172a;--meta:rgba(248,250,252,.9)}
.theme-dark,.theme-light .surface{--strong:#ffffff;--text:#e6edf5;--body:#c6d2e0;--muted:#9aa8ba;--dim:#7d8b9d;--faint:#3d4c5e;--line:rgba(255,255,255,.08);--line-strong:rgba(255,255,255,.12);--hover:rgba(255,255,255,.04);--accent:#33a5fd;--accent-strong:#99d2fe;--accent-soft:rgba(0,142,252,.13);--green:oklch(.82 .19 140);--green-soft:oklch(.82 .19 140 / .1);--green-glow:0 0 10px oklch(.82 .19 140 / .6);--amber:#fbbf24;--amber-text:#fde68a;--amber-soft:rgba(251,191,36,.08);--amber-line:rgba(251,191,36,.3);--rose:#ff92a8;--rose-strong:#ffd1dc;--rose-soft:rgba(255,146,168,.06);--rose-line:rgba(255,146,168,.25);--hit-bg:rgba(110,231,140,.055);--miss-bg:rgba(255,146,168,.1);--tk-k:#33a5fd;--tk-t:#c7d2fe;--tk-v:#e6edf5;--tk-s:#fbbf24;--tk-n:#ff92a8;--tk-c:#7d8b9d;--tk-f:#22d3ee;--tk-p:#9aa8ba}
.theme-light{--strong:#0f172a;--text:#1e293b;--body:#334155;--muted:#475569;--dim:#64748b;--faint:#94a3b8;--line:#e2e8f0;--line-strong:#cbd5e1;--hover:rgba(15,23,42,.04);--accent:#0072ca;--accent-strong:#005597;--accent-soft:rgba(0,142,252,.1);--green:oklch(.5 .15 145);--green-soft:oklch(.62 .17 145 / .12);--green-glow:0 0 0 3px oklch(.62 .17 145 / .18);--amber:#b45309;--amber-text:#92400e;--amber-soft:rgba(251,191,36,.12);--amber-line:rgba(217,119,6,.35);--rose:#be123c;--rose-strong:#9f1239;--rose-soft:rgba(190,18,60,.05);--rose-line:rgba(190,18,60,.25)}
.theme-light .surface{--bg:#0a0e15;--band:#080b11;--code:#0f172a;color:var(--text)}
.app a{color:var(--accent);text-decoration:none}.app a:hover{color:var(--accent-strong)}
.app button{font:inherit}
.app :focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:3px}
.mono,.app code,.app pre{font-family:var(--mono)}
.eyebrow{font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--dim)}
.hdr{display:flex;flex-wrap:wrap;align-items:center;gap:20px;padding:14px 32px;border-bottom:1px solid var(--line);background:var(--band)}
.app a.brand{display:flex;align-items:center;gap:12px;color:var(--text)}
.brand-tile{display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:4px;background:var(--code);border:1px solid rgba(0,142,252,.45);box-shadow:inset 0 0 14px rgba(0,142,252,.25)}
.brand-text{display:flex;flex-direction:column;line-height:1.1}
.brand-name{font-weight:600;font-size:18px;letter-spacing:-.01em}
.brand-sub{font-size:11px;color:var(--dim);letter-spacing:.04em}
.verchip{font-size:12px;color:var(--muted);border:1px solid var(--line-strong);border-radius:3px;padding:3px 10px}
.nav{display:flex;flex-wrap:wrap;gap:2px}
.app .nav a{color:var(--muted);padding:8px 12px;border-radius:3px;font-size:14px}
.app .nav a:hover{color:var(--text)}
.app .nav a[aria-current="page"]{color:var(--text);background:var(--accent-soft)}
.grow{flex:1 1 0}
.status{display:inline-flex;align-items:center;gap:8px;font-size:13px;color:var(--body);border:1px solid var(--rose-line);background:var(--rose-soft);border-radius:3px;padding:6px 12px 6px 10px}
.status .lamp{width:8px;height:8px;border-radius:50%;background:var(--rose);box-shadow:0 0 10px rgba(255,146,168,.6)}
.status.good{border-color:var(--line-strong);background:transparent}
.status.good .lamp{background:var(--green);box-shadow:var(--green-glow)}
.themebtn{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:4px;background:transparent;border:1px solid var(--line);color:var(--muted);cursor:pointer;padding:0}
.themebtn:hover{color:var(--text);background:var(--hover)}
.body{display:flex;flex-wrap:wrap;align-items:flex-start;width:100%;max-width:1440px;margin:0 auto;flex:1 0 auto}
.side{flex:1 1 248px;max-width:280px;padding:32px 16px 48px 24px;border-right:1px solid var(--line);align-self:stretch;display:flex;flex-direction:column;gap:28px}
.side-group{display:flex;flex-direction:column;gap:4px}
.side-title{padding:0 12px 8px}
.app .side-link{display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;padding:6px 12px;border-radius:3px;color:var(--muted);font-size:14px;background:transparent;border:0;text-align:left;cursor:pointer}
.app .side-link:hover{color:var(--text);background:var(--hover)}
.app .side-link.on,.app .side-link[aria-current="page"]{color:var(--text);background:var(--accent-soft)}
.side-link .count{font-family:var(--mono);font-size:12px;color:var(--dim)}
.side-link .count.bad{color:var(--rose)}
.side-link .count.warn{color:var(--amber-text)}
.side-link .fname{font-family:var(--mono);font-size:13px;display:flex;align-items:center;gap:8px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.side-link .dot{width:6px;height:6px;border-radius:50%;background:var(--brand);box-shadow:0 0 0 4px rgba(0,142,252,.18);flex:0 0 auto}
.side-link .dot.low{background:var(--rose);box-shadow:0 0 0 4px rgba(255,146,168,.16)}
.main{flex:999 1 560px;min-width:0;padding:0 56px 96px}
.hero{position:relative;overflow:hidden;padding:48px 0 40px;border-bottom:1px solid var(--line)}
.wave{position:absolute;right:-150px;top:-170px;opacity:.16;pointer-events:none}
.crumbs{position:relative;display:flex;flex-wrap:wrap;gap:8px;font-size:13px;color:var(--dim)}
.crumbs .here{color:var(--text)}
.titlerow{position:relative;display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 22px;margin-top:22px}
.h1{margin:0;font-size:76px;line-height:1;font-weight:600;letter-spacing:-.035em;color:var(--strong)}
.h1 .gen{font-family:var(--mono);font-size:56px;font-weight:400;letter-spacing:-.02em;color:var(--rose)}
.h1 .gen.good{color:var(--green)}
.badges{display:flex;gap:8px;flex-wrap:wrap}
.badge{font-family:var(--mono);font-size:12px;font-weight:500;border-radius:3px;padding:3px 9px;border:1px solid transparent}
.badge.bad{color:var(--rose);background:var(--rose-soft);border-color:var(--rose-line)}
.badge.warn{color:var(--amber-text);background:var(--amber-soft);border-color:var(--amber-line)}
.badge.good{color:var(--green);background:var(--green-soft)}
.lede{position:relative;max-width:680px;margin:22px 0 0;font-size:19px;line-height:1.6;color:var(--body)}
.meta{position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));margin-top:36px;border:1px solid var(--line-strong);border-radius:4px;background:var(--meta);overflow:hidden}
.meta > div{padding:16px 20px;border-right:1px solid var(--line)}
.meta > div:last-child{border-right:0}
.meta-value{font-family:var(--mono);margin-top:6px;font-size:24px;font-weight:500;color:var(--text)}
.meta-value small{font-size:14px;color:var(--muted);margin-left:2px}
.meta-value.bad{color:var(--rose)}
.meta-value.warn{color:var(--amber-text)}
.meta-value.good{color:var(--green)}
.cov{position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:16px}
.cov-card{border:1px solid var(--line);border-radius:4px;background:var(--band);padding:18px 20px}
.cov-top{display:flex;align-items:baseline;justify-content:space-between;gap:12px}
.cov-pct{font-family:var(--mono);font-size:24px;font-weight:500;color:var(--text);margin-top:6px}
.cov-pct.low{color:var(--rose)}
.cov-frac{font-family:var(--mono);font-size:13px;color:var(--dim)}
.bar{position:relative;height:4px;border-radius:2px;background:var(--line-strong);margin-top:14px}
.bar i{position:absolute;left:0;top:0;bottom:0;border-radius:2px;background:var(--brand)}
.bar.low i{background:var(--rose)}
.bar .gate{position:absolute;top:-4px;bottom:-4px;width:2px;margin-left:-1px;border-radius:1px;background:var(--muted)}
.cov-note{margin-top:10px;font-size:12px;color:var(--dim)}
.callout{position:relative;display:flex;gap:14px;align-items:flex-start;margin:24px 0 0;border-radius:4px;padding:14px 18px;border:1px solid var(--rose-line);background:var(--rose-soft);font-size:15px;color:var(--body)}
.callout svg{flex:0 0 auto;margin-top:2px;color:var(--rose)}
.callout-title{font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--rose);margin:0 0 4px}
.sec{padding-top:8px}
.divider{display:flex;align-items:center;gap:16px;margin-top:64px}
.divider-num{font-family:var(--mono);font-size:12px;color:var(--accent)}
.divider h2{margin:0;font-size:13px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
.divider-line{flex:1 1 0;height:1px;background:var(--line)}
.sec-head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;margin-top:24px}
.sec-head h3{margin:0;font-size:26px;font-weight:500;letter-spacing:-.01em;color:var(--strong)}
.sec-note{font-size:13px;color:var(--dim)}
.sec-note span{color:var(--accent)}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.app .chip{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 14px;border:1px solid var(--line-strong);border-radius:3px;background:transparent;color:var(--muted);font-size:13px;cursor:pointer}
.app .chip:hover{color:var(--text);background:var(--hover)}
.app .chip.on{color:var(--text);background:var(--accent-soft);border-color:rgba(0,142,252,.4)}
.chip b{font-family:var(--mono);font-weight:500;font-size:12px;color:var(--dim)}
.chip.on b{color:var(--accent)}
.table-wrap{overflow-x:auto;margin:20px 0 0;border:1px solid var(--line);border-radius:4px}
.tbl{border-collapse:collapse;width:100%;min-width:620px;font-size:14px}
.tbl th,.tbl td{padding:12px 16px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
.tbl th{color:var(--muted);font-weight:500;font-size:12px;letter-spacing:.06em;text-transform:uppercase;background:var(--band)}
.tbl tr:last-child td{border-bottom:0}
.tbl .num{text-align:right;font-family:var(--mono);font-variant-numeric:tabular-nums;font-size:13px;color:var(--muted);white-space:nowrap}
.tbl th.num{font-family:inherit;font-size:12px}
.tbl tr.bad td:first-child{box-shadow:inset 2px 0 0 var(--rose)}
.tbl tr.bad td{background:var(--rose-soft)}
.tbl tbody tr:hover td{background:var(--hover)}
.tbl[data-filter=failed] tbody tr:not([data-group=failed]),.tbl[data-filter=flaky] tbody tr:not([data-group=flaky]),.tbl[data-filter=skip] tbody tr:not([data-group=skip]),.tbl[data-filter=pass] tbody tr:not([data-group=pass]){display:none}
.oc{display:inline-flex;align-items:center;gap:7px;font-family:var(--mono);font-size:11px;font-weight:600;border-radius:3px;padding:3px 8px;white-space:nowrap}
.oc i{width:6px;height:6px;border-radius:50%;background:currentColor}
.oc.pass{color:var(--green);background:var(--green-soft)}
.oc.fail,.oc.timeout,.oc.signal{color:var(--rose);background:var(--rose-soft);box-shadow:inset 0 0 0 1px var(--rose-line)}
.oc.flaky{color:var(--amber-text);background:var(--amber-soft);box-shadow:inset 0 0 0 1px var(--amber-line)}
.oc.skip{color:var(--muted);background:transparent;box-shadow:inset 0 0 0 1px var(--line-strong)}
.tid{font-family:var(--mono);font-size:13.5px;color:var(--text);overflow-wrap:anywhere}
.tid span{color:var(--dim)}
.why{display:flex;align-items:center;gap:8px;margin-top:6px;color:var(--muted);font-size:13px}
.why svg{flex:0 0 auto;color:var(--dim)}
.failure{margin-top:12px;border:1px solid var(--rose-line);border-radius:4px;background:var(--code);overflow:hidden;font-family:var(--mono);font-size:13px;line-height:1.7}
.failure-head{display:flex;align-items:center;gap:8px;padding:8px 14px;border-bottom:1px solid var(--line);background:var(--band);color:var(--muted);font-size:12px}
.failure-head .dot{width:8px;height:8px;border-radius:50%;background:var(--rose);flex:0 0 auto}
.failure-msg{padding:12px 16px 0;color:var(--rose-strong);white-space:pre-wrap}
.failure-detail{padding:4px 16px 14px;color:var(--muted);white-space:pre-wrap}
.ratio{display:flex;align-items:baseline;justify-content:flex-end;gap:8px}
.ratio b{font-weight:500;color:var(--text)}
.ratio b.low{color:var(--rose)}
.ratio span{color:var(--dim);font-size:12px}
.mini{position:relative;height:3px;border-radius:2px;background:var(--line-strong);margin:8px 0 0 auto;width:120px}
.mini i{position:absolute;left:0;top:0;bottom:0;border-radius:2px;background:var(--brand)}
.mini.low i{background:var(--rose)}
.fileref{font-family:var(--mono);font-size:13.5px;display:inline-flex;align-items:center;gap:10px}
.fileref .dot{width:6px;height:6px;border-radius:50%;background:var(--brand)}
.fileref .dot.low{background:var(--rose)}
.legend{display:flex;flex-wrap:wrap;gap:18px;font-size:13px;color:var(--muted)}
.legend span{display:inline-flex;align-items:center;gap:8px}
.sw{width:14px;height:14px;border-radius:2px;border:1px solid var(--line-strong)}
.sw.hit{background:rgba(110,231,140,.18)}
.sw.miss{background:rgba(255,146,168,.28);box-shadow:inset 2px 0 0 #ff92a8}
.code{position:relative;margin:16px 0 0;border:1px solid var(--code-line);border-radius:4px;background:var(--code);overflow:hidden;color:var(--text)}
.theme-light .code{border-color:var(--code)}
.code summary{list-style:none;cursor:pointer}
.code summary::-webkit-details-marker{display:none}
.code-head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px;background:var(--band)}
.code[open] .code-head{border-bottom:1px solid var(--line)}
.code-head:hover{background:var(--hover)}
.code-file{display:flex;gap:10px;align-items:center;font-family:var(--mono);font-size:13px;color:var(--text);min-width:0;overflow-wrap:anywhere}
.code-file .chev{color:var(--dim);transition:transform .25s;flex:0 0 auto}
.code[open] .code-file .chev{transform:rotate(90deg)}
.code-file .dot{width:8px;height:8px;border-radius:50%;background:var(--brand);flex:0 0 auto}
.code-file .dot.low{background:var(--rose)}
.code-stats{display:flex;gap:14px;font-family:var(--mono);font-size:12px;color:var(--muted)}
.code-stats b{font-weight:500;color:var(--text)}
.code-stats b.low{color:var(--rose)}
.rows{overflow-x:auto;padding:12px 0;font-family:var(--mono);font-size:13.5px;line-height:1.75}
.rows-inner{display:inline-block;min-width:100%}
.row{display:grid;grid-template-columns:52px 64px minmax(0,1fr);min-height:1.75em}
.row .ln{color:var(--dim);text-align:right;padding-right:14px;user-select:none}
.row .hits{text-align:right;padding-right:18px;color:var(--faint);font-size:12px;user-select:none}
.row code{white-space:pre;padding-right:24px;color:var(--tk-v)}
.row.hit{background:var(--hit-bg)}
.row.hit .hits{color:var(--green)}
.row.miss{background:var(--miss-bg);box-shadow:inset 2px 0 0 var(--rose)}
.row.miss .hits{color:var(--rose);font-weight:600}
.row.miss .ln{color:var(--rose)}
.code .k{color:var(--tk-k)}.code .t{color:var(--tk-t)}.code .v{color:var(--tk-v)}.code .s{color:var(--tk-s)}.code .n{color:var(--tk-n)}.code .c{color:var(--tk-c);font-style:italic}.code .f{color:var(--tk-f)}.code .p{color:var(--tk-p)}
.ftr{border-top:1px solid var(--line);background:var(--band);margin-top:auto}
.ftr-inner{max-width:1440px;margin:0 auto;padding:28px 32px;display:flex;flex-wrap:wrap;align-items:center;gap:16px 28px}
.ftr-title{font-weight:600;color:var(--text)}
.ftr-message{font-size:13px;color:var(--dim)}
.app a.ftr-echo{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);border:1px solid var(--line-strong);border-radius:3px;padding:5px 12px 5px 8px}
.app a.ftr-echo:hover{color:var(--text)}
@media (max-width:760px){
.hdr{padding:12px 16px;gap:12px}
.side{max-width:none;flex-basis:100%;border-right:0;border-bottom:1px solid var(--line);padding:20px 16px;flex-direction:row;flex-wrap:wrap;gap:20px}
.side-group{flex:1 1 220px}
.main{padding:0 16px 64px}
.h1{font-size:48px}.h1 .gen{font-size:36px}
.lede{font-size:17px}
.wave{right:-260px;top:-200px}
.ftr-inner{padding:24px 16px}
}
</style>';
}
