/**
 * The summary printed after echoc's own listing: outcomes, time, checks, the slowest tests,
 * skips with their reasons, failures at their lines, coverage per file and the gates.
 */

namespace ecotest::cli::terminal;

use ecotest::cli::text;

/**
 * How many slow tests and uncovered files are listed.
 */
internal const usize TOP = 5;

/**
 * The summary of `$run`. `$diff` is the diff coverage sentence and `$report` the HTML report's
 * path; either may be empty.
 */
public function render(const Run& $run, const array<FileCoverage>& $files, Totals? $totals, const Verdict& $verdict, const string& $diff, const string& $report) : string
{
    $out = '\n';

    $c = $run->counts();
    $secs = $run->seconds();

    usize $failed = $c->failed();
    $out->append("ecotest   {$c->total} tests: {$c->pass} passed, {$failed} failed, {$c->skip} skipped, {$c->flaky} flaky in {$secs:.2f} s");
    if ($run->passes > 1) {
        $out->append(" over {$run->passes} passes");
    }
    $out->append('\n');

    usize $stopped = $run->stopped();
    if ($stopped > 0) {
        $out->append("stopped   echoc did not reach the tests in {$stopped} of {$run->passes} passes\n");
    }

    timing($out, $run);
    checks($out, $run);
    listed($out, $run, .skip, 'skipped');
    listed($out, $run, .flaky, 'flaky');
    failures($out, $run);
    extras($out, $run);
    coverage($out, $files, $totals);

    foreach ($verdict->failed as const &$gate) {
        $out->append("gate      FAIL {$gate}\n");
    }

    if (!$diff->empty()) {
        $out->append("diff      {$diff}\n");
    }
    if (!$report->empty()) {
        $out->append("report    {$report}\n");
    }

    return $out;
}

/**
 * Median and 95th percentile duration, and the slowest tests.
 */
private function timing(string& $out, const Run& $run) : void
{
    if ($run->tests->empty()) {
        return;
    }

    int64 $median = $run->percentile(50);
    int64 $slow = $run->percentile(95);

    $out->append("time      p50 {$median} ms, p95 {$slow} ms\n");

    foreach ($run->slowest(TOP) as const &$test) {
        int64 $took = $test->ms();
        $out->append("          {$took:>6} ms  {$test->id}\n");
    }
}

/**
 * Checks per test, and the tests that checked nothing ecotest could see.
 */
private function checks(string& $out, const Run& $run) : void
{
    usize $counted = $run->asserting();
    if ($counted == 0) {
        return;
    }

    int64 $total = $run->assertions();
    $per = ($total as float64) / ($counted as float64);
    $out->append("checks    {$total} in {$counted} tests using ecotest ({$per:.1f} per test)\n");
    foreach ($run->tests as const &$test) {
        if ($test->silent()) {
            $out->append("          checks nothing: {$test->id}\n");
        }
    }
}

/**
 * The tests with `$outcome`, under `$label`, with why: the skip reason or how the passes went.
 */
private function listed(string& $out, const Run& $run, Outcome $outcome, const string& $label) : void
{
    foreach ($run->tests as const &$test) {
        if ($test->outcome != $outcome) {
            continue;
        }

        $why = $test->why();
        if (!$why->empty()) {
            $why = ": {$why}";
        }

        $out->append("{$label:<9} {$test->id}{$why}\n");
    }
}

/**
 * Each failure with its line, summary, detail and context.
 */
private function failures(string& $out, const Run& $run) : void
{
    foreach ($run->tests as const &$test) {
        if (!$test->outcome->broken()) {
            continue;
        }

        $out->append("{$test->outcome:<9} {$test->id}\n");

        $fault = guard $test->events->fault else {
            continue;
        };
        if (!$fault->file->empty()) {
            $out->append("          at {$fault->file}:{$fault->line}\n");
        }
        if (!$fault->summary->empty()) {
            $out->append(text::indent($fault->summary, 12));
            $out->append('\n');
        }
        if (!$fault->detail->empty()) {
            $out->append(text::indent($fault->detail, 12));
            $out->append('\n');
        }
        foreach ($fault->context as const &$scope) {
            $out->append("            in {$scope}\n");
        }
    }
}

/**
 * Notes, metrics and benches the tests recorded.
 */
private function extras(string& $out, const Run& $run) : void
{
    foreach ($run->tests as const &$test) {
        foreach ($test->events->notes as const &$note) {
            $out->append("note      {$test->id}: {$note}\n");
        }
        foreach ($test->events->metrics as const &$metric) {
            $out->append("metric    {$test->id}: {$metric->name} = {$metric->value}\n");
        }
        foreach ($test->events->benches as const &$b) {
            $out->append("bench     {$b->label}: {$b->p50} ns/op, p95 {$b->p95} ns ({$test->id})\n");
        }
    }
}

/**
 * Totals, then the least covered files with their missed lines. Nothing without coverage.
 */
private function coverage(string& $out, const array<FileCoverage>& $files, Totals? $totals) : void
{
    $t = guard $totals else {
        return;
    };

    $out->append("coverage  {$t}\n");

    foreach (FileCoverage::worst($files, TOP) as $i) {
        const FileCoverage& $file = $files[$i];
        $r = $file->lineTotals();
        $missed = text::cut($file->missedRanges());
        $out->append("          {$r:>6}  {$file->file}  missing {$missed}\n");
    }
}
