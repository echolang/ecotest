/**
 * The run as JUnit XML, the format CI servers read: one suite per file, one case per test. It
 * fails exactly when the run does. A flaky test passed in the end, so it is a passing case with a
 * `flakyFailure` for every pass that broke, as surefire writes it; failed gates and incomplete
 * passes are failing cases of their own suite, `ecotest`.
 */

namespace ecotest::cli::junit;

use ecotest::cli::{Fault, escape, text};

/**
 * The JUnit XML of `$run`, judged by `$verdict`.
 */
public function render(const Run& $run, const Verdict& $verdict) : string
{
    $c = $run->counts();
    usize $gates = $verdict->failed->count();
    usize $stops = $verdict->stopped->count();
    usize $tests = $c->total + $gates + $stops;
    usize $failures = $c->fail + $gates;
    usize $errors = $c->timeout + $c->signal + $stops;
    $secs = $run->seconds();

    $out = '<?xml version="1.0" encoding="UTF-8"?>\n';
    $out->append("<testsuites name=\"ecotest\" tests=\"{$tests}\" failures=\"{$failures}\" errors=\"{$errors}\" skipped=\"{$c->skip}\" time=\"{$secs:.3f}\">\n");

    $suite = '';
    foreach ($run->tests as const &$test) {
        $file = "{$test->module}/{$test->file}";
        if ($file != $suite) {
            if (!$suite->empty()) {
                $out->append('  </testsuite>\n');
            }
            $suite = $file;
            $name = escape::markup($test->file);
            $out->append("  <testsuite name=\"{$name}\">\n");
        }

        $name = escape::markup($test->name);
        $class = escape::markup($test->module);
        $took = ($test->ms() as float64) / 1000.0;
        $out->append("    <testcase name=\"{$name}\" classname=\"{$class}\" time=\"{$took:.3f}\"");

        if ($test->outcome == Outcome::pass) {
            $out->append('/>\n');
            continue;
        }

        $out->append('>\n');

        if ($test->outcome == Outcome::flaky) {
            foreach ($test->attempts as const &$attempt) {
                if (!$attempt->outcome->broken()) {
                    continue;
                }
                Fault $fault = Fault();
                if (!$attempt->failures->empty()) {
                    $fault = $attempt->failures[0];
                }
                $message = escape::markup($fault->summary);
                $body = escape::markup(junitBody($attempt->failures, ''));
                $out->append("      <flakyFailure type=\"{$attempt->outcome}\" message=\"{$message}\">{$body}</flakyFailure>\n");
            }
        } else if ($test->outcome == Outcome::skip) {
            $reason = escape::markup($test->events->skipReason);
            $out->append("      <skipped message=\"{$reason}\"/>\n");
        } else {
            // a test that failed without saying how still gets a message and a body, both bare
            Fault $fault = Fault();
            array<Fault> $all = $test->failures();
            if (!$all->empty()) {
                $fault = $all[0];
            }
            $message = escape::markup($fault->summary);
            $body = escape::markup(junitBody($all, $test->output));
            if ($test->outcome == Outcome::timeout || $test->outcome == Outcome::signal) {
                $out->append("      <error type=\"{$test->outcome}\" message=\"{$message}\">{$body}</error>\n");
            } else {
                $out->append("      <failure type=\"{$test->outcome}\" message=\"{$message}\">{$body}</failure>\n");
            }
        }

        $out->append('    </testcase>\n');
    }

    if (!$suite->empty()) {
        $out->append('  </testsuite>\n');
    }

    if ($gates + $stops > 0) {
        $out->append('  <testsuite name="ecotest">\n');
        foreach ($verdict->stopped as const &$reason) {
            $text = escape::markup($reason);
            $out->append("    <testcase name=\"run incomplete\" classname=\"ecotest\"><error type=\"stopped\" message=\"{$text}\">{$text}</error></testcase>\n");
        }
        foreach ($verdict->failed as const &$gate) {
            $text = escape::markup($gate);
            $out->append("    <testcase name=\"gate\" classname=\"ecotest\"><failure type=\"gate\" message=\"{$text}\">{$text}</failure></testcase>\n");
        }
        $out->append('  </testsuite>\n');
    }

    $out->append('</testsuites>\n');
    return $out;
}

/**
 * The body of a JUnit failure or error: each check's location, summary, values and detail, then
 * `$output` when the test printed something.
 */
private function junitBody(const array<Fault>& $failures, const string& $output) : string
{
    string $out = '';
    foreach ($failures as const &$fault) {
        if (!$out->empty()) {
            $out->append("\n");
        }
        $out->append("{$fault->file}:{$fault->line}\n");
        $out->append($fault->summary);
        $values = text::values($fault);
        if (!$values->empty()) {
            $out->append("\n");
            $out->append($values);
        }
        if (!$fault->detail->empty()) {
            $out->append("\n");
            $out->append($fault->detail);
        }
    }
    if (!$output->empty()) {
        if (!$out->empty()) {
            $out->append("\n");
        }
        $out->append($output);
    }
    return $out;
}
