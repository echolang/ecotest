/**
 * Small file chores the tool repeats.
 */

namespace ecotest::cli::files;

/**
 * Says `$line` on stderr after `ecotest: `. Diagnostics never go to stdout, which carries only the
 * report, so `ecotest report --format json > out.json` stays JSON.
 */
public function warn(const string& $line) : void
{
    std::io::eprintln("ecotest: {$line}");
}

/**
 * Writes `$text` to `$path`, replacing what was there.
 */
public function write(const string& $path, const string& $text) : status<std::io::ioerror>
{
    guard std::io::writefile($path, $text) else ($e) {
        return .error($e);
    };
    return .ok;
}

/**
 * Appends one line to `$path`, creating it when it is missing.
 */
public function appendLine(const string& $path, const string& $line) : status<std::io::ioerror>
{
    $f = guard std::io::append($path) else ($e) {
        return .error($e);
    };

    guard $f->write("{$line}\n") else ($e) {
        $f->close();
        return .error($e);
    };
    $f->close();
    return .ok;
}

/**
 * Writes `$text` to `$path` whole or not at all: into `<path>.tmp` first, then renamed over it, so a
 * reader never sees half a file.
 */
public function seal(const string& $path, const string& $text) : status<std::io::ioerror>
{
    $tmp = "{$path}.tmp";
    guard std::io::writefile($tmp, $text) else ($e) {
        return .error($e);
    };
    guard std::io::rename($tmp, $path) else ($e) {
        return .error($e);
    };
    return .ok;
}
