/**
 * Small file chores the tool repeats.
 */

namespace ecotest::cli::files;

/**
 * Creates `$path` and every missing directory above it. A directory that is already there is
 * fine; the first one that cannot be made is the failure.
 */
public function mkdirs(const string& $path) : status<std::io::ioerror>
{
    $built = '';
    $first = true;

    foreach (str::split($path, '/') as const &$part) {
        if (!$first) {
            $built->append('/');
        }
        $first = false;
        $built->append(string($part));

        if ($built->empty() || $built == '/') {
            continue;
        }

        guard std::io::mkdir($built) else ($e) {
            if (!std::io::exists($built)->or(false)) {
                return .error($e);
            }
            continue;
        };
    }

    return .ok;
}

/**
 * `$path` as seen from `$base`: itself when absolute, `$base` when empty, joined onto `$base`
 * otherwise.
 */
public function resolve(const string& $base, const string& $path) : string
{
    if ($path->empty()) {
        return $base;
    }

    if ($path->starts('/')) {
        return $path;
    }

    return std::env::join($base, $path);
}

/**
 * Writes `$text` to `$path`, replacing what was there.
 */
public function write(const string& $path, const string& $text) : status<std::io::ioerror>
{
    guard std::io::writefile($path, $text) else ($e) {
        return .error($e);
    };
    return .ok;
}

/**
 * Appends one line to `$path`, creating it when it is missing.
 */
public function appendLine(const string& $path, const string& $line) : status<std::io::ioerror>
{
    $f = guard std::io::append($path) else ($e) {
        return .error($e);
    };

    guard $f->write("{$line}\n") else ($e) {
        $f->close();
        return .error($e);
    };
    $f->close();
    return .ok;
}

/**
 * The newest run directory under `$root`, by its name, or null when there is no run yet.
 */
public function latest(const string& $root) : string?
{
    $best = '';

    $listing = guard std::io::opendir($root) else {
        return null;
    };

    foreach ($listing as const &$entry) {
        $name = $entry->name();
        if ($entry->is_directory() && $name->starts('run-') && $name > $best) {
            $best = $name;
        }
    }

    $listing->close();

    if ($best->empty()) {
        return null;
    }

    return std::env::join($root, $best);
}
