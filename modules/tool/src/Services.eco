namespace ecotest::cli;

/**
 * The services a run needs, started before echoc and stopped after it. Each one's output goes to
 * `<run>/services/<name>.log`, and its URL reaches the tests as `ECOTEST_<NAME>_URL`.
 */
public class Services
{
    public array<ServiceSpec> $specs = [];
    public array<std::process::child> $running = [];
    public array<string> $envNames = [];
    public array<string> $envValues = [];

    /**
     * Reads the `services` list of `ecotest.json`.
     */
    public function configure(const array<json::Value>& $list) : void
    {
        foreach ($list as const &$entry) {
            array<string> $command = [];
            foreach (Doc::list($entry, 'run') as const &$word) {
                $command[] = $word->asStr() ?? '';
            }

            json::Value $ready = Doc::object($entry, 'ready');
            string $readyUrl = '';
            int64 $readyMs = 0;
            int64 $timeoutMs = 10000;
            if ($ready->isObject()) {
                $readyUrl = Doc::text($ready, 'http');
                $readyMs = Doc::number($ready, 'ms');
                int64 $within = Doc::number($ready, 'timeout_ms');
                if ($within > 0) {
                    $timeoutMs = $within;
                }
            }

            string $url = Doc::text($entry, 'url');
            if ($url->empty()) {
                $url = Services::origin($readyUrl);
            }

            array<string> $names = [];
            array<string> $values = [];
            ordered_map<string, json::Value> $fields = Doc::object($entry, 'env')->asObject() ?? ordered_map<string, json::Value>();
            foreach ($fields as $key => const &$value) {
                $names[] = $key;
                $values[] = $value->asStr() ?? '';
            }

            $this->specs[] = ServiceSpec(Doc::text($entry, 'name'), $command, $readyUrl, $readyMs, $timeoutMs, $url, $names, $values);
        }
    }

    /**
     * Starts every service in `$project` and waits until each is ready. False, with the reason
     * printed, when one cannot start or never becomes ready.
     */
    public function start(const string& $runDir, const string& $project) : bool
    {
        if ($this->specs->empty()) {
            return true;
        }

        string $logs = std::env::join($runDir, 'services');
        Files::mkdirs($logs);

        foreach ($this->specs as const &$spec) {
            if ($spec->command->empty()) {
                std::io::println("ecotest: service {$spec->name} has no `run` command");
                return false;
            }

            array<string> $args = [];
            for (usize $i = 1; $i < $spec->command->count(); $i++) {
                $args[] = $spec->command[$i];
            }

            string $logPath = std::env::join($logs, "{$spec->name}.log");
            std::io::file $log = guard std::io::create($logPath) else ($e) {
                std::io::println("ecotest: cannot write {$logPath}: {$e}");
                return false;
            };

            std::process::command $cmd = std::process::command($spec->command[0], $args);
            $cmd->dir($project);
            for (usize $i = 0; $i < $spec->envNames->count(); $i++) {
                $cmd->env($spec->envNames[$i], $spec->envValues[$i]);
            }
            $cmd->stdout(.file($log));
            $cmd->stderr(.merge);

            std::process::child $child = guard $cmd->spawn() else ($e) {
                std::io::println("ecotest: cannot start service {$spec->name}: {$e}");
                return false;
            };
            $this->running[] = $child;

            if (!Services::ready($spec)) {
                std::io::println("ecotest: service {$spec->name} was not ready within {$spec->timeoutMs} ms; see {$logPath}");
                return false;
            }

            if (!$spec->url->empty()) {
                $this->envNames[] = $spec->variable();
                $this->envValues[] = $spec->url;
            }

            std::io::println("ecotest: service {$spec->name} ready at {$spec->url}");
        }

        return true;
    }

    /**
     * Stops every service this run started.
     */
    public function stop() : void
    {
        foreach ($this->running as &$child) {
            status<std::io::ioerror> $killed = $child->kill();
            result<std::process::exit_status, std::io::ioerror> $waited = $child->wait();
        }

        $this->running->clear();
    }

    /**
     * The last `$lines` lines of every service log in run `$dir`, for a run that failed: what the
     * service said while the tests talked to it.
     */
    public const function tails(const string& $dir, usize $lines) : string
    {
        string $out = '';

        foreach ($this->specs as const &$spec) {
            string $path = std::env::join(std::env::join($dir, 'services'), "{$spec->name}.log");
            array<string> $all = str::lines(Doc::read($path))->owned();
            if ($all->empty()) {
                continue;
            }

            usize $from = 0;
            if ($all->count() > $lines) {
                $from = $all->count() - $lines;
            }

            $out->append("service   {$spec->name}, last lines of {$path}\n");
            for (usize $i = $from; $i < $all->count(); $i++) {
                string $line = $all[$i];
                $out->append("          {$line}\n");
            }
        }

        return $out;
    }

    /**
     * Waits for `$spec` to answer: a 2xx or 3xx from its ready URL, or just its fixed delay.
     */
    private static function ready(const ServiceSpec& $spec) : bool
    {
        if ($spec->readyUrl->empty()) {
            if ($spec->readyMs > 0) {
                std::time::sleep(std::time::duration::millis($spec->readyMs));
            }
            return true;
        }

        std::time::instant $started = std::time::instant::now();

        while ($started->elapsed()->as_millis() < $spec->timeoutMs) {
            curl::Request $probe = curl::Request::get($spec->readyUrl);
            $probe->timeout(500);
            result<curl::Response, curl::Error> $answer = curl::send($probe);

            if (!$answer->failed()) {
                curl::Response $res = $answer->unwrap();
                if ($res->status >= 200 && $res->status < 400) {
                    return true;
                }
            }

            std::time::sleep(std::time::duration::millis(50));
        }

        return false;
    }

    /**
     * `scheme://host:port` of `$url`, or empty.
     */
    private static function origin(const string& $url) : string
    {
        usize $scheme = $url->find('://');
        if ($scheme >= $url->size()) {
            return '';
        }

        usize $path = $url->find('/', $scheme + 3);
        if ($path >= $url->size()) {
            return $url;
        }

        return $url->sub(0, $path);
    }
}
