namespace ecotest::cli;

use ecotest::cli::{doc, files};

/**
 * The services a run needs, started before echoc and stopped after it. Each one's output goes to
 * `<run>/services/<name>.log`, and its URL reaches the tests as `ECOTEST_<NAME>_URL`.
 */
public class Services
{
    public array<ServiceSpec> $specs = [];
    public array<std::process::child> $running = [];

    /**
     * What the tests are handed: each started service's URL by its variable, in start order.
     */
    public ordered_map<string, string> $env = [];

    /**
     * Reads the `services` list of `ecotest.json`.
     */
    public function configure(const array<json::Value>& $list) : void
    {
        foreach ($list as const &$entry) {
            array<string> $command = [];
            foreach (doc::list($entry, 'run') as const &$word) {
                $command[] = $word->asStr() ?? '';
            }

            // an object that is not there reads every field as empty, so no check is a delay of 0
            $ready = doc::object($entry, 'ready');
            $probe = doc::text($ready, 'http');
            Readiness $readiness = .delay(doc::number($ready, 'ms'));
            if (!$probe->empty()) {
                int64 $timeoutMs = doc::number($ready, 'timeout_ms');
                if ($timeoutMs <= 0) {
                    $timeoutMs = 10000;
                }
                $readiness = .http($probe, $timeoutMs);
            }

            $url = doc::text($entry, 'url');
            if ($url->empty()) {
                // no URL is the empty one: the service is not handed to the tests
                $url = Services::origin($probe) ?? '';
            }

            ordered_map<string, string> $env = [];
            $fields = doc::object($entry, 'env')->asObject() ?? ordered_map<string, json::Value>();
            foreach ($fields as $key => const &$value) {
                $env->set($key, $value->asStr() ?? '');
            }

            $this->specs[] = ServiceSpec(doc::text($entry, 'name'), mv $command, mv $readiness, mv $url, mv $env);
        }
    }

    /**
     * Starts every service in `$project` and waits until each is ready, or answers why one cannot
     * start or never became ready. The services started before it keep running until `stop`.
     */
    public function start(const string& $runDir, const string& $project) : status<ServiceError>
    {
        if ($this->specs->empty()) {
            return .ok;
        }

        $logs = std::env::join($runDir, 'services');
        guard files::mkdirs($logs) else ($e) {
            return .error(.cannotWrite($logs, $e));
        };

        foreach ($this->specs as const &$spec) {
            if ($spec->command->empty()) {
                return .error(.noCommand($spec->name));
            }

            $args = arr::room<string>($spec->command->count() - 1);
            for (usize $i = 1; $i < $spec->command->count(); $i++) {
                $args[] = $spec->command[$i];
            }

            $logPath = std::env::join($logs, "{$spec->name}.log");
            $log = guard std::io::create($logPath) else ($e) {
                return .error(.cannotWrite($logPath, $e));
            };

            $cmd = std::process::command($spec->command[0], $args);
            $cmd->dir($project);
            foreach ($spec->env as $name => const &$value) {
                $cmd->env($name, $value);
            }
            $cmd->stdout(.file($log));
            $cmd->stderr(.merge);

            $child = guard $cmd->spawn() else ($e) {
                return .error(.cannotStart($spec->name, $e));
            };
            $this->running[] = mv $child;

            // ready after its fixed delay, or once its URL answers in time
            match ($spec->ready) {
                .delay($ms) => {
                    if ($ms > 0) {
                        std::time::sleep(std::time::duration::millis($ms));
                    }
                },
                .http($url, $timeoutMs) => {
                    if (!Services::poll($url, $timeoutMs)) {
                        return .error(.notReady($spec->name, $timeoutMs, $logPath));
                    }
                },
            };

            if (!$spec->url->empty()) {
                $this->env->set($spec->variable(), $spec->url);
            }

            std::io::println("ecotest: service {$spec->name} ready at {$spec->url}");
        }

        return .ok;
    }

    /**
     * Stops every service this run started.
     */
    public function stop() : void
    {
        // best effort: killing a service that already ended fails, and the wait only reaps it;
        // neither failure leaves anything to do
        foreach ($this->running as &$child) {
            $killed = $child->kill();
            $waited = $child->wait();
        }

        $this->running->clear();
    }

    /**
     * The last `$lines` lines of every service log in run `$dir`, for a run that failed: what the
     * service said while the tests talked to it.
     */
    public const function tails(const string& $dir, usize $lines) : string
    {
        $out = '';

        foreach ($this->specs as const &$spec) {
            $path = std::env::join(std::env::join($dir, 'services'), "{$spec->name}.log");
            $text = guard doc::read($path) else {
                continue;
            };
            $all = str::lines($text)->owned();
            if ($all->empty()) {
                continue;
            }

            usize $from = 0;
            if ($all->count() > $lines) {
                $from = $all->count() - $lines;
            }

            $out->append("service   {$spec->name}, last lines of {$path}\n");
            for (usize $i = $from; $i < $all->count(); $i++) {
                const string& $line = $all[$i];
                $out->append("          {$line}\n");
            }
        }

        return $out;
    }

    /**
     * True once `$url` answers with a 2xx or 3xx, asked every 50 ms for up to `$timeoutMs`.
     */
    private static function poll(const string& $url, int64 $timeoutMs) : bool
    {
        $started = std::time::instant::now();

        while ($started->elapsed()->as_millis() < $timeoutMs) {
            if (Services::answers($url)) {
                return true;
            }
            std::time::sleep(std::time::duration::millis(50));
        }

        return false;
    }

    /**
     * True when `$url` answers within half a second with a 2xx or 3xx.
     */
    private static function answers(const string& $url) : bool
    {
        $probe = curl::Request::get($url);
        $probe->timeout(500);
        $res = guard curl::send($probe) else {
            return false;
        };
        return $res->status >= 200 && $res->status < 400;
    }

    /**
     * `scheme://host:port` of `$url`, or null when it has no scheme.
     */
    private static function origin(const string& $url) : string?
    {
        usize $scheme = $url->find('://');
        if ($scheme >= $url->size()) {
            return null;
        }

        usize $path = $url->find('/', $scheme + 3);
        if ($path >= $url->size()) {
            return $url;
        }

        return $url->sub(0, $path);
    }
}
