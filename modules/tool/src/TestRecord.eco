namespace ecotest::cli;

use ecotest::protocol;

/**
 * Everything known about one test after a run: echoc's report rows, one per pass, and the events
 * the test wrote through ecotest.
 */
public class TestRecord
{
    public const string $id;

    /**
     * The id in file-name form, as `ecotest::protocol::key` writes it. echoc names the test's
     * coverage file this way and ecotest its event file, so all three join on it.
     */
    public const string $key;
    public string $module = '';
    public string $file = '';
    public string $name = '';
    public string $group = '';

    public Outcome $outcome = .pass;

    /**
     * How each pass went, in order.
     */
    public array<Attempt> $attempts = [];
    public string $output = '';

    /**
     * What the test wrote through ecotest in the pass it was last folded in.
     */
    public Events $events = Events();

    /**
     * The record of the test `$id`, keyed by its file-name form.
     */
    public constructor(const string& $id)
    {
        $this->id = $id;
        $this->key = protocol::key($id);
    }

    /**
     * The test's id as people read it, split at `::` into the file and the test's own name, as in
     * `tests/a.eco` and `adds`. The module is dropped from the front unless `$keepModule`, which
     * keeps tests of different modules apart. Without `::` the suite is empty and the label is the
     * whole id.
     */
    public const function title(bool $keepModule) : TestTitle
    {
        usize $from = 0;
        $prefix = "{$this->module}/";
        if (!$keepModule && !$this->module->empty() && $this->id->starts($prefix)) {
            $from = $prefix->size();
        }

        usize $at = $this->id->find('::');
        if ($at == $this->id->size() || $at < $from) {
            return TestTitle('', $this->id->sub($from, $this->id->size() - $from));
        }
        return TestTitle($this->id->sub($from, $at - $from), $this->id->sub($at + 2, $this->id->size() - $at - 2));
    }

    /**
     * How the latest pass went, or the settled outcome before any pass was recorded.
     */
    public const function latest() : Outcome
    {
        if ($this->attempts->empty()) {
            return $this->outcome;
        }

        return $this->attempts[$this->attempts->count() - 1]->outcome;
    }

    /**
     * The duration of the last pass, in milliseconds.
     */
    public const function ms() : int64
    {
        if ($this->attempts->empty()) {
            return 0;
        }

        return $this->attempts[$this->attempts->count() - 1]->ms;
    }

    /**
     * How each pass went, in order: `pass fail pass`.
     */
    public const function attemptWords() : string
    {
        $words = arr::room<string>($this->attempts->count());
        foreach ($this->attempts as const &$attempt) {
            $words[] = $attempt->outcome->value();
        }
        return str::join($words, ' ');
    }

    /**
     * Why a listed test is listed: how its passes went when it is flaky, otherwise the reason it
     * skipped, which is empty for any other test.
     */
    public const function why() : string
    {
        if ($this->outcome == Outcome::flaky) {
            return $this->attemptWords();
        }
        return $this->events->skipReason;
    }

    /**
     * Where the test stopped: in its last pass, or for a flaky test in the last pass that broke, so
     * a test that failed once is never reported without why. Null when no pass failed.
     */
    public const function fault() : Fault?
    {
        array<Fault> $all = $this->failures();
        if ($all->empty()) {
            return null;
        }
        return $all[0];
    }

    /**
     * Every failure of the pass that reports: the last broken pass of a flaky test, otherwise
     * the last pass.
     */
    public const function failures() : array<Fault>
    {
        if ($this->outcome == Outcome::flaky) {
            for (usize $i = $this->attempts->count(); $i > 0; $i--) {
                const Attempt& $attempt = $this->attempts[$i - 1];
                if ($attempt->outcome->broken()) {
                    return $attempt->failures;
                }
            }
        }

        return $this->events->failures;
    }

    /**
     * True for a passing test that used ecotest and checked nothing through it.
     */
    public const function silent() : bool
    {
        return $this->outcome == Outcome::pass && $this->events->usedEcotest && $this->events->checks == 0;
    }

    /**
     * Settles `$outcome` from the passes: a skip stays a skip, passes that disagree are flaky,
     * otherwise the last pass decides.
     */
    public function settle() : void
    {
        if ($this->events->skipped) {
            $this->outcome = .skip;
            return;
        }

        if ($this->attempts->empty()) {
            return;
        }

        $passed = false;
        $broke = false;
        foreach ($this->attempts as const &$attempt) {
            if ($attempt->outcome == Outcome::pass) {
                $passed = true;
            }
            if ($attempt->outcome->broken()) {
                $broke = true;
            }
        }

        if ($passed && $broke) {
            $this->outcome = .flaky;
            return;
        }

        $this->outcome = $this->attempts[$this->attempts->count() - 1]->outcome;
    }
}
