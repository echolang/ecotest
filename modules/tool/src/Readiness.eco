namespace ecotest::cli;

/**
 * How a run tells a service it started is ready for the tests.
 */
public enum Readiness
{
    /**
     * Ready once `$url` answers with a 2xx or 3xx, given at most `$timeoutMs` milliseconds.
     */
    case http(string $url, int64 $timeoutMs);

    /**
     * Ready after a fixed `$ms` milliseconds; 0 is ready at once.
     */
    case delay(int64 $ms);

    /**
     * The longest the run waits for the service, in milliseconds.
     */
    public const function limit() : int64
    {
        return match ($this) {
            .http($url, $timeoutMs) => $timeoutMs,
            .delay($ms) => $ms,
        };
    }
}
