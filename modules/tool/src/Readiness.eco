namespace ecotest::cli;

/**
 * How a run tells a service it started is ready for the tests.
 */
public enum Readiness
{
    /**
     * Ready once `$url` answers with a 2xx or 3xx, given at most `$timeoutMs` milliseconds. The
     * tool does not ask: it hands the check to the tests, and ecotest-http's `Api(service:)` makes
     * it, so the tool needs no HTTP client.
     */
    case http(string $url, int64 $timeoutMs);

    /**
     * Ready after a fixed `$ms` milliseconds; 0 is ready at once.
     */
    case delay(int64 $ms);
}
