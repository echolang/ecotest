namespace ecotest::cli;

use ecotest::cli::doc;

/**
 * echoc's `coverage/map.json`: every counter of every covered module.
 */
public struct CoverageMap
{
    public string $hash = '';
    public array<ModuleSites> $modules = [];

    /**
     * The map at `$path`, or why there is none: missing, unreadable, or not JSON.
     */
    public static function load(const string& $path) : result<CoverageMap, CoverageMapError>
    {
        $text = guard std::io::readfile($path) else ($e) {
            return .error(.unreadable($path, $e));
        };

        $doc = guard json::parse($text) else ($e) {
            return .error(.malformed($path, $e));
        };

        $map = CoverageMap();
        $map->hash = doc::text($doc, 'hash');

        foreach (doc::list($doc, 'modules') as const &$module) {
            $sites = ModuleSites(doc::text($module, 'name'), doc::text($module, 'dir'));

            foreach (doc::list($module, 'counters') as const &$counter) {
                $sites->sites[] = CoverageSite(
                    doc::text($counter, 'file'),
                    doc::number($counter, 'line'),
                    doc::number($counter, 'column'),
                    doc::text($counter, 'kind'),
                    doc::text($counter, 'edge'),
                    doc::text($counter, 'function')
                );
            }

            $map->modules[] = mv $sites;
        }

        return .ok(mv $map);
    }

    /**
     * The module named `$name`, or null.
     */
    public const function module(const string& $name) : ModuleSites?
    {
        foreach ($this->modules as const &$module) {
            if ($module->name == $name) {
                return $module;
            }
        }
        return null;
    }
}
