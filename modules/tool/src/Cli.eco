/**
 * The ecotest command line: the commands, their flags, and the hand-off to `Tool`.
 *
 *   ecotest [run] [--coverage] [--html] [--repeat N] [--filter ...] [--style auto|pretty|simple] [gates]
 *   ecotest report [run] --format terminal|md|junit|lcov|html|json [--style ...]
 *   ecotest history
 *   ecotest api
 *   ecotest who <file:line>
 *   ecotest affected --since <ref>
 */

namespace ecotest::cli;

use ecotest::cli::files;
use command;

/**
 * Runs the command `$argv` names, the program name first, and answers the exit code.
 */
public function main(const array<string>& $argv) : int32
{
    $app = command::Command('ecotest', '0.2.0', 'run echoc tests and report on them');

    $run = $app->command('run', 'run the tests and report (the default)', 'Runs echoc test, merges what the tests recorded through ecotest, prints a summary and writes every report into the run directory.');
    $report = $app->command('report', 'render a stored run', 'Renders the newest run, or the one named, in another format.');
    $history = $app->command('history', 'trends across runs', 'Duration and outcome trends from the run history.');
    $api = $app->command('api', 'public API no test calls', 'Lists public functions and methods whose coverage counter never ran in the newest run.');
    $who = $app->command('who', 'tests that ran a line', 'Names the tests that ran a source line in the newest run.');
    $affected = $app->command('affected', 'run the tests touching a change', 'Runs only the tests whose coverage touches lines changed since a git ref.');

    $app->positional($report, '[run]', 'the run directory', 'Defaults to the newest run.', 0, 1, '');
    $app->positional($who, '<file:line>', 'the source line', 'A path, or its tail, and a line number.', 1, 1, '');

    $coverage = $app->flag('coverage', '', 'measure line, branch and function coverage');
    $html = $app->flag('html', '', 'write report.html into the run directory');
    $repeat = $app->arg('repeat', '', '<n>', 'run every test n times and flag the flaky ones');
    $filter = $app->repeat('filter', '', '<spec>', 'which tests to run, as echoc test --filter');
    $target = $app->arg('target', '', '<name>', 'a test target from the manifest');
    $define = $app->repeat('define', '', '<name>', 'a flag #[if: NAME] can test');
    $timeout = $app->arg('timeout', '', '<ms>', 'kill a test that runs longer');
    $echoc = $app->arg('echoc', '', '<path>', 'the echoc to run');
    $buildDir = $app->arg('build-dir', '', '<dir>', 'echoc build directory');
    $module = $app->repeat('coverage-module', '', '<name>', 'also report coverage of this module');
    $minCoverage = $app->arg('min-coverage', '', '<percent>', 'fail below this line coverage');
    $minBranches = $app->arg('min-branch-coverage', '', '<percent>', 'fail below this branch coverage');
    $minDiff = $app->arg('min-diff-coverage', '', '<percent>', 'fail below this coverage of changed lines');
    $maxFlaky = $app->arg('max-flaky', '', '<n>', 'fail with more flaky tests');
    $since = $app->arg('since', '', '<ref>', 'git ref for diff coverage and affected');
    $format = $app->arg('format', '', '<name>', 'terminal, md, junit, lcov, html or json');
    $project = $app->arg('project', '', '<dir>', 'the module to test, the current directory by default');
    $style = $app->arg('style', '', '<auto|pretty|simple>', 'live progress and a styled summary, or plain text');

    $styles = [
        command::OptionValue('auto', 'pretty on a terminal, simple elsewhere', 'Watch the run live when stderr is a terminal, and style the summary when stdout takes colour or unicode.'),
        command::OptionValue('pretty', 'live progress and a styled summary', 'A spinner over the compile, a bar over the tests with failures as they happen, and a summary closed by a PASS or FAIL badge.'),
        command::OptionValue('simple', 'echoc listing and plain text', 'What ecotest printed before it drew anything: the listing echoc writes, then the plain summary.'),
    ];
    $app->values($style, $styles);
    $app->fallback($style, 'auto');

    foreach ([$coverage, $html] as $f) {
        $app->accept($f, $run);
        $app->accept($f, $affected);
    }
    foreach ([$repeat, $filter, $target, $define, $timeout, $echoc, $buildDir, $minCoverage, $minBranches, $minDiff, $maxFlaky] as $a) {
        $app->accept($a, $run);
        $app->accept($a, $affected);
    }
    $app->accept($module, $run);
    $app->accept($module, $report);
    $app->accept($module, $api);
    $app->accept($since, $run);
    $app->accept($since, $affected);
    $app->require($since, $affected);
    $app->accept($format, $report);
    foreach ([$run, $report, $affected] as $sub) {
        $app->accept($style, $sub);
    }
    $app->accept($echoc, $api);
    foreach ([$run, $report, $history, $api, $who, $affected] as $sub) {
        $app->accept($project, $sub);
    }

    $r = $app->parse(defaulted($argv));

    if (refused($r, $app)) {
        return 2;
    }

    $parsed = $r->parsed;

    if ($parsed->wantsVersion) {
        std::io::println(command::renderVersion($app));
        return 0;
    }

    if ($parsed->wantsHelp) {
        command::CLIContext $help = .from($parsed, $app, .stdout);
        $help->print(command::renderHelp($app, $parsed, $help));
        return 0;
    }

    $tool = Tool();
    Invocation& $invocation = $tool->echoc;
    $invocation->project = files::resolve(std::env::cwd(), $parsed->value($project));
    $invocation->program = $parsed->value($echoc);
    if ($invocation->program->empty()) {
        $invocation->program = string(std::env::var('ECHOC', 'echoc'));
    }
    $invocation->buildDir = $parsed->value($buildDir);
    if ($invocation->buildDir->empty()) {
        $invocation->buildDir = 'ecobuild';
    }
    $invocation->coverage = $parsed->stated($coverage);
    $invocation->repeat = (str::uint($parsed->value($repeat)) ?? 1) as usize;
    $tool->html = $parsed->stated($html);
    $tool->modules = $parsed->values($module);
    $tool->since = $parsed->value($since);
    $tool->format = $parsed->value($format);
    $tool->style = .of($parsed->value($style));
    $tool->live = .from($parsed, $app, .stderr);
    $tool->page = .from($parsed, $app, .stdout);

    foreach ($parsed->values($filter) as const &$spec) {
        $invocation->forwarded[] = '--filter';
        $invocation->forwarded[] = $spec;
    }
    foreach ($parsed->values($define) as const &$name) {
        $invocation->forwarded[] = '--define';
        $invocation->forwarded[] = $name;
    }
    if ($parsed->stated($target)) {
        $invocation->forwarded[] = '--target';
        $invocation->forwarded[] = $parsed->value($target);
    }
    if ($parsed->stated($timeout)) {
        $invocation->forwarded[] = '--timeout';
        $invocation->forwarded[] = $parsed->value($timeout);
    }

    // a gate not given is off; ecotest.json may still set the line gate
    $tool->gates->minLines = str::float($parsed->value($minCoverage));
    $tool->gates->minBranches = str::float($parsed->value($minBranches));
    $tool->gates->minDiff = str::float($parsed->value($minDiff));
    $tool->gates->maxFlaky = str::int($parsed->value($maxFlaky));

    $subject = $parsed->subject($app);

    if ($subject == 'run') {
        return $tool->run();
    }

    if ($subject == 'report') {
        $dir = '';
        if (!$parsed->positionals->empty()) {
            $dir = $parsed->positionals[0];
        }
        return $tool->report($dir);
    }

    if ($subject == 'history') {
        return $tool->history();
    }

    if ($subject == 'api') {
        return $tool->api();
    }

    if ($subject == 'who') {
        return $tool->who($parsed->positionals[0]);
    }

    return $tool->affected();
}

/**
 * `$argv` with `run` put in front when it names no command: bare `ecotest`, or `ecotest --coverage`.
 * A lone help or version flag still reaches the root page.
 */
public function defaulted(const array<string>& $argv) : array<string>
{
    if ($argv->count() > 1) {
        const string& $first = $argv[1];
        if (!$first->starts('-') || $first == '-h' || $first == '--help' || $first == '-v' || $first == '--version') {
            return $argv;
        }
    }

    array<string> $words = [$argv[0], 'run'];
    for (usize $i = 1; $i < $argv->count(); $i++) {
        $words[] = $argv[$i];
    }
    return $words;
}

/**
 * Prints why the command line was refused, when it was. True when it was.
 */
private function refused(const command::Outcome& $r, const command::Command& $app) : bool
{
    command::Error $e = guard $r->error else {
        return false;
    };

    command::CLIContext $err = .from($r->parsed, $app, .stderr);
    $err->print(command::renderError($e, $app, $r->parsed, $err));
    return true;
}
