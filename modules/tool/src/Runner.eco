namespace ecotest::cli;

use ecotest::cli::{doc, files};

/**
 * Runs `echoc test` once per pass into a run directory. Each pass gets its own `report.jsonl`,
 * an `events/` directory the tests write into through `ECOTEST_RUN_DIR`, and a copy of echoc's
 * coverage files, which echoc clears on its next run.
 */
public class Runner
{
    /**
     * Handed to the tests as `ECOTEST_SEED`, so every pass of a run draws the same values.
     */
    public uint64 $seed = 0;

    /**
     * Extra environment for the tests, by variable name: the services' URLs.
     */
    public ordered_map<string, string> $env = [];

    /**
     * Watches each pass live when set. Without one, echoc writes its own listing to the terminal.
     */
    public LiveView? $view = null;

    /**
     * Runs every pass of `$echoc` into `$dir`, or answers why one could not run: echoc would not
     * start, or its pass directory or log could not be written.
     */
    public const function run(const Invocation& $echoc, const string& $dir) : status<RunError>
    {
        for (usize $pass = 1; $pass <= $echoc->repeat; $pass++) {
            $passDir = std::env::join($dir, "pass-{$pass}");
            $events = std::env::join($passDir, 'events');
            guard files::mkdirs($events) else ($e) {
                return .error(.cannotWrite($events, $e));
            };

            array<string> $args = ['test', '--report', std::env::join($passDir, 'report.jsonl')];
            if ($echoc->coverage) {
                $args[] = '--coverage';
            }

            $test = $echoc->command(mv $args);
            foreach ($echoc->forwarded as const &$word) {
                $test->arg($word);
            }
            $test->env('ECOTEST_RUN_DIR', $passDir);
            // a test that runs echoc itself reaches the same compiler
            $test->env('ECHOC', $echoc->program);
            $test->env('ECOTEST_SEED', "{$this->seed}");
            foreach ($this->env as $name => const &$value) {
                $test->env($name, $value);
            }

            guard $this->launch($echoc, $test, $passDir, $pass) else ($e) {
                return .error($e);
            };

            if ($echoc->coverage) {
                $this->keepCoverage($echoc, $passDir);
            }
        }

        return .ok;
    }

    /**
     * Runs pass `$pass` of `$echoc`, the command `$test`, to its end: with the streams inherited,
     * or watched through the view.
     */
    private const function launch(const Invocation& $echoc, std::process::command& $test, const string& $passDir, usize $pass) : status<RunError>
    {
        LiveView $view = guard $this->view else {
            if ($echoc->repeat > 1) {
                std::io::println("ecotest: pass {$pass} of {$echoc->repeat}");
            }

            guard $test->status() else ($e) {
                return .error(.cannotRun($echoc->program, $e));
            };
            return .ok;
        };

        return $this->watch($echoc, $test, $passDir, $pass, $view);
    }

    /**
     * Runs pass `$pass`, the command `$test`, with echoc's output in `echoc.log` beside its report,
     * and feeds both to `$view` as they grow, until echoc ends.
     */
    private const function watch(const Invocation& $echoc, std::process::command& $test, const string& $passDir, usize $pass, LiveView $view) : status<RunError>
    {
        $logPath = std::env::join($passDir, 'echoc.log');
        $log = guard std::io::create($logPath) else ($e) {
            return .error(.cannotWrite($logPath, $e));
        };

        // the log is printed back when the compile fails, so it keeps echoc's colour
        if ($view->ctx->caps->color) {
            $test->arg('--color');
            $test->arg('always');
        }
        $test->stdout(.file($log));
        $test->stderr(.merge);

        $child = guard $test->spawn() else ($e) {
            $log->close();
            return .error(.cannotRun($echoc->program, $e));
        };

        $view->begin($pass, $echoc->repeat, $passDir);
        $report = Tail(std::env::join($passDir, 'report.jsonl'));
        $output = Tail($logPath);

        while (Runner::alive($child)) {
            if ($view->compiling()) {
                $view->output($output->take());
            }
            $view->rows(doc::lines($report->take()));
            std::thread::sleep(40);
        }

        // read once more after echoc ended, so its last rows are seen, a last one without its
        // newline too
        if ($view->compiling()) {
            $view->output($output->rest());
        }
        $view->rows(doc::lines($report->rest()));

        $log->close();
        $view->end($logPath);
        return .ok;
    }

    /**
     * True while `$child` has not ended.
     */
    private static function alive(std::process::child& $child) : bool
    {
        // a child this process spawned can always be asked; dying beats watching forever
        return $child->try_wait()->unwrap() == null;
    }

    /**
     * Copies `$echoc`'s coverage map and counter files into the pass. A file that cannot be copied is
     * named on stdout, so a run that then reports no coverage says why.
     */
    private const function keepCoverage(const Invocation& $echoc, const string& $passDir) : void
    {
        $from = std::env::join(files::resolve($echoc->project, $echoc->buildDir), 'coverage');
        $to = std::env::join($passDir, 'coverage');
        $tests = std::env::join($to, 'tests');
        // a directory that cannot be made fails the copies into it, and those are named below
        files::mkdirs($tests);

        $map = std::env::join($from, 'map.json');
        guard std::io::copy($map, std::env::join($to, 'map.json')) else ($e) {
            std::io::println("ecotest: cannot keep the coverage map {$map}: {$e}");
            return;
        };

        $listing = guard std::io::opendir(std::env::join($from, 'tests')) else ($e) {
            std::io::println("ecotest: cannot read the coverage counters in {$from}: {$e}");
            return;
        };

        foreach ($listing as const &$entry) {
            guard std::io::copy($entry->path(), std::env::join($tests, $entry->name())) else ($e) {
                std::io::println("ecotest: cannot keep the coverage counters {$entry->path()}: {$e}");
                continue;
            };
        }

        $listing->close();
    }
}
