namespace ecotest::cli;

use ecotest::protocol;
use ecotest::cli::{doc, files, interrupt};

/**
 * Runs `echoc test` once per pass into a run directory and folds what each pass reports into the
 * run. Each pass gets its own `report.jsonl`, an `events/` directory the tests write into through
 * `ECOTEST_RUN_DIR`, `echoc.json` with how echoc ended, and a copy of the coverage that pass
 * measured.
 */
public class Runner
{
    /**
     * Handed to the tests as `ECOTEST_SEED`, so every pass of a run draws the same values.
     */
    public uint64 $seed = 0;

    /**
     * Extra environment for the tests, by variable name: the services' URLs.
     */
    public ordered_map<string, string> $env = [];

    /**
     * Watches each pass live when set. Without one, echoc writes its own listing to the terminal.
     */
    public LiveView? $view = null;

    /**
     * Runs every pass of `$echoc` into `$dir`, folding each into `$run`, or answers why one could
     * not run: echoc would not start, a pass directory could not be written, coverage could not be
     * kept, or an interrupt arrived.
     */
    public function run(const Invocation& $echoc, const string& $dir, Run& $run) : status<RunError>
    {
        $coverage = ($echoc->project / $echoc->buildDir / 'coverage')->string();

        for (usize $pass = 1; $pass <= $echoc->repeat; $pass++) {
            $passDir = ($dir / "pass-{$pass}")->string();
            $events = ($passDir / 'events')->string();
            guard std::fs::mkdir($events, recursive: true) else ($e) {
                return .error(.cannotWrite($events, $e));
            };

            // what echoc left from an earlier run is not this pass's coverage
            if ($echoc->coverage) {
                Runner::clearCoverage($coverage);
            }

            array<string> $args = ['test', '--report', ($passDir / 'report.jsonl')->string()];
            if ($echoc->coverage) {
                $args[] = '--coverage';
            }

            $test = $echoc->command(mv $args);
            $test->group();
            foreach ($echoc->forwarded as const &$word) {
                $test->arg($word);
            }
            $test->env(protocol::RUN_DIR, $passDir);
            // a test that runs echoc itself reaches the same compiler
            $test->env('ECHOC', $echoc->program);
            $test->env(protocol::SEED, "{$this->seed}");
            foreach ($this->env as $name => const &$value) {
                $test->env($name, $value);
            }

            $run->begin($passDir);
            $exit = guard $this->launch($echoc, $test, $passDir, $pass, $run) else ($e) {
                return .error($e);
            };
            $run->exited($exit);
            Runner::record($passDir, $exit);

            const Pass& $done = $run->passes[$run->passes->count() - 1];
            if ($echoc->coverage && $done->reached) {
                guard Runner::keepCoverage($coverage, $passDir) else ($e) {
                    return .error($e);
                };
            }
        }

        return .ok;
    }

    /**
     * Runs pass `$pass` of `$echoc`, the command `$test`, to its end and answers how echoc ended:
     * with the streams inherited and the report folded afterwards, or watched through the view.
     */
    private function launch(
        const Invocation& $echoc,
        std::process::command& $test,
        const string& $passDir,
        usize $pass,
        Run& $run
    ) : result<PassExit, RunError> {
        LiveView $view = guard $this->view else {
            if ($echoc->repeat > 1) {
                files::warn("pass {$pass} of {$echoc->repeat}");
            }

            $child = guard $test->spawn() else ($e) {
                return .error(.cannotRun($echoc->program, $e));
            };
            $exit = guard Runner::await($child) else ($e) {
                return .error($e);
            };

            foreach (doc::lines(doc::read(($passDir / 'report.jsonl')->string()) ?? '') as const &$row) {
                $folded = $run->fold($row);
            }
            return .ok($exit);
        };

        return $this->watch($echoc, $test, $passDir, $pass, $view, $run);
    }

    /**
     * Runs pass `$pass`, the command `$test`, with echoc's output in `echoc.log` beside its report,
     * folding the rows into `$run` and feeding both to `$view` as they grow, until echoc ends.
     */
    private function watch(
        const Invocation& $echoc,
        std::process::command& $test,
        const string& $passDir,
        usize $pass,
        LiveView $view,
        Run& $run
    ) : result<PassExit, RunError> {
        $logPath = ($passDir / 'echoc.log')->string();
        $log = guard std::fs::create($logPath) else ($e) {
            return .error(.cannotWrite($logPath, $e));
        };

        // the log is printed back when the compile fails, so it keeps echoc's colour
        if ($view->ctx->caps->color) {
            $test->arg('--color');
            $test->arg('always');
        }
        $test->stdout(.file($log));
        $test->stderr(.merge);

        $child = guard $test->spawn() else ($e) {
            $log->close();
            return .error(.cannotRun($echoc->program, $e));
        };

        $view->begin($pass, $echoc->repeat);
        $report = Tail(($passDir / 'report.jsonl')->string());
        $output = Tail($logPath);

        while (Runner::alive($child)) {
            if (interrupt::requested()) {
                $stopped = $child->stop();
                $log->close();
                return .error(.interrupted);
            }
            if ($view->compiling()) {
                $view->output($output->take());
            }
            Runner::feed($view, $run, $report->take());
            std::thread::sleep(40);
        }

        // read once more after echoc ended, so its last rows are seen, a last one without its
        // newline too
        if ($view->compiling()) {
            $view->output($output->rest());
        }
        Runner::feed($view, $run, $report->rest());

        $log->close();
        $view->end($logPath);

        $status = guard $child->wait() else ($e) {
            return .error(.cannotRun($echoc->program, $e));
        };
        return .ok(PassExit($status->code(), $status->signal()));
    }

    /**
     * Folds the report rows in `$text` into `$run` and shows each to `$view`.
     */
    private static function feed(LiveView& $view, Run& $run, const string& $text) : void
    {
        foreach (doc::lines($text) as const &$row) {
            $test = $run->fold($row);
            $view->take($row, $test);
        }
        $view->advance();
    }

    /**
     * Waits for `$child` to end, stopping it and everything it started when an interrupt arrives.
     */
    private static function await(std::process::child& $child) : result<PassExit, RunError>
    {
        while (Runner::alive($child)) {
            if (interrupt::requested()) {
                $stopped = $child->stop();
                return .error(.interrupted);
            }
            std::thread::sleep(40);
        }

        $status = guard $child->wait() else ($e) {
            return .error(.cannotRun('echoc', $e));
        };
        return .ok(PassExit($status->code(), $status->signal()));
    }

    /**
     * True while `$child` has not ended.
     */
    private static function alive(std::process::child& $child) : bool
    {
        // a child this process spawned can always be asked; dying beats watching forever
        return $child->try_wait()->unwrap() == null;
    }

    /**
     * Writes how echoc ended into the pass as `echoc.json`, so a stored run is judged by it too. A
     * file that cannot be written leaves the pass to be judged on its rows.
     */
    private static function record(const string& $passDir, const PassExit& $exit) : void
    {
        $doc = json::object();
        $doc['v'] = json::int(1);
        $doc['exit'] = json::nil();
        $doc['signal'] = json::nil();
        if ($exit->code != null) {
            $doc['exit'] = json::int(($exit->code ?? 0) as int64);
        }
        if ($exit->signal != null) {
            $doc['signal'] = json::int(($exit->signal ?? 0) as int64);
        }
        $written = files::write(($passDir / 'echoc.json')->string(), json::dump($doc));
    }

    /**
     * Removes the coverage map and counter files echoc left in `$from`, so whatever is there after
     * the next pass is that pass's.
     */
    private static function clearCoverage(const string& $from) : void
    {
        $gone = std::fs::remove(($from / 'map.json'));

        $tests = ($from / 'tests');
        $listing = guard std::fs::opendir($tests) else {
            return;
        };
        array<string> $stale = [];
        foreach ($listing as const &$entry) {
            if ($entry->name()->ends('.ecocov')) {
                $stale[] = $entry->path()->string();
            }
        }
        $listing->close();

        foreach ($stale as const &$path) {
            $removed = std::fs::remove($path);
        }
    }

    /**
     * Copies the coverage map and counter files in `$from` into the pass at `$passDir`.
     */
    private static function keepCoverage(const string& $from, const string& $passDir) : status<RunError>
    {
        $to = ($passDir / 'coverage')->string();
        $tests = ($to / 'tests')->string();
        guard std::fs::mkdir($tests, recursive: true) else ($e) {
            return .error(.cannotWrite($tests, $e));
        };

        $map = ($from / 'map.json')->string();
        guard std::fs::copy($map, ($to / 'map.json')) else ($e) {
            return .error(.cannotKeep($map, $e));
        };

        $counters = ($from / 'tests')->string();
        $listing = guard std::fs::opendir($counters) else ($e) {
            return .error(.cannotKeep($counters, $e));
        };

        foreach ($listing as const &$entry) {
            $src = $entry->path();
            guard std::fs::copy($src, ($tests / $entry->name())) else ($e) {
                $listing->close();
                return .error(.cannotKeep($src->string(), $e));
            };
        }

        $listing->close();
        return .ok;
    }
}
