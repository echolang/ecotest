namespace ecotest::cli;

/**
 * Runs `echoc test` once per pass into a run directory. Each pass gets its own `report.jsonl`,
 * an `events/` directory the tests write into through `ECOTEST_RUN_DIR`, and a copy of echoc's
 * coverage files, which echoc clears on its next run.
 */
public class Runner
{
    public string $project = '.';
    public string $echoc = 'echoc';
    public array<string> $forwarded = [];
    public bool $coverage = false;
    public string $buildDir = 'ecobuild';
    public usize $repeat = 1;
    public uint64 $seed = 0;
    public array<string> $envNames = [];
    public array<string> $envValues = [];

    /**
     * Watches each pass live when set. Without one, echoc writes its own listing to the terminal.
     */
    public LiveView? $view = null;

    /**
     * Runs every pass into `$dir`. True when echoc could be started for each of them.
     */
    public function run(const string& $dir) : bool
    {
        for (usize $pass = 1; $pass <= $this->repeat; $pass++) {
            string $passDir = std::env::join($dir, "pass-{$pass}");
            Files::mkdirs(std::env::join($passDir, 'events'));

            array<string> $args = ['test', '--report', std::env::join($passDir, 'report.jsonl')];
            if ($this->coverage) {
                $args[] = '--coverage';
            }
            if ($this->buildDir != 'ecobuild') {
                $args[] = '--build-dir';
                $args[] = $this->buildDir;
            }
            foreach ($this->forwarded as const &$word) {
                $args[] = $word;
            }

            std::process::command $echoc = std::process::command($this->echoc, $args);
            $echoc->dir($this->project);
            $echoc->env('ECOTEST_RUN_DIR', $passDir);
            // a test that runs echoc itself reaches the same compiler
            $echoc->env('ECHOC', $this->echoc);
            $echoc->env('ECOTEST_SEED', "{$this->seed}");
            for (usize $i = 0; $i < $this->envNames->count(); $i++) {
                $echoc->env($this->envNames[$i], $this->envValues[$i]);
            }

            if (!$this->launch($echoc, $passDir, $pass)) {
                return false;
            }

            if ($this->coverage) {
                $this->keepCoverage($passDir);
            }
        }

        return true;
    }

    /**
     * Runs one pass of `$echoc` to its end: with the streams inherited, or watched through the view.
     * False when echoc could not be started.
     */
    private function launch(std::process::command& $echoc, const string& $passDir, usize $pass) : bool
    {
        LiveView $view = guard $this->view else {
            if ($this->repeat > 1) {
                std::io::println("ecotest: pass {$pass} of {$this->repeat}");
            }

            result<std::process::exit_status, std::io::ioerror> $ran = $echoc->status();
            if ($ran->failed()) {
                $e = $ran->failure();
                std::io::println("ecotest: cannot run {$this->echoc}: {$e}");
                return false;
            }
            return true;
        };

        return $this->watch($echoc, $passDir, $pass, $view);
    }

    /**
     * Runs one pass with echoc's output in `echoc.log` beside its report, and feeds both to `$view`
     * as they grow, until echoc ends.
     */
    private function watch(std::process::command& $echoc, const string& $passDir, usize $pass, LiveView $view) : bool
    {
        string $logPath = std::env::join($passDir, 'echoc.log');
        std::io::file $log = guard std::io::create($logPath) else ($e) {
            std::io::println("ecotest: cannot write {$logPath}: {$e}");
            return false;
        };

        // the log is printed back when the compile fails, so it keeps echoc's colour
        if ($view->ctx->caps->color) {
            $echoc->arg('--color');
            $echoc->arg('always');
        }
        $echoc->stdout(.file($log));
        $echoc->stderr(.merge);

        std::process::child $child = guard $echoc->spawn() else ($e) {
            $log->close();
            std::io::println("ecotest: cannot run {$this->echoc}: {$e}");
            return false;
        };

        $view->begin($pass, $this->repeat, $passDir);
        Tail $report = Tail(std::env::join($passDir, 'report.jsonl'));
        Tail $output = Tail($logPath);

        while (Runner::alive($child)) {
            if ($view->compiling()) {
                $view->output($output->take());
            }
            $view->rows(Doc::lines($report->take()));
            std::thread::sleep(40);
        }

        // read once more after echoc ended, so its last rows are seen, a last one without its
        // newline too
        if ($view->compiling()) {
            $view->output($output->rest());
        }
        $view->rows(Doc::lines($report->rest()));

        $log->close();
        $view->end($logPath);
        return true;
    }

    /**
     * True while `$child` has not ended.
     */
    private static function alive(std::process::child& $child) : bool
    {
        // a child this process spawned can always be asked; dying beats watching forever
        return $child->try_wait()->unwrap() == null;
    }

    /**
     * Copies echoc's coverage map and counter files into the pass.
     */
    private function keepCoverage(const string& $passDir) : void
    {
        string $from = std::env::join(Files::resolve($this->project, $this->buildDir), 'coverage');
        string $to = std::env::join($passDir, 'coverage');
        Files::mkdirs(std::env::join($to, 'tests'));

        result<bool, std::io::ioerror> $map = std::io::copy(std::env::join($from, 'map.json'), std::env::join($to, 'map.json'));

        std::io::dir $listing = guard std::io::opendir(std::env::join($from, 'tests')) else {
            return;
        };

        foreach ($listing as const &$entry) {
            result<bool, std::io::ioerror> $copied = std::io::copy($entry->path(), std::env::join(std::env::join($to, 'tests'), $entry->name()));
        }

        $listing->close();
    }
}
