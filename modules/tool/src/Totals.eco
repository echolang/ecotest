namespace ecotest::cli;

/**
 * The coverage of a whole run: lines, branches and functions, each hit out of total.
 */
public struct Totals
{
    public Ratio $lines = Ratio();
    public Ratio $branches = Ratio();
    public Ratio $functions = Ratio();
}

namespace str;

/**
 * `$t` as a sentence: `81.4% lines, 70.0% branches, 92.3% functions`.
 */
public function from(const ecotest::cli::Totals& $t) : string
{
    return "{$t->lines} lines, {$t->branches} branches, {$t->functions} functions";
}
