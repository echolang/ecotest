namespace ecotest::cli;

use ecotest::protocol;
use ecotest::cli::doc;

/**
 * What a test wrote through ecotest in one pass: how it failed or why it skipped, how many checks
 * it made, and the notes, metrics, benches and snapshots it recorded. A record keeps its last
 * pass's events, so a fresh pass starts from an empty one.
 */
public struct Events
{
    /**
     * Each failed check of the pass, in the order they were written. A crash is recorded only
     * when no check failed first.
     */
    public array<Fault> $failures = [];

    /**
     * True once the test ended itself as skipped, whatever reason it gave.
     */
    public bool $skipped = false;
    public string $skipReason = '';

    /**
     * Event lines of another protocol version, which were left out.
     */
    public usize $foreign = 0;

    /**
     * True once the test wrote any event, so its checks were counted.
     */
    public bool $usedEcotest = false;

    public int64 $checks = 0;
    public array<string> $notes = [];
    public array<Metric> $metrics = [];
    public array<BenchResult> $benches = [];
    public array<string> $snapshotsNew = [];
    public array<string> $snapshotsUpdated = [];

    /**
     * The first failure of the pass, or null when none failed.
     */
    public const function fault() : Fault?
    {
        if ($this->failures->empty()) {
            return null;
        }
        return $this->failures[0];
    }

    /**
     * Folds one ecotest event of the pass into these events.
     */
    public function apply(const json::Value& $event) : void
    {
        // a line without a version predates it, and reads as the first
        int64 $v = doc::number($event, 'v');
        if ($v != 0 && $v != protocol::VERSION) {
            $this->foreign++;
            return;
        }

        $this->usedEcotest = true;
        protocol::Kind $kind = guard protocol::Kind::of(doc::text($event, 'type')) else {
            return;
        };

        match ($kind) {
            .fail => {
                array<string> $context = [];
                foreach (doc::list($event, 'context') as const &$scope) {
                    $context[] = $scope->asStr() ?? '';
                }

                $this->failures[] = Fault(
                    doc::text($event, 'summary'),
                    doc::text($event, 'file'),
                    doc::number($event, 'line'),
                    doc::text($event, 'detail'),
                    mv $context,
                    doc::text($event, 'expected'),
                    doc::text($event, 'actual')
                );
            },
            .crash => {
                $this->crashed($event);
            },
            .skip => {
                $this->skipped = true;
                $this->skipReason = doc::text($event, 'reason');
            },
            .checks => {
                $this->checks = doc::number($event, 'count');
            },
            .note => {
                $this->notes[] = doc::text($event, 'text');
            },
            .metric => {
                $this->metrics[] = Metric(doc::text($event, 'name'), doc::number($event, 'value'));
            },
            .bench => {
                $this->benches[] = BenchResult(
                    doc::text($event, 'label'),
                    doc::number($event, 'p50_ns'),
                    doc::number($event, 'p95_ns'),
                    doc::number($event, 'calls')
                );
            },
            .snapshotNew => {
                $this->snapshotsNew[] = doc::text($event, 'path');
            },
            .snapshotUpdated => {
                $this->snapshotsUpdated[] = doc::text($event, 'path');
            },
        };
    }

    /**
     * Records the crash `$crash` describes, its `headline`, `message`, `file` and `line`, unless a
     * failure was recorded first.
     */
    public function crashed(const json::Value& $crash) : void
    {
        if (!$this->failures->empty()) {
            return;
        }

        $headline = doc::text($crash, 'headline');
        $message = doc::text($crash, 'message');
        $this->failures[] = Fault("{$headline}: {$message}", doc::text($crash, 'file'), doc::number($crash, 'line'));
    }
}
