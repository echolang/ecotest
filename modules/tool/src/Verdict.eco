namespace ecotest::cli;

use ecotest::cli::doc;

/**
 * What a run comes to once the gates have judged it: the gates, every one that failed as a line,
 * and whether the run is green with all of them held. Reports render this rather than judging the
 * run again.
 */
public struct Verdict
{
    public Gates $gates;
    public array<string> $failed;
    public bool $green;

    /**
     * The verdict on `$run`, which fell short of `$failed` of `$gates`.
     */
    public constructor(on: const Run& $run, gates: const Gates& $gates, failed: const array<string>& $failed)
    {
        $this->gates = $gates;
        $this->failed = $failed;
        $this->green = $run->green() && $failed->empty();
    }

    /**
     * The verdict `$run` got when it finished in `$dir`, as its `run.json` keeps it, with `$gates`
     * marking the coverage. A run that never wrote one is judged on its tests alone.
     */
    public constructor(storedIn: const string& $dir, run: const Run& $run, gates: const Gates& $gates)
    {
        $this->gates = $gates;
        $this->failed = [];
        $this->green = $run->green();

        $text = guard doc::read(std::env::join($dir, 'run.json')) else {
            return;
        };
        $doc = guard json::parse($text) else {
            return;
        };

        foreach (doc::list($doc, 'failedGates') as const &$gate) {
            $this->failed[] = $gate->asStr() ?? '';
        }
        $this->green = doc::object($doc, 'green')->asBool() ?? ($run->green() && $this->failed->empty());
    }
}
