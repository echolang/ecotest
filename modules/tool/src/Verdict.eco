namespace ecotest::cli;

/**
 * What a run comes to once the gates have judged it: the gates, every one that failed as a line,
 * and whether the run is green with all of them held. Reports render this rather than judging the
 * run again.
 */
public struct Verdict
{
    public Gates $gates;
    public array<string> $failed;
    public bool $green;

    /**
     * The verdict on `$run`, which fell short of `$failed` of `$gates`.
     */
    public static function of(const Run& $run, const Gates& $gates, const array<string>& $failed) : Verdict
    {
        return Verdict($gates, $failed, $run->green() && $failed->empty());
    }

    /**
     * The verdict `$run` got when it finished in `$dir`, as its `run.json` keeps it, with `$gates`
     * marking the coverage. A run that never wrote one is judged on its tests alone.
     */
    public static function stored(const string& $dir, const Run& $run, const Gates& $gates) : Verdict
    {
        json::Value $doc = guard json::parse(Doc::read(std::env::join($dir, 'run.json'))) else {
            return Verdict::of($run, $gates, []);
        };

        array<string> $failed = [];
        foreach (Doc::list($doc, 'failedGates') as const &$gate) {
            $failed[] = $gate->asStr() ?? '';
        }

        bool $green = Doc::object($doc, 'green')->asBool() ?? ($run->green() && $failed->empty());
        return Verdict($gates, $failed, $green);
    }
}
