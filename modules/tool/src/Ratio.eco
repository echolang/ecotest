namespace ecotest::cli;

/**
 * Hit out of total, for lines, branches and functions. `"{$ratio}"` prints the percentage.
 */
public struct Ratio
{
    public usize $hit = 0;
    public usize $total = 0;

    /**
     * The percentage hit, or null when there is nothing to hit: no code is not full coverage.
     */
    public const function percent() : float64?
    {
        if ($this->total == 0) {
            return null;
        }

        return 100.0 * ($this->hit as float64) / ($this->total as float64);
    }
}

namespace str;

/**
 * `$r` as a percentage with one decimal, `81.4%`, or `n/a` when there was nothing to hit.
 */
public function from(const ecotest::cli::Ratio& $r) : string
{
    $p = guard $r->percent() else {
        return 'n/a';
    };
    return "{$p:.1f}%";
}

/**
 * `$r` as a percentage, laid out by the format `$spec`, as in `"{$r:>6}"`.
 */
public function from(const ecotest::cli::Ratio& $r, const string& $spec) : string
{
    return from(from($r), $spec);
}
