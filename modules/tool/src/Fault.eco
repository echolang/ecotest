namespace ecotest::cli;

/**
 * One failed check or crash, as the tool folded it from an event line. A pass keeps every one;
 * reports iterate them. The file is empty when nothing named one.
 */
public struct Fault
{
    public string $summary = '';
    public string $file = '';
    public int64 $line = 0;

    /**
     * Extra lines under the values, such as a diff.
     */
    public string $detail = '';

    /**
     * The `ecotest::context` scopes this failure happened in, outermost first.
     */
    public array<string> $context = [];

    /**
     * What the check wanted, as printed. Empty when the check names none.
     */
    public string $expected = '';

    /**
     * What the check got instead, as printed. Empty when the check names none.
     */
    public string $actual = '';
}
