namespace ecotest::cli;

/**
 * How one pass of a test went, as echoc's report row says: its outcome, how long it took in
 * milliseconds, and where it stopped when it failed, so a flaky test still names the pass that
 * broke.
 */
public struct Attempt
{
    public Outcome $outcome;
    public int64 $ms;
    public Fault? $fault = null;
}
