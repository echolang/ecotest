namespace ecotest::cli;

/**
 * The coverage of a run: echoc's map plus every test's counter file, from every pass. Answers per
 * file totals, which tests ran a line, and whether a function was ever called.
 */
public class Coverage
{
    public CoverageMap $map;
    public array<CounterFile> $tests = [];
    public array<string> $modules = [];
    public array<string> $exclude = [];

    public constructor(CoverageMap $map)
    {
        $this->map = $map;
    }

    /**
     * The coverage stored in run directory `$dir`, or null when no pass recorded any.
     */
    public static function load(const string& $dir) : Coverage?
    {
        Coverage? $found = null;
        usize $pass = 1;

        while (true) {
            string $passDir = std::env::join($dir, "pass-{$pass}");
            bool $there = std::io::exists($passDir)->or(false);
            if (!$there) {
                break;
            }

            string $covDir = std::env::join($passDir, 'coverage');
            $pass++;

            CoverageMap $map = guard CoverageMap::load(std::env::join($covDir, 'map.json')) else {
                continue;
            };

            Coverage $into = $found ?? Coverage($map);
            $into->absorb(std::env::join($covDir, 'tests'));
            $found = $into;
        }

        return $found;
    }

    /**
     * Reads every `.ecocov` file in `$dir`.
     */
    public function absorb(const string& $dir) : void
    {
        std::io::dir $listing = guard std::io::opendir($dir) else {
            return;
        };

        foreach ($listing as const &$entry) {
            string $name = $entry->name();
            if (!$name->ends('.ecocov')) {
                continue;
            }

            CounterFile $loaded = guard CounterFile::load($entry->path()) else {
                continue;
            };
            $this->tests[] = $loaded;
        }

        $listing->close();
    }

    /**
     * True when `$module` is reported: the listed modules, or else the modules whose tests ran,
     * which is the module under test and never the libraries it uses.
     */
    public const function reports(const string& $module) : bool
    {
        foreach ($this->modules as const &$wanted) {
            if ($wanted == $module) {
                return true;
            }
        }
        return false;
    }

    /**
     * True when `$file` matches one of the exclude patterns.
     */
    public const function excluded(const string& $file) : bool
    {
        foreach ($this->exclude as const &$pattern) {
            if (Glob::matches($pattern, $file)) {
                return true;
            }
        }
        return false;
    }

    /**
     * Module `$sites`' counts summed over every test.
     */
    public const function merged(const ModuleSites& $sites) : array<uint64>
    {
        usize $n = $sites->sites->count();
        array<uint64> $sum = arr::room<uint64>($n);
        for (usize $i = 0; $i < $n; $i++) {
            $sum[] = 0;
        }

        foreach ($this->tests as const &$test) {
            array<uint32> $counts = $test->of($sites->name);
            for (usize $i = 0; $i < $n && $i < $counts->count(); $i++) {
                $sum[$i] = $sum[$i] + ($counts[$i] as uint64);
            }
        }

        return $sum;
    }

    /**
     * Coverage per reported file, sorted by path.
     */
    public const function files() : array<FileCoverage>
    {
        array<FileCoverage> $out = [];
        map<string, usize> $at = [];

        // a generic body is counted once per instance; the source has one branch and one function
        // there, so counters at the same position merge, and either instance running counts
        map<string, usize> $seen = [];

        foreach ($this->map->modules as const &$module) {
            if (!$this->reports($module->name)) {
                continue;
            }

            array<uint64> $hits = $this->merged($module);

            for (usize $i = 0; $i < $module->sites->count(); $i++) {
                CoverageSite $site = $module->sites[$i];
                if ($this->excluded($site->file)) {
                    continue;
                }

                string $key = "{$module->name}/{$site->file}";
                if (!$at->has($key)) {
                    $at->set($key, $out->count());
                    $out[] = FileCoverage($module->name, $site->file, std::env::join($module->dir, $site->file));
                }

                FileCoverage $file = $out[$at->get($key)];
                uint64 $count = $hits[$i];

                if ($site->kind == 'line') {
                    uint64 $before = 0;
                    if ($file->lines->has($site->line)) {
                        $before = $file->lines->get($site->line);
                    }
                    if ($count > $before || !$file->lines->has($site->line)) {
                        $file->lines->set($site->line, $count);
                    }
                } else if ($site->kind == 'branch') {
                    string $spot = "{$key}:{$site->line}:{$site->column}:{$site->edge}";
                    if ($seen->has($spot)) {
                        usize $k = $seen->get($spot);
                        $file->branchHits[$k] = $file->branchHits[$k] + $count;
                    } else {
                        $seen->set($spot, $file->branchHits->count());
                        $file->branchLines[] = $site->line;
                        $file->branchEdges[] = $site->edge;
                        $file->branchHits[] = $count;
                    }
                } else if ($site->kind == 'fn') {
                    string $spot = "{$key}:{$site->line}:{$site->column}:fn";
                    if ($seen->has($spot)) {
                        usize $k = $seen->get($spot);
                        $file->functionHits[$k] = $file->functionHits[$k] + $count;
                    } else {
                        $seen->set($spot, $file->functionHits->count());
                        $file->functionNames[] = $site->function;
                        $file->functionLines[] = $site->line;
                        $file->functionHits[] = $count;
                    }
                }
            }
        }

        $out->sort(key: (const FileCoverage& $f) : string => $f->file);
        return $out;
    }

    /**
     * Totals over every reported file.
     */
    public const function totals(const array<FileCoverage>& $files) : array<Ratio>
    {
        Ratio $lines = Ratio(0, 0);
        Ratio $branches = Ratio(0, 0);
        Ratio $functions = Ratio(0, 0);

        foreach ($files as const &$file) {
            Ratio $l = $file->lineTotals();
            Ratio $b = $file->branchTotals();
            Ratio $f = $file->functionTotals();
            $lines->hit = $lines->hit + $l->hit;
            $lines->total = $lines->total + $l->total;
            $branches->hit = $branches->hit + $b->hit;
            $branches->total = $branches->total + $b->total;
            $functions->hit = $functions->hit + $f->hit;
            $functions->total = $functions->total + $f->total;
        }

        return [$lines, $branches, $functions];
    }

    /**
     * The ids of the tests that ran any counter on `$line` of a file whose path ends with `$file`.
     */
    public const function testsAt(const string& $file, int64 $line) : array<string>
    {
        array<string> $out = [];

        foreach ($this->tests as const &$test) {
            bool $hit = false;

            foreach ($this->map->modules as const &$module) {
                array<uint32> $counts = $test->of($module->name);

                for (usize $i = 0; $i < $module->sites->count() && $i < $counts->count(); $i++) {
                    CoverageSite $site = $module->sites[$i];
                    if ($site->line == $line && $counts[$i] > 0 && Coverage::sameFile($site->file, $file)) {
                        $hit = true;
                        break;
                    }
                }

                if ($hit) {
                    break;
                }
            }

            if ($hit) {
                bool $seen = false;
                foreach ($out as const &$id) {
                    if ($id == $test->testId) {
                        $seen = true;
                    }
                }
                if (!$seen) {
                    $out[] = $test->testId;
                }
            }
        }

        $out->sort();
        return $out;
    }

    /**
     * True when the `fn` counter at `$file`:`$line` ran in any test.
     */
    public const function called(const string& $file, int64 $line) : bool?
    {
        bool? $found = null;

        foreach ($this->map->modules as const &$module) {
            array<uint64> $hits = $this->merged($module);

            for (usize $i = 0; $i < $module->sites->count(); $i++) {
                CoverageSite $site = $module->sites[$i];
                if ($site->kind == 'fn' && $site->line == $line && Coverage::sameFile($site->file, $file)) {
                    if ($hits[$i] > 0) {
                        return true;
                    }
                    $found = false;
                }
            }
        }

        return $found;
    }

    /**
     * True when two paths name the same file: equal, or one ends with the other at a `/`.
     */
    public static function sameFile(const string& $a, const string& $b) : bool
    {
        if ($a == $b) {
            return true;
        }

        if ($a->size() > $b->size()) {
            return $a->ends($b) && $a->byte($a->size() - $b->size() - 1) == 47;
        }

        if ($b->size() > $a->size()) {
            return $b->ends($a) && $b->byte($b->size() - $a->size() - 1) == 47;
        }

        return false;
    }
}
