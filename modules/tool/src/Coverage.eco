namespace ecotest::cli;

use ecotest::paths;

/**
 * The coverage of a run: echoc's map plus every test's counts, from every pass, merged once.
 * Answers per file totals, which tests ran a line, and whether a function was ever called. Files
 * are known by their absolute path, so two modules with a `src/a.eco` each never mix.
 */
public class Coverage
{
    public const CoverageMap $map;

    /**
     * Each module's counts summed over every test, by the counters' `local` index.
     */
    private map<string, array<uint64>> $merged = [];

    /**
     * The tests that ran any counter on a line, by `Coverage::spot`.
     */
    private map<string, array<string>> $byLine = [];

    /**
     * Whether the function counter on a line ran in any test, by `Coverage::spot`.
     */
    private map<string, bool> $fnAt = [];

    /**
     * The lines of the function counters named `name` in a file, by `Coverage::spot` of the path
     * and the name. A type's constructors are found this way: echoc's declarations place them on
     * the type's line, their counters sit on their bodies.
     */
    private map<string, array<int64>> $fnNamed = [];

    /**
     * Each module's directory with its links resolved, by name, so its files compare equal to the
     * same files reached any other way (`/var` and `/private/var` on macOS).
     */
    private map<string, string> $dirs = [];

    public constructor(CoverageMap $map)
    {
        foreach ($map->modules as const &$module) {
            $this->dirs->set($module->name, std::io::realpath($module->dir)->or($module->dir));
        }

        foreach ($map->modules as const &$module) {
            $zero = arr::room<uint64>($module->sites->count());
            for (usize $i = 0; $i < $module->sites->count(); $i++) {
                $zero[] = 0;
            }
            $this->merged->set($module->name, mv $zero);

            foreach ($module->sites as const &$site) {
                if ($site->kind != 'fn') {
                    continue;
                }
                $path = $this->where($module, $site);
                $this->fnAt->set(Coverage::spot($path, $site->line), false);

                $named = Coverage::spot($path, 0);
                $named->append($site->function);
                if (!$this->fnNamed->has($named)) {
                    array<int64> $none = [];
                    $this->fnNamed->set($named, $none);
                }
                array<int64>& $lines = $this->fnNamed->at($named);
                if ($lines->empty() || $lines[$lines->count() - 1] != $site->line) {
                    $lines[] = $site->line;
                }
            }
        }
        $this->map = mv $map;
    }

    /**
     * The key of `$line` of the file at `$path`.
     */
    private static function spot(const string& $path, int64 $line) : string
    {
        return "{$path}\n{$line}";
    }

    /**
     * The absolute path of `$site`'s file in `$module`.
     */
    public const function where(const ModuleSites& $module, const CoverageSite& $site) : string
    {
        return paths::resolve($this->dirs->get($module->name), $site->file);
    }

    /**
     * The absolute path of `$file` in the module named `$module`, or null when the map has no such
     * module.
     */
    public const function path(const string& $module, const string& $file) : string?
    {
        if (!$this->dirs->has($module)) {
            return null;
        }
        return paths::resolve($this->dirs->get($module), $file);
    }

    /**
     * The directories of the modules `$scope` reports, links resolved.
     */
    public const function dirsOf(const Scope& $scope) : array<string>
    {
        array<string> $out = [];
        foreach ($this->dirs as $name => const &$dir) {
            if ($scope->reports($name)) {
                $out[] = $dir;
            }
        }
        return $out;
    }

    /**
     * The coverage stored in run directory `$dir`, or null when no pass recorded any, or why it
     * cannot be read. A counter file joins its test by its name, the test id's file-name form.
     */
    public static function load(const string& $dir, const Run& $run) : result<Coverage?, CoverageError>
    {
        Coverage? $found = null;
        string $firstMap = '';

        foreach ($run->passes as const &$pass) {
            $covDir = std::env::join($pass->dir, 'coverage');
            $mapPath = std::env::join($covDir, 'map.json');
            if (!std::io::exists($mapPath)->or(false)) {
                continue;
            }

            $map = guard CoverageMap::load($mapPath) else ($e) {
                return .error(.map($e));
            };

            if ($found == null) {
                $firstMap = $mapPath;
                $found = Coverage(mv $map);
            } else {
                CoverageMap $other = mv $map;
                $into = guard $found;
                if ($other->hash != $into->map->hash) {
                    return .error(.mixedBuilds($firstMap, $mapPath));
                }
            }

            Coverage $into = guard $found;
            guard $into->absorb(std::env::join($covDir, 'tests'), $run) else ($e) {
                return .error($e);
            };
        }

        return .ok($found);
    }

    /**
     * Adds every `.ecocov` file in `$dir`, each joined to its test in `$run`. A file that cannot
     * be read is left out, as a test killed mid-write leaves one; one of another build is refused.
     */
    public function absorb(const string& $dir, const Run& $run) : status<CoverageError>
    {
        $listing = guard std::io::opendir($dir) else {
            return .ok;
        };

        array<string> $paths = [];
        foreach ($listing as const &$entry) {
            if ($entry->name()->ends('.ecocov')) {
                $paths[] = $entry->path();
            }
        }
        $listing->close();
        $paths->sort();

        foreach ($paths as const &$path) {
            $loaded = guard CounterFile::load($path) else {
                continue;
            };

            // the header holds at most 128 bytes of the id; the file name holds all of it
            $key = paths::stem($path);
            string $id = $run->keyed($key)?->id ?? $loaded->testId;

            guard $this->add($id, $loaded, $path) else ($e) {
                return .error($e);
            };
        }

        return .ok;
    }

    /**
     * Adds the counts of test `$id`, read from `$path`.
     */
    public function add(const string& $id, const CounterFile& $counts, const string& $path) : status<CoverageError>
    {
        foreach ($this->map->modules as const &$module) {
            if (!$counts->counts->has($module->name)) {
                continue;
            }

            const array<uint32>& $mine = $counts->counts->at($module->name);
            if ($mine->count() != $module->sites->count()) {
                return .error(.foreign($path, $module->name, $module->sites->count(), $mine->count()));
            }

            array<uint64>& $sum = $this->merged->at($module->name);
            foreach ($module->sites as const &$site) {
                uint32 $n = $mine[$site->local];
                if ($n == 0) {
                    continue;
                }

                $sum[$site->local] = $sum[$site->local] + ($n as uint64);
                $key = Coverage::spot($this->where($module, $site), $site->line);

                if ($site->kind == 'fn') {
                    $this->fnAt->set($key, true);
                }

                if (!$this->byLine->has($key)) {
                    array<string> $none = [];
                    $this->byLine->set($key, $none);
                }
                array<string>& $ids = $this->byLine->at($key);
                if ($ids->empty() || $ids[$ids->count() - 1] != $id) {
                    $ids[] = $id;
                }
            }
        }

        return .ok;
    }

    /**
     * Coverage per file of the modules `$scope` reports, sorted by module and path.
     */
    public const function files(const Scope& $scope) : array<FileCoverage>
    {
        array<FileCoverage> $out = [];
        map<string, usize> $at = [];

        // a generic body is counted once per instance; the source has one branch and one function
        // there, so counters at the same position merge, and either instance running counts
        map<Spot, usize> $edgeAt = [];
        map<Spot, usize> $functionAt = [];

        foreach ($this->map->modules as const &$module) {
            if (!$scope->reports($module->name)) {
                continue;
            }

            const array<uint64>& $hits = $this->merged->at($module->name);

            foreach ($module->sites as const &$site) {
                if ($scope->excluded($site->file)) {
                    continue;
                }

                $path = $this->where($module, $site);
                if (!$at->has($path)) {
                    $at->set($path, $out->count());
                    $out[] = FileCoverage($module->name, $site->file, $path);
                }

                FileCoverage& $file = $out[$at->get($path)];
                uint64 $count = $hits[$site->local];

                if ($site->kind == 'line') {
                    if (!$file->lines->has($site->line) || $count > $file->lines->get($site->line)) {
                        $file->lines->set($site->line, $count);
                    }
                } else if ($site->kind == 'branch') {
                    $spot = Spot($path, $site->line, $site->column, $site->edge);
                    if ($edgeAt->has($spot)) {
                        BranchSite& $branch = $file->branches[$edgeAt->get($spot)];
                        $branch->hits = $branch->hits + $count;
                    } else {
                        $edgeAt->set($spot, $file->branches->count());
                        $file->branches[] = BranchSite($site->line, $site->edge, $count);
                    }
                } else if ($site->kind == 'fn') {
                    $spot = Spot($path, $site->line, $site->column, '');
                    if ($functionAt->has($spot)) {
                        FunctionSite& $function = $file->functions[$functionAt->get($spot)];
                        $function->hits = $function->hits + $count;
                    } else {
                        $functionAt->set($spot, $file->functions->count());
                        $file->functions[] = FunctionSite($site->function, $site->line, $site->column, $count);
                    }
                }
            }
        }

        $out->sort(key: (const FileCoverage& $f) : string => "{$f->module}\n{$f->file}");
        return $out;
    }

    /**
     * Totals over every file of `$files`.
     */
    public static function totals(const array<FileCoverage>& $files) : Totals
    {
        $t = Totals();

        foreach ($files as const &$file) {
            $l = $file->lineTotals();
            $b = $file->branchTotals();
            $f = $file->functionTotals();
            $t->lines->hit = $t->lines->hit + $l->hit;
            $t->lines->total = $t->lines->total + $l->total;
            $t->branches->hit = $t->branches->hit + $b->hit;
            $t->branches->total = $t->branches->total + $b->total;
            $t->functions->hit = $t->functions->hit + $f->hit;
            $t->functions->total = $t->functions->total + $f->total;
        }

        return $t;
    }

    /**
     * True when the map has counters in the file at the absolute `$path`.
     */
    public const function knows(const string& $path) : bool
    {
        foreach ($this->map->modules as const &$module) {
            foreach ($module->sites as const &$site) {
                if ($this->where($module, $site) == $path) {
                    return true;
                }
            }
        }
        return false;
    }

    /**
     * The ids of the tests that ran any counter on `$line` of the file at the absolute `$path`,
     * sorted.
     */
    public const function testsAt(const string& $path, int64 $line) : array<string>
    {
        $key = Coverage::spot($path, $line);
        if (!$this->byLine->has($key)) {
            array<string> $none = [];
            return $none;
        }

        array<string> $out = [];
        map<string, bool> $named = [];
        foreach ($this->byLine->at($key) as const &$id) {
            if (!$named->has($id)) {
                $named->set($id, true);
                $out[] = $id;
            }
        }
        $out->sort();
        return $out;
    }

    /**
     * The lines of the function counters named `$name` in the file at the absolute `$path`.
     */
    public const function functionsNamed(const string& $path, const string& $name) : array<int64>
    {
        $key = Coverage::spot($path, 0);
        $key->append($name);
        if (!$this->fnNamed->has($key)) {
            array<int64> $none = [];
            return $none;
        }
        return $this->fnNamed->get($key);
    }

    /**
     * Whether the function counter on `$line` of the file at the absolute `$path` ran in any test,
     * or null when there is no function counter there.
     */
    public const function called(const string& $path, int64 $line) : bool?
    {
        $key = Coverage::spot($path, $line);
        if (!$this->fnAt->has($key)) {
            return null;
        }
        return $this->fnAt->get($key);
    }
}
