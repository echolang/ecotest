namespace ecotest::cli;

/**
 * How much of a change ran: not asked for, measured, or asked for and not measurable, with why.
 */
public enum DiffMeasure
{
    case off;
    case measured(Ratio $ratio);
    case unmeasured(string $why);
}

/**
 * The thresholds a run must meet. A null bound is off. A bound that is set and cannot be measured
 * fails: a gate nobody could check is not a gate that held.
 */
public struct Gates
{
    public float64? $minLines = null;
    public float64? $minBranches = null;
    public float64? $minDiff = null;
    public int64? $maxFlaky = null;

    /**
     * The verdict on `$run`, with every failed gate as a line. `$totals` is the coverage, null when
     * none was measured, with `$why` saying why; `$diff` the diff coverage.
     */
    public const function check(const Run& $run, Totals? $totals, const string& $why, const DiffMeasure& $diff) : Verdict
    {
        array<string> $failed = [];

        $t = $totals ?? Totals();
        Gates::hold($failed, 'line', $t->lines, $this->minLines, $totals != null, $why);
        Gates::hold($failed, 'branch', $t->branches, $this->minBranches, $totals != null, $why);

        match ($diff) {
            .off => {
                if ($this->minDiff != null) {
                    $failed[] = 'diff coverage not measured: no --since';
                }
            },
            .measured($r) => {
                // a change without code has no lines to fall short of
                if ($r->total > 0) {
                    Gates::hold($failed, 'diff', $r, $this->minDiff, true, '');
                }
            },
            .unmeasured($reason) => {
                if ($this->minDiff != null) {
                    $failed[] = "diff coverage not measured: {$reason}";
                }
            },
        };

        Gates::allow($failed, $run->counts()->flaky as int64, $this->maxFlaky);

        return Verdict(on: $run, gates: $this, failed: $failed);
    }

    /**
     * True when `$r` falls short of the bound `$min`. Without a bound nothing does; without
     * anything to measure, everything does.
     */
    public static function below(const Ratio& $r, float64? $min) : bool
    {
        $bound = guard $min else {
            return false;
        };
        $got = guard $r->percent() else {
            return true;
        };
        return $got < $bound;
    }

    /**
     * Adds the line for the `$what` coverage `$r` to `$failed` when it falls short of `$min`, or
     * when `$min` is set and nothing was `$measured`, for the reason `$why`.
     */
    private static function hold(
        array<string>& $failed,
        const string& $what,
        const Ratio& $r,
        float64? $min,
        bool $measured,
        const string& $why
    ) : void {
        $bound = guard $min else {
            return;
        };

        if (!$measured) {
            $failed[] = "{$what} coverage not measured: {$why}";
            return;
        }

        $got = guard $r->percent() else {
            $failed[] = "{$what} coverage not measured: nothing in scope";
            return;
        };

        if ($got < $bound) {
            $failed[] = "{$what} coverage {$got:.1f}% is below {$bound:.1f}%";
        }
    }

    /**
     * Adds the line for `$flaky` flaky tests to `$failed` when there are more than `$max`.
     */
    private static function allow(array<string>& $failed, int64 $flaky, int64? $max) : void
    {
        $most = guard $max else {
            return;
        };

        if ($flaky > $most) {
            $failed[] = "{$flaky} flaky tests, at most {$most} allowed";
        }
    }
}
