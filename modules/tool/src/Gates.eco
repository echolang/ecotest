namespace ecotest::cli;

/**
 * The thresholds a run must meet. A null bound is off.
 */
public struct Gates
{
    public float64? $minLines = null;
    public float64? $minBranches = null;
    public float64? $minDiff = null;
    public int64? $maxFlaky = null;

    /**
     * The verdict on `$run`, with every failed gate as a line. `$totals` is the coverage and `$diff`
     * the diff coverage, each null when none was measured.
     */
    public const function check(const Run& $run, Totals? $totals, Ratio? $diff) : Verdict
    {
        array<string> $failed = [];

        $this->cover($failed, $totals);

        // no diff to measure has nothing to fall short of: a ratio over no lines reads as whole
        Gates::hold($failed, 'diff', $diff ?? Ratio(), $this->minDiff);

        Gates::allow($failed, $run->counts()->flaky as int64, $this->maxFlaky);

        return Verdict(on: $run, gates: $this, failed: $failed);
    }

    /**
     * Adds the lines for the line and branch coverage of `$totals` that fall short of their gates.
     * A run without coverage has none to fall short of.
     */
    private const function cover(array<string>& $failed, Totals? $totals) : void
    {
        $t = guard $totals else {
            return;
        };

        Gates::hold($failed, 'line', $t->lines, $this->minLines);
        Gates::hold($failed, 'branch', $t->branches, $this->minBranches);
    }

    /**
     * True when `$r` falls short of the bound `$min`. Without a bound nothing does.
     */
    public static function below(const Ratio& $r, float64? $min) : bool
    {
        $bound = guard $min else {
            return false;
        };
        return $r->percent() < $bound;
    }

    /**
     * Adds the line for the `$what` coverage `$r` to `$failed` when it falls short of `$min`.
     */
    private static function hold(array<string>& $failed, const string& $what, const Ratio& $r, float64? $min) : void
    {
        $bound = guard $min else {
            return;
        };

        $got = $r->percent();
        if ($got < $bound) {
            $failed[] = "{$what} coverage {$got:.1f}% is below {$bound:.1f}%";
        }
    }

    /**
     * Adds the line for `$flaky` flaky tests to `$failed` when there are more than `$max`.
     */
    private static function allow(array<string>& $failed, int64 $flaky, int64? $max) : void
    {
        $most = guard $max else {
            return;
        };

        if ($flaky > $most) {
            $failed[] = "{$flaky} flaky tests, at most {$most} allowed";
        }
    }
}
