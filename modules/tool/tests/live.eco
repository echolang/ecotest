/**
 * Watching a run live: the tail that follows echoc's files, the view that draws them, and real
 * runs of the sample module in pretty style, on a terminal and on a stream that cannot be redrawn.
 */

use ecotest::{expect, TempDir};
use ecotest::cli::{Tail, LiveView, Tool, Style, Doc, Run, Gates, Verdict, JsonReport, FileCoverage, Ratio};

internal function terminal() : command::CLIContext
{
    return command::CLIContext::buffer(command::TerminalCapabilities(true, true, 80, true));
}

internal function pipe() : command::CLIContext
{
    return command::CLIContext::buffer(command::TerminalCapabilities(false, false, 0, false));
}

internal function rows(const command::CLIContext& $ctx) : string
{
    string $out = '';
    foreach ($ctx->page->rows as const &$row) {
        $out->append($row);
        $out->append("\n");
    }
    return $out;
}

internal function passDir(const string& $events) : TempDir
{
    $dir = TempDir();
    bool $made = std::io::mkdir($dir->file('events'))->or(false);
    $dir->write('events/m_a.eco__adds.jsonl', $events);
    return $dir;
}

internal function everything(const command::CLIContext& $ctx) : string
{
    string $out = rows($ctx);
    $out->append($ctx->vt);
    return $out;
}

internal function pretty(Sample $sample, command::CLIContext $live) : Tool
{
    Tool $tool = $sample->tool();
    $tool->style = Style::pretty;
    $tool->live = $live;
    $tool->page = pipe();
    return $tool;
}

test a_tail_answers_whole_lines_as_they_are_written
{
    $dir = TempDir();
    Tail $tail = Tail($dir->file('grows.log'));

    expect($tail->take())->is('');

    $dir->write('grows.log', "one\ntw");
    expect($tail->take())->is("one\n");
    expect($tail->take())->is('');

    $dir->write('grows.log', "one\ntwo\nthree");
    expect($tail->take())->is("two\n");
}

test a_view_ignores_rows_before_it_began
{
    $ctx = pipe();
    LiveView $view = LiveView($ctx);

    $view->output("early\n");
    $view->row(expect(json::parse('{"type":"run","selected":1}'))->ok());
    $view->row(expect(json::parse('{"type":"test","id":"m/a.eco::t","status":"pass"}'))->ok());
    $view->row(expect(json::parse('{"type":"end"}'))->ok());
    $view->row(expect(json::parse('{"type":"other"}'))->ok());
    $view->end('nowhere');

    expect($ctx->page->rows)->empty();
}

test a_view_shows_the_compile_then_the_tests_on_a_pipe
{
    $ctx = pipe();
    LiveView $view = LiveView($ctx);

    $dir = passDir("{\"type\":\"checks\",\"count\":3}\n");
    $view->begin(2, 3, $dir->path);
    $view->output("compiling sample\n");
    $view->row(expect(json::parse('{"type":"test","id":"m/a.eco::early","status":"pass"}'))->ok());
    $view->row(expect(json::parse('{"type":"run","selected":3}'))->ok());
    $view->output("echoc listing\n");
    $view->row(expect(json::parse('{"type":"test","id":"m/a.eco::adds","module":"m","status":"pass","ms":3}'))->ok());
    $view->row(expect(json::parse('{"type":"test","id":"m/a.eco::stops","module":"m","status":"fail","failure":{"headline":"fatal error","file":"tests/a.eco","line":9,"message":"expected 2, got 1\\n  in row 3"}}'))->ok());
    $view->row(expect(json::parse('{"type":"test","id":"m/a.eco::hangs","module":"m","status":"timeout"}'))->ok());
    $view->row(expect(json::parse('{"type":"end"}'))->ok());

    expect(rows($ctx))
        ->has('compiling sample')
        ->lacks('echoc listing')
        ->has('compiled in')
        ->has('v a.eco > adds  3 ms - 3 assertions')
        ->has('x a.eco > stops')
        ->has('| tests/a.eco:9  fatal error: expected 2, got 1')
        ->lacks('in row 3')
        ->has('a.eco > hangs  timeout')
        ->has('1 passed - 2 failed - 3 assertions in');
}

test a_green_pass_settles_the_bar_and_a_cut_one_fails_it
{
    $ctx = terminal();
    LiveView $view = LiveView($ctx);

    $dir = passDir("{\"type\":\"checks\",\"count\":1}\n");
    $view->begin(1, 1, $dir->path);
    $view->row(expect(json::parse('{"type":"run","selected":1}'))->ok());
    $view->row(expect(json::parse('{"type":"test","id":"m/a.eco::adds","module":"m","status":"pass","ms":3}'))->ok());
    $view->row(expect(json::parse('{"type":"end"}'))->ok());
    $view->end('nowhere');
    expect($ctx->vt)->has('1 passed · 1 assertion in');

    $cut = terminal();
    LiveView $stopped = LiveView($cut);
    $stopped->begin(1, 1, 'nowhere');
    $stopped->row(expect(json::parse('{"type":"run","selected":2}'))->ok());
    $stopped->row(expect(json::parse('{"type":"test","id":"m/a.eco::adds","module":"m","status":"pass","ms":3}'))->ok());
    $stopped->end('nowhere');
    expect(rows($cut))->has('1 passed in')->lacks('assertion');
}

test a_pretty_run_draws_the_tests_live_and_keeps_echocs_log
{
    $sample = Sample();
    command::CLIContext $live = terminal();
    Tool $tool = pretty($sample, $live);
    $tool->forwarded = ['--define', 'BROKEN'];

    expect($tool->run())->is(1);

    expect(everything($live))->has('compiled in')->has('halves_wrongly')->has('crashes');
    expect(std::io::exists(std::env::join($sample->latest(), 'pass-1/echoc.log'))->or(false))->yes();
}

test a_pretty_run_on_a_pipe_writes_rows_and_names_each_pass
{
    $sample = Sample();
    command::CLIContext $live = pipe();
    Tool $tool = pretty($sample, $live);
    $tool->repeat = 2;

    expect($tool->run())->is(0);
    expect(rows($live))->has('pass 1 of 2')->has('pass 2 of 2')->has('math.eco > halves');
}

test a_watched_run_reports_what_reading_it_back_would
{
    $sample = Sample();
    Tool $tool = pretty($sample, pipe());
    $tool->repeat = 2;
    $tool->forwarded = ['--define', 'BROKEN'];
    expect($tool->run())->is(1);

    Run $back = Run::load($sample->latest());
    array<FileCoverage> $none = [];
    array<Ratio> $noTotals = [];
    json::Value $read = expect(json::parse(JsonReport::render($back, $none, $noTotals, Verdict::of($back, Gates(), []))))->ok();
    json::Value $watched = $sample->runJson();

    expect(Doc::number($watched, 'passes'))->is(2);
    expect(Doc::number($watched, 'ms'))->is(Doc::number($read, 'ms'));
    expect(json::pretty(Doc::object($watched, 'counts')))->is(json::pretty(Doc::object($read, 'counts')));
    array<json::Value> $tests = Doc::list($watched, 'tests');
    array<json::Value> $readTests = Doc::list($read, 'tests');
    expect($tests->empty())->no();
    expect($tests->count())->is($readTests->count());
    for (usize $i = 0; $i < $tests->count(); $i++) {
        expect(json::pretty($tests[$i]))->is(json::pretty($readTests[$i]));
    }
}

test a_compile_error_fails_the_spinner_and_prints_echocs_log
{
    $sample = Sample();
    $sample->dir->write('src/math.eco', 'public function add(int64 $a, int64 $b) : int64
{
    return $a + nope;
}
');
    command::CLIContext $live = pipe();

    expect(pretty($sample, $live)->run())->is(1);
    expect(rows($live))->has('echoc stopped before any test ran')->has('nope');
}

test a_run_directory_that_cannot_be_written_fails_a_pretty_run
{
    $sample = Sample();
    string $root = $sample->dir->file('.ecotest');
    bool $made = std::io::mkdir($root)->or(false);
    expect(ecotest::run('chmod', ['555', $root]))->succeeds();

    int32 $code = pretty($sample, pipe())->run();
    expect(ecotest::run('chmod', ['755', $root]))->succeeds();
    expect($code)->is(1);
}

test a_compiler_that_cannot_start_fails_a_pretty_run
{
    $sample = Sample();
    Tool $tool = pretty($sample, pipe());
    $tool->echoc = '/nonexistent/echoc';

    expect($tool->run())->is(1);
}

test auto_watches_a_terminal_and_leaves_a_pipe_to_echoc
{
    $sample = Sample();
    command::CLIContext $live = pipe();
    Tool $tool = $sample->tool();
    $tool->style = Style::auto;
    $tool->live = $live;
    $tool->page = terminal();

    expect($tool->run())->is(0);
    expect($live->page->rows)->empty();
    expect($tool->report(''))->is(0);
}
