/**
 * Watching a run live: the tail that follows echoc's files, the view that draws them, and real
 * runs of the sample module in pretty style, on a terminal and on a stream that cannot be redrawn.
 */

use ecotest::{expect, paths, TempDir};
use ecotest::cli::{Tail, LiveView, Tool, Runner, Invocation, doc, Run, Gates, Verdict, runjson};

internal function terminal() : command::CLIContext
{
    return command::CLIContext::buffer(command::TerminalCapabilities(true, true, 80, true));
}

internal function pipe() : command::CLIContext
{
    return command::CLIContext::buffer(command::TerminalCapabilities(false, false, 0, false));
}

internal function rows(const command::CLIContext& $ctx) : string
{
    $out = '';
    foreach ($ctx->page->rows as const &$row) {
        $out->append($row);
        $out->append('\n');
    }
    return $out;
}

internal function passDir(const string& $events) : TempDir
{
    $dir = TempDir();
    guard std::io::mkdir($dir->file('events'));
    $dir->write('events/m_a.eco__adds.jsonl', $events);
    return $dir;
}

/**
 * One of echoc's report rows, parsed from `$text`.
 */
internal function parsed(const string& $text) : json::Value
{
    $row = guard json::parse($text);
    return $row;
}

/**
 * Folds the report row `$text` into `$run` and shows it to `$view`, as the runner does.
 */
internal function show(LiveView& $view, Run& $run, const string& $text) : void
{
    $row = parsed($text);
    $test = $run->fold($row);
    $view->take($row, $test);
    $view->advance();
}

internal function everything(const command::CLIContext& $ctx) : string
{
    $out = rows($ctx);
    $out->append($ctx->vt);
    return $out;
}

internal function pretty(Sample $sample, command::CLIContext $live) : Tool
{
    $tool = $sample->tool();
    $tool->style = .pretty;
    $tool->live = $live;
    $tool->page = pipe();
    return $tool;
}

test a_tail_answers_whole_lines_as_they_are_written
{
    $dir = TempDir();
    $tail = Tail($dir->file('grows.log'));

    expect($tail->take())->is('');

    $dir->write('grows.log', 'one\ntw');
    expect($tail->take())->is('one\n');
    expect($tail->take())->is('');

    $dir->write('grows.log', 'one\ntwo\nthree');
    expect($tail->take())->is('two\n');

    // once the writer is gone, a last line without its newline is still read
    expect($tail->rest())->is('three');
    expect($tail->rest())->is('');
}

test a_view_ignores_rows_before_it_began
{
    $ctx = pipe();
    $view = LiveView($ctx);

    $run = Run('/nowhere');
    $view->output('early\n');
    show($view, $run, '{"v":2,"type":"run","selected":1}');
    show($view, $run, '{"v":2,"type":"test","id":"m/a.eco::t","status":"pass"}');
    show($view, $run, '{"v":2,"type":"end"}');
    show($view, $run, '{"v":2,"type":"other"}');
    $view->end('nowhere');

    expect($ctx->page->rows)->empty();

    // a compile that stopped without a log still fails the spinner
    $quiet = pipe();
    $stopped = LiveView($quiet);
    $stopped->begin(1, 1);
    $stopped->end('nowhere');
    expect(rows($quiet))->has('echoc stopped before any test ran');
}

test a_view_shows_the_compile_then_the_tests_on_a_pipe
{
    $ctx = pipe();
    $view = LiveView($ctx);

    $dir = passDir('{"type":"checks","count":3}\n');
    $run = Run('/nowhere');
    $run->begin($dir->path);
    $view->begin(2, 3);
    $view->output('compiling sample\n');
    show($view, $run, '{"v":2,"type":"test","id":"m/a.eco::early","status":"pass"}');
    show($view, $run, '{"v":2,"type":"run","selected":3}');
    $view->output('echoc listing\n');
    show($view, $run, '{"v":2,"type":"test","id":"m/a.eco::adds","module":"m","status":"pass","ms":3}');
    show($view, $run, '{"v":2,"type":"test","id":"m/a.eco::stops","module":"m","status":"fail","failure":{"headline":"fatal error","file":"tests/a.eco","line":9,"message":"expected 2, got 1\\n  in row 3"}}');
    show($view, $run, '{"v":2,"type":"test","id":"m/a.eco::hangs","module":"m","status":"timeout"}');
    show($view, $run, '{"v":2,"type":"end"}');

    expect(rows($ctx))
        ->has('compiling sample')
        ->lacks('echoc listing')
        ->has('compiled in')
        ->has('v a.eco > adds  3 ms - 3 assertions')
        ->has('x a.eco > stops')
        ->has('| tests/a.eco:9  fatal error: expected 2, got 1')
        ->lacks('in row 3')
        ->has('a.eco > hangs  timeout')
        ->has('1 passed - 2 failed - 3 assertions in');
}

test a_green_pass_settles_the_bar_and_a_cut_one_fails_it
{
    $ctx = terminal();
    $view = LiveView($ctx);

    $dir = passDir('{"type":"checks","count":1}\n');
    $run = Run('/nowhere');
    $run->begin($dir->path);
    $view->begin(1, 1);
    show($view, $run, '{"v":2,"type":"run","selected":1}');
    show($view, $run, '{"v":2,"type":"test","id":"m/a.eco::adds","module":"m","status":"pass","ms":3}');
    show($view, $run, '{"v":2,"type":"end"}');
    $view->end('nowhere');
    expect($ctx->vt)->has('1 passed · 1 assertion in');

    $cut = terminal();
    $stopped = LiveView($cut);
    $cutRun = Run('/nowhere');
    $cutRun->begin('/nowhere/pass-1');
    $stopped->begin(1, 1);
    show($stopped, $cutRun, '{"v":2,"type":"run","selected":2}');
    show($stopped, $cutRun, '{"v":2,"type":"test","id":"m/a.eco::adds","module":"m","status":"pass","ms":3}');
    $stopped->end('nowhere');
    expect(rows($cut))->has('1 passed in')->lacks('assertion');
}

test a_pretty_run_draws_the_tests_live_and_keeps_echocs_log
{
    $sample = Sample();
    $live = terminal();
    $tool = pretty($sample, $live);
    $tool->echoc->forwarded = ['--define', 'BROKEN'];

    expect($tool->run())->is(1);

    expect(everything($live))->has('compiled in')->has('halves_wrongly')->has('crashes');
    expect(std::io::exists(std::env::join($sample->latest(), 'pass-1/echoc.log'))->or(false))->yes();
}

test a_pretty_run_on_a_pipe_writes_rows_and_names_each_pass
{
    $sample = Sample();
    $live = pipe();
    $tool = pretty($sample, $live);
    $tool->echoc->repeat = 2;

    expect($tool->run())->is(0);
    expect(rows($live))->has('pass 1 of 2')->has('pass 2 of 2')->has('math.eco > halves');
}

test a_watched_run_reports_what_reading_it_back_would
{
    $sample = Sample();
    $tool = pretty($sample, pipe());
    $tool->echoc->repeat = 2;
    $tool->echoc->forwarded = ['--define', 'BROKEN'];
    expect($tool->run())->is(1);

    $back = Run(readFrom: $sample->latest());
    $read = parsed(runjson::render($back, [], null, Verdict(on: $back, gates: Gates(), failed: [])));
    $watched = $sample->runJson();

    expect(doc::number($watched, 'passes'))->is(2);
    expect(doc::number($watched, 'ms'))->is(doc::number($read, 'ms'));
    expect(json::pretty(doc::object($watched, 'counts')))->is(json::pretty(doc::object($read, 'counts')));
    $tests = doc::list($watched, 'tests');
    $readTests = doc::list($read, 'tests');
    expect($tests->empty())->no();
    expect($tests->count())->is($readTests->count());
    for (usize $i = 0; $i < $tests->count(); $i++) {
        expect(json::pretty($tests[$i]))->is(json::pretty($readTests[$i]));
    }
}

test a_compile_error_fails_the_spinner_and_prints_echocs_log
{
    $sample = Sample();
    $sample->dir->write('src/math.eco', 'public function add(int64 $a, int64 $b) : int64
{
    return $a + nope;
}
');
    $live = pipe();

    expect(pretty($sample, $live)->run())->is(1);
    expect(rows($live))->has('echoc stopped before any test ran')->has('nope');
}

test a_run_directory_that_cannot_be_written_fails_a_pretty_run
{
    $sample = Sample();
    $root = $sample->dir->file('.ecotest');
    guard std::io::mkdir($root);
    expect(ecotest::run('chmod', ['555', $root]))->succeeds();

    int32 $code = pretty($sample, pipe())->run();
    expect(ecotest::run('chmod', ['755', $root]))->succeeds();
    expect($code)->is(1);

    // a pass directory that is there but closed keeps echoc's log out
    $dir = TempDir();
    $pass = $dir->file('run/pass-1');
    guard paths::mkdirs(std::env::join($pass, 'events'));
    expect(ecotest::run('chmod', ['555', $pass]))->succeeds();
    $echoc = Invocation();
    $echoc->project = $dir->path;
    $runner = Runner();
    $runner->view = LiveView(pipe());
    $into = Run($dir->file('run'));
    $ran = $runner->run($echoc, $dir->file('run'), $into);
    expect(ecotest::run('chmod', ['755', $pass]))->succeeds();
    $e = expect($ran)->fails();
    expect("{$e}")->is("cannot write {$pass}/echoc.log: Permission denied");
}

test a_compiler_that_cannot_start_fails_a_pretty_run
{
    $sample = Sample();
    $tool = pretty($sample, pipe());
    $tool->echoc->program = '/nonexistent/echoc';

    expect($tool->run())->is(1);
}

test auto_watches_a_terminal_and_leaves_a_pipe_to_echoc
{
    $sample = Sample();
    $live = pipe();
    $tool = $sample->tool();
    $tool->style = .auto;
    $tool->live = $live;
    $tool->page = terminal();

    expect($tool->run())->is(0);
    expect($live->page->rows)->empty();
    expect($tool->report(''))->is(0);
}
