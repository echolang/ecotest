/**
 * The small pieces on their own, with no run behind them: diffs, globs, paths, service variables,
 * ratios, outcomes, events folded into a run, titles, styles, the look and the slowest tests.
 */

use ecotest::{expect, paths, TempDir};
use ecotest::cli::{GitDiff, ChangedFile, glob, ServiceSpec, Readiness, Ratio, Outcome, Attempt, Fault, TestRecord, Run, Pass, PassExit, FileCoverage, Style, Look, digest, files};

test git_diff_hunks_keep_both_sides
{
    $text = 'diff --git a/src/a.eco b/src/a.eco\n--- a/src/a.eco\n+++ b/src/a.eco\n@@ -3,0 +4,2 @@ fn\n+x\n+y\n@@ -10 +12 @@\n-a\n+b\n@@ -20,2 +21,0 @@\n-c\n-d\n--- a/gone.eco\n+++ /dev/null\n@@ -1,2 +0,0 @@\n';
    $diff = GitDiff(parsing: $text, top: '/repo');

    expect($diff->files->count())->is(2);
    const ChangedFile& $a = $diff->files[0];
    expect($a->path)->is('/repo/src/a.eco');
    expect($a->relative)->is('src/a.eco');
    expect($a->newLines())->is([4, 5, 12, 21, 22]);
    expect($a->oldLines())->is([3, 4, 10, 20, 21]);

    const ChangedFile& $gone = $diff->files[1];
    expect($gone->deleted)->yes();
    expect($gone->relative)->is('gone.eco');
    expect($gone->oldLines())->is([1, 2]);
}

test quoted_git_paths_are_unquoted
{
    expect(GitDiff::unquote('"src/\\303\\244.eco"'))->is('src/ä.eco');
    expect(GitDiff::unquote('"a\\"b\\\\c\\td"'))->is("a\"b\\c\td");

    $diff = GitDiff(parsing: '--- "a/\\303\\244.eco"\n+++ "b/\\303\\244.eco"\n@@ -1 +1 @@\n', top: '/r');
    expect($diff->files[0]->relative)->is('ä.eco');
}

test a_digest_is_fnv1a_64
{
    expect(digest::fnv(''))->is('cbf29ce484222325');
    expect(digest::fnv('hello'))->is('a430d84680aabd0b');
}

test a_tree_is_removed_without_following_links
{
    $dir = TempDir();
    $keep = TempDir();
    $kept = $keep->write('keep.txt', 'x');
    guard std::io::mkdir($dir->file('a'));
    guard std::io::mkdir($dir->file('a/b'));
    $dir->write('a/b/c.txt', 'x');
    expect(ecotest::run('ln', ['-s', $keep->path, $dir->file('a/link')]))->succeeds();

    expect(paths::removeTree($dir->file('a')))->yes();
    expect(std::io::exists($dir->file('a'))->or(true))->no();
    expect(std::io::exists($kept)->or(false))->yes();
}

test a_sealed_file_is_written_whole
{
    $dir = TempDir();
    $path = $dir->write('run.json', 'old');
    expect(files::seal($path, 'new'))->fine();
    expect(expect($dir->read('run.json'))->ok())->is('new');
    expect(std::io::exists("{$path}.tmp")->or(true))->no();
}

test globs_match_inside_and_across_directories
{
    expect(glob::matches('examples/**', 'examples/a/b.eco'))->yes();
    expect(glob::matches('src/*.eco', 'src/a.eco'))->yes();
    expect(glob::matches('src/*.eco', 'src/x/a.eco'))->no();
    expect(glob::matches('**/gen/*.eco', 'src/gen/a.eco'))->yes();
    expect(glob::matches('**/gen/*.eco', 'gen/a.eco'))->yes();
}

test a_service_url_variable_is_upper_case
{
    $spec = ServiceSpec('my-api', [], .delay(0), '', []);
    expect($spec->variable())->is('ECOTEST_MY_API_URL');
}

test ratios_print_one_decimal
{
    $third = Ratio(1, 3);
    expect("{$third}")->is('33.3%');
    expect(Ratio()->percent())->none();
    $none = Ratio();
    expect("{$none}")->is('n/a');
}

test passes_that_disagree_are_flaky
{
    $t = TestRecord('m/a.eco::t');
    expect($t->key)->is('m_a.eco__t');
    $t->attempts = [Attempt(.pass, 0), Attempt(.fail, 0)];
    $t->settle();
    expect($t->outcome == Outcome::flaky)->yes();

    $s = TestRecord('m/a.eco::s');
    $s->attempts = [Attempt(.pass, 0)];
    $s->events->skipped = true;
    $s->events->skipReason = 'no db';
    $s->settle();
    expect($s->outcome == Outcome::skip)->yes();
}

test a_skip_without_a_reason_is_still_a_skip
{
    $t = TestRecord('m/a.eco::t');
    $t->attempts = [Attempt(.pass, 0)];
    $event = guard json::parse('{"v":1,"type":"skip","reason":""}');
    $t->events->apply($event);
    $t->settle();
    expect($t->outcome == Outcome::skip)->yes();
}

test a_flaky_test_keeps_the_fault_of_the_pass_that_broke
{
    $t = TestRecord('m/a.eco::t');
    $t->attempts = [Attempt(.fail, 0, Fault('expected 2, got 1', 'tests/a.eco', 9)), Attempt(.pass, 0)];
    $t->settle();

    expect($t->outcome == Outcome::flaky)->yes();
    expect(expect($t->fault())->some()->summary)->is('expected 2, got 1');
}

test events_of_another_version_are_left_out
{
    $t = TestRecord('m/a.eco::t');
    $foreign = guard json::parse('{"v":9,"type":"checks","count":3}');
    $t->events->apply($foreign);
    expect($t->events->foreign)->is(1);
    expect($t->events->checks)->is(0);
    expect($t->events->usedEcotest)->no();
}

test a_failure_that_names_its_values_inline_is_not_repeated
{
    $t = TestRecord('m/a.eco::t');
    $inline = guard json::parse('{"v":1,"type":"fail","summary":"expected 1, got 2","expected":"1","actual":"2","inline":true,"file":"a.eco","line":1}');
    $t->events->apply($inline);
    expect(expect($t->events->fault)->some()->detail)->is('');

    $u = TestRecord('m/a.eco::u');
    $apart = guard json::parse('{"v":1,"type":"fail","summary":"lists differ","expected":"[1]","actual":"[2]","file":"a.eco","line":1}');
    $u->events->apply($apart);
    expect(expect($u->events->fault)->some()->detail)->is("expected: [1]\n     got: [2]");
}

test a_pass_says_why_it_is_incomplete
{
    $p = Pass('/r/pass-1');
    expect(expect($p->stop())->some())->is('echoc stopped before the tests');

    $p->reached = true;
    $p->selected = 2;
    $p->rows = 1;
    expect(expect($p->stop())->some())->is('echoc ended after 1 of 2 tests without its end row');

    $p->ended = true;
    expect(expect($p->stop())->some())->is('echoc reported 1 of 2 tests');

    $p->rows = 2;
    $p->exit = PassExit(1, null);
    expect(expect($p->stop())->some())->is('echoc exited 1 although every test passed');

    $p->failing = true;
    expect($p->stop())->none();

    $p->exit = PassExit(null, 9);
    expect(expect($p->stop())->some())->is('echoc was stopped by signal 9');
}

test missed_lines_fold_into_ranges
{
    $f = FileCoverage('m', 'src/a.eco', '/x/src/a.eco');
    $f->lines->set(1, 1);
    $f->lines->set(2, 0);
    $f->lines->set(3, 0);
    $f->lines->set(5, 0);
    expect($f->missedRanges())->is('2-3, 5');
    expect($f->lineTotals()->hit)->is(1);
}

test a_run_folds_events_into_its_tests
{
    $run = Run('nowhere');
    $t = $run->find('m/a.eco::t');
    $doc = guard json::parse('{"type":"fail","summary":"expected 1, got 2","expected":"1","actual":"2","detail":"","context":["row 3"],"file":"tests/a.eco","line":7}');
    $t->events->apply($doc);

    $fault = expect($t->events->fault)->some();
    expect($fault->summary)->is('expected 1, got 2');
    expect($fault->line)->is(7);
    expect($fault->context)->is(['row 3']);
}

test a_later_pass_starts_from_a_clean_record
{
    $dir = TempDir();
    $run = Run($dir->path);
    guard std::io::mkdir($dir->file('one'));
    guard std::io::mkdir($dir->file('one/events'));
    guard std::io::mkdir($dir->file('two'));
    $dir->write('one/events/m_a.eco__t.jsonl', '{"type":"checks","count":5}\n{"type":"skip","reason":"no db"}\n{"type":"fail","summary":"no","file":"tests/a.eco","line":9}\n');

    $run->begin($dir->file('one'));
    $row = guard json::parse('{"v":2,"type":"test","id":"m/a.eco::t","module":"m","status":"pass"}');
    $first = $run->fold($row);
    expect($run->asserting())->is(1);
    expect($run->assertions())->is(5);

    $run->begin($dir->file('two'));
    $timeout = guard json::parse('{"v":2,"type":"test","id":"m/a.eco::t","module":"m","status":"timeout"}');
    $t = guard $run->fold($timeout);
    expect($run->asserting())->is(0);
    expect($run->assertions())->is(0);

    // nothing the first pass wrote describes the second
    expect($t->events->skipReason)->is('');
    expect($t->events->fault)->none();
    expect($t->events->checks)->is(0);
    expect($t->events->usedEcotest)->no();
    expect($t->attemptWords())->is('skip timeout');

    $run->settle();
    expect($t->outcome == Outcome::timeout)->yes();
    expect($run->green())->no();
}

test a_title_drops_the_module_unless_kept
{
    $short = titled('m/tests/a.eco::adds', 'm')->title(false);
    expect($short->suite)->is('tests/a.eco');
    expect($short->label)->is('adds');

    $kept = titled('m/tests/a.eco::adds', 'm')->title(true);
    expect($kept->suite)->is('m/tests/a.eco');
    expect($kept->label)->is('adds');

    $loose = titled('m/loose', 'm')->title(false);
    expect($loose->suite)->is('');
    expect($loose->label)->is('loose');
}

test styles_are_named_and_follow_the_stream_on_auto
{
    $tty = command::TerminalCapabilities(false, true, 80, true);
    $pipe = command::plain();
    $forced = command::TerminalCapabilities(true, false, 0, false);

    expect(Style::of('auto') == Style::auto)->yes();
    expect(Style::of('pretty') == Style::pretty)->yes();
    expect(Style::of('simple') == Style::simple)->yes();
    expect(Style::of('fancy') == Style::auto)->yes();

    expect(Style::auto->live($tty))->yes();
    expect(Style::auto->live($pipe))->no();
    expect(Style::pretty->live($pipe))->yes();
    expect(Style::simple->live($tty))->no();
    expect(Style::auto->styled($tty))->yes();
    expect(Style::auto->styled($forced))->yes();
    expect(Style::auto->styled($pipe))->no();
    expect(Style::pretty->styled($pipe))->yes();
    expect(Style::simple->styled($forced))->no();
}

internal function titled(const string& $id, const string& $module) : TestRecord
{
    $t = TestRecord($id);
    $t->module = $module;
    return $t;
}

test a_look_titles_ids_and_fills_meters
{
    $ascii = Look(command::plain());
    expect($ascii->title(titled('m/tests/a.eco::adds', 'm')))->is('tests/a.eco > adds');
    expect($ascii->title(titled('other/a.eco::adds', 'm')))->is('other/a.eco > adds');
    expect($ascii->title(titled('loose', '')))->is('loose');
    expect($ascii->meter(50.0, 4))->is('##..');
    expect($ascii->meter(120.0, 4))->is('####');
    expect($ascii->mark(.timeout))->is('x');

    $tty = Look(command::TerminalCapabilities(true, true, 80, true));
    expect($tty->meter(10.0, 10))->has('\x1b[31m━\x1b[39m');
    expect($tty->mark(.flaky))->is('\x1b[33m~\x1b[39m');
}

test a_run_knows_its_slowest_tests_and_percentiles
{
    $run = Run('nowhere');
    expect($run->percentile(50))->is(0);

    foreach ([5, 1, 9] as const &$ms) {
        $t = $run->find("m/a.eco::t{$ms}");
        $t->attempts = [Attempt(.pass, $ms as int64)];
    }

    expect($run->percentile(50))->is(5);
    expect($run->percentile(95))->is(9);
    $top = $run->slowest(2);
    expect($top->count())->is(2);
    expect($top[0]->id)->is('m/a.eco::t9');
}
