use ecotest::expect;
use ecotest::cli::{GitDiff, Glob, Coverage, ServiceSpec, Ratio, Outcome, TestRecord, Run, FileCoverage, Style, Look};

test git_diff_hunks_become_changed_lines
{
    string $text = "diff --git a/src/a.eco b/src/a.eco\n--- a/src/a.eco\n+++ b/src/a.eco\n@@ -3,0 +4,2 @@ fn\n+x\n+y\n@@ -10 +12 @@\n-a\n+b\n+++ /dev/null\n";
    $diff = GitDiff::parse($text);

    expect($diff->files)->is(['src/a.eco']);
    expect($diff->lines[0])->is([4, 5, 12]);
}

test globs_match_inside_and_across_directories
{
    expect(Glob::matches('examples/**', 'examples/a/b.eco'))->yes();
    expect(Glob::matches('src/*.eco', 'src/a.eco'))->yes();
    expect(Glob::matches('src/*.eco', 'src/x/a.eco'))->no();
    expect(Glob::matches('**/gen/*.eco', 'src/gen/a.eco'))->yes();
    expect(Glob::matches('**/gen/*.eco', 'gen/a.eco'))->yes();
}

test paths_match_by_their_tail
{
    expect(Coverage::sameFile('src/date.eco', 'mylib/src/date.eco'))->yes();
    expect(Coverage::sameFile('src/date.eco', 'src/mydate.eco'))->no();
    expect(Coverage::sameFile('date.eco', 'src/date.eco'))->yes();
}

test a_service_url_variable_is_upper_case
{
    array<string> $none = [];
    $spec = ServiceSpec('my-api', $none, '', 0, 0, '', $none, $none);
    expect($spec->variable())->is('ECOTEST_MY_API_URL');
}

test ratios_print_one_decimal
{
    expect(Ratio(1, 3)->shown())->is('33.3%');
    expect(Ratio(0, 0)->percent())->is(100.0);
}

test passes_that_disagree_are_flaky
{
    $t = TestRecord('m/a.eco::t', 'm_a.eco__t');
    $t->attempts = [Outcome::pass, Outcome::fail];
    $t->settle();
    expect($t->outcome == Outcome::flaky)->yes();

    $s = TestRecord('m/a.eco::s', 'm_a.eco__s');
    $s->attempts = [Outcome::pass];
    $s->skipReason = 'no db';
    $s->settle();
    expect($s->outcome == Outcome::skip)->yes();
}

test missed_lines_fold_into_ranges
{
    $f = FileCoverage('m', 'src/a.eco', '/x/src/a.eco');
    $f->lines->set(1, 1);
    $f->lines->set(2, 0);
    $f->lines->set(3, 0);
    $f->lines->set(5, 0);
    expect($f->missedRanges())->is('2-3, 5');
    expect($f->lineTotals()->hit)->is(1);
}

test a_run_folds_events_into_its_tests
{
    $run = Run('nowhere');
    $t = $run->find('m/a.eco::t');
    $doc = guard json::parse('{"type":"fail","summary":"expected 1, got 2","expected":"1","actual":"2","detail":"","context":["row 3"],"file":"tests/a.eco","line":7}');
    $run->apply($t, $doc);

    expect($t->failure)->is('expected 1, got 2');
    expect($t->failureLine)->is(7);
    expect($t->context)->is(['row 3']);
}

test styles_are_named_and_follow_the_stream_on_auto
{
    command::TerminalCapabilities $tty = command::TerminalCapabilities(false, true, 80, true);
    command::TerminalCapabilities $pipe = command::plain();
    command::TerminalCapabilities $forced = command::TerminalCapabilities(true, false, 0, false);

    expect(Style::of('auto') == Style::auto)->yes();
    expect(Style::of('pretty') == Style::pretty)->yes();
    expect(Style::of('simple') == Style::simple)->yes();
    expect(Style::of('fancy') == Style::auto)->yes();

    expect(Style::auto->live($tty))->yes();
    expect(Style::auto->live($pipe))->no();
    expect(Style::pretty->live($pipe))->yes();
    expect(Style::simple->live($tty))->no();
    expect(Style::auto->styled($tty))->yes();
    expect(Style::auto->styled($forced))->yes();
    expect(Style::auto->styled($pipe))->no();
    expect(Style::pretty->styled($pipe))->yes();
    expect(Style::simple->styled($forced))->no();
}

internal function titled(const string& $id, const string& $module) : TestRecord
{
    TestRecord $t = TestRecord($id, TestRecord::key($id));
    $t->module = $module;
    return $t;
}

test a_look_titles_ids_and_fills_meters
{
    Look $ascii = Look(command::plain());
    expect($ascii->title(titled('m/tests/a.eco::adds', 'm')))->is('tests/a.eco > adds');
    expect($ascii->title(titled('other/a.eco::adds', 'm')))->is('other/a.eco > adds');
    expect($ascii->title(titled('loose', '')))->is('loose');
    expect($ascii->meter(50.0, 4))->is('##..');
    expect($ascii->meter(120.0, 4))->is('####');
    expect($ascii->mark(Outcome::timeout))->is('x');

    Look $tty = Look(command::TerminalCapabilities(true, true, 80, true));
    expect($tty->meter(10.0, 10))->has("\x1b[31m━\x1b[39m");
    expect($tty->mark(Outcome::flaky))->is("\x1b[33m~\x1b[39m");
}

test a_run_knows_its_slowest_tests_and_percentiles
{
    Run $run = Run('nowhere');
    expect($run->percentile(50))->is(0);

    foreach ([5, 1, 9] as const &$ms) {
        TestRecord $t = $run->find("m/a.eco::t{$ms}");
        $t->durations = [$ms as int64];
    }

    expect($run->percentile(50))->is(5);
    expect($run->percentile(95))->is(9);
    array<TestRecord> $top = $run->slowest(2);
    expect($top->count())->is(2);
    expect($top[0]->id)->is('m/a.eco::t9');
}
