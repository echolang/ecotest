use ecotest::{expect, TempDir};
use ecotest::cli::{Store, Tool, doc};

/**
 * A small module the tool is run against, written into a temp directory per test so runs never
 * share a build. Green by default; `--define BROKEN` adds a failing check and a plain crash,
 * `--define FLAKY` a test that fails on the second pass only.
 */
internal class Sample
{
    public TempDir $dir = TempDir();

    public constructor()
    {
        $root = Sample::ecotestRoot();

        $this->dir->write('module.eco', "#[module: \"sample\"]\n#[sources: \"src/*.eco\"]\n\n#[target: test] {\n    #[sources: \"tests/*.eco\"]\n    #[depends: \"{$root}\"]\n}\n");
        guard std::io::mkdir($this->dir->file('src'));
        guard std::io::mkdir($this->dir->file('tests'));

        $this->dir->write('src/math.eco', 'public function add(int64 $a, int64 $b) : int64
{
    return $a + $b;
}

public function halve(int64 $n) : int64
{
    if ($n < 0) {
        return 0;
    }

    return $n / 2;
}

public function unused() : int64
{
    return 7;
}
');

        $this->dir->write('tests/math.eco', 'use ecotest::expect;

test adds
{
    expect(add(2, 3))->is(5);
    ecotest::note(\'sums small numbers\');
    ecotest::metric(\'pairs\', 1);
}

test halves
{
    expect(halve(8))->is(4);
}

test benches
{
    ecotest::bench(\'add\', function() : void {
        int64 $n = add(1, 2);
    });
}

test checks_nothing
{
    int64 $n = add(1, 1);
}

test needs_a_database
{
    $url = ecotest::needs(env: \'SAMPLE_NEVER_SET\');
}

#[if: BROKEN]
test halves_wrongly
{
    $at = ecotest::context(\'case 3\');
    expect(halve(3))->is(2);
}

test crashes
{
    expect(1)->is(1);
    die(\'plain stop\');
}
#[end]

#[if: FLAKY]
test flips
{
    string $dir = string(std::env::var(\'ECOTEST_RUN_DIR\', \'\'));
    expect($dir->ends(\'pass-2\'))->no();
}
#[end]
');
    }

    /**
     * A tool pointed at this module, with its own build directory and the compiler under test.
     */
    public const function tool() : Tool
    {
        $tool = Tool();
        $tool->echoc->project = $this->dir->path;
        $tool->echoc->program = Sample::compiler();
        return $tool;
    }

    /**
     * The newest finished run directory of this module. The test fails when there is none.
     */
    public const function latest() : string
    {
        return expect(Store($this->dir->file('.ecotest'))->latest())->some();
    }

    /**
     * The newest run's `run.json`, parsed.
     */
    public const function runJson() : json::Value
    {
        $parsed = guard json::parse(expect(doc::read(std::env::join($this->latest(), 'run.json')))->some());
        return $parsed;
    }

    /**
     * The test called `$name` in the newest run's `run.json`, or JSON null.
     */
    public const function result(const string& $name) : json::Value
    {
        foreach (doc::list($this->runJson(), 'tests') as const &$test) {
            if (doc::text($test, 'name') == $name) {
                return $test;
            }
        }

        return json::nil();
    }

    /**
     * The echoc the outer run uses, which `ecotest` hands down as `ECHOC`.
     */
    public static function compiler() : string
    {
        return string(std::env::var('ECHOC', 'echoc'));
    }

    /**
     * The ecotest repository root, two levels above this module.
     */
    public static function ecotestRoot() : string
    {
        $here = std::env::cwd();
        return std::env::join(std::env::join($here, '..'), '..');
    }
}
