/**
 * The command line: flags reach the tool, and every command is dispatched.
 */

use ecotest::{expect, TempDir};
use ecotest::cli;

test version_and_help_answer_zero
{
    expect(cli::main(['ecotest', '--version']))->is(0);
    expect(cli::main(['ecotest', '--help']))->is(0);
}

test run_is_the_command_when_none_is_named
{
    expect(cli::defaulted(['ecotest']))->is(['ecotest', 'run']);
    expect(cli::defaulted(['ecotest', '--coverage', '--html']))->is(['ecotest', 'run', '--coverage', '--html']);
    expect(cli::defaulted(['ecotest', 'run', '--coverage']))->is(['ecotest', 'run', '--coverage']);
    expect(cli::defaulted(['ecotest', 'report', 'x']))->is(['ecotest', 'report', 'x']);
    expect(cli::defaulted(['ecotest', '--help']))->is(['ecotest', '--help']);
    expect(cli::defaulted(['ecotest', '-v']))->is(['ecotest', '-v']);
}

test a_bad_command_line_answers_two
{
    expect(cli::main(['ecotest', 'run', '--no-such-flag']))->is(2);
    expect(cli::main(['ecotest', 'affected']))->is(2);
    expect(cli::main(['ecotest', '--no-such-flag']))->is(2);
    expect(cli::main(['ecotest', 'history', '--coverage']))->is(2);
}

test every_command_is_dispatched
{
    $empty = TempDir();

    expect(cli::main(['ecotest', 'report', '--project', $empty->path]))->is(1);
    expect(cli::main(['ecotest', 'report', 'nowhere', '--project', $empty->path, '--format', 'md']))->is(1);
    expect(cli::main(['ecotest', 'history', '--project', $empty->path]))->is(0);
    expect(cli::main(['ecotest', 'api', '--project', $empty->path]))->is(1);
    expect(cli::main(['ecotest', 'who', 'src/a.eco:1', '--project', $empty->path]))->is(1);
    expect(cli::main(['ecotest', 'affected', '--since', 'main', '--project', $empty->path]))->is(1);
}

test run_takes_every_flag
{
    $sample = Sample();

    int32 $code = cli::main([
        'ecotest', 'run',
        '--project', $sample->dir->path,
        '--echoc', Sample::compiler(),
        '--build-dir', $sample->dir->file('build'),
        '--coverage',
        '--html',
        '--repeat', '2',
        '--filter', 'adds',
        '--define', 'UNUSED',
        '--target', 'tests',
        '--timeout', '60000',
        '--coverage-module', 'sample',
        '--min-coverage', '1',
        '--min-branch-coverage', '0',
        '--max-flaky', '0',
        '--seed', '5',
        '--keep', '3',
    ]);

    expect($code)->is(0);
}

test the_style_is_a_word_the_command_line_knows
{
    $empty = TempDir();

    expect(cli::main(['ecotest', 'report', 'nowhere', '--project', $empty->path, '--style', 'pretty']))->is(1);
    expect(cli::main(['ecotest', 'report', 'nowhere', '--project', $empty->path, '--style', 'simple', '--color', 'never']))->is(1);
    expect(cli::main(['ecotest', 'run', '--style', 'fancy']))->is(2);
    expect(cli::main(['ecotest', 'report', '--format', 'bogus']))->is(2);
}

test numbers_and_refs_are_checked_when_parsed
{
    $empty = TempDir();
    foreach ([
        ['--repeat', '0'],
        ['--repeat', 'abc'],
        ['--keep', '0'],
        ['--timeout', 'soon'],
        ['--seed', '-1'],
        ['--min-coverage', 'abc'],
        ['--min-coverage', '101'],
        ['--min-branch-coverage', '-5'],
        ['--min-diff-coverage', 'x'],
        ['--max-flaky', '-1'],
        ['--max-flaky', '0'],
        ['--since', '--output=x'],
    ] as const &$flag) {
        array<string> $argv = ['ecotest', 'run', '--project', $empty->path];
        $argv[] = $flag[0];
        $argv[] = $flag[1];
        $c = ecotest::context("{$flag[0]} {$flag[1]}");
        expect(cli::main($argv))->is(2);
    }
}

test the_version_is_the_manifests
{
    // the tool ships inside ecotest's exe, so its manifest carries ecotest's version
    $v = ecotest::version();
    expect($v)->isNot('unknown');
    expect(expect(ecotest::cli::doc::read('module.eco'))->some())->has("#[version: \"{$v}\"]");
}
