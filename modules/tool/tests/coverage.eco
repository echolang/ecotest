/**
 * Coverage data built by hand: counter files good and broken, a map with two instances of one
 * generic body, excludes, and the queries over them.
 */

use ecotest::{expect, TempDir};
use ecotest::cli::{CounterFile, CoverageMap, Coverage, Run, Scope};

/**
 * Appends `$n` to `$out` as a little-endian `uint32`, the way counter files store every number.
 */
internal function le32(string& $out, usize $n) : void
{
    $out->push(($n % 256) as uint8);
    $out->push((($n / 256) % 256) as uint8);
    $out->push((($n / 65536) % 256) as uint8);
    $out->push((($n / 16777216) % 256) as uint8);
}

/**
 * An `.ecocov` file for `$id` with one module's counts.
 */
internal function counterFile(const string& $id, const string& $module, const array<usize>& $counts) : string
{
    $out = 'ECOCOV';
    $out->push(0);
    $out->push(0);
    le32($out,2);
    le32($out,1);
    for (usize $i = 0; $i < 8; $i++) {
        $out->push(0);
    }
    $out->append($id);
    while ($out->size() < 160) {
        $out->push(0);
    }

    le32($out,$module->size());
    le32($out,$counts->count());
    $out->append($module);
    while ($out->size() % 4 != 0) {
        $out->push(0);
    }
    foreach ($counts as const &$n) {
        le32($out,$n);
    }

    return $out;
}

/**
 * A map of module `m`: a function and its line run by one instance, the same branch counted by two
 * instances, a second counter on line 2, and a file excluded by pattern.
 */
internal function mapText() : string
{
    $out = '{"v":2,"hash":"h","modules":[{"name":"m","dir":"/p","counters":[';
    $out->append('{"local":0,"file":"src/a.eco","line":1,"column":1,"kind":"fn","function":"f"},');
    $out->append('{"local":1,"file":"src/a.eco","line":1,"column":1,"kind":"fn","function":"f"},');
    $out->append('{"local":2,"file":"src/a.eco","line":2,"column":5,"kind":"line","function":"f"},');
    $out->append('{"local":3,"file":"src/a.eco","line":2,"column":9,"kind":"line","function":"f"},');
    $out->append('{"local":4,"file":"src/a.eco","line":3,"column":5,"kind":"branch","edge":"then","function":"f"},');
    $out->append('{"local":5,"file":"src/a.eco","line":3,"column":5,"kind":"branch","edge":"then","function":"f"},');
    $out->append('{"local":6,"file":"gen/skip.eco","line":1,"column":1,"kind":"line","function":"g"},');
    $out->append('{"local":7,"file":"src/a.eco","line":4,"column":1,"kind":"region","function":"f"}');
    $out->append(']},{"name":"lib","dir":"/l","counters":[{"local":0,"file":"src/l.eco","line":1,"column":1,"kind":"line","function":"l"}]}]}');
    return $out;
}

test a_counter_file_is_read_or_refused
{
    $dir = TempDir();
    array<usize> $counts = [3, 0, 1];
    $good = $dir->write('good.ecocov', counterFile('m/t.eco::one', 'm', $counts));

    $file = expect(CounterFile::load($good))->ok();
    expect($file->testId)->is('m/t.eco::one');
    expect($file->counts->keys())->is(['m']);
    expect($file->counts->at('m')->count())->is(3);
    expect($file->counts->has('other'))->no();

    $bytes = counterFile('m/t.eco::one', 'm', $counts);
    $short = expect(CounterFile::load($dir->write('short.ecocov', $bytes->sub(0, 100))))->fails();
    expect("{$short}")->is("{$dir->file('short.ecocov')} is not a version 2 counter file");
    $version = $bytes->sub(0, 8);
    le32($version, 1);
    $version->append($bytes->sub(12, $bytes->size() - 12));
    $old = expect(CounterFile::load($dir->write('old.ecocov', $version)))->fails();
    expect("{$old}")->has('is not a version 2 counter file');
    $headless = expect(CounterFile::load($dir->write('headless.ecocov', $bytes->sub(0, 164))))->fails();
    expect("{$headless}")->is("{$dir->file('headless.ecocov')} ends before the counts it promises");
    $cut = expect(CounterFile::load($dir->write('cut.ecocov', $bytes->sub(0, $bytes->size() - 2))))->fails();
    expect("{$cut}")->has('ends before the counts it promises');
    $missing = expect(CounterFile::load($dir->file('missing.ecocov')))->fails();
    expect("{$missing}")->is("cannot read {$dir->file('missing.ecocov')}: No such file or directory");
}

test a_map_that_does_not_parse_says_so_and_modules_are_found_by_name
{
    $dir = TempDir();
    $bad = expect(CoverageMap::load($dir->write('bad.json', '{')))->fails();
    expect("{$bad}")->has("{$dir->file('bad.json')} does not parse: ");
    $missing = expect(CoverageMap::load($dir->file('missing.json')))->fails();
    expect("{$missing}")->is("cannot read {$dir->file('missing.json')}: No such file or directory");

    $map = expect(CoverageMap::load($dir->write('map.json', mapText())))->ok();
    expect(expect($map->module('lib'))->some()->dir)->is('/l');
    expect($map->module('nowhere'))->none();
}

/**
 * The scope that reports module `m` and leaves out `gen/`.
 */
internal function scopeOfM() : Scope
{
    $s = Scope();
    $s->modules->set('m', true);
    $s->exclude = ['gen/**'];
    return $s;
}

/**
 * The counts in `$bytes`, written to `$name` in `$dir`, read back.
 */
internal function counted(const TempDir& $dir, const string& $name, const string& $bytes) : CounterFile
{
    return expect(CounterFile::load($dir->write($name, $bytes)))->ok();
}

test instances_of_one_body_merge_into_one_function_line_and_edge
{
    $dir = TempDir();
    $map = expect(CoverageMap::load($dir->write('map.json', mapText())))->ok();

    $c = Coverage($map);
    expect($c->add('m/t.eco::a', counted($dir, 'a.ecocov', counterFile('m/t.eco::a', 'm', [0, 2, 0, 1, 0, 1, 0, 0])), 'a.ecocov'))->fine();
    expect($c->add('m/t.eco::b', counted($dir, 'b.ecocov', counterFile('m/t.eco::b', 'm', [0, 1, 0, 1, 0, 0, 0, 0])), 'b.ecocov'))->fine();

    $files = $c->files(scopeOfM());
    expect($files->count())->is(1);
    expect($files[0]->file)->is('src/a.eco');
    expect($files[0]->path)->is('/p/src/a.eco');
    expect($files[0]->functionTotals()->total)->is(1);
    expect($files[0]->functionTotals()->hit)->is(1);
    expect($files[0]->lineTotals()->hit)->is(1);
    expect($files[0]->branchTotals()->total)->is(1);
    expect($files[0]->branchTotals()->hit)->is(1);

    expect($c->testsAt('/p/src/a.eco', 2))->is(['m/t.eco::a', 'm/t.eco::b']);
    expect($c->testsAt('/p/src/a.eco', 9))->empty();
    expect($c->testsAt('src/a.eco', 2))->empty();
    expect(expect($c->called('/p/src/a.eco', 1))->some())->yes();
    expect($c->called('/p/src/a.eco', 2))->none();
    expect($c->functionsNamed('/p/src/a.eco', 'f'))->is([1]);
    expect(scopeOfM()->excluded('gen/skip.eco'))->yes();
}

test counters_are_read_by_their_local_index
{
    $dir = TempDir();
    // the counters are listed backwards: count 0 belongs to the last one listed, on line 2
    $map = expect(CoverageMap::load($dir->write('map.json', '{"hash":"h","modules":[{"name":"m","dir":"/p","counters":[{"local":1,"file":"a.eco","line":1,"column":1,"kind":"line","function":"f"},{"local":0,"file":"a.eco","line":2,"column":1,"kind":"line","function":"f"}]}]}')))->ok();

    $c = Coverage($map);
    expect($c->add('m/t.eco::a', counted($dir, 'a.ecocov', counterFile('m/t.eco::a', 'm', [5, 0])), 'a.ecocov'))->fine();

    expect($c->testsAt('/p/a.eco', 2))->is(['m/t.eco::a']);
    expect($c->testsAt('/p/a.eco', 1))->empty();
}

test a_map_with_a_bad_local_index_is_refused
{
    $dir = TempDir();
    $twice = expect(CoverageMap::load($dir->write('map.json', '{"hash":"h","modules":[{"name":"m","dir":"/p","counters":[{"local":0,"file":"a.eco","line":1,"column":1,"kind":"line"},{"local":0,"file":"a.eco","line":2,"column":1,"kind":"line"}]}]}')))->fails();
    expect("{$twice}")->has('module m has a counter with the bad index 0');
}

test a_counter_file_of_another_build_is_foreign
{
    $dir = TempDir();
    $map = expect(CoverageMap::load($dir->write('map.json', mapText())))->ok();
    $c = Coverage($map);

    $e = expect($c->add('m/t.eco::a', counted($dir, 'a.ecocov', counterFile('m/t.eco::a', 'm', [1, 1, 1, 1, 1, 1, 1])), 'a.ecocov'))->fails();
    expect("{$e}")->is('a.ecocov has 7 counts for m, whose map has 8: it is from another build');
}

test a_test_counted_twice_is_named_once
{
    $dir = TempDir();
    $map = expect(CoverageMap::load($dir->write('map.json', mapText())))->ok();

    $c = Coverage($map);
    $one = counterFile('m/t.eco::a', 'm', [1, 1, 1, 1, 1, 1, 1, 1]);
    expect($c->add('m/t.eco::a', counted($dir, 'a.ecocov', $one), 'a.ecocov'))->fine();
    expect($c->add('m/t.eco::a', counted($dir, 'a2.ecocov', $one), 'a2.ecocov'))->fine();

    expect($c->testsAt('/p/src/a.eco', 2))->is(['m/t.eco::a']);

    $s = Scope();
    $s->modules->set('m', true);
    expect($c->files($s)->count())->is(2);
}

test files_of_two_modules_with_one_name_stay_apart
{
    $dir = TempDir();
    $map = expect(CoverageMap::load($dir->write('map.json', '{"hash":"h","modules":[{"name":"m","dir":"/p","counters":[{"local":0,"file":"src/a.eco","line":1,"column":1,"kind":"line"}]},{"name":"lib","dir":"/l","counters":[{"local":0,"file":"src/a.eco","line":1,"column":1,"kind":"line"}]}]}')))->ok();
    $c = Coverage($map);

    expect($c->add('m/t.eco::a', counted($dir, 'a.ecocov', counterFile('m/t.eco::a', 'm', [1])), 'a.ecocov'))->fine();
    expect($c->add('lib/t.eco::b', counted($dir, 'b.ecocov', counterFile('lib/t.eco::b', 'lib', [1])), 'b.ecocov'))->fine();

    expect($c->testsAt('/p/src/a.eco', 1))->is(['m/t.eco::a']);
    expect($c->testsAt('/l/src/a.eco', 1))->is(['lib/t.eco::b']);

    $s = Scope();
    $s->modules->set('m', true);
    $s->modules->set('lib', true);
    $files = $c->files($s);
    expect($files->count())->is(2);
    expect($files[0]->module)->is('lib');
    expect($files[1]->module)->is('m');
}

test a_folder_of_counter_files_skips_what_is_not_one
{
    $dir = TempDir();
    $map = expect(CoverageMap::load($dir->write('map.json', mapText())))->ok();
    $c = Coverage($map);

    $dir->write('notes.txt', 'x');
    $dir->write('broken.ecocov', 'x');
    $dir->write('m_t.eco__a.ecocov', counterFile('m/t.eco::a', 'm', [1, 1, 1, 1, 1, 1, 1, 1]));
    $run = Run('/nowhere');
    expect($c->absorb($dir->path, $run))->fine();
    expect($c->absorb($dir->file('missing'), $run))->fine();

    expect($c->testsAt('/p/src/a.eco', 2))->is(['m/t.eco::a']);
}

test a_long_test_id_is_joined_by_its_file_name
{
    $dir = TempDir();
    $map = expect(CoverageMap::load($dir->write('map.json', mapText())))->ok();
    $c = Coverage($map);

    // the header keeps only 128 bytes of an id; the run knows the whole of it
    $id = str::concat('m/t.eco::', str::repeat('long_', 40));
    $run = Run('/nowhere');
    $run->begin('/nowhere/pass-1');
    $record = $run->find($id);

    $dir->write("{$record->key}.ecocov", counterFile($id->sub(0, 120), 'm', [1, 1, 1, 1, 1, 1, 1, 1]));
    expect($c->absorb($dir->path, $run))->fine();

    expect($c->testsAt('/p/src/a.eco', 2))->is([$id]);
}
