/**
 * Coverage data built by hand: counter files good and broken, a map with two instances of one
 * generic body, excludes, and the queries over them.
 */

use ecotest::{expect, TempDir};
use ecotest::cli::{CounterFile, CoverageMap, Coverage, FileCoverage, Files};

internal function u32(string& $out, usize $n) : void
{
    $out->push(($n % 256) as uint8);
    $out->push((($n / 256) % 256) as uint8);
    $out->push((($n / 65536) % 256) as uint8);
    $out->push((($n / 16777216) % 256) as uint8);
}

/**
 * An `.ecocov` file for `$id` with one module's counts.
 */
internal function counterFile(const string& $id, const string& $module, const array<usize>& $counts) : string
{
    string $out = 'ECOCOV';
    $out->push(0);
    $out->push(0);
    u32($out, 2);
    u32($out, 1);
    for (usize $i = 0; $i < 8; $i++) {
        $out->push(0);
    }
    $out->append($id);
    while ($out->size() < 160) {
        $out->push(0);
    }

    u32($out, $module->size());
    u32($out, $counts->count());
    $out->append($module);
    while ($out->size() % 4 != 0) {
        $out->push(0);
    }
    foreach ($counts as const &$n) {
        u32($out, $n);
    }

    return $out;
}

/**
 * A map of module `m`: a function and its line run by one instance, the same branch counted by two
 * instances, a second counter on line 2, and a file excluded by pattern.
 */
internal function mapText() : string
{
    string $out = '{"v":2,"hash":"h","modules":[{"name":"m","dir":"/p","counters":[';
    $out->append('{"local":0,"file":"src/a.eco","line":1,"column":1,"kind":"fn","function":"f"},');
    $out->append('{"local":1,"file":"src/a.eco","line":1,"column":1,"kind":"fn","function":"f"},');
    $out->append('{"local":2,"file":"src/a.eco","line":2,"column":5,"kind":"line","function":"f"},');
    $out->append('{"local":3,"file":"src/a.eco","line":2,"column":9,"kind":"line","function":"f"},');
    $out->append('{"local":4,"file":"src/a.eco","line":3,"column":5,"kind":"branch","edge":"then","function":"f"},');
    $out->append('{"local":5,"file":"src/a.eco","line":3,"column":5,"kind":"branch","edge":"then","function":"f"},');
    $out->append('{"local":6,"file":"gen/skip.eco","line":1,"column":1,"kind":"line","function":"g"},');
    $out->append('{"local":7,"file":"src/a.eco","line":4,"column":1,"kind":"region","function":"f"}');
    $out->append(']},{"name":"lib","dir":"/l","counters":[{"local":0,"file":"src/l.eco","line":1,"column":1,"kind":"line","function":"l"}]}]}');
    return $out;
}

test a_counter_file_is_read_or_refused
{
    $dir = TempDir();
    array<usize> $counts = [3, 0, 1];
    string $good = $dir->write('good.ecocov', counterFile('m/t.eco::one', 'm', $counts));

    CounterFile $file = expect(CounterFile::load($good))->some();
    expect($file->testId)->is('m/t.eco::one');
    expect($file->modules)->is(['m']);
    expect($file->of('m')->count())->is(3);
    expect($file->of('other'))->empty();

    string $bytes = counterFile('m/t.eco::one', 'm', $counts);
    expect(CounterFile::load($dir->write('short.ecocov', $bytes->sub(0, 100))))->none();
    expect(CounterFile::load($dir->write('headless.ecocov', $bytes->sub(0, 164))))->none();
    expect(CounterFile::load($dir->write('cut.ecocov', $bytes->sub(0, $bytes->size() - 2))))->none();
}

test a_map_that_does_not_parse_is_null_and_modules_are_found_by_name
{
    $dir = TempDir();
    expect(CoverageMap::load($dir->write('bad.json', '{')))->none();

    CoverageMap $map = expect(CoverageMap::load($dir->write('map.json', mapText())))->some();
    expect(expect($map->module('lib'))->some()->dir)->is('/l');
    expect($map->module('nowhere'))->none();
}

test instances_of_one_body_merge_into_one_function_line_and_edge
{
    $dir = TempDir();
    CoverageMap $map = expect(CoverageMap::load($dir->write('map.json', mapText())))->some();

    Coverage $c = Coverage($map);
    $c->modules = ['m'];
    $c->exclude = ['gen/**'];
    $c->tests[] = expect(CounterFile::load($dir->write('a.ecocov', counterFile('m/t.eco::a', 'm', [0, 2, 0, 1, 0, 1, 0, 0]))))->some();
    $c->tests[] = expect(CounterFile::load($dir->write('b.ecocov', counterFile('m/t.eco::b', 'm', [0, 1, 0, 1, 0, 0, 0, 0]))))->some();

    array<FileCoverage> $files = $c->files();
    expect($files->count())->is(1);
    expect($files[0]->file)->is('src/a.eco');
    expect($files[0]->functionTotals()->total)->is(1);
    expect($files[0]->functionTotals()->hit)->is(1);
    expect($files[0]->lineTotals()->hit)->is(1);
    expect($files[0]->branchTotals()->total)->is(1);
    expect($files[0]->branchTotals()->hit)->is(1);

    expect($c->testsAt('a.eco', 2))->is(['m/t.eco::a', 'm/t.eco::b']);
    expect($c->testsAt('src/a.eco', 9))->empty();
    expect(expect($c->called('src/a.eco', 1))->some())->yes();
    expect($c->called('src/a.eco', 2))->none();
    expect($c->excluded('gen/skip.eco'))->yes();
}

test a_test_counted_twice_is_named_once
{
    $dir = TempDir();
    CoverageMap $map = expect(CoverageMap::load($dir->write('map.json', mapText())))->some();

    Coverage $c = Coverage($map);
    $c->modules = ['m'];
    string $one = counterFile('m/t.eco::a', 'm', [1, 1, 1, 1, 1, 1, 1]);
    $c->tests[] = expect(CounterFile::load($dir->write('a.ecocov', $one)))->some();
    $c->tests[] = expect(CounterFile::load($dir->write('a2.ecocov', $one)))->some();

    expect($c->testsAt('src/a.eco', 2))->is(['m/t.eco::a']);
    expect($c->files()->count())->is(2);
}

test a_folder_of_counter_files_skips_what_is_not_one
{
    $dir = TempDir();
    CoverageMap $map = expect(CoverageMap::load($dir->write('map.json', mapText())))->some();
    Coverage $c = Coverage($map);

    $dir->write('notes.txt', 'x');
    $dir->write('broken.ecocov', 'x');
    $dir->write('a.ecocov', counterFile('m/t.eco::a', 'm', [1, 1, 1, 1, 1, 1, 1]));
    $c->absorb($dir->path);
    $c->absorb($dir->file('missing'));

    expect($c->tests->count())->is(1);
}

test paths_name_one_file_only_at_a_separator
{
    expect(Coverage::sameFile('src/a.eco', 'xsrc/a.eco'))->no();
    expect(Coverage::sameFile('src/a.eco', 'src/b.eco'))->no();
}
