/**
 * Run directories written by hand: rows and events a live run rarely produces, a compiler that
 * answers `-p decls` from a file, and a runner whose compiler leaves no coverage behind.
 */

use ecotest::{expect, paths, TempDir};
use ecotest::cli::{Run, Runner, Invocation, Tool, Store, files, doc, queries, Services};

test a_pass_folds_every_kind_of_row_and_event
{
    $dir = TempDir();
    $pass = $dir->file('.ecotest/run-1/pass-1');
    guard paths::mkdirs(std::env::join($pass, 'events'));

    guard files::write(std::env::join($pass, 'report.jsonl'), '{"v":2,"type":"run","version":"9.9.9","selected":3}
{"v":2,"type":"note","text":"not a row the tool reads"}
{"v":2,"type":"test","id":"m/t.eco::crashed","module":"m","file":"t.eco","name":"crashed","status":"fail","ms":3,"failure":{"headline":"fatal error","message":"boom","file":"t.eco","line":7}}
{"v":2,"type":"test","id":"m/t.eco::checked","module":"m","file":"t.eco","name":"checked","status":"fail","ms":4}
{"v":2,"type":"test","id":"m/t.eco::plain","module":"m","file":"t.eco","name":"plain","status":"fail","ms":4}
{"v":2,"type":"end","ms":9}
');

    guard files::write(std::env::join($pass, 'events/m_t.eco__checked.jsonl'), '{"type":"fail","summary":"values differ","expected":"1","actual":"2","detail":"more","file":"t.eco","line":5,"context":["row 1"]}
{"type":"fail","summary":"second","expected":"","actual":"","detail":"","file":"t.eco","line":6}
{"type":"crash","headline":"fatal error","message":"after the check","file":"t.eco","line":8}
{"type":"snapshot-new","path":"a.snap"}
{"type":"snapshot-updated","path":"b.snap"}
{"type":"something-later","value":1}
');

    guard files::write(std::env::join($pass, 'events/m_t.eco__plain.jsonl'), '{"type":"fail","summary":"plain","expected":"x","actual":"y","detail":"","file":"t.eco","line":2,"context":[4]}
');

    $run = Run(readFrom: $dir->file('.ecotest/run-1'));

    expect($run->version)->is('9.9.9');
    expect($run->wallMs)->is(9);
    expect($run->tests->count())->is(3);
    $plain = expect($run->tests[2]->events->fault)->some();
    expect($plain->detail)->is('expected: x\n     got: y');
    expect($plain->context)->is(['']);
    $crash = expect($run->tests[0]->events->fault)->some();
    expect($crash->summary)->is('fatal error: boom');
    expect($crash->line)->is(7);
    $differs = expect($run->tests[1]->events->fault)->some();
    expect($differs->summary)->is('values differ');
    expect($differs->detail)->is('expected: 1\n     got: 2\nmore\nalso t.eco:6: second');
    expect($differs->context)->is(['row 1']);
    expect($run->tests[1]->events->notes)->is(['wrote new snapshot a.snap', 'updated snapshot b.snap']);
    expect($run->stopped())->empty();
}

/**
 * A run directory under `$dir` whose one pass reported `$rows` and ended with `$exit`.
 */
internal function stored(const TempDir& $dir, const string& $rows, const string& $exit) : Run
{
    $pass = $dir->file('.ecotest/run-1/pass-1');
    guard paths::mkdirs(std::env::join($pass, 'events'));
    guard files::write(std::env::join($pass, 'report.jsonl'), $rows);
    if (!$exit->empty()) {
        guard files::write(std::env::join($pass, 'echoc.json'), $exit);
    }
    return Run(readFrom: $dir->file('.ecotest/run-1'));
}

test a_pass_without_its_end_row_is_stopped
{
    $dir = TempDir();
    $run = stored($dir, '{"v":2,"type":"run","selected":2}\n{"v":2,"type":"test","id":"m/t.eco::a","status":"pass"}\n', '{"exit":null,"signal":9}');

    expect($run->green())->no();
    expect($run->stopped())->is(['echoc ended after 1 of 2 tests without its end row']);
}

test a_pass_with_every_row_but_a_failed_exit_is_stopped
{
    $dir = TempDir();
    $run = stored($dir, '{"v":2,"type":"run","selected":1}\n{"v":2,"type":"test","id":"m/t.eco::a","status":"pass"}\n{"v":2,"type":"end","ms":1}\n', '{"exit":3,"signal":null}');

    expect($run->green())->no();
    expect($run->stopped())->is(['echoc exited 3 although every test passed']);
}

test a_report_of_another_version_is_refused
{
    $dir = TempDir();
    $run = stored($dir, '{"v":3,"type":"run","selected":1}\n{"v":3,"type":"end"}\n', '');

    expect($run->green())->no();
    expect($run->stopped())->is(["echoc's report is version 3; this ecotest reads version 2"]);
}

test a_run_without_passes_is_not_green
{
    expect(Run('/nowhere')->green())->no();
}

test a_compiler_without_coverage_leaves_the_pass_without_it
{
    $dir = TempDir();
    $echoc = Invocation();
    $echoc->project = $dir->path;
    $echoc->program = 'true';
    $echoc->coverage = true;

    $run = Run($dir->file('run'));
    expect(Runner()->run($echoc, $dir->file('run'), $run))->fine();
    expect(std::io::exists($dir->file('run/pass-1/coverage/map.json'))->or(false))->no();
    // nor a report: the run read back from it has no tests, and its pass never reached them
    $back = Run(readFrom: $dir->file('run'));
    expect($back->tests)->empty();
    expect($back->stopped())->is(['echoc stopped before the tests']);
}

test a_failed_compile_keeps_no_coverage_of_an_earlier_run
{
    $dir = TempDir();
    // what an earlier run left in the build directory
    guard paths::mkdirs($dir->file('ecobuild/coverage/tests'));
    $dir->write('ecobuild/coverage/map.json', '{"hash":"old","modules":[]}');
    $dir->write('ecobuild/coverage/tests/m_t.eco__a.ecocov', 'old');

    $fake = TempDir();
    $echoc = $fake->write('echoc', '#!/bin/sh\necho "error: does not compile" >&2\nexit 1\n');
    expect(ecotest::run('chmod', ['+x', $echoc]))->succeeds();

    $invocation = Invocation();
    $invocation->project = $dir->path;
    $invocation->program = $echoc;
    $invocation->coverage = true;

    $run = Run($dir->file('run'));
    expect(Runner()->run($invocation, $dir->file('run'), $run))->fine();

    expect(std::io::exists($dir->file('run/pass-1/coverage'))->or(true))->no();
    expect(std::io::exists($dir->file('ecobuild/coverage/map.json'))->or(true))->no();
    expect(std::io::exists($dir->file('ecobuild/coverage/tests/m_t.eco__a.ecocov'))->or(true))->no();
    expect(expect($dir->read('run/pass-1/echoc.json'))->ok())->has('"exit":1');
}

test a_runner_says_why_a_pass_could_not_run
{
    $dir = TempDir();
    $echoc = Invocation();
    $echoc->project = $dir->path;
    $echoc->program = '/nonexistent/echoc';

    $run = Run($dir->file('run'));
    $missing = expect(Runner()->run($echoc, $dir->file('run'), $run))->fails();
    expect("{$missing}")->is('cannot run /nonexistent/echoc: No such file or directory');

    $unwritable = expect(Runner()->run($echoc, '/dev/null/run', $run))->fails();
    expect("{$unwritable}")->is('cannot write /dev/null/run/pass-1/events: Not a directory');
}

test a_report_that_cannot_be_written_fails_the_run_and_a_lost_history_line_does_not
{
    $dir = TempDir();
    $dir->write('rows.jsonl', '{"v":2,"type":"run","version":"9.9.9","selected":0}\n{"v":2,"type":"end","ms":1}\n');
    $fake = TempDir();
    $echoc = $fake->write('echoc', '#!/bin/sh\ncat rows.jsonl > "$3"\nif [ -f block ]; then mkdir "$ECOTEST_RUN_DIR/../run.json"; fi\n');
    expect(ecotest::run('chmod', ['+x', $echoc]))->succeeds();
    guard paths::mkdirs($dir->file('.ecotest/history.jsonl'));

    $tool = Tool();
    $tool->echoc->project = $dir->path;
    $tool->echoc->program = $echoc;
    expect($tool->run())->is(0);

    $dir->write('block', '');
    expect($tool->run())->is(1);
    // the run could not be sealed, so it never counts as finished
    expect(Store($dir->file('.ecotest'))->runs()->count())->is(1);

    $nowhere = Tool();
    $nowhere->echoc->project = '/dev/null/project';
    expect($nowhere->run())->is(1);
}

test commands_on_a_run_without_coverage_say_so
{
    $dir = TempDir();
    guard paths::mkdirs($dir->file('.ecotest/run-1'));

    $tool = Tool();
    $tool->echoc->project = $dir->path;
    expect($tool->api())->is(1);
    expect($tool->who('src/math.eco:3'))->is(1);
    expect($tool->report(''))->is(1);
    expect($tool->report($dir->file('.ecotest/run-1')))->is(1);
}

test the_newest_run_is_the_newest_finished_one
{
    $dir = TempDir();
    foreach (['run-999', 'run-1000', 'run-1001'] as const &$name) {
        guard paths::mkdirs($dir->file(".ecotest/{$name}"));
    }
    $dir->write('.ecotest/run-999/run.json', '{"complete":true}');
    $dir->write('.ecotest/run-1000/run.json', '{"complete":true}');

    $store = Store($dir->file('.ecotest'));
    expect(expect($store->latest())->some())->ends('run-1000');
    expect($store->runs()->count())->is(2);
}

test old_runs_are_pruned_but_the_one_the_queries_read_stays
{
    $dir = TempDir();
    foreach (['run-1', 'run-2', 'run-3', 'run-4'] as const &$name) {
        guard paths::mkdirs($dir->file(".ecotest/{$name}"));
        $dir->write(".ecotest/{$name}/run.json", '{"complete":true}');
    }
    // abandoned long ago, and one still running
    guard paths::mkdirs($dir->file('.ecotest/run-0'));
    guard paths::mkdirs($dir->file('.ecotest/run-5'));

    $store = Store($dir->file('.ecotest'));
    expect($store->point($dir->file('.ecotest/run-1')))->fine();
    $gone = $store->prune(2, $dir->file('.ecotest/run-4'));

    expect($gone->count())->is(2);
    foreach (['run-1', 'run-3', 'run-4', 'run-5'] as const &$name) {
        expect(std::io::exists($dir->file(".ecotest/{$name}"))->or(false))->yes(says: $name);
    }
    expect(std::io::exists($dir->file('.ecotest/run-2'))->or(true))->no();
    expect(std::io::exists($dir->file('.ecotest/run-0'))->or(true))->no();
}

test a_service_without_a_log_has_no_tail
{
    $services = Services();
    $doc = guard json::parse('[{"name": "quiet", "run": ["true", 4], "env": "not an object"}, {"name": "odd", "env": {"N": 5}}]');
    array<json::Value> $none = [];
    $services->configure($doc->asArray() ?? $none);

    $dir = TempDir();
    expect($services->tails($dir->path, 5))->empty();
    expect($services->specs[0]->command)->is(['true', '']);
    expect($services->specs[1]->env->values())->is(['']);

    guard paths::mkdirs($dir->file('services'));
    guard files::write($dir->file('services/odd.log'), '');
    expect($services->tails($dir->path, 5))->empty();
    guard files::write($dir->file('services/quiet.log'), 'one\ntwo\n');
    expect($services->tails($dir->path, 5))->has('one')->has('two');
}

test api_reports_what_the_compiler_cannot_tell_it
{
    $sample = Sample();
    $first = $sample->tool();
    $first->echoc->coverage = true;
    expect($first->run())->is(0);

    $missing = $sample->tool();
    $missing->echoc->program = '/nonexistent/echoc';
    expect($missing->api())->is(1);

    $chatty = $sample->tool();
    $chatty->echoc->program = 'echo';
    expect($chatty->api())->is(1);
}

test api_lists_what_it_cannot_judge
{
    $sample = Sample();
    $first = $sample->tool();
    $first->echoc->coverage = true;
    expect($first->run())->is(0);

    $fake = TempDir();
    $fake->write('decls.json', '{"modules": [
        {"name": "elsewhere", "declarations": [{"kind": "function", "visibility": "public", "file": "src/x.eco", "line": 1, "qualified": "x"}]},
        {"name": "sample", "declarations": [
            {"kind": "function", "visibility": "private", "file": "src/math.eco", "line": 1, "qualified": "hidden"},
            {"kind": "function", "visibility": "public", "file": "src/never/x.eco", "line": 1, "qualified": "excluded"},
            {"kind": "function", "visibility": "public", "file": "src/math.eco", "line": 2, "qualified": "no counter"},
            {"kind": "function", "visibility": "public", "file": "src/math.eco", "line": 1, "qualified": "add"},
            {"kind": "class", "methods": [{"visibility": "public", "file": "src/math.eco", "line": 15, "qualified": "unused"}], "constructors": [{"visibility": "public", "file": "src/math.eco", "line": 6, "qualified": "halve"}]}
        ]}
    ]}');
    $echoc = $fake->write('echoc', "#!/bin/sh\ncat {$fake->path}/decls.json\n");
    expect(ecotest::run('chmod', ['+x', $echoc]))->succeeds();

    $tool = $sample->tool();
    $tool->echoc->program = $echoc;
    $tool->exclude = ['src/never/**'];
    $tool->echoc->buildDir = 'elsewhere';
    expect($tool->api())->is(0);

    $found = expect(queries::judged($tool))->ok();
    expect($found->decided)->is(2);
    expect($found->never)->is(['unused  src/math.eco:15']);
    expect($found->undecided)->is(['no counter at this line: no counter  src/math.eco:2']);
}

/**
 * A fake git for the sample: `rev-parse` answers its directory, `diff` the file `changes.diff`,
 * `show` the file `old.eco`, and `ls-files` nothing.
 */
internal function fakeGit(Sample& $sample, const TempDir& $fake) : string
{
    $git = $fake->write('git', '#!/bin/sh
case "$*" in
  *rev-parse*) pwd ;;
  *ls-files*) ;;
  *show*) cat old.eco ;;
  *diff*) cat changes.diff ;;
esac
');
    expect(ecotest::run('chmod', ['+x', $git]))->succeeds();
    return $git;
}

/**
 * The sample, run once with coverage, the run the queries read.
 */
internal function covered() : Sample
{
    $sample = Sample();
    $first = $sample->tool();
    $first->echoc->coverage = true;
    expect($first->run())->is(0);
    return $sample;
}

test who_names_the_tests_on_a_line_and_refuses_a_changed_file
{
    $sample = covered();
    $tool = $sample->tool();

    expect(expect(queries::ran($tool, 'src/math.eco:3'))->ok())->is(['sample/math.eco::adds', 'sample/math.eco::benches', 'sample/math.eco::checks_nothing']);
    expect(expect(queries::ran($tool, 'src/math.eco:17'))->ok())->empty();
    expect(queries::ran($tool, 'src/nowhere.eco:1'))->fails();
    expect(queries::ran($tool, 'no line'))->fails();

    $source = expect($sample->dir->read('src/math.eco'))->ok();
    $sample->dir->write('src/math.eco', str::concat('// a line on top moves every other one\n', $source));
    expect(queries::ran($tool, 'src/math.eco:3'))->fails();
}

test affected_names_a_test_once_however_many_of_its_lines_changed
{
    $sample = covered();
    $fake = TempDir();
    $sample->dir->write('changes.diff', '--- a/src/math.eco\n+++ b/src/math.eco\n@@ -6,7 +6,7 @@\n');

    $tool = $sample->tool();
    $tool->git = fakeGit($sample, $fake);
    $tool->since = 'main';

    $selection = expect(queries::select($tool))->ok();
    expect($selection->ids)->is(['sample/math.eco::halves']);
    expect($selection->everything)->no();

    expect($tool->affected())->is(0);
    expect($tool->echoc->forwarded)->is(['--filter', 'halves']);

    // the filtered run is not the one the queries read
    expect(expect(Store($sample->dir->file('.ecotest'))->covered())->ok())->isNot($sample->latest());
}

test affected_reads_a_deletion_on_the_side_the_coverage_saw
{
    $sample = covered();
    $fake = TempDir();
    $before = expect($sample->dir->read('src/math.eco'))->ok();
    $sample->dir->write('old.eco', $before);
    // the guard in halve, lines 8 to 10, is gone since the covered run
    $lines = str::lines($before)->owned();
    string $after = '';
    for (usize $i = 0; $i < $lines->count(); $i++) {
        if ($i < 7 || $i > 9) {
            $after->append($lines[$i]);
            $after->append("\n");
        }
    }
    $sample->dir->write('src/math.eco', $after);
    $sample->dir->write('changes.diff', '--- a/src/math.eco\n+++ b/src/math.eco\n@@ -8,3 +7,0 @@\n');

    $tool = $sample->tool();
    $tool->git = fakeGit($sample, $fake);
    $tool->since = 'main';

    $selection = expect(queries::select($tool))->ok();
    expect($selection->ids)->is(['sample/math.eco::halves']);
}

test affected_refuses_coverage_of_another_version
{
    $sample = covered();
    $fake = TempDir();
    $sample->dir->write('old.eco', 'something else entirely');
    $sample->dir->write('src/math.eco', 'public function add(int64 $a, int64 $b) : int64 { return $a; }\n');
    $sample->dir->write('changes.diff', '--- a/src/math.eco\n+++ b/src/math.eco\n@@ -1 +1 @@\n');

    $tool = $sample->tool();
    $tool->git = fakeGit($sample, $fake);
    $tool->since = 'main';

    expect(queries::select($tool))->fails();
}

test affected_runs_everything_for_a_new_source_file
{
    $sample = covered();
    $fake = TempDir();
    $sample->dir->write('src/more.eco', 'public function more() : int64 { return 1; }\n');
    $sample->dir->write('changes.diff', '--- /dev/null\n+++ b/src/more.eco\n@@ -0,0 +1 @@\n');

    $tool = $sample->tool();
    $tool->git = fakeGit($sample, $fake);
    $tool->since = 'main';

    expect(expect(queries::select($tool))->ok()->everything)->yes();
}
