/*
 * ecotest-tool: the commands behind the `ecotest` executable. Runs `echoc test`, folds its report,
 * the events tests wrote through ecotest and the coverage counters into one run, and renders,
 * gates and remembers it.
 */

#[module: "ecotest-tool"]
#[version: "0.2.0"]
#[epm::license: "MIT"]
#[epm::description: "Runs echoc tests and reports on them: outcomes, flakiness, coverage, history"]

#[requires: "echolang/libcommand" { version: "^0.1", source: git "https://github.com/echolang/libcommand" }]
#[requires: "echolang/libjson" { version: "^0.1", source: git "https://github.com/echolang/libjson" }]
#[requires: "echolang/libcurl" { version: "^1.0", source: git "https://github.com/echolang/libcurl" }]

#[sources: "src/**/*.eco"]

#[target: test] {
    #[sources: "tests/*.eco"]
    #[depends: "../.."]
}
