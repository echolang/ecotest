namespace ecotest::http;

use ecotest::protocol;
use ecotest::http::url;

/**
 * A service under test: a base URL, default headers, and the transport that carries requests.
 * Every request returns a `Reply` to check. It copies like any struct, so `with` and `bearer`
 * hand back a changed copy and leave the original alone; the transport stays shared.
 */
public struct Api
{
    /**
     * The services whose ready check already passed in this process, by name.
     */
    internal static array<string> $ready = [];

    /**
     * The base URL, without a trailing `/`.
     */
    public const string $base;

    /**
     * What carries the requests. Copies of this `Api` share it.
     */
    public Transport $transport;

    /**
     * The headers sent with every request, one per name.
     */
    public array<Header> $headers = [];

    /**
     * A service at `$base`, such as `http://127.0.0.1:8080`, reached over sockets.
     */
    public constructor(const string& $base)
    {
        $this->base = Api::trimmed($base);
        $this->transport = CurlTransport();
    }

    /**
     * A service reached through `$transport`, such as an app dispatched in process.
     */
    public constructor(transport: Transport $transport, base: const string& $base = 'http://app')
    {
        $this->base = Api::trimmed($base);
        $this->transport = $transport;
    }

    /**
     * A copy that sends `$name: $value` with every request, in place of any header of that name
     * this one sends.
     */
    public const function with(const string& $name, const string& $value) : Api
    {
        Api $copy = $this;
        setHeader($copy->headers, $name, $value);
        return $copy;
    }

    /**
     * A copy that no longer sends header `$name`.
     */
    public const function without(const string& $name) : Api
    {
        Api $copy = $this;
        dropHeader($copy->headers, $name);
        return $copy;
    }

    /**
     * A copy that sends `Authorization: Bearer $token` with every request.
     */
    public const function bearer(const string& $token) : Api
    {
        string $value = "Bearer {$token}";
        return $this->with('Authorization', $value);
    }

    /**
     * GET `$path`, with `$query` appended as encoded fields.
     */
    public const function get(const string& $path, query: const ordered_map<string, string>& $query = []) : Reply
    {
        return $this->send(.get, $path, null, query: $query);
    }

    /**
     * HEAD `$path`, with `$query` appended as encoded fields.
     */
    public const function head(const string& $path, query: const ordered_map<string, string>& $query = []) : Reply
    {
        return $this->send(.head, $path, null, query: $query);
    }

    /**
     * DELETE `$path`, with `$query` appended as encoded fields.
     */
    public const function delete(const string& $path, query: const ordered_map<string, string>& $query = []) : Reply
    {
        return $this->send(.delete, $path, null, query: $query);
    }

    /**
     * POST `$body` to `$path`: `json:` text or a document, `form:` fields, or `body:` with `type:`.
     */
    public const function post(const string& $path, construct Body $body) : Reply
    {
        return $this->send(.post, $path, $body);
    }

    /**
     * POST `$body` to `$path` with `$query` appended as encoded fields.
     */
    public const function post(const string& $path, query: const ordered_map<string, string>& $query, construct Body $body) : Reply
    {
        return $this->send(.post, $path, $body, query: $query);
    }

    /**
     * PUT `$body` to `$path`: `json:` text or a document, `form:` fields, or `body:` with `type:`.
     */
    public const function put(const string& $path, construct Body $body) : Reply
    {
        return $this->send(.put, $path, $body);
    }

    /**
     * PUT `$body` to `$path` with `$query` appended as encoded fields.
     */
    public const function put(const string& $path, query: const ordered_map<string, string>& $query, construct Body $body) : Reply
    {
        return $this->send(.put, $path, $body, query: $query);
    }

    /**
     * PATCH `$body` to `$path`: `json:` text or a document, `form:` fields, or `body:` with `type:`.
     */
    public const function patch(const string& $path, construct Body $body) : Reply
    {
        return $this->send(.patch, $path, $body);
    }

    /**
     * PATCH `$body` to `$path` with `$query` appended as encoded fields.
     */
    public const function patch(const string& $path, query: const ordered_map<string, string>& $query, construct Body $body) : Reply
    {
        return $this->send(.patch, $path, $body, query: $query);
    }

    /**
     * Sends a request built here, with `$body` and its Content-Type when there is one, and returns
     * what came back. The body's Content-Type replaces one set with `with`. A transport failure is
     * kept on the reply, so the first check on it fails at the test's line.
     */
    public const function send(Verb $verb, const string& $path, const Body? $body = null, query: const ordered_map<string, string>& $query = []) : Reply
    {
        $request = Request($verb, Api::target($this->base, $path, $query));
        $request->headers = $this->headers;

        if ($body != null) {
            $b = guard $body;
            $request->body = $b->text;
            $request->set('Content-Type', $b->type);
        }

        Transport $carrier = $this->transport;
        $response = $carrier->send($request);
        if ($verb == Verb::head) {
            $res = guard $response else {
                return Reply(mv $request, mv $response);
            };
            $res->body = '';
            return Reply(mv $request, .ok($res));
        }
        return Reply(mv $request, mv $response);
    }

    /**
     * Waits for the ready URL the tool exported for service `$name`, once per process. Stops the
     * test at `$at` when it does not answer in time.
     */
    internal static function await(const string& $name, std::src::location $at) : void
    {
        foreach (Api::$ready as const &$done) {
            if ($done == $name) {
                return;
            }
        }

        string $readyVar = protocol::serviceVar($name, 'READY');
        string $ready = string(std::env::var($readyVar, ''));
        if ($ready->empty()) {
            Api::$ready[] = $name;
            return;
        }

        string $limitVar = protocol::serviceVar($name, 'READY_MS');
        string $limitText = string(std::env::var($limitVar, ''));
        int64 $limit = str::int($limitText) ?? 10000;

        if (waitReady($ready, $limit)) {
            Api::$ready[] = $name;
            return;
        }

        ecotest::stop("service {$name} was not ready at {$ready} within {$limit} ms", $at);
    }

    /**
     * `$base` without a trailing `/`.
     */
    private static function trimmed(const string& $base) : string
    {
        if ($base->ends('/')) {
            return $base->sub(0, $base->size() - 1);
        }
        return $base;
    }

    /**
     * `$base` and `$path` with exactly one `/` between them, then `$query` joined with `?` or `&`
     * before any `#fragment`. A full URL as `$path` wins over `$base`.
     */
    private static function target(const string& $base, const string& $path, const ordered_map<string, string>& $query) : string
    {
        string $out = '';
        if ($path->starts('http://') || $path->starts('https://')) {
            $out = $path;
        } else if ($path->starts('/')) {
            $out = "{$base}{$path}";
        } else {
            $out = "{$base}/{$path}";
        }

        if ($query->empty()) {
            return $out;
        }

        string $fragment = '';
        usize $hash = $out->find('#');
        if ($hash < $out->size()) {
            $fragment = string($out->sub($hash, $out->size() - $hash));
            $out = string($out->sub(0, $hash));
        }

        if (!$out->contains('?')) {
            $out->push(63);
        } else if (!$out->ends('?') && !$out->ends('&')) {
            $out->push(38);
        }
        $out->append(url::query($query));
        $out->append($fragment);
        return $out;
    }
}

/**
 * The service ecotest started under `$name` (the `services` list of `ecotest.json`). Outside
 * `ecotest` its `ECOTEST_<NAME>_URL` is unset and the test is skipped, not failed. When the
 * tool also exports `ECOTEST_<NAME>_READY`, that URL has to answer with a 2xx or 3xx within
 * `ECOTEST_<NAME>_READY_MS` first, once per process; otherwise the test stops here.
 */
#[caller]
public function live(service: const string& $name) : Api
{
    $at = std::src::caller();
    $url = ecotest::needs(env: protocol::serviceVar($name), at: $at);
    Api::await($name, $at);
    return Api($url);
}
