namespace ecotest::http;

/**
 * A service under test: a base URL, default headers, and the transport that carries requests.
 * Every request returns a `Reply` to check.
 */
public class Api
{
    public const string $base;
    public Transport $transport;
    private array<Header> $headers = [];

    /**
     * A service at `$base`, such as `http://127.0.0.1:8080`, reached over sockets.
     */
    public constructor(const string& $base)
    {
        $this->base = Api::trimmed($base);
        $this->transport = CurlTransport();
    }

    /**
     * The service ecotest started under `$name` (the `services` list of `ecotest.json`). Outside
     * `ecotest` its `ECOTEST_<NAME>_URL` is unset and the test is skipped, not failed.
     */
    #[caller]
    public constructor(service: const string& $name)
    {
        $variable = Api::variable($name);
        $url = ecotest::needs(env: $variable);
        $this->base = Api::trimmed($url);
        $this->transport = CurlTransport();
    }

    /**
     * A service reached through `$transport`, such as an app dispatched in process.
     */
    public constructor(transport: Transport $transport, base: const string& $base = 'http://app')
    {
        $this->base = Api::trimmed($base);
        $this->transport = $transport;
    }

    /**
     * Sends `$name: $value` with every request from here on.
     */
    public function with(const string& $name, const string& $value) : Api
    {
        $this->headers[] = Header($name, $value);
        return $this;
    }

    /**
     * Sends `Authorization: Bearer $token` with every request from here on.
     */
    public function bearer(const string& $token) : Api
    {
        return $this->with('Authorization', "Bearer {$token}");
    }

    /**
     * GET `$path`.
     */
    public function get(const string& $path) : Reply
    {
        return $this->send(.get, $path);
    }

    /**
     * HEAD `$path`.
     */
    public function head(const string& $path) : Reply
    {
        return $this->send(.head, $path);
    }

    /**
     * DELETE `$path`.
     */
    public function delete(const string& $path) : Reply
    {
        return $this->send(.delete, $path);
    }

    /**
     * POST `$body` to `$path`: `json:` text or a document, `form:` fields, or `body:` with `type:`.
     */
    public function post(const string& $path, construct Body $body) : Reply
    {
        return $this->send(.post, $path, $body);
    }

    /**
     * PUT `$body` to `$path`: `json:` text or a document, `form:` fields, or `body:` with `type:`.
     */
    public function put(const string& $path, construct Body $body) : Reply
    {
        return $this->send(.put, $path, $body);
    }

    /**
     * PATCH `$body` to `$path`: `json:` text or a document, `form:` fields, or `body:` with `type:`.
     */
    public function patch(const string& $path, construct Body $body) : Reply
    {
        return $this->send(.patch, $path, $body);
    }

    /**
     * Sends a request built here, with `$body` and its Content-Type when there is one, and returns
     * what came back. A transport failure is kept on the reply, so the first check on it fails at
     * the test's line.
     */
    public function send(Verb $verb, const string& $path, const Body? $body = null) : Reply
    {
        $request = Request($verb, Api::join($this->base, $path));
        $request->headers = $this->headers;

        if ($body != null) {
            $b = guard $body;
            $request->body = $b->text;
            $request->header('Content-Type', $b->type);
        }

        $response = $this->transport->send($request);
        return Reply(mv $request, mv $response);
    }

    /**
     * `ECOTEST_<NAME>_URL`, the variable the ecotest tool exports for service `$name`.
     */
    public static function variable(const string& $name) : string
    {
        string $out = 'ECOTEST_';
        for (usize $i = 0; $i < $name->size(); $i++) {
            uint8 $b = $name->byte($i);
            if ($b >= 97 && $b <= 122) {
                $out->push($b - 32);
            } else if (($b >= 65 && $b <= 90) || ($b >= 48 && $b <= 57)) {
                $out->push($b);
            } else {
                $out->push(95);
            }
        }
        $out->append('_URL');
        return $out;
    }

    /**
     * `$base` without a trailing `/`.
     */
    private static function trimmed(const string& $base) : string
    {
        if ($base->ends('/')) {
            return $base->sub(0, $base->size() - 1);
        }
        return $base;
    }

    /**
     * `$base` and `$path` with exactly one `/` between them. A full URL as `$path` wins.
     */
    private static function join(const string& $base, const string& $path) : string
    {
        if ($path->starts('http://') || $path->starts('https://')) {
            return $path;
        }
        if ($path->starts('/')) {
            return "{$base}{$path}";
        }
        return "{$base}/{$path}";
    }
}
