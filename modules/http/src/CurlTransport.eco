namespace ecotest::http;

/**
 * Requests over real sockets, through libcurl. Redirects are not followed, so a test sees the
 * status the service sent.
 */
public class CurlTransport : Transport
{
    public int32 $timeoutMs;

    public constructor(int32 $timeoutMs = 10000)
    {
        $this->timeoutMs = $timeoutMs;
    }

    /**
     * Sends `$request` with libcurl.
     */
    public function send(const Request& $request) : result<Response, TransportError>
    {
        $out = curl::Request($request->verb->curl(), $request->url);
        $out->body = $request->body;
        $out->timeout($this->timeoutMs);

        foreach ($request->headers as const &$h) {
            $out->header($h->name, $h->value);
        }

        $got = guard curl::send($out) else ($e) {
            return .error(.curl($e));
        };

        $res = Response($got->status);
        $res->body = $got->body;
        $res->ms = ($got->seconds * 1000.0) as int64;

        foreach ($got->headers->items as const &$h) {
            $res->headers[] = Header($h->name, $h->value);
        }

        return .ok(mv $res);
    }
}
