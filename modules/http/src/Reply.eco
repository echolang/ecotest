namespace ecotest::http;

use ecotest::http::jsonpath;

/**
 * The JSON body, parsed once for every check that needs it.
 */
internal class JsonBox
{
    public json::Value? $doc = null;
    public string $error = '';
    public bool $tried = false;
}

/**
 * One exchange and the checks on it. Each check names the test line that made it and, on failure,
 * shows the request line, the status, the headers and the start of the body. A request that got no
 * response at all fails the first check made on it.
 */
public class Reply
{
    /**
     * Where `invalid` looks for the refused fields: an array of objects, each naming the field and
     * the rule it broke, as `{"field": "title", "code": "min"}`. An API with another shape checks
     * its errors with `includes`.
     */
    public const string ERRORS = '$.errors';
    public const string ERROR_FIELD = 'field';
    public const string ERROR_RULE = 'code';

    /**
     * The request as it was sent.
     */
    public const Request $request;

    /**
     * What came back, or why nothing did.
     */
    public const result<Response, TransportError> $response;

    private JsonBox $json;

    public constructor(Request $request, result<Response, TransportError> $response)
    {
        $this->request = $request;
        $this->response = $response;
        $this->json = JsonBox();
    }

    /**
     * The status is `$code`.
     */
    #[caller]
    public const function status(int64 $code) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        if ($res->status != $code) {
            $this->fail("expected status {$code}, got {$res->status}", std::src::caller());
        }
        return $this;
    }

    /**
     * The status is 2xx.
     */
    #[caller]
    public const function ok() : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        if ($res->status < 200 || $res->status > 299) {
            $this->fail("expected a 2xx status, got {$res->status}", std::src::caller());
        }
        return $this;
    }

    /**
     * A header called `$name`, compared without case, is `$value`. With several of that name, one
     * matching is enough.
     */
    #[caller]
    public const function header(const string& $name, const string& $value) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        $values = $res->headers($name);
        if ($values->empty()) {
            $this->fail("expected header {$name}: {$value}, it is missing", std::src::caller());
            return $this;
        }

        foreach ($values as const &$v) {
            if ($v == $value) {
                return $this;
            }
        }

        $got = str::join($values, ', ');
        $this->fail("expected header {$name}: {$value}, got {$got}", std::src::caller());
        return $this;
    }

    /**
     * A header called `$name`, compared without case, starts with `$prefix`. With several of that
     * name, one matching is enough.
     */
    #[caller]
    public const function header(const string& $name, starts: const string& $prefix) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        $values = $res->headers($name);
        if ($values->empty()) {
            $this->fail("expected header {$name} starting with '{$prefix}', it is missing", std::src::caller());
            return $this;
        }

        foreach ($values as const &$v) {
            if ($v->starts($prefix)) {
                return $this;
            }
        }

        $got = str::join($values, ', ');
        $this->fail("expected header {$name} starting with '{$prefix}', got {$got}", std::src::caller());
        return $this;
    }

    /**
     * The media type of the Content-Type is `$type`, compared without case: `application/json`
     * matches `application/json; charset=utf-8`.
     */
    #[caller]
    public const function type(const string& $type) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        $got = $res->header('Content-Type') ?? '';
        string $media = Reply::media($got);
        if (!str::iequals($media->view(), $type->view())) {
            $this->fail("expected Content-Type {$type}, got '{$got}'", std::src::caller());
        }
        return $this;
    }

    /**
     * The status is `$code` and the body is problem details: its media type is
     * `application/problem+json` (RFC 9457).
     */
    #[caller]
    public const function problem(int64 $code) : Reply
    {
        $this->isProblem($code, std::src::caller());
        return $this;
    }

    /**
     * The answer is a 422 problem that refuses `$field` for breaking `$rule`: some item of the
     * array at `ERRORS` has `ERROR_FIELD` = `$field` and `ERROR_RULE` = `$rule`. A failure lists
     * what was refused instead.
     */
    #[caller]
    public function invalid(const string& $field, const string& $rule) : Reply
    {
        $this->refuses($field, $rule, std::src::caller());
        return $this;
    }

    /**
     * The answer is a 422 problem that refuses `$field`, whatever the rule.
     */
    #[caller]
    public function invalid(const string& $field) : Reply
    {
        $this->refuses($field, '', std::src::caller());
        return $this;
    }

    /**
     * The body is exactly `$text`.
     */
    #[caller]
    public const function body(const string& $text) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        if ($res->body != $text) {
            ecotest::fail('the body differs', std::src::caller(), $expected: $text, $actual: $res->body, $detail: $this->exchange());
        }
        return $this;
    }

    /**
     * The body contains `$part`.
     */
    #[caller]
    public const function has(const string& $part) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        if (!$res->body->contains($part)) {
            $this->fail("expected the body to contain '{$part}'", std::src::caller());
        }
        return $this;
    }

    /**
     * The body does not contain `$part`.
     */
    #[caller]
    public const function lacks(const string& $part) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        if ($res->body->contains($part)) {
            $this->fail("expected the body not to contain '{$part}'", std::src::caller());
        }
        return $this;
    }

    /**
     * Every value at `$path` in the JSON body is the same JSON as `$want`: numbers by value,
     * objects whatever their key order.
     */
    #[caller]
    public function json(const string& $path, const json::Value& $want) : Reply
    {
        $this->jsonIs($path, $want, std::src::caller());
        return $this;
    }

    /**
     * Every value at `$path` in the JSON body is the string `$want`.
     */
    #[caller]
    public function json(const string& $path, const string& $want) : Reply
    {
        $this->jsonIs($path, json::str($want), std::src::caller());
        return $this;
    }

    /**
     * Every value at `$path` in the JSON body is the number `$want`.
     */
    #[caller]
    public function json(const string& $path, int64 $want) : Reply
    {
        $this->jsonIs($path, json::int($want), std::src::caller());
        return $this;
    }

    /**
     * Every value at `$path` in the JSON body is the number `$want`.
     */
    #[caller]
    public function json(const string& $path, float64 $want) : Reply
    {
        $this->jsonIs($path, json::float($want), std::src::caller());
        return $this;
    }

    /**
     * Every value at `$path` in the JSON body is the boolean `$want`.
     */
    #[caller]
    public function json(const string& $path, bool $want) : Reply
    {
        $this->jsonIs($path, json::bool($want), std::src::caller());
        return $this;
    }

    /**
     * Every value at `$path` in the JSON body is JSON `null`.
     */
    #[caller]
    public function isNull(const string& $path) : Reply
    {
        $this->jsonIs($path, json::nil(), std::src::caller());
        return $this;
    }

    /**
     * Something exists at `$path` in the JSON body.
     */
    #[caller]
    public function present(const string& $path) : Reply
    {
        $found = guard $this->hits($path, std::src::caller()) else {
            return $this;
        };

        if ($found->empty()) {
            $this->fail("expected a value at {$path}", std::src::caller());
        }
        return $this;
    }

    /**
     * Every value at `$path` in the JSON body is an array of `$count` items.
     */
    #[caller]
    public function count(const string& $path, usize $count) : Reply
    {
        $found = guard $this->hits($path, std::src::caller()) else {
            return $this;
        };

        if ($found->empty()) {
            $this->fail("expected {$count} items at {$path}, found nothing there", std::src::caller());
            return $this;
        }

        foreach ($found as const &$hit) {
            if (!$hit->value->isArray()) {
                $shown = "{$hit->value}";
                $this->fail("expected {$count} items at {$hit->path}, got {$shown}, not an array", std::src::caller());
                return $this;
            }
            usize $got = $hit->value->count();
            if ($got != $count) {
                $this->fail("expected {$count} items at {$hit->path}, got {$got}", std::src::caller());
                return $this;
            }
        }
        return $this;
    }

    /**
     * Every array at `$path` holds an object with all of `$members`, each the same JSON as given.
     * Other members of that object do not matter: `includes('$.errors', ['field' => 'title'])`.
     */
    #[caller]
    public function includes(const string& $path, const ordered_map<string, json::Value>& $members) : Reply
    {
        $at = std::src::caller();
        $found = guard $this->hits($path, $at) else {
            return $this;
        };

        $wantedDoc = objectOf($members);
        string $wanted = "{$wantedDoc}";
        if ($found->empty()) {
            $this->fail("expected an item {$wanted} at {$path}, found nothing there", $at);
            return $this;
        }

        foreach ($found as const &$hit) {
            if (!$hit->value->isArray()) {
                $shown = "{$hit->value}";
                $this->fail("expected an item {$wanted} at {$hit->path}, got {$shown}, not an array", $at);
                return $this;
            }
            if (Reply::itemWith($hit->value, $members) == null) {
                $shown = "{$hit->value}";
                $this->fail("expected an item {$wanted} at {$hit->path}, got {$shown}", $at);
                return $this;
            }
        }
        return $this;
    }

    /**
     * Every value at `$path` passes `$test`. `says:` names what they should be.
     */
    #[caller]
    public function matches(const string& $path, function<bool(const json::Value&)> $test, says: const string& $what = '') : Reply
    {
        $found = guard $this->hits($path, std::src::caller()) else {
            return $this;
        };

        if ($found->empty()) {
            $this->fail("expected a value at {$path}", std::src::caller());
            return $this;
        }

        foreach ($found as const &$hit) {
            if (!$test($hit->value)) {
                $shown = "{$hit->value}";
                $summary = "{$hit->path} = {$shown} failed the test";
                if (!$what->empty()) {
                    $summary = "expected {$hit->path} to be {$what}, got {$shown}";
                }
                $this->fail($summary, std::src::caller());
                return $this;
            }
        }
        return $this;
    }

    /**
     * The one value at `$path`, as text, for the next request: a string as itself, anything else
     * as its JSON. Stops the test when there is no JSON body, when the path is malformed, or when
     * it names no value or several.
     */
    #[caller]
    public function capture(const string& $path) : string
    {
        $at = std::src::caller();
        ecotest::checked();

        $res = guard $this->received() else {
            $line = $this->request->line();
            $why = $this->reason();
            die($this->stopped("cannot capture {$path}: no response to {$line}: {$why}", $at), $at);
        };

        $this->loadJson();
        $doc = guard $this->json->doc else {
            die($this->stopped("cannot capture {$path}: the body is not JSON ({$this->json->error})", $at), $at);
        };

        $found = guard jsonpath::all($doc, $path) else ($e) {
            die($this->stopped("cannot capture {$path}: {$e}", $at), $at);
        };

        if ($found->empty()) {
            die($this->stopped("cannot capture {$path}: nothing there", $at), $at);
        }
        if ($found->count() > 1) {
            usize $n = $found->count();
            die($this->stopped("cannot capture {$path}: it names {$n} values", $at), $at);
        }

        const json::Value& $v = $found[0]->value;
        return $v->asStr() ?? "{$v}";
    }

    /**
     * The value of the first header called `$name`, compared without case, for the next request:
     * `capture(header: 'Location')`. Stops the test when there is no response or no such header.
     */
    #[caller]
    public const function capture(header: const string& $name) : string
    {
        $at = std::src::caller();
        ecotest::checked();

        $res = guard $this->received() else {
            $line = $this->request->line();
            $why = $this->reason();
            die($this->stopped("cannot capture header {$name}: no response to {$line}: {$why}", $at), $at);
        };

        $value = guard $res->header($name) else {
            die($this->stopped("cannot capture header {$name}: it is missing", $at), $at);
        };
        return $value;
    }

    /**
     * The JSON body as a document, for reading more than one value out of it. Stops the test when
     * there is no response or the body is not JSON.
     */
    #[caller]
    public function document() : json::Value
    {
        $at = std::src::caller();
        ecotest::checked();

        $res = guard $this->received() else {
            $line = $this->request->line();
            $why = $this->reason();
            die($this->stopped("no JSON document: no response to {$line}: {$why}", $at), $at);
        };

        $this->loadJson();
        $doc = guard $this->json->doc else {
            die($this->stopped("no JSON document: the body is not JSON ({$this->json->error})", $at), $at);
        };
        return $doc->clone();
    }

    /**
     * The exchange took less than `$ms` milliseconds.
     */
    #[caller]
    public const function faster(than: int64 $ms) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        if ($res->ms >= $ms) {
            $this->fail("expected an answer within {$ms} ms, took {$res->ms} ms", std::src::caller());
        }
        return $this;
    }

    /**
     * The body matches the test's next snapshot. A JSON body is stored pretty-printed, with each
     * path in `$redact` replaced first, so ids and timestamps do not break it. A redact path that
     * is malformed or matches nothing fails, and so does `$redact` on a body that is not JSON.
     */
    #[caller]
    public function snapshot(const array<string>& $redact = []) : Reply
    {
        $at = std::src::caller();
        $res = guard $this->answered($at) else {
            return $this;
        };

        $this->loadJson();
        json::Value $doc = guard $this->json->doc else {
            if (!$redact->empty()) {
                $this->fail("cannot redact a body that is not JSON ({$this->json->error})", $at);
                return $this;
            }
            ecotest::snapshot($res->body, at: $at);
            return $this;
        };
        $doc = $doc->clone();

        json::Value $mark = json::str('[redacted]');
        foreach ($redact as const &$path) {
            $steps = guard jsonpath::steps($path) else ($e) {
                $this->fail("cannot redact {$path}: {$e}", $at);
                return $this;
            };
            if (jsonpath::replace($doc, $steps, $mark) == 0) {
                $this->fail("cannot redact {$path}: it matches nothing", $at);
                return $this;
            }
        }

        string $text = json::pretty($doc);
        ecotest::snapshot($text, at: $at);
        return $this;
    }

    /**
     * The media type of a Content-Type value: everything before `;`, trimmed.
     */
    private static function media(const string& $value) : string
    {
        usize $semi = $value->find(';');
        if ($semi >= $value->size()) {
            return str::trim($value);
        }
        string $head = string($value->sub(0, $semi));
        return str::trim($head);
    }

    /**
     * The response, or null after failing the check with the transport's reason when there is none.
     */
    private const function answered(std::src::location $at) : Response?
    {
        ecotest::checked();

        match ($this->response) {
            .ok($res) => {
                return $res;
            },
            .error($e) => {
                $line = $this->request->line();
                ecotest::fail("no response to {$line}: {$e}", $at);
                return null;
            },
        };
    }

    /**
     * The response, or null when nothing came back.
     */
    private const function received() : Response?
    {
        return match ($this->response) {
            .ok($res) => $res,
            .error($e) => null,
        };
    }

    /**
     * Why nothing came back, in words. Empty when something did.
     */
    private const function reason() : string
    {
        return match ($this->response) {
            .ok($res) => '',
            .error($e) => "{$e}",
        };
    }

    /**
     * Parses the body once. Does not fail the check: callers that need a document say so.
     */
    private function loadJson() : void
    {
        if ($this->json->tried) {
            return;
        }
        $this->json->tried = true;
        $res = guard $this->received() else {
            return;
        };
        $doc = guard json::parse($res->body) else ($e) {
            $this->json->error = "{$e}";
            return;
        };
        $this->json->doc = $doc;
    }

    /**
     * The JSON body, parsed once. Null after failing the check when there is no response or the
     * body is not JSON.
     */
    private function parsed(std::src::location $at) : json::Value?
    {
        $res = guard $this->answered($at) else {
            return null;
        };
        $this->loadJson();
        json::Value $doc = guard $this->json->doc else {
            $this->fail("expected a JSON body ({$this->json->error})", $at);
            return null;
        };
        return $doc;
    }

    private function hits(const string& $path, std::src::location $at) : array<jsonpath::Hit>?
    {
        $doc = guard $this->parsed($at) else {
            return null;
        };

        $found = guard jsonpath::all($doc, $path) else ($e) {
            $this->fail("bad JSON path {$path}: {$e}", $at);
            return null;
        };
        return $found;
    }

    /**
     * Checks the status is `$code` and the media type is problem details. False after failing.
     */
    private const function isProblem(int64 $code, std::src::location $at) : bool
    {
        $res = guard $this->answered($at) else {
            return false;
        };

        if ($res->status != $code) {
            $this->fail("expected a {$code} problem, got status {$res->status}", $at);
            return false;
        }

        $got = $res->header('Content-Type') ?? '';
        string $media = Reply::media($got);
        if (!str::iequals($media->view(), 'application/problem+json')) {
            $this->fail("expected a {$code} problem as application/problem+json, got '{$got}'", $at);
            return false;
        }
        return true;
    }

    /**
     * Checks for a 422 problem whose errors refuse `$field` for `$rule`, any rule when it is empty.
     */
    private function refuses(const string& $field, const string& $rule, std::src::location $at) : void
    {
        if (!$this->isProblem(422, $at)) {
            return;
        }

        string $wanted = "{$field} refused";
        ordered_map<string, json::Value> $members = [self::ERROR_FIELD => json::str($field)];
        if (!$rule->empty()) {
            $wanted = "{$field} refused with {$rule}";
            $members[self::ERROR_RULE] = json::str($rule);
        }

        $found = guard $this->hits(self::ERRORS, $at) else {
            return;
        };
        if ($found->count() == 1 && $found[0]->value->isArray()) {
            if (Reply::itemWith($found[0]->value, $members) != null) {
                return;
            }
        }

        // what was refused instead, as `title (min), body (required)`
        array<string> $refused = [];
        foreach ($found as const &$hit) {
            foreach ($hit->value->asArray() ?? array<json::Value>() as const &$e) {
                string $f = $e->get(self::ERROR_FIELD)?->asStr() ?? '?';
                string $r = $e->get(self::ERROR_RULE)?->asStr() ?? '?';
                $refused[] = "{$f} ({$r})";
            }
        }
        string $got = 'nothing';
        if (!$refused->empty()) {
            $got = str::join($refused, ', ');
        }
        $this->fail("expected {$wanted}, got {$got}", $at);
    }

    /**
     * The first object in array `$list` that has every one of `$members` as the same JSON, or null.
     */
    private static function itemWith(const json::Value& $list, const ordered_map<string, json::Value>& $members) : json::Value?
    {
        foreach ($list->asArray() ?? array<json::Value>() as const &$item) {
            if (!$item->isObject()) {
                continue;
            }
            bool $all = true;
            foreach ($members as $k => const &$want) {
                $got = guard $item->get($k) else {
                    $all = false;
                    break;
                };
                if (!jsonpath::same($got, $want)) {
                    $all = false;
                    break;
                }
            }
            if ($all) {
                return $item->clone();
            }
        }
        return null;
    }

    /**
     * Checks that every value at `$path` is the same JSON as `$want`.
     */
    private function jsonIs(const string& $path, const json::Value& $want, std::src::location $at) : void
    {
        $found = guard $this->hits($path, $at) else {
            return;
        };

        if ($found->empty()) {
            $expected = "{$want}";
            $this->fail("expected {$path} = {$expected}, found nothing there", $at);
            return;
        }

        foreach ($found as const &$hit) {
            if (!jsonpath::same($hit->value, $want)) {
                $expected = "{$want}";
                $actual = "{$hit->value}";
                string $summary = "expected {$path} = {$expected}, got {$actual}";
                if ($found->count() > 1) {
                    $summary = "expected {$path} = {$expected}, got {$actual} at {$hit->path}";
                }
                ecotest::fail($summary, $at, $expected: $expected, $actual: $actual, $detail: $this->exchange());
                return;
            }
        }
    }

    /**
     * Fails the check with the exchange as the detail.
     */
    private const function fail(const string& $summary, std::src::location $at) : void
    {
        ecotest::fail($summary, $at, $detail: $this->exchange());
    }

    /**
     * The report to stop with, for a check that cannot continue.
     */
    private const function stopped(const string& $summary, std::src::location $at) : string
    {
        return ecotest::report($summary, $at, $detail: $this->exchange());
    }

    /**
     * The request line, the status, the headers and the start of the body. Only the request line
     * when nothing came back.
     */
    private const function exchange() : string
    {
        $out = $this->request->line();
        $res = guard $this->received() else {
            return $out;
        };
        $out->append("\n-> {$res->status} in {$res->ms} ms");

        foreach ($res->headers as const &$h) {
            $out->append("\n   {$h->name}: {$h->value}");
        }

        const string& $body = $res->body;
        if ($body->size() > 1200) {
            usize $more = $body->size() - 1200;
            $out->append("\n\n");
            $out->append($body->sub(0, 1200));
            $out->append("\n   ... {$more} more bytes");
        } else if (!$body->empty()) {
            $out->append("\n\n");
            $out->append($body);
        }

        return $out;
    }
}

/**
 * A JSON object holding `$fields` in their order.
 */
internal function objectOf(const ordered_map<string, json::Value>& $fields) : json::Value
{
    $o = json::object();
    foreach ($fields as $k => const &$v) {
        $o[$k] = $v->clone();
    }
    return $o;
}
