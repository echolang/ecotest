namespace ecotest::http;

use ecotest::http::jsonpath;

/**
 * One exchange and the checks on it. Each check names the test line that made it and, on failure,
 * shows the request line, the status, the headers and the start of the body. A request that got no
 * response at all fails the first check made on it.
 */
public class Reply
{
    /**
     * The request as it was sent.
     */
    public const Request $request;

    /**
     * What came back, or why nothing did.
     */
    public const result<Response, TransportError> $response;

    /**
     * The status is `$code`.
     */
    #[caller]
    public const function status(int64 $code) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        if ($res->status != $code) {
            $this->fail("expected status {$code}, got {$res->status}", std::src::caller());
        }
        return $this;
    }

    /**
     * The status is 2xx.
     */
    #[caller]
    public const function ok() : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        if ($res->status < 200 || $res->status > 299) {
            $this->fail("expected a 2xx status, got {$res->status}", std::src::caller());
        }
        return $this;
    }

    /**
     * A header called `$name`, compared without case, is `$value`. With several of that name, one
     * matching is enough.
     */
    #[caller]
    public const function header(const string& $name, const string& $value) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        $values = $res->headers($name);
        if ($values->empty()) {
            $this->fail("expected header {$name}: {$value}, it is missing", std::src::caller());
            return $this;
        }

        foreach ($values as const &$v) {
            if ($v == $value) {
                return $this;
            }
        }

        $got = str::join($values, ', ');
        $this->fail("expected header {$name}: {$value}, got {$got}", std::src::caller());
        return $this;
    }

    /**
     * The media type of the Content-Type is `$type`, compared without case: `application/json`
     * matches `application/json; charset=utf-8`.
     */
    #[caller]
    public const function type(const string& $type) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        $got = $res->header('Content-Type') ?? '';
        string $media = Reply::media($got);
        if (!str::iequals($media->view(), $type->view())) {
            $this->fail("expected Content-Type {$type}, got '{$got}'", std::src::caller());
        }
        return $this;
    }

    /**
     * The body is exactly `$text`.
     */
    #[caller]
    public const function body(const string& $text) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        if ($res->body != $text) {
            $this->fail('the body differs', std::src::caller());
        }
        return $this;
    }

    /**
     * The body contains `$part`.
     */
    #[caller]
    public const function has(const string& $part) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        if (!$res->body->contains($part)) {
            $this->fail("expected the body to contain '{$part}'", std::src::caller());
        }
        return $this;
    }

    /**
     * Every value at `$path` in the JSON body is the same JSON as `$want`: numbers by value,
     * objects whatever their key order.
     */
    #[caller]
    public const function json(const string& $path, const json::Value& $want) : Reply
    {
        $this->jsonIs($path, $want, std::src::caller());
        return $this;
    }

    /**
     * Every value at `$path` in the JSON body is the string `$want`.
     */
    #[caller]
    public const function json(const string& $path, const string& $want) : Reply
    {
        $this->jsonIs($path, json::str($want), std::src::caller());
        return $this;
    }

    /**
     * Every value at `$path` in the JSON body is the number `$want`.
     */
    #[caller]
    public const function json(const string& $path, int64 $want) : Reply
    {
        $this->jsonIs($path, json::int($want), std::src::caller());
        return $this;
    }

    /**
     * Every value at `$path` in the JSON body is the number `$want`.
     */
    #[caller]
    public const function json(const string& $path, float64 $want) : Reply
    {
        $this->jsonIs($path, json::float($want), std::src::caller());
        return $this;
    }

    /**
     * Every value at `$path` in the JSON body is the boolean `$want`.
     */
    #[caller]
    public const function json(const string& $path, bool $want) : Reply
    {
        $this->jsonIs($path, json::bool($want), std::src::caller());
        return $this;
    }

    /**
     * Every value at `$path` in the JSON body is JSON `null`.
     */
    #[caller]
    public const function isNull(const string& $path) : Reply
    {
        $this->jsonIs($path, json::nil(), std::src::caller());
        return $this;
    }

    /**
     * Something exists at `$path` in the JSON body.
     */
    #[caller]
    public const function present(const string& $path) : Reply
    {
        $found = guard $this->hits($path, std::src::caller()) else {
            return $this;
        };

        if ($found->empty()) {
            $this->fail("expected a value at {$path}", std::src::caller());
        }
        return $this;
    }

    /**
     * Every value at `$path` in the JSON body is an array of `$count` items.
     */
    #[caller]
    public const function count(const string& $path, usize $count) : Reply
    {
        $found = guard $this->hits($path, std::src::caller()) else {
            return $this;
        };

        if ($found->empty()) {
            $this->fail("expected {$count} items at {$path}, found nothing there", std::src::caller());
            return $this;
        }

        foreach ($found as const &$hit) {
            if (!$hit->value->isArray()) {
                $shown = "{$hit->value}";
                $this->fail("expected {$count} items at {$hit->path}, got {$shown}, not an array", std::src::caller());
                return $this;
            }
            usize $got = $hit->value->count();
            if ($got != $count) {
                $this->fail("expected {$count} items at {$hit->path}, got {$got}", std::src::caller());
                return $this;
            }
        }
        return $this;
    }

    /**
     * Every value at `$path` passes `$test`. `says:` names what they should be.
     */
    #[caller]
    public const function matches(const string& $path, function<bool(const json::Value&)> $test, says: const string& $what = '') : Reply
    {
        $found = guard $this->hits($path, std::src::caller()) else {
            return $this;
        };

        if ($found->empty()) {
            $this->fail("expected a value at {$path}", std::src::caller());
            return $this;
        }

        foreach ($found as const &$hit) {
            if (!$test($hit->value)) {
                $shown = "{$hit->value}";
                $summary = "{$hit->path} = {$shown} failed the test";
                if (!$what->empty()) {
                    $summary = "expected {$hit->path} to be {$what}, got {$shown}";
                }
                $this->fail($summary, std::src::caller());
                return $this;
            }
        }
        return $this;
    }

    /**
     * The one value at `$path`, as text, for the next request: a string as itself, anything else
     * as its JSON. Stops the test when there is no JSON body, when the path is malformed, or when
     * it names no value or several.
     */
    #[caller]
    public const function capture(const string& $path) : string
    {
        $at = std::src::caller();
        ecotest::Session::checked();

        $res = guard $this->received() else {
            $line = $this->request->line();
            $why = $this->reason();
            die($this->stopped("cannot capture {$path}: no response to {$line}: {$why}", $at), $at);
        };

        $doc = guard json::parse($res->body) else ($e) {
            die($this->stopped("cannot capture {$path}: the body is not JSON ({$e})", $at), $at);
        };

        $found = guard jsonpath::all($doc, $path) else ($e) {
            die($this->stopped("cannot capture {$path}: {$e}", $at), $at);
        };

        if ($found->empty()) {
            die($this->stopped("cannot capture {$path}: nothing there", $at), $at);
        }
        if ($found->count() > 1) {
            usize $n = $found->count();
            die($this->stopped("cannot capture {$path}: it names {$n} values", $at), $at);
        }

        const json::Value& $v = $found[0]->value;
        return $v->asStr() ?? "{$v}";
    }

    /**
     * The exchange took less than `$ms` milliseconds.
     */
    #[caller]
    public const function faster(than: int64 $ms) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        if ($res->ms >= $ms) {
            $this->fail("expected an answer within {$ms} ms, took {$res->ms} ms", std::src::caller());
        }
        return $this;
    }

    /**
     * The body matches the test's next snapshot. A JSON body is stored pretty-printed, with each
     * path in `$redact` replaced first, so ids and timestamps do not break it. A redact path that
     * is malformed or matches nothing fails, and so does `$redact` on a body that is not JSON.
     */
    #[caller]
    public const function snapshot(const array<string>& $redact = []) : Reply
    {
        $at = std::src::caller();
        $res = guard $this->answered($at) else {
            return $this;
        };

        $doc = guard json::parse($res->body) else ($e) {
            if (!$redact->empty()) {
                $this->fail("cannot redact a body that is not JSON ({$e})", $at);
                return $this;
            }
            ecotest::snapshot($res->body, at: $at);
            return $this;
        };

        json::Value $mark = json::str('[redacted]');
        foreach ($redact as const &$path) {
            $steps = guard jsonpath::steps($path) else ($e) {
                $this->fail("cannot redact {$path}: {$e}", $at);
                return $this;
            };
            if (jsonpath::replace($doc, $steps, $mark) == 0) {
                $this->fail("cannot redact {$path}: it matches nothing", $at);
                return $this;
            }
        }

        string $text = json::pretty($doc);
        ecotest::snapshot($text, at: $at);
        return $this;
    }

    /**
     * The media type of a Content-Type value: everything before `;`, trimmed.
     */
    private static function media(const string& $value) : string
    {
        usize $semi = $value->find(';');
        if ($semi >= $value->size()) {
            return str::trim($value);
        }
        string $head = string($value->sub(0, $semi));
        return str::trim($head);
    }

    /**
     * The response, or null after failing the check with the transport's reason when there is none.
     */
    private const function answered(std::src::location $at) : Response?
    {
        ecotest::Session::checked();

        match ($this->response) {
            .ok($res) => {
                return $res;
            },
            .error($e) => {
                $line = $this->request->line();
                ecotest::Failure("no response to {$line}: {$e}", $at)->raise();
                return null;
            },
        };
    }

    /**
     * The response, or null when nothing came back.
     */
    private const function received() : Response?
    {
        return match ($this->response) {
            .ok($res) => $res,
            .error($e) => null,
        };
    }

    /**
     * Why nothing came back, in words. Empty when something did.
     */
    private const function reason() : string
    {
        return match ($this->response) {
            .ok($res) => '',
            .error($e) => "{$e}",
        };
    }

    /**
     * Every value `$path` names in the JSON body, or null after failing the check because there is
     * no response, the body is not JSON, or the path is malformed.
     */
    private const function hits(const string& $path, std::src::location $at) : array<jsonpath::Hit>?
    {
        $res = guard $this->answered($at) else {
            return null;
        };

        $doc = guard json::parse($res->body) else ($e) {
            $this->fail("expected a JSON body ({$e})", $at);
            return null;
        };

        $found = guard jsonpath::all($doc, $path) else ($e) {
            $this->fail("bad JSON path {$path}: {$e}", $at);
            return null;
        };
        return $found;
    }

    /**
     * Checks that every value at `$path` is the same JSON as `$want`.
     */
    private const function jsonIs(const string& $path, const json::Value& $want, std::src::location $at) : void
    {
        $found = guard $this->hits($path, $at) else {
            return;
        };

        if ($found->empty()) {
            $expected = "{$want}";
            $this->fail("expected {$path} = {$expected}, found nothing there", $at);
            return;
        }

        foreach ($found as const &$hit) {
            if (!jsonpath::same($hit->value, $want)) {
                $expected = "{$want}";
                $actual = "{$hit->value}";
                string $summary = "expected {$path} = {$expected}, got {$actual}";
                if ($found->count() > 1) {
                    $summary = "expected {$path} = {$expected}, got {$actual} at {$hit->path}";
                }
                ecotest::Failure($summary, $at, $expected: $expected, $actual: $actual, $detail: $this->exchange(), $inline: true)->raise();
                return;
            }
        }
    }

    /**
     * Fails the check with the exchange as the detail.
     */
    private const function fail(const string& $summary, std::src::location $at) : void
    {
        ecotest::Failure($summary, $at, $detail: $this->exchange())->raise();
    }

    /**
     * Reports a failure with the exchange as the detail, for a check that stops the test.
     */
    private const function stopped(const string& $summary, std::src::location $at) : string
    {
        return ecotest::Session::report(ecotest::Failure($summary, $at, $detail: $this->exchange()));
    }

    /**
     * The request line, the status, the headers and the start of the body. Only the request line
     * when nothing came back.
     */
    private const function exchange() : string
    {
        $out = $this->request->line();
        $res = guard $this->received() else {
            return $out;
        };
        $out->append("\n-> {$res->status} in {$res->ms} ms");

        foreach ($res->headers as const &$h) {
            $out->append("\n   {$h->name}: {$h->value}");
        }

        const string& $body = $res->body;
        if ($body->size() > 1200) {
            usize $more = $body->size() - 1200;
            $out->append("\n\n");
            $out->append($body->sub(0, 1200));
            $out->append("\n   ... {$more} more bytes");
        } else if (!$body->empty()) {
            $out->append("\n\n");
            $out->append($body);
        }

        return $out;
    }
}
