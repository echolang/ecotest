namespace ecotest::http;

/**
 * One exchange and the checks on it. Each check names the test line that made it and, on failure,
 * shows the request line, the status, the headers and the start of the body. A request that got no
 * response at all fails the first check made on it.
 */
public class Reply
{
    public Request $request;
    public Response $response;
    public string $error = '';

    public constructor(Request $request, Response $response, const string& $error)
    {
        $this->request = $request;
        $this->response = $response;
        $this->error = $error;
    }

    /**
     * The status is `$code`.
     */
    #[caller]
    public function status(int64 $code) : Reply
    {
        if (!$this->answered(std::src::caller())) {
            return $this;
        }

        if ($this->response->status != $code) {
            $this->fail("expected status {$code}, got {$this->response->status}", std::src::caller());
        }
        return $this;
    }

    /**
     * The status is 2xx.
     */
    #[caller]
    public function ok() : Reply
    {
        if (!$this->answered(std::src::caller())) {
            return $this;
        }

        if ($this->response->status < 200 || $this->response->status > 299) {
            $this->fail("expected a 2xx status, got {$this->response->status}", std::src::caller());
        }
        return $this;
    }

    /**
     * Header `$name` is `$value`.
     */
    #[caller]
    public function header(const string& $name, const string& $value) : Reply
    {
        if (!$this->answered(std::src::caller())) {
            return $this;
        }

        string $actual = guard $this->response->header($name) else {
            $this->fail("expected header {$name}: {$value}, it is missing", std::src::caller());
            return $this;
        };

        if ($actual != $value) {
            $this->fail("expected header {$name}: {$value}, got {$actual}", std::src::caller());
        }
        return $this;
    }

    /**
     * The Content-Type starts with `$type`, so `application/json` matches one with a charset.
     */
    #[caller]
    public function type(const string& $type) : Reply
    {
        if (!$this->answered(std::src::caller())) {
            return $this;
        }

        string $got = $this->response->header('Content-Type') ?? '';
        if (!$got->starts($type)) {
            $this->fail("expected Content-Type {$type}, got '{$got}'", std::src::caller());
        }
        return $this;
    }

    /**
     * The body is exactly `$text`.
     */
    #[caller]
    public function body(const string& $text) : Reply
    {
        if (!$this->answered(std::src::caller())) {
            return $this;
        }

        if ($this->response->body != $text) {
            $this->fail('the body differs', std::src::caller());
        }
        return $this;
    }

    /**
     * The body contains `$part`.
     */
    #[caller]
    public function has(const string& $part) : Reply
    {
        if (!$this->answered(std::src::caller())) {
            return $this;
        }

        if (!$this->response->body->contains($part)) {
            $this->fail("expected the body to contain '{$part}'", std::src::caller());
        }
        return $this;
    }

    /**
     * The string at `$path` in the JSON body is `$want`.
     */
    #[caller]
    public function json(const string& $path, const string& $want) : Reply
    {
        $this->jsonIs($path, json::str($want), std::src::caller());
        return $this;
    }

    /**
     * The integer at `$path` in the JSON body is `$want`.
     */
    #[caller]
    public function json(const string& $path, int64 $want) : Reply
    {
        $this->jsonIs($path, json::int($want), std::src::caller());
        return $this;
    }

    /**
     * The number at `$path` in the JSON body is `$want`.
     */
    #[caller]
    public function json(const string& $path, float64 $want) : Reply
    {
        $this->jsonIs($path, json::float($want), std::src::caller());
        return $this;
    }

    /**
     * The boolean at `$path` in the JSON body is `$want`.
     */
    #[caller]
    public function json(const string& $path, bool $want) : Reply
    {
        $this->jsonIs($path, json::bool($want), std::src::caller());
        return $this;
    }

    /**
     * The value at `$path` in the JSON body is JSON `null`.
     */
    #[caller]
    public function isNull(const string& $path) : Reply
    {
        $this->jsonIs($path, json::nil(), std::src::caller());
        return $this;
    }

    /**
     * Something exists at `$path` in the JSON body.
     */
    #[caller]
    public function present(const string& $path) : Reply
    {
        json::Value $d = guard $this->document(std::src::caller()) else {
            return $this;
        };

        if (JsonPath::all($d, $path)->empty()) {
            $this->fail("expected a value at {$path}", std::src::caller());
        }
        return $this;
    }

    /**
     * The array at `$path` in the JSON body holds `$count` items.
     */
    #[caller]
    public function count(const string& $path, usize $count) : Reply
    {
        json::Value $d = guard $this->document(std::src::caller()) else {
            return $this;
        };

        json::Value $v = guard JsonPath::one($d, $path) else {
            $this->fail("expected {$count} items at {$path}, found nothing there", std::src::caller());
            return $this;
        };

        usize $got = $v->count();
        if (!$v->isArray() || $got != $count) {
            $this->fail("expected {$count} items at {$path}, got {$got}", std::src::caller());
        }
        return $this;
    }

    /**
     * Every value at `$path` passes `$test`. `says:` names what they should be.
     */
    #[caller]
    public function matches(const string& $path, function<bool(const json::Value&)> $test, says: string $what = '') : Reply
    {
        json::Value $d = guard $this->document(std::src::caller()) else {
            return $this;
        };

        array<json::Value> $found = JsonPath::all($d, $path);
        if ($found->empty()) {
            $this->fail("expected a value at {$path}", std::src::caller());
            return $this;
        }

        foreach ($found as const &$value) {
            if (!$test($value)) {
                string $shown = JsonPath::show($value);
                string $summary = "{$path} = {$shown} failed the test";
                if (!$what->empty()) {
                    $summary = "expected {$path} to be {$what}, got {$shown}";
                }
                $this->fail($summary, std::src::caller());
                return $this;
            }
        }
        return $this;
    }

    /**
     * The value at `$path`, as text, for the next request: a string as itself, anything else as
     * its JSON. Stops the test when nothing is there.
     */
    #[caller]
    public function capture(const string& $path) : string
    {
        std::src::location $at = std::src::caller();

        json::Value $d = guard $this->document($at) else {
            die($this->stopped("cannot capture {$path}: the body is not JSON", $at), $at);
        };

        json::Value $v = guard JsonPath::one($d, $path) else {
            die($this->stopped("cannot capture {$path}: nothing there", $at), $at);
        };

        return $v->asStr() ?? JsonPath::show($v);
    }

    /**
     * The exchange took less than `$ms` milliseconds.
     */
    #[caller]
    public function faster(than: int64 $ms) : Reply
    {
        if (!$this->answered(std::src::caller())) {
            return $this;
        }

        if ($this->response->ms >= $ms) {
            $this->fail("expected an answer within {$ms} ms, took {$this->response->ms} ms", std::src::caller());
        }
        return $this;
    }

    /**
     * The body matches the test's next snapshot. A JSON body is stored pretty-printed, with each
     * path in `$redact` replaced first, so ids and timestamps do not break it.
     */
    #[caller]
    public function snapshot(array<string> $redact = []) : Reply
    {
        if (!$this->answered(std::src::caller())) {
            return $this;
        }

        string $text = $this->response->body;
        result<json::Value, json::Error> $parsed = json::parse($text);
        if (!$parsed->failed()) {
            json::Value $doc = $parsed->unwrap();
            foreach ($redact as const &$path) {
                JsonPath::replace($doc, $path, json::str('[redacted]'));
            }
            $text = json::pretty($doc);
        }

        ecotest::expect($text)->snapshot();
        return $this;
    }

    /**
     * True when there was a response. Otherwise the check fails with the transport's reason.
     */
    private function answered(std::src::location $at) : bool
    {
        ecotest::Session::checked();

        if ($this->error->empty()) {
            return true;
        }

        string $line = $this->request->line();
        ecotest::Failure("no response to {$line}: {$this->error}", $at)->raise();
        return false;
    }

    /**
     * The body as JSON, or null after failing the check because it is not.
     */
    private function document(std::src::location $at) : json::Value?
    {
        if (!$this->answered($at)) {
            return null;
        }

        result<json::Value, json::Error> $parsed = json::parse($this->response->body);
        if ($parsed->failed()) {
            string $why = $parsed->failure()->message();
            $this->fail("expected a JSON body ({$why})", $at);
            return null;
        }

        return $parsed->unwrap();
    }

    /**
     * Compares the value at `$path` with `$want`.
     */
    private function jsonIs(const string& $path, const json::Value& $want, std::src::location $at) : void
    {
        json::Value $d = guard $this->document($at) else {
            return;
        };

        string $expected = JsonPath::show($want);
        json::Value $v = guard JsonPath::one($d, $path) else {
            $this->fail("expected {$path} = {$expected}, found nothing there", $at);
            return;
        };

        string $actual = JsonPath::show($v);
        if ($actual != $expected) {
            $this->fail("expected {$path} = {$expected}, got {$actual}", $at);
        }
    }

    /**
     * Fails the check with the exchange as the detail.
     */
    private function fail(const string& $summary, std::src::location $at) : void
    {
        ecotest::Failure($summary, $at, $detail: $this->exchange())->raise();
    }

    /**
     * Records a failure that stops the test, for checks that return a value, and answers the report
     * to stop with.
     */
    private function stopped(const string& $summary, std::src::location $at) : string
    {
        return ecotest::Session::report(ecotest::Failure($summary, $at, $detail: $this->exchange()));
    }

    /**
     * The request line, the status, the headers and the start of the body.
     */
    private const function exchange() : string
    {
        string $out = $this->request->line();
        $out->append("\n-> {$this->response->status} in {$this->response->ms} ms");

        for (usize $i = 0; $i < $this->response->headerNames->count(); $i++) {
            string $name = $this->response->headerNames[$i];
            string $value = $this->response->headerValues[$i];
            $out->append("\n   {$name}: {$value}");
        }

        string $body = $this->response->body;
        if ($body->size() > 1200) {
            string $cut = $body->sub(0, 1200);
            $cut->append("\n   ... ");
            usize $more = $body->size() - 1200;
            $cut->append("{$more} more bytes");
            $body = $cut;
        }

        if (!$body->empty()) {
            $out->append("\n\n");
            $out->append($body);
        }

        return $out;
    }
}
