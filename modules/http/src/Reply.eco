namespace ecotest::http;

use ecotest::http::jsonpath;

/**
 * One exchange and the checks on it. Each check names the test line that made it and, on failure,
 * shows the request line, the status, the headers and the start of the body. A request that got no
 * response at all fails the first check made on it.
 */
public class Reply
{
    /**
     * The request as it was sent.
     */
    public const Request $request;

    /**
     * What came back, or why nothing did.
     */
    public const result<Response, TransportError> $response;

    /**
     * The status is `$code`.
     */
    #[caller]
    public const function status(int64 $code) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        if ($res->status != $code) {
            $this->fail("expected status {$code}, got {$res->status}", std::src::caller());
        }
        return $this;
    }

    /**
     * The status is 2xx.
     */
    #[caller]
    public const function ok() : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        if ($res->status < 200 || $res->status > 299) {
            $this->fail("expected a 2xx status, got {$res->status}", std::src::caller());
        }
        return $this;
    }

    /**
     * Header `$name` is `$value`.
     */
    #[caller]
    public const function header(const string& $name, const string& $value) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        $actual = guard $res->header($name) else {
            $this->fail("expected header {$name}: {$value}, it is missing", std::src::caller());
            return $this;
        };

        if ($actual != $value) {
            $this->fail("expected header {$name}: {$value}, got {$actual}", std::src::caller());
        }
        return $this;
    }

    /**
     * The Content-Type starts with `$type`, so `application/json` matches one with a charset.
     */
    #[caller]
    public const function type(const string& $type) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        $got = $res->header('Content-Type') ?? '';
        if (!$got->starts($type)) {
            $this->fail("expected Content-Type {$type}, got '{$got}'", std::src::caller());
        }
        return $this;
    }

    /**
     * The body is exactly `$text`.
     */
    #[caller]
    public const function body(const string& $text) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        if ($res->body != $text) {
            $this->fail('the body differs', std::src::caller());
        }
        return $this;
    }

    /**
     * The body contains `$part`.
     */
    #[caller]
    public const function has(const string& $part) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        if (!$res->body->contains($part)) {
            $this->fail("expected the body to contain '{$part}'", std::src::caller());
        }
        return $this;
    }

    /**
     * The string at `$path` in the JSON body is `$want`.
     */
    #[caller]
    public const function json(const string& $path, const string& $want) : Reply
    {
        $this->jsonIs($path, json::str($want), std::src::caller());
        return $this;
    }

    /**
     * The integer at `$path` in the JSON body is `$want`.
     */
    #[caller]
    public const function json(const string& $path, int64 $want) : Reply
    {
        $this->jsonIs($path, json::int($want), std::src::caller());
        return $this;
    }

    /**
     * The number at `$path` in the JSON body is `$want`.
     */
    #[caller]
    public const function json(const string& $path, float64 $want) : Reply
    {
        $this->jsonIs($path, json::float($want), std::src::caller());
        return $this;
    }

    /**
     * The boolean at `$path` in the JSON body is `$want`.
     */
    #[caller]
    public const function json(const string& $path, bool $want) : Reply
    {
        $this->jsonIs($path, json::bool($want), std::src::caller());
        return $this;
    }

    /**
     * The value at `$path` in the JSON body is JSON `null`.
     */
    #[caller]
    public const function isNull(const string& $path) : Reply
    {
        $this->jsonIs($path, json::nil(), std::src::caller());
        return $this;
    }

    /**
     * Something exists at `$path` in the JSON body.
     */
    #[caller]
    public const function present(const string& $path) : Reply
    {
        $d = guard $this->document(std::src::caller()) else {
            return $this;
        };

        if (jsonpath::all($d, $path)->empty()) {
            $this->fail("expected a value at {$path}", std::src::caller());
        }
        return $this;
    }

    /**
     * The array at `$path` in the JSON body holds `$count` items.
     */
    #[caller]
    public const function count(const string& $path, usize $count) : Reply
    {
        $d = guard $this->document(std::src::caller()) else {
            return $this;
        };

        $v = guard jsonpath::one($d, $path) else {
            $this->fail("expected {$count} items at {$path}, found nothing there", std::src::caller());
            return $this;
        };

        usize $got = $v->count();
        if (!$v->isArray() || $got != $count) {
            $this->fail("expected {$count} items at {$path}, got {$got}", std::src::caller());
        }
        return $this;
    }

    /**
     * Every value at `$path` passes `$test`. `says:` names what they should be.
     */
    #[caller]
    public const function matches(const string& $path, function<bool(const json::Value&)> $test, says: const string& $what = '') : Reply
    {
        $d = guard $this->document(std::src::caller()) else {
            return $this;
        };

        $found = jsonpath::all($d, $path);
        if ($found->empty()) {
            $this->fail("expected a value at {$path}", std::src::caller());
            return $this;
        }

        foreach ($found as const &$value) {
            if (!$test($value)) {
                $shown = "{$value}";
                $summary = "{$path} = {$shown} failed the test";
                if (!$what->empty()) {
                    $summary = "expected {$path} to be {$what}, got {$shown}";
                }
                $this->fail($summary, std::src::caller());
                return $this;
            }
        }
        return $this;
    }

    /**
     * The value at `$path`, as text, for the next request: a string as itself, anything else as
     * its JSON. Stops the test when nothing is there.
     */
    #[caller]
    public const function capture(const string& $path) : string
    {
        $at = std::src::caller();

        $d = guard $this->document($at) else {
            die($this->stopped("cannot capture {$path}: the body is not JSON", $at), $at);
        };

        $v = guard jsonpath::one($d, $path) else {
            die($this->stopped("cannot capture {$path}: nothing there", $at), $at);
        };

        return $v->asStr() ?? "{$v}";
    }

    /**
     * The exchange took less than `$ms` milliseconds.
     */
    #[caller]
    public const function faster(than: int64 $ms) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        if ($res->ms >= $ms) {
            $this->fail("expected an answer within {$ms} ms, took {$res->ms} ms", std::src::caller());
        }
        return $this;
    }

    /**
     * The body matches the test's next snapshot. A JSON body is stored pretty-printed, with each
     * path in `$redact` replaced first, so ids and timestamps do not break it.
     */
    #[caller]
    public const function snapshot(const array<string>& $redact = []) : Reply
    {
        $res = guard $this->answered(std::src::caller()) else {
            return $this;
        };

        ecotest::expect(Reply::stored($res->body, $redact))->snapshot();
        return $this;
    }

    /**
     * The text a snapshot of `$body` keeps: JSON pretty-printed with each path in `$redact`
     * replaced, anything else as it is.
     */
    private static function stored(const string& $body, const array<string>& $redact) : string
    {
        $doc = guard json::parse($body) else {
            return $body;
        };

        foreach ($redact as const &$path) {
            jsonpath::replace($doc, $path, json::str('[redacted]'));
        }
        return json::pretty($doc);
    }

    /**
     * The response, or null after failing the check with the transport's reason when there is none.
     */
    private const function answered(std::src::location $at) : Response?
    {
        ecotest::Session::checked();

        match ($this->response) {
            .ok($res) => {
                return $res;
            },
            .error($e) => {
                $line = $this->request->line();
                ecotest::Failure("no response to {$line}: {$e}", $at)->raise();
                return null;
            },
        };
    }

    /**
     * The response, or null when nothing came back.
     */
    private const function received() : Response?
    {
        return match ($this->response) {
            .ok($res) => $res,
            .error($e) => null,
        };
    }

    /**
     * The body as JSON, or null after failing the check because it is not.
     */
    private const function document(std::src::location $at) : json::Value?
    {
        $res = guard $this->answered($at) else {
            return null;
        };

        $doc = guard json::parse($res->body) else ($e) {
            $this->fail("expected a JSON body ({$e})", $at);
            return null;
        };
        return $doc;
    }

    /**
     * Compares the value at `$path` with `$want`.
     */
    private const function jsonIs(const string& $path, const json::Value& $want, std::src::location $at) : void
    {
        $d = guard $this->document($at) else {
            return;
        };

        $expected = "{$want}";
        $v = guard jsonpath::one($d, $path) else {
            $this->fail("expected {$path} = {$expected}, found nothing there", $at);
            return;
        };

        $actual = "{$v}";
        if ($actual != $expected) {
            $this->fail("expected {$path} = {$expected}, got {$actual}", $at);
        }
    }

    /**
     * Fails the check with the exchange as the detail.
     */
    private const function fail(const string& $summary, std::src::location $at) : void
    {
        ecotest::Failure($summary, $at, $detail: $this->exchange())->raise();
    }

    /**
     * Reports a failure with the exchange as the detail, for a check that stops the test.
     */
    private const function stopped(const string& $summary, std::src::location $at) : string
    {
        return ecotest::Session::report(ecotest::Failure($summary, $at, $detail: $this->exchange()));
    }

    /**
     * The request line, the status, the headers and the start of the body. Only the request line
     * when nothing came back.
     */
    private const function exchange() : string
    {
        $out = $this->request->line();
        $res = guard $this->received() else {
            return $out;
        };
        $out->append("\n-> {$res->status} in {$res->ms} ms");

        foreach ($res->headers as const &$h) {
            $out->append("\n   {$h->name}: {$h->value}");
        }

        const string& $body = $res->body;
        if ($body->size() > 1200) {
            usize $more = $body->size() - 1200;
            $out->append("\n\n");
            $out->append($body->sub(0, 1200));
            $out->append("\n   ... {$more} more bytes");
        } else if (!$body->empty()) {
            $out->append("\n\n");
            $out->append($body);
        }

        return $out;
    }
}
