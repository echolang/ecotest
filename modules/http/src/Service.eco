namespace ecotest::http;

/**
 * A service a single test starts and stops itself: the program runs until the value goes. For
 * services shared by many tests, list them in `ecotest.json` and use `Api(service:)` instead.
 */
public class Service
{
    public const string $url;
    private std::process::child $child;

    /**
     * Starts `$program` with `$arguments`, then waits until `$ready` answers with a 2xx or 3xx, at
     * most `within`. `$url` is the base URL tests use. Stops the test when it never gets ready.
     */
    #[caller]
    public constructor(
        const string& $program,
        const array<string>& $arguments,
        ready: const string& $ready,
        url: const string& $url,
        within: std::time::duration $limit = .secs(10)
    ) {
        $at = std::src::caller();
        $this->url = $url;

        $cmd = std::process::command($program, $arguments);
        $cmd->stdout(.discard);
        $cmd->stderr(.discard);

        $child = guard $cmd->spawn() else ($e) {
            die(ecotest::Session::report(ecotest::Failure("cannot start {$program}: {$e}", $at)), $at);
        };
        $this->child = mv $child;

        $started = std::time::instant::now();
        while ($started->elapsed()->as_millis() < $limit->as_millis()) {
            $probe = curl::Request::get($ready);
            $probe->timeout(500);
            $answer = guard curl::send($probe) else {
                std::time::sleep(.millis(50));
                continue;
            };
            if ($answer->status >= 200 && $answer->status < 400) {
                return;
            }
            std::time::sleep(.millis(50));
        }

        int64 $ms = $limit->as_millis();
        ecotest::Failure("{$program} was not ready at {$ready} within {$ms} ms", $at)->stop();
    }

    /**
     * An `Api` for this service.
     */
    public const function api() : Api
    {
        return Api($this->url);
    }

    destructor()
    {
        $killed = $this->child->kill();
        $waited = $this->child->wait();
    }
}
