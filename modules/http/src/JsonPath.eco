/**
 * A small JSON path: `$.items[0].name`, `$.items[*].id`, `$['odd key']`. The leading `$` is
 * optional. `[*]` fans out over an array, so a path can name several values. Anything outside
 * this grammar is a `PathError`, never a shorter path.
 */

namespace ecotest::http::jsonpath;

/**
 * One step of a path.
 */
public enum Step
{
    /**
     * The member `$name` of an object.
     */
    case key(string $name);

    /**
     * The item at `$at` of an array.
     */
    case index(usize $at);

    /**
     * Every item of an array.
     */
    case all;
}

/**
 * Why a path could not be read. Each case carries the byte offset where reading stopped.
 */
public enum PathError
{
    /**
     * A `[` or a quote that is never closed.
     */
    case unclosed(usize $at);

    /**
     * A step with nothing in it: `$.`, `$..`, `[]`, or an empty path.
     */
    case empty(usize $at);

    /**
     * A bracket that holds neither `*`, digits, nor a quoted key.
     */
    case badIndex(usize $at);

    /**
     * Text where the next step should start.
     */
    case trailing(usize $at);

    /**
     * `..`, recursive descent, which this grammar leaves out.
     */
    case descent(usize $at);
}

/**
 * One value a path names, with the concrete path that reaches it: `$.items[1].id` for a hit of
 * `$.items[*].id`.
 */
public struct Hit
{
    /**
     * The path to this one value, with every wildcard resolved to its index.
     */
    public string $path;

    /**
     * The value. Arrays and objects share their storage with the document.
     */
    public json::Value $value;
}

/**
 * The steps of `$path`, or where it breaks the grammar.
 */
public function steps(const string& $path) : result<array<Step>, PathError>
{
    array<Step> $out = [];
    usize $n = $path->size();

    if ($n == 0) {
        return .error(.empty(0));
    }

    usize $i = 0;
    if ($path->byte(0) == 36) {
        $i = 1;
    } else if ($path->byte(0) != 46 && $path->byte(0) != 91) {
        // a bare first key, as in `a.b`
        usize $end = nameEnd($path, 0);
        if ($end < $n && $path->byte($end) == 93) {
            return .error(.trailing($end));
        }
        $out[] = .key(string($path->sub(0, $end)));
        $i = $end;
    }

    while ($i < $n) {
        uint8 $c = $path->byte($i);

        if ($c == 46) {
            if ($i + 1 < $n && $path->byte($i + 1) == 46) {
                return .error(.descent($i));
            }
            usize $end = nameEnd($path, $i + 1);
            if ($end < $n && $path->byte($end) == 93) {
                return .error(.trailing($end));
            }
            if ($end == $i + 1) {
                return .error(.empty($i));
            }
            $out[] = .key(string($path->sub($i + 1, $end - $i - 1)));
            $i = $end;
            continue;
        }

        if ($c != 91) {
            return .error(.trailing($i));
        }

        if ($i + 1 >= $n) {
            return .error(.unclosed($i));
        }

        uint8 $quote = $path->byte($i + 1);
        if ($quote == 39 || $quote == 34) {
            string $name = '';
            usize $j = $i + 2;
            bool $closed = false;
            while ($j < $n) {
                uint8 $b = $path->byte($j);
                if ($b == 92 && $j + 1 < $n) {
                    uint8 $next = $path->byte($j + 1);
                    if ($next == 39 || $next == 34 || $next == 92) {
                        $name->push($next);
                        $j = $j + 2;
                        continue;
                    }
                }
                if ($b == $quote) {
                    $closed = true;
                    break;
                }
                $name->push($b);
                $j++;
            }
            if (!$closed || $j + 1 >= $n) {
                return .error(.unclosed($i));
            }
            if ($path->byte($j + 1) != 93) {
                return .error(.trailing($j + 1));
            }
            $out[] = .key($name);
            $i = $j + 2;
            continue;
        }

        usize $close = $path->find(']', $i);
        if ($close >= $n) {
            return .error(.unclosed($i));
        }
        if ($close == $i + 1) {
            return .error(.empty($i));
        }

        $inner = string($path->sub($i + 1, $close - $i - 1));
        if ($inner == '*') {
            $out[] = .all;
        } else {
            if (!digits($inner)) {
                return .error(.badIndex($i + 1));
            }
            uint64 $at = guard str::uint($inner) else {
                return .error(.badIndex($i + 1));
            };
            $out[] = .index($at as usize);
        }
        $i = $close + 1;
    }

    return .ok(mv $out);
}

/**
 * `$steps` written back as a path: `$.a[0]['odd key'][*]`.
 */
public function render(const array<Step>& $steps) : string
{
    string $out = '$';
    foreach ($steps as const &$step) {
        $out->append(str::from($step));
    }
    return $out;
}

/**
 * Every value `$steps` reach in `$doc`, each with its concrete path. Empty when they lead nowhere.
 * `[*]` matches the items of an array and nothing else.
 */
public function find(const json::Value& $doc, const array<Step>& $steps) : array<Hit>
{
    array<Hit> $current = [Hit('$', $doc)];

    foreach ($steps as const &$step) {
        array<Hit> $next = [];
        string $suffix = str::from($step);

        foreach ($current as const &$hit) {
            match ($step) {
                .key($name) => {
                    reach($next, $hit, $hit->value->get($name), $suffix);
                },
                .index($at) => {
                    reach($next, $hit, $hit->value->at($at), $suffix);
                },
                .all => {
                    fanOut($next, $hit);
                },
            };
        }

        $current = mv $next;
    }

    return $current;
}

/**
 * Every value `$path` names in `$doc`, or why the path cannot be read.
 */
public function all(const json::Value& $doc, const string& $path) : result<array<Hit>, PathError>
{
    $parsed = guard steps($path) else ($e) {
        return .error($e);
    };
    return .ok(find($doc, $parsed));
}

/**
 * Replaces every value `$steps` reach in `$doc` with a copy of `$with`, in place, and answers how
 * many it replaced. For snapshots with fields that change on every run. Nothing is created: a key
 * or an index that is not there is left alone.
 */
public function replace(json::Value& $doc, const array<Step>& $steps, const json::Value& $with) : usize
{
    if ($steps->empty()) {
        $doc = $with->clone();
        return 1;
    }

    // the parents of the last step; their arrays and objects share storage with `$doc`
    array<Step> $prefix = [];
    for (usize $k = 0; $k + 1 < $steps->count(); $k++) {
        $prefix[] = $steps[$k];
    }

    usize $count = 0;
    foreach (find($doc, $prefix) as const &$parent) {
        json::Value $box = $parent->value;

        match ($steps[$steps->count() - 1]) {
            .key($name) => {
                $count = $count + writeKey($box, $name, $with);
            },
            .index($at) => {
                $count = $count + writeAt($box, $at, $with);
            },
            .all => {
                if ($box->isArray()) {
                    usize $n = $box->count();
                    for (usize $i = 0; $i < $n; $i++) {
                        $count = $count + writeAt($box, $i, $with);
                    }
                }
            },
        };
    }

    return $count;
}

/**
 * Whether `$a` and `$b` hold the same JSON: numbers by value (`1` is `1.0`), objects whatever
 * their key order, arrays item by item.
 */
public function same(const json::Value& $a, const json::Value& $b) : bool
{
    if ($a->isNumber() && $b->isNumber()) {
        if ($a->isInt() && $b->isInt()) {
            int64 $ia = guard $a->asInt() else {
                return false;
            };
            int64 $ib = guard $b->asInt() else {
                return false;
            };
            return $ia == $ib;
        }
        float64 $fa = guard $a->asFloat() else {
            return false;
        };
        float64 $fb = guard $b->asFloat() else {
            return false;
        };
        return $fa == $fb;
    }

    if ($a->isNull() || $b->isNull()) {
        return $a->isNull() && $b->isNull();
    }

    if ($a->isBool() && $b->isBool()) {
        bool $ba = guard $a->asBool() else {
            return false;
        };
        bool $bb = guard $b->asBool() else {
            return false;
        };
        return $ba == $bb;
    }

    if ($a->isStr() && $b->isStr()) {
        string $sa = guard $a->asStr() else {
            return false;
        };
        string $sb = guard $b->asStr() else {
            return false;
        };
        return $sa == $sb;
    }

    if ($a->isArray() && $b->isArray()) {
        usize $n = $a->count();
        if ($n != $b->count()) {
            return false;
        }
        for (usize $i = 0; $i < $n; $i++) {
            $x = guard $a->at($i) else {
                return false;
            };
            $y = guard $b->at($i) else {
                return false;
            };
            if (!same($x, $y)) {
                return false;
            }
        }
        return true;
    }

    if ($a->isObject() && $b->isObject()) {
        if ($a->count() != $b->count()) {
            return false;
        }
        $object = guard $a->asObject() else {
            return false;
        };
        foreach ($object as $key => const &$x) {
            $y = guard $b->get($key) else {
                return false;
            };
            if (!same($x, $y)) {
                return false;
            }
        }
        return true;
    }

    return false;
}

/**
 * Where a dotted key ends: the next `.`, `[` or `]`, or the end of `$path`.
 */
private function nameEnd(const string& $path, usize $from) : usize
{
    usize $i = $from;
    usize $n = $path->size();
    while ($i < $n) {
        uint8 $b = $path->byte($i);
        if ($b == 46 || $b == 91 || $b == 93) {
            break;
        }
        $i++;
    }
    return $i;
}

/**
 * Whether `$text` is one or more ASCII digits.
 */
private function digits(const string& $text) : bool
{
    if ($text->empty()) {
        return false;
    }
    for (usize $i = 0; $i < $text->size(); $i++) {
        uint8 $b = $text->byte($i);
        if ($b < 48 || $b > 57) {
            return false;
        }
    }
    return true;
}

/**
 * Adds the hit one step below `$from` when `$found` is there.
 */
private function reach(array<Hit>& $into, const Hit& $from, json::Value? $found, const string& $step) : void
{
    $value = guard $found else {
        return;
    };
    $into[] = Hit("{$from->path}{$step}", $value);
}

/**
 * Adds a hit for every item of `$from` when it is an array.
 */
private function fanOut(array<Hit>& $into, const Hit& $from) : void
{
    if (!$from->value->isArray()) {
        return;
    }
    usize $n = $from->value->count();
    for (usize $i = 0; $i < $n; $i++) {
        $item = guard $from->value->at($i) else {
            continue;
        };
        $into[] = Hit("{$from->path}[{$i}]", $item);
    }
}

/**
 * Writes `$with` under `$name` when `$box` is an object that already has that key. Answers 1 when
 * it wrote.
 */
private function writeKey(json::Value& $box, const string& $name, const json::Value& $with) : usize
{
    if (!$box->isObject() || $box->get($name) == null) {
        return 0;
    }
    $box[$name] = $with->clone();
    return 1;
}

/**
 * Writes `$with` at `$at` when `$box` is an array that long. Answers 1 when it wrote.
 */
private function writeAt(json::Value& $box, usize $at, const json::Value& $with) : usize
{
    if (!$box->isArray() || $at >= $box->count()) {
        return 0;
    }
    $box[$at] = $with->clone();
    return 1;
}

/**
 * Whether `$name` can be written as `.name` and read back as the same key.
 */
internal function plain(const string& $name) : bool
{
    if ($name->empty()) {
        return false;
    }
    for (usize $i = 0; $i < $name->size(); $i++) {
        uint8 $b = $name->byte($i);
        bool $word = ($b >= 48 && $b <= 57) || ($b >= 65 && $b <= 90) || ($b >= 97 && $b <= 122) || $b == 95 || $b == 45;
        if (!$word) {
            return false;
        }
    }
    return true;
}

/**
 * `$name` as a bracketed, quoted key: `['it\'s']`.
 */
internal function quoted(const string& $name) : string
{
    string $out = "['";
    for (usize $i = 0; $i < $name->size(); $i++) {
        uint8 $b = $name->byte($i);
        if ($b == 39 || $b == 92) {
            $out->push(92);
        }
        $out->push($b);
    }
    $out->append("']");
    return $out;
}

namespace str;

/**
 * The step as a path writes it: `.name`, `['odd key']`, `[3]` or `[*]`.
 */
public function from(const ecotest::http::jsonpath::Step& $step) : string
{
    match ($step) {
        .key($name) => {
            if (ecotest::http::jsonpath::plain($name)) {
                return ".{$name}";
            }
            return ecotest::http::jsonpath::quoted($name);
        },
        .index($at) => {
            return "[{$at}]";
        },
        .all => {
            return '[*]';
        },
    };
}

/**
 * The reason in words, with the byte where reading stopped.
 */
public function from(const ecotest::http::jsonpath::PathError& $e) : string
{
    return match ($e) {
        .unclosed($at) => "the bracket or quote at byte {$at} is never closed",
        .empty($at) => "the step at byte {$at} is empty",
        .badIndex($at) => "the index at byte {$at} is neither digits, '*' nor a quoted key",
        .trailing($at) => "unexpected text at byte {$at}",
        .descent($at) => "'..' at byte {$at}: recursive descent is not supported",
    };
}
