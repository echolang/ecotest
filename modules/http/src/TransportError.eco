namespace ecotest::http;

/**
 * Why a request got no response at all.
 */
public enum TransportError
{
    /**
     * libcurl got nothing back: refused, unreachable, timed out, or a URL it could not use.
     */
    case curl(curl::Error $cause);

    /**
     * A transport other than libcurl, such as one that dispatches in process, could not deliver
     * the request, for the reason given.
     */
    case refused(string $reason);
}

namespace str;

/**
 * The reason in words, as a failure report shows it: libcurl's sentence, or the transport's own.
 */
public function from(const ecotest::http::TransportError& $e) : string
{
    return match ($e) {
        .curl($cause) => "{$cause}",
        .refused($reason) => $reason,
    };
}
