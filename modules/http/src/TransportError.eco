namespace ecotest::http;

/**
 * Why a request got no response at all, in terms every transport can report.
 */
public enum TransportError
{
    /**
     * Nothing answered: the connection was refused, or the host does not resolve.
     */
    case unreachable;

    /**
     * No answer came within `$ms` milliseconds.
     */
    case timeout(int32 $ms);

    /**
     * The request could not be sent as it is, such as a URL the transport cannot use, for the
     * reason given.
     */
    case invalid(string $reason);

    /**
     * The exchange broke off for the reason given.
     */
    case failed(string $reason);
}

namespace str;

/**
 * The reason in words, as a failure report shows it.
 */
public function from(const ecotest::http::TransportError& $e) : string
{
    return match ($e) {
        .unreachable => 'nothing answers there',
        .timeout($ms) => "no answer within {$ms} ms",
        .invalid($reason) => "cannot be sent: {$reason}",
        .failed($reason) => $reason,
    };
}
