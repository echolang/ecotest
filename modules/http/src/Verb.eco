namespace ecotest::http;

/**
 * The request methods a test sends, backed by the method as it goes on the wire:
 * `$verb->value()` is `'GET'`.
 */
public enum Verb : string
{
    case get = 'GET';
    case head = 'HEAD';
    case post = 'POST';
    case put = 'PUT';
    case patch = 'PATCH';
    case delete = 'DELETE';
}
