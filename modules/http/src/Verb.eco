namespace ecotest::http;

/**
 * The request methods a test sends.
 */
public enum Verb
{
    case get;
    case head;
    case post;
    case put;
    case patch;
    case delete;

    /**
     * libcurl's spelling of the verb: `$verb->curl()`.
     */
    map curl : curl::Method
    {
        .get = .get;
        .head = .head;
        .post = .post;
        .put = .put;
        .patch = .patch;
        .delete = .delete;
    }

    /**
     * The method as it goes on the wire.
     */
    public const function word() : string
    {
        return $this->curl()->value();
    }
}
