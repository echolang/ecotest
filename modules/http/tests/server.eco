use std::thread;

/**
 * A real HTTP server on an ephemeral loopback port, on its own thread, for the checks to talk to.
 */
internal class TestServer
{
    public http::Server $app;
    public thread::handle? $thread = null;
    public int32 $port = 0;

    public constructor()
    {
        $this->app = http::Server();

        $this->app->get('/users/1', (http::Request $r) : http::Response => http::Response(
            json: '{"id":1,"name":"Ada","admin":false,"score":2.5,"note":null,"items":[{"id":1,"at":"x"},{"id":2,"at":"y"}]}'
        ));
        $this->app->post('/users', function(http::Request $r) : http::Response {
            $res = http::Response(json: $r->body);
            $res->status = 201;
            return $res;
        });
        $this->app->get('/plain', (http::Request $r) : http::Response => http::Response(text: 'hello there'));
        $this->app->get('/whoami', function(http::Request $r) : http::Response {
            $auth = $r->header('Authorization') ?? 'nobody';
            return http::Response(text: $auth);
        });

        // the method in the body and in X-Method; a HEAD reaches the GET route
        $verb = function(http::Request $r) : http::Response {
            string $name = "{$r->method}";
            $res = http::Response(ok: $name);
            $res->header('X-Method', $name);
            return $res;
        };
        $this->app->get('/verb', $verb);
        $this->app->post('/verb', $verb);
        $this->app->put('/verb', $verb);
        $this->app->patch('/verb', $verb);
        $this->app->del('/verb', $verb);

        $this->app->get('/moved', function(http::Request $r) : http::Response {
            $res = http::Response(302, '');
            $res->header('Location', '/plain');
            return $res;
        });

        // the headers a client added on its own
        $seen = function(http::Request $r) : http::Response {
            $host = $r->header('Host') ?? '';
            $accept = $r->header('Accept') ?? '';
            $agent = $r->header('User-Agent') ?? '';
            $encoding = $r->header('Accept-Encoding') ?? '';
            $length = $r->header('Content-Length') ?? '';
            return http::Response(ok: "host={$host}\naccept={$accept}\nagent={$agent}\nencoding={$encoding}\nlength={$length}");
        };
        $this->app->get('/headers', $seen);
        $this->app->post('/headers', $seen);

        $this->app->get('/slow', function(http::Request $r) : http::Response {
            std::time::sleep(.millis(800));
            return http::Response(ok: 'late');
        });
    }

    /**
     * Starts listening and returns the base URL once the port is bound. A second call returns the
     * same URL.
     */
    public function start() : string
    {
        if ($this->thread != null) {
            return "http://127.0.0.1:{$this->port}";
        }

        http::Server $app = $this->app;
        // a port that cannot be bound stops here, not as a timeout in eventually() below
        $spawned = guard thread::spawn(function() : void {
            guard $app->listen('127.0.0.1', 0);
        });
        $this->thread = $spawned;

        ecotest::eventually(() : bool => $app->port() > 0);
        $this->port = $app->port();
        return "http://127.0.0.1:{$this->port}";
    }

    destructor()
    {
        $this->app->stop();
        if ($this->thread != null) {
            $t = guard $this->thread;
            $t->join();
        }
    }
}
