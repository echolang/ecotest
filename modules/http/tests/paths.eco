/**
 * JSON paths off the common road: no `$`, bare keys, odd brackets, and steps that lead nowhere.
 */

use ecotest::expect;
use ecotest::http::jsonpath;

test steps_read_every_spelling
{
    expect(jsonpath::steps('a.b'))->is(['a', 'b']);
    expect(jsonpath::steps('$a[0]'))->is(['a', '[0]']);
    expect(jsonpath::steps('$["k"][x]'))->is(['k', '[x]']);
    expect(jsonpath::steps('$.a[0'))->is(['a']);
}

test steps_that_lead_nowhere_find_nothing
{
    $doc = guard json::parse('{"o":{"k":1},"l":[1,2]}');

    expect(jsonpath::all($doc, '$.o[*]'))->empty();
    expect(jsonpath::all($doc, '$.l[x]'))->empty();
    expect(jsonpath::all($doc, '$.l[9]'))->empty();
}

test replace_follows_indexes_and_skips_what_is_not_there
{
    $doc = guard json::parse('{"l":[1,2]}');

    jsonpath::replace($doc, '$.l[0]', json::str('a'));
    jsonpath::replace($doc, '$.l[x]', json::str('b'));
    jsonpath::replace($doc, '$.l[9]', json::str('c'));
    jsonpath::replace($doc, '$.gone', json::str('d'));

    expect(json::dump($doc->clone()))->is('{"l":["a",2]}');
}
