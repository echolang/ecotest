use ecotest::http::{Transport, Request, Response, TransportError};

/**
 * A transport that answers from memory and remembers what it was sent.
 */
internal class FakeTransport : Transport
{
    public array<Request> $sent = [];
    public Response $answer = Response(200);
    public bool $broken = false;

    public function send(const Request& $request) : result<Response, TransportError>
    {
        $this->sent[] = $request;

        if ($this->broken) {
            return .error(.failed('wire cut'));
        }
        return .ok($this->answer);
    }

    /**
     * The request line of everything sent, in order.
     */
    public const function lines() : array<string>
    {
        array<string> $out = [];
        foreach ($this->sent as const &$request) {
            $out[] = $request->line();
        }
        return $out;
    }

    /**
     * The Content-Type of everything sent, in order, or empty where there was none.
     */
    public const function types() : array<string>
    {
        array<string> $out = [];
        foreach ($this->sent as const &$request) {
            string $type = '';
            foreach ($request->headers as const &$h) {
                if (str::iequals($h->name->view(), 'content-type')) {
                    $type = $h->value;
                }
            }
            $out[] = $type;
        }
        return $out;
    }

    /**
     * Every header of request `$i` as `name: value`, in order.
     */
    public const function headers(usize $i) : array<string>
    {
        array<string> $out = [];
        foreach ($this->sent[$i]->headers as const &$h) {
            $out[] = "{$h->name}: {$h->value}";
        }
        return $out;
    }
}
