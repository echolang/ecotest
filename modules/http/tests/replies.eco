/**
 * Every check on a reply, failing and passing, on replies built in memory.
 */

use ecotest::expect;
use ecotest::http::{Header, Reply};

test a_request_without_a_response_fails_every_check_with_the_reason
{
    $got = said(function() : void {
        lost()->status(200)->ok()->header('a', 'b')->type('x')->body('x')->has('x')
            ->json('$.a', 'x')->present('$.a')->count('$.a', 1)
            ->matches('$.a', (const json::Value& $v) : bool => true)
            ->faster(than: 1)->snapshot();
    });

    expect($got->count())->is(12);
    expect($got)->all((const string& $s) : bool => $s == 'no response to GET http://app/x: refused');
}

test status_header_and_body_failures_show_the_exchange
{
    $r = reply(200, 'plain text', [Header('Content-Type', 'text/plain'), Header('X-Id', '7')]);
    $r->ok()->header('x-id', '7')->type('TEXT/plain')->body('plain text')->has('plain');

    $failures = ecotest::caught(function() : void {
        $r->status(201)->header('X-Id', '8')->header('X-Gone', '1')->type('application/json')
            ->body('other')->has('zzz')->faster(than: 0)->json('$.a', 'x');
        reply(500, '')->ok();
        reply(101, '')->ok()->type('text/plain');
    });

    array<string> $summaries = [];
    foreach ($failures as const &$f) {
        $summaries[] = $f->summary;
    }

    expect($summaries->count())->is(11);
    expect($summaries[0])->is('expected status 201, got 200');
    expect($summaries[1])->is('expected header X-Id: 8, got 7');
    expect($summaries[2])->is('expected header X-Gone: 1, it is missing');
    expect($summaries[3])->is("expected Content-Type application/json, got 'text/plain'");
    expect($summaries[4])->is('the body differs');
    expect($summaries[5])->is("expected the body to contain 'zzz'");
    expect($summaries[6])->is('expected an answer within 0 ms, took 0 ms');
    expect($summaries[7])->starts('expected a JSON body (');
    expect($summaries[8])->is('expected a 2xx status, got 500');
    expect($summaries[9])->is('expected a 2xx status, got 101');
    expect($summaries[10])->is("expected Content-Type text/plain, got ''");

    expect($failures[0]->detail)->is("GET http://app/x\n-> 200 in 0 ms\n   Content-Type: text/plain\n   X-Id: 7\n\nplain text");
    expect($failures[8]->detail)->is("GET http://app/x\n-> 500 in 0 ms");
}

test json_failures_name_the_path
{
    $r = reply(200, '{"s":"a","i":1,"f":1.5,"b":true,"n":null,"l":[1,2],"o":{"k":1}}');
    $r->json('$.s', 'a')->json('$.i', 1)->json('$.f', 1.5)->json('$.b', true)->isNull('$.n')
        ->present('$.o.k')->count('$.l', 2)
        ->matches('$.l[*]', (const json::Value& $v) : bool => ($v->asInt() ?? 0) > 0);

    $got = said(function() : void {
        $r->json('$.s', 'b')->json('$.i', 2)->json('$.f', 2.5)->json('$.b', false)->isNull('$.s')
            ->json('$.gone', 'x')->present('$.gone')->count('$.gone', 1)->count('$.o', 1)->count('$.l', 3)
            ->matches('$.gone', (const json::Value& $v) : bool => true)
            ->matches('$.l[*]', (const json::Value& $v) : bool => ($v->asInt() ?? 0) > 1)
            ->matches('$.l[*]', (const json::Value& $v) : bool => ($v->asInt() ?? 0) > 1, says: 'big');
    });

    expect($got)->is([
        'expected $.s = "b", got "a"',
        'expected $.i = 2, got 1',
        'expected $.f = 2.5, got 1.5',
        'expected $.b = false, got true',
        'expected $.s = null, got "a"',
        'expected $.gone = "x", found nothing there',
        'expected a value at $.gone',
        'expected 1 items at $.gone, found nothing there',
        'expected 1 items at $.o, got {"k":1}, not an array',
        'expected 3 items at $.l, got 2',
        'expected a value at $.gone',
        '$.l[0] = 1 failed the test',
        'expected $.l[0] to be big, got 1',
    ]);
}

test capture_hands_back_text_or_json
{
    $r = reply(200, '{"s":"a","i":1,"o":{"k":1}}');

    expect($r->capture('$.s'))->is('a');
    expect($r->capture('$.i'))->is('1');
    expect($r->capture('$.o'))->is('{"k":1}');
}

#[tests: expects death]
test capture_stops_on_a_body_that_is_not_json
{
    $id = reply(200, 'plain')->capture('$.id');
}

#[tests: expects death]
test capture_stops_when_nothing_is_there
{
    $id = reply(200, '{}')->capture('$.id');
}

test a_long_body_is_cut_in_the_report
{
    $failures = ecotest::caught(function() : void {
        reply(500, str::repeat('x', 1300))->ok();
    });

    expect($failures[0]->detail)->ends("\n   ... 100 more bytes");
}

test a_body_that_is_not_json_is_snapshot_as_it_is
{
    reply(200, 'plain words')->snapshot();
}

#[tests: expects death]
test capture_stops_even_inside_caught_on_a_body_that_is_not_json
{
    $failures = ecotest::caught(function() : void {
        $id = reply(200, 'plain')->capture('$.id');
    });
}

test json_numbers_compare_by_value
{
    $r = reply(200, '{"i":1,"f":1.0,"big":10000000000,"half":0.5}');
    $r->json('$.i', 1.0)->json('$.f', 1)->json('$.big', 10000000000)->json('$.half', 0.5);

    expect(said(function() : void {
        $r->json('$.i', 2.0)->json('$.f', '1');
    }))->is(['expected $.i = 2.0, got 1', 'expected $.f = "1", got 1.0']);
}

test a_wildcard_value_check_needs_every_match
{
    reply(200, '{"l":[{"k":1},{"k":1}]}')->json('$.l[*].k', 1);

    expect(said(function() : void {
        reply(200, '{"l":[{"k":1},{"k":2}]}')->json('$.l[*].k', 1);
    }))->is(['expected $.l[*].k = 1, got 2 at $.l[1].k']);
}

test json_compares_a_document_structurally
{
    $r = reply(200, '{"o":{"a":1,"b":[1,2]}}');
    $same = guard json::parse('{"b":[1,2.0],"a":1}');
    $r->json('$.o', $same);

    $short = guard json::parse('{"a":1}');
    $order = guard json::parse('{"a":1,"b":[2,1]}');
    expect(said(function() : void {
        $r->json('$.o', $short)->json('$.o', $order);
    }))->is([
        'expected $.o = {"a":1}, got {"a":1,"b":[1,2]}',
        'expected $.o = {"a":1,"b":[2,1]}, got {"a":1,"b":[1,2]}',
    ]);
}

test count_with_a_wildcard_checks_every_match
{
    reply(200, '{"l":[[1,2],[3,4]]}')->count('$.l[*]', 2);

    expect(said(function() : void {
        reply(200, '{"l":[[1,2],[3]]}')->count('$.l[*]', 2);
        reply(200, '{"l":[[1,2],"x"]}')->count('$.l[*]', 2);
    }))->is(['expected 2 items at $.l[1], got 1', 'expected 2 items at $.l[1], got "x", not an array']);
}

#[tests: expects death]
test capture_stops_on_a_path_naming_several_values
{
    $id = reply(200, '{"l":[1,2]}')->capture('$.l[*]');
}

#[tests: expects death]
test capture_stops_on_a_malformed_path
{
    $id = reply(200, '{"l":[1,2]}')->capture('$.l[');
}

test a_malformed_path_fails_at_the_callers_line
{
    $failures = ecotest::caught(function() : void {
        reply(200, '{}')->json('$..a', 1);
    });

    expect($failures->count())->is(1);
    expect($failures[0]->summary)->is("bad JSON path $..a: '..' at byte 1: recursive descent is not supported");
    string $file = "{$failures[0]->at->file}";
    expect($file)->ends('replies.eco');
}

test a_redact_path_that_matches_nothing_fails
{
    expect(said(function() : void {
        reply(200, '{"a":1}')->snapshot(['$.a', '$.b']);
    }))->is(['cannot redact $.b: it matches nothing']);
}

test redacting_a_body_that_is_not_json_fails
{
    $got = said(function() : void {
        reply(200, 'plain')->snapshot(['$.a']);
    });

    expect($got->count())->is(1);
    expect($got[0])->starts('cannot redact a body that is not JSON (');
}

test a_malformed_redact_path_fails
{
    expect(said(function() : void {
        reply(200, '{}')->snapshot(['$[']);
    }))->is(['cannot redact $[: the bracket or quote at byte 1 is never closed']);
}

test header_checks_look_at_every_header_of_that_name
{
    $r = reply(200, '', [Header('Set-Cookie', 'a=1'), Header('set-cookie', 'b=2')]);
    $r->header('SET-COOKIE', 'b=2')->header('Set-Cookie', 'a=1');

    $res = answer($r);
    expect($res->headers('Set-Cookie'))->is(['a=1', 'b=2']);
    expect($res->headers('X-None'))->empty();

    expect(said(function() : void {
        $r->header('Set-Cookie', 'c=3');
    }))->is(['expected header Set-Cookie: c=3, got a=1, b=2']);
}

test type_compares_the_media_type_only
{
    $r = reply(200, '', [Header('Content-Type', 'Application/JSON ; charset=utf-8')]);
    $r->type('application/json');

    expect(said(function() : void {
        $r->type('application/js')->type('application/json; charset=utf-8');
    }))->is([
        "expected Content-Type application/js, got 'Application/JSON ; charset=utf-8'",
        "expected Content-Type application/json; charset=utf-8, got 'Application/JSON ; charset=utf-8'",
    ]);
}
