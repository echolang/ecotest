namespace ecotest::http;

/**
 * Delivers requests to a nexus kernel in process: `Api(transport: KernelTransport($app->kernel))`.
 * The URL's path and query become the request target; scheme and host are ignored.
 */
public class KernelTransport : Transport
{
    public nexus::Kernel $kernel;

    public constructor(nexus::Kernel $kernel)
    {
        $this->kernel = $kernel;
    }

    /**
     * Hands `$request` to the kernel and converts what it answers.
     */
    public function send(const Request& $request) : result<Response, TransportError>
    {
        $in = nexus::Request(KernelTransport::method($request->verb), KernelTransport::target($request->url));
        $in->body = $request->body;

        foreach ($request->headers as const &$h) {
            $in->headers->add($h->name, $h->value);
        }

        $started = std::time::instant::now();
        $got = $this->kernel->handle(mv $in);

        $out = Response($got->status as int64);
        $out->body = $got->body;
        $out->ms = $started->elapsed()->as_millis();

        foreach ($got->headers->items as const &$h) {
            $out->headers[] = Header($h->name, $h->value);
        }

        return .ok(mv $out);
    }

    /**
     * The path and query of `$url`: everything from the first `/` after the host.
     */
    private static function target(const string& $url) : string
    {
        usize $scheme = $url->find('://');
        if ($scheme >= $url->size()) {
            return $url;
        }

        usize $path = $url->find('/', $scheme + 3);
        if ($path >= $url->size()) {
            return '/';
        }

        return $url->sub($path, $url->size() - $path);
    }

    /**
     * nexus's spelling of `$verb`.
     */
    private static function method(Verb $verb) : nexus::Method
    {
        return match ($verb) {
            .get => .get,
            .head => .head,
            .post => .post,
            .put => .put,
            .patch => .patch,
            .delete => .delete,
        };
    }
}
