/**
 * The ecotest-http checks against a tiny nexus app, in process.
 */

use ecotest::http::{Api, KernelTransport};
use nexus::testing::TestApp;
use container::Container;

class KEcho : nexus::Action
{
    public function handle(nexus::Payload& $payload) : nexus::Response
    {
        json::Value $o = json::object();
        $o['method'] = json::str($payload->request->method->verb());
        $o['body'] = json::str($payload->request->body);
        $o['who'] = json::str($payload->request->header('X-Who') ?? '');
        return nexus::Response(json: $o);
    }
}

class KApp : nexus::Extension
{
    public function name() : string
    {
        return 'kapp';
    }

    public function services(nexus::Services& $s) : status<nexus::BootError>
    {
        $s->bind<KEcho>(scope: function() : KEcho {
            return KEcho();
        });

        array<nexus::Method> $m = [nexus::Method::get, nexus::Method::post];
        array<nexus::MiddlewareRef> $w = [];
        function<nexus::Response(nexus::Payload&)> $d = function(nexus::Payload& $payload) : nexus::Response {
            KEcho $a = $payload->get<KEcho>();
            return $a->handle($payload);
        };
        function<bool(Container)> $b = function(Container $services) : bool {
            return $services->has<KEcho>();
        };
        $s->route(nexus::Route($m, '/echo', 'KEcho', $d, $b, $w));
        return .ok;
    }
}

test an_api_runs_against_the_kernel_in_process
{
    array<nexus::Extension> $exts = [KApp()];
    TestApp $app = TestApp::boot($exts);
    $api = Api(transport: KernelTransport($app->kernel));

    $api->with('X-Who', 'tester')->get('/echo')->ok()->json('$.method', 'GET')->json('$.who', 'tester');
    $api->post('/echo', json: '{"a":1}')->ok()->json('$.method', 'POST')->json('$.body', '{"a":1}');
    $api->get('/missing')->status(404);
}

test every_verb_and_any_url_shape_reaches_the_kernel
{
    array<nexus::Extension> $exts = [KApp()];
    TestApp $app = TestApp::boot($exts);
    $api = Api(transport: KernelTransport($app->kernel), base: '');

    $api->get('/echo')->ok();
    $api->get('http://host')->status(404);
    $api->head('http://host/echo')->ok();
    $api->put('/echo', json: '{}')->status(405);
    $api->patch('/echo', json: '{}')->status(405);
    $api->delete('/echo')->status(405);
}
