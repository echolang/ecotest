namespace ecotest;

/**
 * A fresh directory under the system temp directory, removed with everything in it when the value
 * goes. `$dir = TempDir();` at the top of a test is the whole setup.
 */
public class TempDir
{
    /**
     * The path of the directory.
     */
    public const string $path;

    /**
     * The cleanup that removes the directory when the test stops before this value goes.
     */
    private usize $cleanup = 0;

    /**
     * Makes the directory. One that cannot be made stops the test at the line that asked for it.
     */
    #[caller]
    public constructor()
    {
        $at = std::src::caller();
        $made = guard std::fs::tempdir() else ($e) {
            die(report("cannot create temp directory: {$e}", $at), $at);
        };
        $this->path = $made->string();

        // a failed check stops the test without destructors; the session removes it then
        string $held = $this->path;
        $this->cleanup = defer(function() : void {
            $gone = std::fs::remove_all($held);
        });
    }

    /**
     * The path of `$name` inside the directory. Nothing is created.
     */
    public const function file(const string& $name) : string
    {
        return ($this->path / $name)->string();
    }

    /**
     * Writes `$text` to `$name` inside the directory and returns its path. A file that cannot be
     * written stops the test at the line that asked for it.
     */
    #[caller]
    public const function write(const string& $name, const string& $text) : string
    {
        $at = std::src::caller();
        $to = $this->file($name);
        $n = guard std::fs::writefile($to, $text) else ($e) {
            die(report("cannot write temp file {$to}: {$e}", $at), $at);
        };
        return $to;
    }

    /**
     * The contents of `$name` inside the directory, or the error that kept it from being read.
     */
    public const function read(const string& $name) : result<string, std::io::ioerror>
    {
        return std::fs::readfile($this->file($name));
    }

    destructor()
    {
        undefer($this->cleanup);
        $gone = std::fs::remove_all($this->path);
    }
}
