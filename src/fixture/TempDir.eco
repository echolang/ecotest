namespace ecotest;

/**
 * A fresh directory under the system temp directory, removed with everything in it when the value
 * goes. `$dir = TempDir();` at the top of a test is the whole setup.
 */
public class TempDir
{
    /**
     * How many directories this process has made, so two in one test never collide.
     */
    internal static usize $made = 0;

    /**
     * The path of the directory.
     */
    public const string $path;

    /**
     * Makes the directory. One that cannot be made stops the test at the line that asked for it.
     */
    #[caller]
    public constructor()
    {
        $at = std::src::caller();
        TempDir::$made = TempDir::$made + 1;

        int32 $pid = std::env::pid();
        usize $n = TempDir::$made;
        int64 $stamp = std::time::timestamp::now()->unix_nanos();

        $this->path = std::env::join(std::env::tmp(), "ecotest-{$pid}-{$n}-{$stamp}");
        guard std::io::mkdir($this->path) else ($e) {
            die(Session::report(Failure("cannot create temp directory {$this->path}: {$e}", $at)), $at);
        };
    }

    /**
     * The path of `$name` inside the directory. Nothing is created.
     */
    public const function file(const string& $name) : string
    {
        return std::env::join($this->path, $name);
    }

    /**
     * Writes `$text` to `$name` inside the directory and returns its path. A file that cannot be
     * written stops the test at the line that asked for it.
     */
    #[caller]
    public const function write(const string& $name, const string& $text) : string
    {
        $at = std::src::caller();
        $to = $this->file($name);
        guard std::io::writefile($to, $text) else ($e) {
            die(Session::report(Failure("cannot write temp file {$to}: {$e}", $at)), $at);
        };
        return $to;
    }

    /**
     * The contents of `$name` inside the directory, or the error that kept it from being read.
     */
    public const function read(const string& $name) : result<string, std::io::ioerror>
    {
        return std::io::readfile($this->file($name));
    }

    destructor()
    {
        TempDir::remove($this->path);
    }

    /**
     * Removes `$path` and everything below it. Best effort: a temp directory left behind is not a
     * test failure.
     */
    private static function remove(const string& $path) : void
    {
        $listing = guard std::io::opendir($path) else {
            return;
        };

        foreach ($listing as const &$entry) {
            if ($entry->is_directory()) {
                TempDir::remove($entry->path());
            } else {
                $gone = std::io::remove($entry->path());
            }
        }

        $listing->close();
        $removed = std::io::rmdir($path);
    }
}
