namespace ecotest;

/**
 * Calls `$ready` until it returns true, pausing `every` between tries. Fails the check when
 * `within` has passed first. For anything that settles on its own time: a server binding its
 * port, a worker draining a queue.
 */
#[caller]
public function eventually(
    function<bool()> $ready,
    within: std::time::duration $limit = .secs(2),
    every: std::time::duration $pause = .millis(10)
) : void {
    $at = std::src::caller();
    Session::checked();

    $started = std::time::instant::now();
    usize $tries = 0;

    while (true) {
        $tries++;
        if ($ready()) {
            return;
        }

        if ($started->elapsed()->as_millis() >= $limit->as_millis()) {
            int64 $ms = $limit->as_millis();
            fail("not ready after {$ms} ms ({$tries} tries)", $at);
            return;
        }

        std::time::sleep($pause);
    }
}
