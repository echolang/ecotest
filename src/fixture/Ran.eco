namespace ecotest;

/**
 * What a program run by `ecotest::run` did: how it exited and what it printed.
 */
public struct Ran
{
    /**
     * The program and its arguments, joined with spaces, for failure messages.
     */
    public string $command;

    /**
     * The exit code, or null when a signal ended the program.
     */
    public int32? $code;

    /**
     * Everything the program wrote to stdout.
     */
    public string $stdout;

    /**
     * Everything the program wrote to stderr.
     */
    public string $stderr;
}

/**
 * Runs `$program` with `$arguments` to completion and captures both streams. A program that
 * cannot be started stops the test.
 */
#[caller]
public function run(const string& $program, const array<string>& $arguments = []) : Ran
{
    $at = std::src::caller();
    string $command = $program;
    foreach ($arguments as const &$argument) {
        $command->append(' ');
        $command->append($argument);
    }

    $o = guard std::process::command($program, $arguments)->output() else ($e) {
        die(Session::report(Failure("cannot run {$command}: {$e}", $at)), $at);
    };

    return Ran(mv $command, $o->status->code(), mv $o->stdout, mv $o->stderr);
}
