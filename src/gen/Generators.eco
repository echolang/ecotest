namespace ecotest::gen;

use ecotest::{Draws, Failure, Gen, Pair, Session};
use ecotest::{show, utf8};

/**
 * An integer in `[$low, $high]` from one answer, where answer 0 is `$target` and larger answers
 * step away from it on alternating sides: target, +1, -1, +2, -2, and on along the longer side
 * once the shorter one runs out. Recording favours the target, its neighbours and both ends.
 */
internal function zigzag(Draws& $d, int64 $low, int64 $high, int64 $target) : int64
{
    // wrapping subtraction: the spans fit an unsigned 64-bit number even for the full range
    uint64 $up = ($high - $target) as uint64;
    uint64 $down = ($target - $low) as uint64;
    uint64 $span = $up + $down;

    uint64 $m = $up;
    if ($down < $up) {
        $m = $down;
    }

    array<uint64> $edges = [0, 1, 2, $span];
    if ($m > 0) {
        if ($m == $up) {
            $edges[] = $m * 2 - 1;
        } else {
            $edges[] = $m * 2;
        }
    }

    uint64 $c = $d->draw($span, $edges);

    if ($c == 0) {
        return $target;
    }

    if ($c <= $m * 2) {
        uint64 $k = ($c + 1) / 2;
        if ($c % 2 == 1) {
            return $target + ($k as int64);
        }
        return $target - ($k as int64);
    }

    uint64 $far = $c - $m;
    if ($up > $down) {
        return $target + ($far as int64);
    }
    return $target - ($far as int64);
}

/**
 * Integers in `[$low, $high]`. A failing one shrinks towards 0, or towards the end of the range
 * nearest to it. Both ends come up far more often than chance.
 */
public function ints(int64 $low, int64 $high) : Gen<int64>
{
    int64 $target = 0;
    if ($low > 0) {
        $target = $low;
    }
    if ($high < 0) {
        $target = $high;
    }

    return Gen<int64>(
        function(Draws& $d) : int64 {
            if ($high <= $low) {
                return $low;
            }
            return zigzag($d, $low, $high, $target);
        },
        (const int64& $v) => "{$v}"
    );
}

/**
 * Floats in `[$low, $high)`. A failing one shrinks towards a whole number near 0, then towards
 * no fraction at all.
 */
public function floats(float64 $low, float64 $high) : Gen<float64>
{
    return Gen<float64>(
        function(Draws& $d) : float64 {
            if (!($high > $low)) {
                return $low;
            }

            // past 2^52 a float has no fraction to draw: spread one answer over the range
            float64 $limit = 4503599627370496.0;
            bool $small = $low > 0.0 - $limit && $high < $limit;
            int64 $first = std::math::floor($low) as int64;
            int64 $last = std::math::ceil($high) as int64 - 1;

            if (!$small || $last < $first) {
                uint64 $c = $d->draw(9007199254740991, [0]);
                float64 $v = $low + (($c as float64) / 9007199254740992.0) * ($high - $low);
                if ($v >= $high) {
                    return $low;
                }
                return $v;
            }

            int64 $target = 0;
            if ($first > 0) {
                $target = $first;
            }
            if ($last < 0) {
                $target = $last;
            }

            int64 $whole = $target;
            if ($last > $first) {
                $whole = zigzag($d, $first, $last, $target);
            }

            uint64 $c = $d->draw(4294967295, [0]);
            float64 $part = ($c as float64) / 4294967296.0;
            float64 $v = ($whole as float64) + $part;

            if ($v < $low) {
                // the bit of the range below its first whole number
                return $low + $part * (std::math::ceil($low) - $low);
            }
            if ($v >= $high) {
                if (($whole as float64) >= $low) {
                    return $whole as float64;
                }
                return $low;
            }
            return $v;
        },
        (const float64& $v) => show::float($v)
    );
}

/**
 * `true` or `false`. A failing `true` shrinks to `false`.
 */
public function bools() : Gen<bool>
{
    return Gen<bool>(
        (Draws& $d) => $d->draw(1) == 1,
        function(const bool& $v) : string {
            if ($v) {
                return 'true';
            }
            return 'false';
        }
    );
}

/**
 * Strings of up to `max` characters drawn from `alphabet`, which is read as UTF-8 characters, not
 * bytes, so every string it makes is valid UTF-8. A failing one shrinks by dropping characters and
 * by moving each one towards the start of the alphabet.
 */
public function text(alphabet: const string& $alphabet = 'abcdefghijklmnopqrstuvwxyz0123456789 ', max: usize $max = 32) : Gen<string>
{
    $characters = utf8::characters($alphabet);

    return Gen<string>(
        function(Draws& $d) : string {
            string $out = '';
            if ($characters->empty()) {
                return $out;
            }

            usize $n = 0;
            uint64 $last = ($characters->count() - 1) as uint64;
            while ($d->more($n, $max)) {
                $out->append($characters[$d->draw($last, [0]) as usize]);
                $n++;
            }
            return $out;
        },
        (const string& $v) => show::text($v)
    );
}

/**
 * Lists of up to `max` items from `$item`. A failing one shrinks by dropping items and by
 * shrinking the items that are left.
 */
public function lists<T>(Gen<T> $item, max: usize $max = 16) : Gen<array<T>>
{
    return Gen<array<T>>(
        function(Draws& $d) : array<T> {
            array<T> $out = [];
            while ($d->more($out->count(), $max)) {
                $out[] = $item->draw($d);
            }
            return $out;
        },
        function(const array<T>& $v) : string {
            string $out = '[';
            for (usize $i = 0; $i < $v->count(); $i++) {
                if ($i > 0) {
                    $out->append(', ');
                }
                $out->append($item->show($v[$i]));
            }
            $out->append(']');
            return $out;
        }
    );
}

/**
 * One of `$items`. A failing one shrinks towards the items listed before it. Needs `str::from` on
 * `T`.
 */
#[caller]
public function pick<T>(array<T> $items) : Gen<T>
{
    // a release build drops asserts, and an empty pick would index past the end
    if ($items->empty()) {
        die(Session::report(Failure('gen::pick needs at least one item', std::src::caller())), std::src::caller());
    }

    uint64 $last = ($items->count() - 1) as uint64;

    return Gen<T>(
        (Draws& $d) => $items[$d->draw($last, [0, $last]) as usize],
        (const T& $v) => show::item($v)
    );
}

/**
 * A value from one of `$gens`, chosen at random. A failing one shrinks towards the generators
 * listed first. Printed by the first generator.
 */
#[caller]
public function oneOf<T>(array<Gen<T>> $gens) : Gen<T>
{
    if ($gens->empty()) {
        die(Session::report(Failure('gen::oneOf needs at least one generator', std::src::caller())), std::src::caller());
    }

    uint64 $last = ($gens->count() - 1) as uint64;
    $first = $gens[0];

    return Gen<T>(
        (Draws& $d) => $gens[$d->draw($last) as usize]->draw($d),
        (const T& $v) => $first->show($v)
    );
}

/**
 * A pair of independent values.
 */
public function pairs<A, B>(Gen<A> $first, Gen<B> $second) : Gen<Pair<A, B>>
{
    return Gen<Pair<A, B>>(
        function(Draws& $d) : Pair<A, B> {
            $a = $first->draw($d);
            $b = $second->draw($d);
            return Pair<A, B>(mv $a, mv $b);
        },
        function(const Pair<A, B>& $v) : string {
            $a = $first->show($v->first);
            $b = $second->show($v->second);
            return "({$a}, {$b})";
        }
    );
}

/**
 * Values of `$from` passed through `$into`. Shrinks as `$from` does, since shrinking works on the
 * answers the value was made from. Printed through `str::from` on `U`.
 */
public function map<T, U>(Gen<T> $from, function<U(const T&)> $into) : Gen<U>
{
    return map($from, $into, show: (const U& $v) => show::item($v));
}

/**
 * `map` for a `U` without `str::from`, printed by `$show`.
 */
public function map<T, U>(Gen<T> $from, function<U(const T&)> $into, show: function<string(const U&)> $show) : Gen<U>
{
    return Gen<U>(
        (Draws& $d) => $into($from->draw($d)),
        $show
    );
}

/**
 * Values of `$from` that pass `$keep`. Up to 100 draws are tried for each case; a case where none
 * passes is skipped rather than counted. Keep the filter loose: a filter that rejects most values
 * makes slow, thin tests.
 */
public function filter<T>(Gen<T> $from, function<bool(const T&)> $keep) : Gen<T>
{
    return Gen<T>(
        function(Draws& $d) : T {
            $v = $from->draw($d);
            usize $tries = 1;
            while (!$keep($v) && $tries < 100) {
                $v = $from->draw($d);
                $tries++;
            }
            if (!$keep($v)) {
                $d->reject();
            }
            return $v;
        },
        (const T& $v) => $from->show($v)
    );
}

/**
 * A value of `$from`, then a value of the generator `$then` makes from it: a list and an index
 * into it, a size and a matrix of that size. Shrinks both parts together. Printed through
 * `str::from` on `U`.
 */
public function flatMap<T, U>(Gen<T> $from, function<Gen<U>(const T&)> $then) : Gen<U>
{
    return flatMap($from, $then, show: (const U& $v) => show::item($v));
}

/**
 * `flatMap` for a `U` without `str::from`, printed by `$show`.
 */
public function flatMap<T, U>(Gen<T> $from, function<Gen<U>(const T&)> $then, show: function<string(const U&)> $show) : Gen<U>
{
    return Gen<U>(
        function(Draws& $d) : U {
            $v = $from->draw($d);
            return $then($v)->draw($d);
        },
        $show
    );
}
