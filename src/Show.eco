namespace ecotest;

/**
 * How a value reads inside a failure. Text is quoted with its invisible bytes spelled out, so a
 * stray `\r` or trailing space shows, and anything long is cut so a summary stays on one line.
 */
internal class Show
{
    /**
     * How many bytes of a value a one-line summary shows before cutting.
     */
    internal static usize $width = 120;

    /**
     * `$text` quoted, with tabs, newlines, carriage returns and other control bytes escaped, cut to
     * `Show::$width`.
     */
    internal static function text(const string& $text) : string
    {
        string $out = "'";

        for (usize $i = 0; $i < $text->size(); $i++) {
            if ($out->size() > Show::$width) {
                $out->append('...');
                break;
            }

            uint8 $b = $text->byte($i);

            if ($b == 10) {
                $out->push(92);
                $out->push(110);
            } else if ($b == 13) {
                $out->push(92);
                $out->push(114);
            } else if ($b == 9) {
                $out->push(92);
                $out->push(116);
            } else if ($b == 39 || $b == 92) {
                $out->push(92);
                $out->push($b);
            } else if ($b < 32) {
                $out->append("\\x{$b:x}");
            } else {
                $out->push($b);
            }
        }

        $out->append("'");
        return $out;
    }

    /**
     * `$text` cut to `Show::$width` bytes, with `...` where it was cut.
     */
    internal static function cut(const string& $text) : string
    {
        if ($text->size() <= Show::$width) {
            return $text;
        }

        string $out = $text->sub(0, Show::$width);
        $out->append('...');
        return $out;
    }

    /**
     * `$text` with every line indented by `$by` spaces.
     */
    internal static function indent(const string& $text, usize $by) : string
    {
        $pad = str::repeat(' ', $by);
        string $out = '';
        bool $first = true;

        foreach (str::split($text, "\n") as const &$line) {
            if (!$first) {
                $out->append("\n");
            }
            $first = false;
            $out->append($pad);
            $out->append(string($line));
        }

        return $out;
    }
}
