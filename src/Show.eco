/**
 * How a value reads inside a failure. Text is quoted with its invisible bytes spelled out, so a
 * stray `\r` or trailing space shows, and anything long is cut so a summary stays on one line.
 */

namespace ecotest::show;

/**
 * How many bytes of a value a one-line summary shows before cutting.
 */
internal const usize WIDTH = 120;

/**
 * `$text` quoted, with tabs, newlines, carriage returns and other control bytes escaped, cut to
 * `WIDTH`.
 */
internal function text(const string& $text) : string
{
    string $out = "'";

    for (usize $i = 0; $i < $text->size(); $i++) {
        if ($out->size() > WIDTH) {
            $out->append('...');
            break;
        }

        uint8 $b = $text->byte($i);

        if ($b == 10) {
            $out->push(92);
            $out->push(110);
        } else if ($b == 13) {
            $out->push(92);
            $out->push(114);
        } else if ($b == 9) {
            $out->push(92);
            $out->push(116);
        } else if ($b == 39 || $b == 92) {
            $out->push(92);
            $out->push($b);
        } else if ($b < 32) {
            $out->append("\\x{$b:x}");
        } else {
            $out->push($b);
        }
    }

    $out->append("'");
    return $out;
}

/**
 * `$text` cut to `WIDTH` bytes, with `...` where it was cut.
 */
internal function cut(const string& $text) : string
{
    if ($text->size() <= WIDTH) {
        return $text;
    }

    string $out = $text->sub(0, WIDTH);
    $out->append('...');
    return $out;
}

/**
 * `$text` with every line indented by `$by` spaces.
 */
internal function indent(const string& $text, usize $by) : string
{
    $pad = str::repeat(' ', $by);
    string $out = '';
    bool $first = true;

    foreach (str::split($text, "\n") as const &$line) {
        if (!$first) {
            $out->append("\n");
        }
        $first = false;
        $out->append($pad);
        $out->append(string($line));
    }

    return $out;
}
