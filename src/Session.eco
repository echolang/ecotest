namespace ecotest;

use ecotest::{show, protocol};

/**
 * One `soft()` or `caught()` scope: the failures it holds, and whether leaving it reports them
 * (`soft`) or hands them back (`caught`).
 */
internal struct Frame
{
    public array<Failure> $held = [];
    public bool $capture = false;
}

/**
 * What one test process knows about itself: which test it is, where its events go, the open
 * `soft()` and `context()` scopes, the failures held until a soft scope ends, and the cleanups to
 * run when the test stops early. Started by the first ecotest call in the process; without
 * `ECHO_TEST_ID` and `ECOTEST_RUN_DIR` nothing is written and every check still works.
 *
 * Every way a test can end goes through here, so held failures and cleanups are never lost: a
 * soft scope closing, a check that stops, a crash, and a skip.
 */
internal class Session
{
    internal static bool $started = false;
    internal static string $id = '';
    internal static string $events = '';
    internal static array<Frame> $frames = [];
    internal static array<Failure> $drain = [];
    internal static array<string> $context = [];
    internal static bool $reported = false;
    internal static Tally $tally = Tally();
    internal static map<usize, function<void()>> $cleanups = [];
    internal static usize $nextCleanup = 0;

    /**
     * Reads the test's identity, opens its event file and installs the crash hook. Safe to call
     * any number of times.
     */
    internal static function start() : void
    {
        if (Session::$started) {
            return;
        }

        Session::$started = true;
        Session::$id = string(std::env::var('ECHO_TEST_ID', ''));

        $dir = string(std::env::var(protocol::RUN_DIR, ''));
        if (!$dir->empty() && !Session::$id->empty()) {
            $folder = std::fs::path($dir) / 'events';
            $made = std::fs::mkdir($folder, recursive: true);
            $name = protocol::key(Session::$id);
            $name->append('.jsonl');
            Session::$events = ($folder / $name)->string();
            // a static's field is not a place; the handle is
            $tally = Session::$tally;
            $tally->path = Session::$events;
        }

        crash::set_hook(&crashed);
    }

    /**
     * Counts one check towards the test's `checks` event.
     */
    internal static function checked() : void
    {
        Session::start();
        $tally = Session::$tally;
        $tally->checks = $tally->checks + 1;
    }

    /**
     * Appends one event line to the test's event file. Does nothing without one.
     */
    internal static function write(const string& $line) : void
    {
        Session::start();

        if (Session::$events->empty()) {
            return;
        }

        Session::append(Session::$events, $line);
    }

    /**
     * Appends `$line` and a newline to `$path`. A file that cannot be opened loses the line: a
     * report is never a reason to fail the test.
     */
    internal static function append(const string& $path, const string& $line) : void
    {
        $f = guard std::fs::append($path) else {
            return;
        };

        $wrote = $f->write("{$line}\n");
        $f->close();
    }

    /**
     * Runs `$undo` if the test stops early: a failed check, a crash or a skip. A test that ends
     * normally runs its destructors instead, so the owner calls `undefer` from there. Answers the
     * handle `undefer` takes.
     */
    internal static function defer(function<void()> $undo) : usize
    {
        Session::start();
        usize $id = Session::$nextCleanup;
        Session::$nextCleanup = $id + 1;
        Session::$cleanups[$id] = $undo;
        return $id;
    }

    /**
     * Forgets a cleanup that `defer` registered, once its owner has cleaned up by itself.
     */
    internal static function undefer(usize $id) : void
    {
        if (Session::$cleanups->has($id)) {
            Session::$cleanups->remove($id);
        }
    }

    /**
     * Runs every registered cleanup, newest first, and forgets them.
     */
    internal static function cleanup() : void
    {
        array<usize> $ids = [];
        foreach (Session::$cleanups as $id => const &$undo) {
            $ids[] = $id;
        }
        $ids->sort();

        while (!$ids->empty()) {
            usize $id = $ids->pop();
            if (!Session::$cleanups->has($id)) {
                continue;
            }
            $undo = Session::$cleanups->get($id);
            Session::$cleanups->remove($id);
            $undo();
        }
    }

    /**
     * Takes a failure: held while a `soft()` or `caught()` scope is open, otherwise the test
     * stops here.
     */
    internal static function fail(Failure $failure) : void
    {
        Session::start();
        $failure->context = Session::$context;

        if (!Session::$frames->empty()) {
            Frame& $top = Session::$frames[Session::$frames->count() - 1];
            $top->held[] = mv $failure;
            return;
        }

        Session::stop($failure);
    }

    /**
     * Stops the test at the failure's own line, whatever scope is open. Failures a soft scope
     * holds are reported with it.
     */
    internal static function stop(Failure $failure) : void
    {
        die(Session::report($failure), $failure->at);
    }

    /**
     * Writes the failure's event, after any held ones, as the test's last word and answers the
     * report to stop with. For a `guard ... else` that has to end in its own `die`.
     */
    internal static function report(Failure $failure) : string
    {
        Session::start();

        if ($failure->context->empty()) {
            $failure->context = Session::$context;
        }

        Session::flatten();
        Session::$drain[] = mv $failure;
        return Session::flush();
    }

    /**
     * Moves every held failure into `$drain`, outermost first.
     */
    private static function flatten() : void
    {
        foreach (Session::$frames as &$frame) {
            foreach ($frame->held as const &$held) {
                Session::$drain[] = $held;
            }
            $frame->held->clear();
        }
        Session::$frames->clear();
    }

    /**
     * Writes a `fail` event for every drained failure, then the check count, and answers the
     * report that stops the test: the one failure as it reads, or each one under its line.
     */
    internal static function flush() : string
    {
        Session::$reported = true;
        usize $count = Session::$drain->count();
        string $text = '';

        if ($count == 1) {
            const Failure& $only = Session::$drain[0];
            emitFail($only);
            $text = "{$only}";
        } else {
            $text = "{$count} checks failed";
            foreach (Session::$drain as const &$failure) {
                emitFail($failure);
                $at = $failure->at;
                $text->append("\n\n{$at->file}:{$at->line}\n");
                $text->append(show::indent("{$failure}", 2));
            }
        }

        Session::$drain->clear();
        Session::$tally->flush();
        return $text;
    }

    /**
     * Pushes a `context()` line onto the stack attached to later failures.
     */
    internal static function enterContext(const string& $text) : void
    {
        Session::start();
        Session::$context[] = $text;
    }

    /**
     * Drops the innermost `context()` line.
     */
    internal static function leaveContext() : void
    {
        if (!Session::$context->empty()) {
            string $dropped = Session::$context->pop();
        }
    }

    /**
     * How many checks this test has counted so far.
     */
    internal static function checkCount() : int64
    {
        $tally = Session::$tally;
        return $tally->checks;
    }

    /**
     * Sets the check count, so a property that made many inner checks still counts as one.
     */
    internal static function setChecks(int64 $n) : void
    {
        $tally = Session::$tally;
        $tally->checks = $n;
    }

    /**
     * Opens a `soft()` scope.
     */
    internal static function enterSoft() : void
    {
        Session::start();
        Session::$frames[] = Frame();
    }

    /**
     * Opens a `caught()` scope: failures are held and handed back instead of stopping the test.
     */
    internal static function enterCaught() : void
    {
        Session::start();
        Session::$frames[] = Frame([], true);
    }

    /**
     * Closes a `soft()` scope. The outermost one reports every held failure together and stops
     * the test at the first one's line. An inner one merges its failures into the parent.
     */
    internal static function leaveSoft() : void
    {
        if (Session::$frames->empty()) {
            return;
        }

        Frame $frame = Session::$frames->pop();
        if ($frame->capture || $frame->held->empty()) {
            return;
        }

        if (!Session::$frames->empty()) {
            Frame& $parent = Session::$frames[Session::$frames->count() - 1];
            foreach ($frame->held as const &$held) {
                $parent->held[] = $held;
            }
            return;
        }

        $at = $frame->held[0]->at;
        Session::$drain = mv $frame->held;
        die(Session::flush(), $at);
    }

    /**
     * Closes a `caught()` scope and answers the failures it held.
     */
    internal static function leaveCaught() : array<Failure>
    {
        if (Session::$frames->empty()) {
            array<Failure> $none = [];
            return $none;
        }

        Frame $frame = Session::$frames->pop();
        return mv $frame->held;
    }

    /**
     * Ends the test as skipped, unless a soft scope already holds failures: a test that failed is
     * not skipped. Answers the report to stop with in that case, null when the skip stands.
     */
    internal static function skipping(const string& $reason, const std::src::location& $at) : string?
    {
        Session::start();

        bool $held = false;
        foreach (Session::$frames as const &$frame) {
            if (!$frame->held->empty()) {
                $held = true;
            }
        }
        if ($held || !Session::$drain->empty()) {
            Session::flatten();
            return Session::flush();
        }

        Session::$reported = true;
        emitSkip($reason, $at);
        Session::$tally->flush();
        Session::cleanup();
        return null;
    }

    /**
     * A stop that no check reported, as the crash hook sees it: the held failures, then a `crash`
     * event, then the cleanups. After a reported stop only the cleanups run.
     */
    internal static function wreck(
        const string& $headline,
        const string& $message,
        const string& $file,
        int64 $line
    ) : void {
        if (!Session::$reported) {
            // the default report names only the crash; the held failures print first
            Session::flatten();
            if (!Session::$drain->empty()) {
                std::io::eprintln(Session::flush());
            }

            emitCrash($headline, $message, $file, $line);
            Session::$tally->flush();
            Session::$reported = true;
        }

        Session::cleanup();
    }
}

/**
 * The crash hook ecotest installs. Every stop, a check's or not, runs the cleanups; a plain
 * `assert`, `die` or `guard` stop that no check reported also becomes a `crash` event. Then the
 * default report prints as usual.
 */
internal function crashed(const crash::info& $info) : void
{
    Session::wreck(string($info->headline), string($info->message), string($info->file), $info->line as int64);
    crash::default_hook($info);
}
