/**
 * What a test and the ecotest tool agree on: the version of an event line, the event types, the
 * file name a test id becomes, and the variable a named service's URL lives in. Both sides read
 * these from here, so they cannot drift apart.
 */

namespace ecotest::protocol;

/**
 * The version every event line carries as `"v"`. A reader skips lines of another version instead
 * of guessing at them.
 */
public const int64 VERSION = 1;

/**
 * The `"type"` of an event line.
 */
public enum Kind : string
{
    case fail = 'fail';
    case crash = 'crash';
    case skip = 'skip';
    case note = 'note';
    case metric = 'metric';
    case bench = 'bench';
    case checks = 'checks';
    case snapshotNew = 'snapshot-new';
    case snapshotUpdated = 'snapshot-updated';

    /**
     * The kind `$word` names, or null.
     */
    public static function of(const string& $word) : Kind?
    {
        if ($word == Kind::fail->value()) {
            return .fail;
        }
        if ($word == Kind::crash->value()) {
            return .crash;
        }
        if ($word == Kind::skip->value()) {
            return .skip;
        }
        if ($word == Kind::note->value()) {
            return .note;
        }
        if ($word == Kind::metric->value()) {
            return .metric;
        }
        if ($word == Kind::bench->value()) {
            return .bench;
        }
        if ($word == Kind::checks->value()) {
            return .checks;
        }
        if ($word == Kind::snapshotNew->value()) {
            return .snapshotNew;
        }
        if ($word == Kind::snapshotUpdated->value()) {
            return .snapshotUpdated;
        }
        return null;
    }
}

/**
 * The variable that names the directory a test writes its events into, one per pass.
 */
public const string RUN_DIR = 'ECOTEST_RUN_DIR';

/**
 * The variable that carries the seed property tests start from, so every pass draws the same
 * values and a failure replays.
 */
public const string SEED = 'ECOTEST_SEED';

/**
 * The file-name form of a test id: every byte outside `[A-Za-z0-9_.-]` becomes `_`, the same
 * rule echoc uses for the test's coverage file, so events and counters join on one key.
 */
public function key(const string& $id) : string
{
    return scrub($id, false, true);
}

/**
 * The environment variable that carries the URL of the service named `$name`:
 * `ECOTEST_<NAME>_URL`, upper case, with every byte outside `[A-Z0-9]` turned into `_`.
 */
public function serviceVar(const string& $name) : string
{
    return serviceVar($name, 'URL');
}

/**
 * `ECOTEST_<NAME>_<suffix>`, the variable that carries one fact about the service named `$name`:
 * `URL` where it answers, `READY` the URL that answers once it is up, `READY_MS` how long that may
 * take. The tool sets them; ecotest-http reads them.
 */
public function serviceVar(const string& $name, const string& $suffix) : string
{
    string $out = 'ECOTEST_';
    $out->append(scrub($name, true, false));
    $out->push(95);
    $out->append($suffix);
    return $out;
}

/**
 * `$raw` with every byte outside the allowed set turned into `_`. Letters become upper case when
 * `$upper` is set. `$dotHyphen` keeps `_`, `-` and `.` as they are, which is the file-name form
 * of a test id; a service name keeps only letters and digits.
 */
private function scrub(const string& $raw, bool $upper, bool $dotHyphen) : string
{
    string $out = '';

    for (usize $i = 0; $i < $raw->size(); $i++) {
        uint8 $b = $raw->byte($i);

        if ($b >= 97 && $b <= 122) {
            if ($upper) {
                $out->push($b - 32);
            } else {
                $out->push($b);
            }
        } else if (($b >= 65 && $b <= 90) || ($b >= 48 && $b <= 57)) {
            $out->push($b);
        } else if ($dotHyphen && ($b == 95 || $b == 45 || $b == 46)) {
            $out->push($b);
        } else {
            $out->push(95);
        }
    }

    return $out;
}

namespace str;

/**
 * The word an event line carries as `"type"`.
 */
public function from(ecotest::protocol::Kind $kind) : string
{
    return $kind->value();
}
