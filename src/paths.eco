/**
 * File paths as both ecotest and its tool handle them. `/` separates everywhere; on Windows `\`
 * does too, and `C:\` and `\\server\share` are roots. Paths are joined with `std::env::join`, so
 * what this splits is what the platform wrote.
 */

namespace ecotest::paths;

/**
 * True for a byte that separates path segments here.
 */
public function isSep(uint8 $b) : bool
{
#[if: os == windows]
    return $b == 47 || $b == 92;
#[else]
    return $b == 47;
#[end]
}

/**
 * True when `$path` names the same place from any working directory: it starts at a separator,
 * or on Windows at a drive (`C:\`, `C:/`).
 */
public function isAbsolute(const string& $path) : bool
{
    if ($path->empty()) {
        return false;
    }

    if (isSep($path->byte(0))) {
        return true;
    }

#[if: os == windows]
    if ($path->size() >= 3 && $path->byte(1) == 58 && isSep($path->byte(2))) {
        uint8 $d = $path->byte(0);
        return ($d >= 65 && $d <= 90) || ($d >= 97 && $d <= 122);
    }
#[end]

    return false;
}

/**
 * The root of an absolute `$path` (`/`, `C:\`, `\\server\share\`), or empty for a relative one.
 */
public function root(const string& $path) : string
{
    if (!isAbsolute($path)) {
        return '';
    }

#[if: os == windows]
    if ($path->size() >= 2 && isSep($path->byte(0)) && isSep($path->byte(1))) {
        // \\server\share\ is one root
        usize $seps = 0;
        for (usize $i = 2; $i < $path->size(); $i++) {
            if (isSep($path->byte($i))) {
                $seps++;
                if ($seps == 2) {
                    return $path->sub(0, $i + 1);
                }
            }
        }
        return $path;
    }

    if (!isSep($path->byte(0))) {
        return $path->sub(0, 3);
    }
#[end]

    return $path->sub(0, 1);
}

/**
 * The segments of `$path` below its root, without empty ones and without `.`.
 */
public function split(const string& $path) : array<string>
{
    array<string> $out = [];
    $from = root($path)->size();
    string $part = '';

    for (usize $i = $from; $i < $path->size(); $i++) {
        uint8 $b = $path->byte($i);
        if (!isSep($b)) {
            $part->push($b);
            continue;
        }
        if (!$part->empty() && $part != '.') {
            $out[] = $part;
        }
        $part = '';
    }

    if (!$part->empty() && $part != '.') {
        $out[] = $part;
    }

    return $out;
}

/**
 * The index of the last separator in `$path`, or null when there is none.
 */
private function lastSep(const string& $path) : usize?
{
    usize? $cut = null;
    for (usize $i = 0; $i < $path->size(); $i++) {
        if (isSep($path->byte($i))) {
            $cut = $i;
        }
    }
    return $cut;
}

/**
 * Everything before the last separator of `$path`: the root itself when that is all there is,
 * `.` when there is no separator.
 */
public function dir(const string& $path) : string
{
    $cut = guard lastSep($path) else {
        return '.';
    };

    $r = root($path);
    if ($cut < $r->size()) {
        return $r;
    }

    return $path->sub(0, $cut);
}

/**
 * The last segment of `$path`: everything after its last separator, or all of it.
 */
public function base(const string& $path) : string
{
    $cut = guard lastSep($path) else {
        return $path;
    };

    return $path->sub($cut + 1, $path->size() - $cut - 1);
}

/**
 * The last segment of `$path` without its extension. A leading dot (`.env`) is not an extension.
 */
public function stem(const string& $path) : string
{
    $b = base($path);
    for (usize $i = $b->size(); $i > 1; $i--) {
        if ($b->byte($i - 1) == 46) {
            return $b->sub(0, $i - 1);
        }
    }
    return $b;
}

/**
 * `$path` joined onto `$base`: `$path` itself when it is absolute, `$base` when it is empty.
 */
public function resolve(const string& $base, const string& $path) : string
{
    if ($path->empty()) {
        return $base;
    }

    if (isAbsolute($path)) {
        return $path;
    }

    return std::env::join($base, $path);
}

/**
 * `$path` as written from inside `$base`, with `/` between segments, when it lies below `$base`.
 * Anything else comes back as it was. For reports, which name `tests/date.eco` rather than a
 * checkout path.
 */
public function relative(const string& $path, const string& $base) : string
{
    if (root($path) != root($base)) {
        return $path;
    }

    $p = split($path);
    $b = split($base);

    if ($p->count() <= $b->count()) {
        return $path;
    }

    for (usize $i = 0; $i < $b->count(); $i++) {
        if ($p[$i] != $b[$i]) {
            return $path;
        }
    }

    string $out = '';
    for (usize $i = $b->count(); $i < $p->count(); $i++) {
        if (!$out->empty()) {
            $out->append('/');
        }
        $out->append($p[$i]);
    }
    return $out;
}

/**
 * Creates `$path` and every missing directory above it. A directory that is already there is
 * fine; the first one that cannot be made is the failure.
 */
public function mkdirs(const string& $path) : status<std::io::ioerror>
{
    string $built = root($path);

    foreach (split($path) as const &$part) {
        if ($built->empty()) {
            $built = $part;
        } else {
            $built = std::env::join($built, $part);
        }

        guard std::io::mkdir($built) else ($e) {
            if (!std::io::exists($built)->or(false)) {
                return .error($e);
            }
            continue;
        };
    }

    return .ok;
}

/**
 * Removes `$path` and everything below it. A symbolic link is removed, never followed. True when
 * the directory is gone.
 */
public function removeTree(const string& $path) : bool
{
    $listing = guard std::io::opendir($path) else {
        return false;
    };

    array<string> $dirs = [];
    array<string> $others = [];
    foreach ($listing as const &$entry) {
        if ($entry->is_directory()) {
            $dirs[] = $entry->path();
        } else {
            $others[] = $entry->path();
        }
    }
    $listing->close();

    foreach ($others as const &$file) {
        $gone = std::io::remove($file);
    }
    foreach ($dirs as const &$dir) {
        $gone = removeTree($dir);
    }

    return std::io::rmdir($path)->or(false);
}
