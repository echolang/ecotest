namespace ecotest;

/**
 * A generator for property tests: how to make a random `T`, how to offer smaller versions of one
 * that failed, and how to print one. Built by the functions in `ecotest::gen`.
 */
public class Gen<T>
{
    /**
     * Makes one random value from `Random`.
     */
    public const function<T(Random&)> $make;

    /**
     * Offers smaller versions of a failing value for the shrinker to try.
     */
    public const function<array<T>(const T&)> $shrink;

    /**
     * Prints a value for the failure message.
     */
    public const function<string(const T&)> $show;
}
