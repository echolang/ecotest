namespace ecotest;

/**
 * A generator for property tests: how to build a `T` from the answers `Draws` hands out, and how
 * to print one. Shrinking needs nothing more, because it works on the answers rather than on the
 * value. Built by the functions in `ecotest::gen`; a generator of your own is any closure over
 * `Draws`, usually made of other generators:
 * `Gen<Point>((Draws& $d) => Point($x->draw($d), $y->draw($d)), (const Point& $p) => "{$p}")`.
 */
public class Gen<T>
{
    /**
     * Builds one value from `Draws`.
     */
    public const function<T(Draws&)> $draw;

    /**
     * Prints a value for the failure message.
     */
    public const function<string(const T&)> $show;
}
