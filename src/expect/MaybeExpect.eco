namespace ecotest;

use ecotest::show;

/**
 * Checks on a `T?`. `some()` hands back the value and stops the test when there is none, even
 * inside `soft()`.
 */
public class MaybeExpect<T>
{
    /**
     * The value under test.
     */
    public T? $value;

    /**
     * The value, or the test stops because it is absent.
     */
    #[caller]
    public const function some() : T
    {
        Session::checked();
        $at = std::src::caller();

        $got = guard $this->value else {
            die(Session::report(Failure('expected a value, got null', $at)), $at);
        };
        return $got;
    }

    /**
     * A value is present and equals `$want`.
     */
    #[caller]
    public const function some(const T& $want) : MaybeExpect<T>
    {
        Session::checked();

        $got = guard $this->value else {
            $w = show::item($want);
            fail("expected {$w}, got null", std::src::caller(), $expected: $w, $actual: 'null', $inline: true);
            return $this;
        };

        if (!($got == $want)) {
            $w = show::item($want);
            $g = show::item($got);
            fail("expected {$w}, got {$g}", std::src::caller(), $expected: $w, $actual: $g, $inline: true);
        }

        return $this;
    }

    /**
     * No value is present.
     */
    #[caller]
    public const function none() : MaybeExpect<T>
    {
        Session::checked();

        if ($this->value == null) {
            return $this;
        }

        fail('expected null, got a value', std::src::caller());
        return $this;
    }
}
