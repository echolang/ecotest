namespace ecotest;

/**
 * Checks on a `map<K, V>`. A failed `is` lists the missing, extra and changed keys.
 */
public class MapExpect<K, V>
{
    public map<K, V> $value;

    public constructor(map<K, V> $value)
    {
        $this->value = $value;
    }

    /**
     * The map holds `$key`.
     */
    #[caller]
    public function has(key: const K& $key) : MapExpect<K, V>
    {
        Session::checked();

        if ($this->value->has($key)) {
            return $this;
        }

        Failure("expected key {$key}", std::src::caller())->raise();
        return $this;
    }

    /**
     * The map holds `$key`, and its value equals `$want`.
     */
    #[caller]
    public function at(const K& $key, const V& $want) : MapExpect<K, V>
    {
        Session::checked();

        if (!$this->value->has($key)) {
            Failure("expected key {$key}", std::src::caller())->raise();
            return $this;
        }

        $got = $this->value->get($key);
        if (!($got == $want)) {
            Failure("at {$key}: expected {$want}, got {$got}", std::src::caller(), $expected: "{$want}", $actual: "{$got}")->raise();
        }

        return $this;
    }

    /**
     * The map holds exactly `$count` keys.
     */
    #[caller]
    public function size(usize $count) : MapExpect<K, V>
    {
        Session::checked();

        usize $m = $this->value->count();
        if ($m != $count) {
            Failure("expected {$count} keys, got {$m}", std::src::caller())->raise();
        }

        return $this;
    }

    /**
     * The map holds no keys.
     */
    #[caller]
    public function empty() : MapExpect<K, V>
    {
        Session::checked();

        usize $m = $this->value->count();
        if ($m != 0) {
            Failure("expected no keys, got {$m}", std::src::caller())->raise();
        }

        return $this;
    }

    /**
     * The map has the same keys as `$want`, each with an equal value.
     */
    #[caller]
    public function is(const map<K, V>& $want) : MapExpect<K, V>
    {
        Session::checked();

        string $detail = '';

        foreach ($want as $key => const &$value) {
            if (!$this->value->has($key)) {
                $detail->append("- {$key}: {$value}\n");
                continue;
            }

            $got = $this->value->get($key);
            if (!($got == $value)) {
                $detail->append("~ {$key}: expected {$value}, got {$got}\n");
            }
        }

        foreach ($this->value as $key => const &$value) {
            if (!$want->has($key)) {
                $detail->append("+ {$key}: {$value}\n");
            }
        }

        if (!$detail->empty()) {
            Failure('maps differ (- missing, + extra, ~ changed)', std::src::caller(), $detail: $detail)->raise();
        }

        return $this;
    }
}
