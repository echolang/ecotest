namespace ecotest;

/**
 * Checks on a `map<K, V>`. A failed `is` lists the missing, extra and changed keys.
 */
public class MapExpect<K, V>
{
    /**
     * The value under test.
     */
    public map<K, V> $value;

    /**
     * The map holds `$key`.
     */
    #[caller]
    public const function has(key: const K& $key) : MapExpect<K, V>
    {
        Session::checked();

        if ($this->value->has($key)) {
            return $this;
        }

        fail("expected key {$key}", std::src::caller());
        return $this;
    }

    /**
     * The map holds `$key`, and its value equals `$want`.
     */
    #[caller]
    public const function at(const K& $key, const V& $want) : MapExpect<K, V>
    {
        Session::checked();

        if (!$this->value->has($key)) {
            fail("expected key {$key}", std::src::caller());
            return $this;
        }

        $got = $this->value->get($key);
        if (!($got == $want)) {
            fail("at {$key}: expected {$want}, got {$got}", std::src::caller(), $expected: "{$want}", $actual: "{$got}");
        }

        return $this;
    }

    /**
     * The map holds exactly `$count` keys.
     */
    #[caller]
    public const function size(usize $count) : MapExpect<K, V>
    {
        Session::checked();

        usize $m = $this->value->count();
        if ($m != $count) {
            fail("expected {$count} keys, got {$m}", std::src::caller());
        }

        return $this;
    }

    /**
     * The map holds no keys.
     */
    #[caller]
    public const function empty() : MapExpect<K, V>
    {
        Session::checked();

        usize $m = $this->value->count();
        if ($m != 0) {
            fail("expected no keys, got {$m}", std::src::caller());
        }

        return $this;
    }

    /**
     * The map has the same keys as `$want`, each with an equal value.
     */
    #[caller]
    public const function is(const map<K, V>& $want) : MapExpect<K, V>
    {
        Session::checked();

        string $detail = '';

        foreach ($want as $key => const &$value) {
            if (!$this->value->has($key)) {
                $detail->append("- {$key}: {$value}\n");
                continue;
            }

            $got = $this->value->get($key);
            if (!($got == $value)) {
                $detail->append("~ {$key}: expected {$value}, got {$got}\n");
            }
        }

        foreach ($this->value as $key => const &$value) {
            if (!$want->has($key)) {
                $detail->append("+ {$key}: {$value}\n");
            }
        }

        if (!$detail->empty()) {
            fail('maps differ (- missing, + extra, ~ changed)', std::src::caller(), $detail: $detail);
        }

        return $this;
    }
}
