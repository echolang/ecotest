namespace ecotest;

/**
 * Checks on an unsigned integer. Every unsigned width, `usize` included, widens to `uint64`.
 */
public class UnsignedExpect
{
    public uint64 $value;

    public constructor(uint64 $value)
    {
        $this->value = $value;
    }

    /**
     * The number equals `$want`.
     */
    #[caller]
    public function is(uint64 $want) : UnsignedExpect
    {
        Session::checked();

        if ($this->value == $want) {
            return $this;
        }

        Failure("expected {$want}, got {$this->value}", std::src::caller(), $expected: "{$want}", $actual: "{$this->value}")->raise();
        return $this;
    }

    /**
     * The number differs from `$other`.
     */
    #[caller]
    public function isNot(uint64 $other) : UnsignedExpect
    {
        Session::checked();

        if ($this->value != $other) {
            return $this;
        }

        Failure("expected anything but {$other}", std::src::caller())->raise();
        return $this;
    }

    /**
     * The number is greater than `$bound`.
     */
    #[caller]
    public function above(uint64 $bound) : UnsignedExpect
    {
        Session::checked();

        if ($this->value > $bound) {
            return $this;
        }

        Failure("expected more than {$bound}, got {$this->value}", std::src::caller())->raise();
        return $this;
    }

    /**
     * The number is less than `$bound`.
     */
    #[caller]
    public function below(uint64 $bound) : UnsignedExpect
    {
        Session::checked();

        if ($this->value < $bound) {
            return $this;
        }

        Failure("expected less than {$bound}, got {$this->value}", std::src::caller())->raise();
        return $this;
    }

    /**
     * The number lies in `[$low, $high]`, both ends included.
     */
    #[caller]
    public function between(uint64 $low, uint64 $high) : UnsignedExpect
    {
        Session::checked();

        if ($this->value >= $low && $this->value <= $high) {
            return $this;
        }

        Failure("expected {$low} to {$high}, got {$this->value}", std::src::caller())->raise();
        return $this;
    }
}
