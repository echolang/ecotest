namespace ecotest;

/**
 * Checks on an unsigned integer. Every unsigned width, `usize` included, widens to `uint64`.
 */
public class UnsignedExpect
{
    /**
     * The value under test.
     */
    public uint64 $value;

    /**
     * The number equals `$want`.
     */
    #[caller]
    public const function is(uint64 $want) : UnsignedExpect
    {
        Session::checked();

        if ($this->value == $want) {
            return $this;
        }

        fail("expected {$want}, got {$this->value}", std::src::caller(), $expected: "{$want}", $actual: "{$this->value}", $inline: true);
        return $this;
    }

    /**
     * The number differs from `$other`.
     */
    #[caller]
    public const function isNot(uint64 $other) : UnsignedExpect
    {
        Session::checked();

        if ($this->value != $other) {
            return $this;
        }

        fail("expected anything but {$other}", std::src::caller());
        return $this;
    }

    /**
     * The number is greater than `$bound`.
     */
    #[caller]
    public const function above(uint64 $bound) : UnsignedExpect
    {
        Session::checked();

        if ($this->value > $bound) {
            return $this;
        }

        fail("expected more than {$bound}, got {$this->value}", std::src::caller());
        return $this;
    }

    /**
     * The number is less than `$bound`.
     */
    #[caller]
    public const function below(uint64 $bound) : UnsignedExpect
    {
        Session::checked();

        if ($this->value < $bound) {
            return $this;
        }

        fail("expected less than {$bound}, got {$this->value}", std::src::caller());
        return $this;
    }

    /**
     * The number lies in `[$low, $high]`, both ends included.
     */
    #[caller]
    public const function between(uint64 $low, uint64 $high) : UnsignedExpect
    {
        Session::checked();

        if ($this->value >= $low && $this->value <= $high) {
            return $this;
        }

        fail("expected {$low} to {$high}, got {$this->value}", std::src::caller());
        return $this;
    }
}
