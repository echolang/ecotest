namespace ecotest;

use ecotest::show;

/**
 * Checks on a finished program. `stdout()` and `stderr()` hand over to text checks, so
 * `expect($ran)->exits(0)->stdout()->has('done')` reads as one sentence.
 */
public class RanExpect
{
    /**
     * The finished program under test.
     */
    public Ran $ran;

    /**
     * The program exited with `$code`.
     */
    #[caller]
    public const function exits(int32 $code) : RanExpect
    {
        Session::checked();

        if (!$this->exited($code)) {
            $how = $this->describe();
            fail(
                "expected {$this->ran->command} to exit {$code}, got {$how}",
                std::src::caller(),
                $detail: $this->streams()
            );
        }

        return $this;
    }

    /**
     * The program exited 0.
     */
    #[caller]
    public const function succeeds() : RanExpect
    {
        return $this->exits(0);
    }

    /**
     * Text checks on what the program wrote to stdout.
     */
    public const function stdout() : TextExpect
    {
        return TextExpect($this->ran->stdout);
    }

    /**
     * Text checks on what the program wrote to stderr.
     */
    public const function stderr() : TextExpect
    {
        return TextExpect($this->ran->stderr);
    }

    /**
     * True when the program exited on its own with `$code`.
     */
    private const function exited(int32 $code) : bool
    {
        $got = guard $this->ran->code else {
            return false;
        };

        return $got == $code;
    }

    /**
     * "exit 2", or "a signal" when it did not exit on its own.
     */
    private const function describe() : string
    {
        $got = guard $this->ran->code else {
            return 'a signal';
        };

        return "exit {$got}";
    }

    /**
     * Both streams, labelled, for the failure detail.
     */
    private const function streams() : string
    {
        string $out = '';

        if (!$this->ran->stdout->empty()) {
            $out->append("stdout:\n");
            $out->append(show::indent(show::cut($this->ran->stdout), 2));
        }

        if (!$this->ran->stderr->empty()) {
            if (!$out->empty()) {
                $out->append("\n");
            }
            $out->append("stderr:\n");
            $out->append(show::indent(show::cut($this->ran->stderr), 2));
        }

        return $out;
    }
}
