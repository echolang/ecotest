namespace ecotest;

use ecotest::show;

/**
 * Checks on any other value: your structs, classes and enums. Reached through the labelled
 * `expect(value: $x)`, because an unlabelled catch-all would leave `expect($list)` with two equally
 * good overloads. Comparing needs `==` on `T` and printing needs `str::from` for it.
 */
public class Expect<T>
{
    /**
     * The value under test.
     */
    public T $value;

    /**
     * The value equals `$want`.
     */
    #[caller]
    public const function is(const T& $want) : Expect<T>
    {
        Session::checked();

        if ($this->value == $want) {
            return $this;
        }

        $w = show::item($want);
        $g = show::item($this->value);
        fail("expected {$w}, got {$g}", std::src::caller(), $expected: $w, $actual: $g, $inline: true);
        return $this;
    }

    /**
     * The value differs from `$other`.
     */
    #[caller]
    public const function isNot(const T& $other) : Expect<T>
    {
        Session::checked();

        if (!($this->value == $other)) {
            return $this;
        }

        $o = show::item($other);
        fail("expected anything but {$o}", std::src::caller());
        return $this;
    }

    /**
     * The value passes `$test`. `says:` names what it should be in the failure.
     */
    #[caller]
    public const function satisfies(function<bool(const T&)> $test, says: const string& $what = '') : Expect<T>
    {
        Session::checked();

        if ($test($this->value)) {
            return $this;
        }

        $got = show::item($this->value);
        string $summary = "{$got} failed the test";
        if (!$what->empty()) {
            $summary = "expected {$what}, got {$got}";
        }

        fail($summary, std::src::caller(), $actual: $got, $inline: true);
        return $this;
    }
}
