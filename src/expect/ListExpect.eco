namespace ecotest;

use ecotest::show;

/**
 * Checks on an `array<T>`. `size`, `empty`, `all`, `any` and `sorted` work on any `T` (`sorted`
 * needs `<`); the checks that compare items (`is`, `has`, `lacks`, `same`) need `==` and print
 * them with `str::from`.
 */
public class ListExpect<T>
{
    /**
     * The value under test.
     */
    public array<T> $value;

    /**
     * The list equals `$want`: same length, same items in the same order. A failure names the
     * first index where they part.
     */
    #[caller]
    public const function is(const array<T>& $want) : ListExpect<T>
    {
        Session::checked();

        usize $n = $want->count();
        usize $m = $this->value->count();
        usize $k = 0;

        while ($k < $n && $k < $m && $want[$k] == $this->value[$k]) {
            $k++;
        }

        if ($k == $n && $k == $m) {
            return $this;
        }

        string $summary = '';
        if ($k == $n) {
            $summary = "expected {$n} items, got {$m}: extra items from index {$k}";
        } else if ($k == $m) {
            $summary = "expected {$n} items, got {$m}: missing items from index {$k}";
        } else {
            $w = $want[$k];
            $g = $this->value[$k];
            $summary = "lists differ at index {$k}: expected {$w}, got {$g}";
        }

        fail(
            $summary,
            std::src::caller(),
            $expected: $this->show($want),
            $actual: $this->show($this->value)
        );
        return $this;
    }

    /**
     * The list holds exactly `$count` items.
     */
    #[caller]
    public const function size(usize $count) : ListExpect<T>
    {
        Session::checked();

        usize $m = $this->value->count();
        if ($m == $count) {
            return $this;
        }

        fail("expected {$count} items, got {$m}", std::src::caller());
        return $this;
    }

    /**
     * The list holds no items.
     */
    #[caller]
    public const function empty() : ListExpect<T>
    {
        Session::checked();

        if ($this->value->empty()) {
            return $this;
        }

        usize $m = $this->value->count();
        fail("expected no items, got {$m}", std::src::caller());
        return $this;
    }

    /**
     * Some item equals `$item`.
     */
    #[caller]
    public const function has(const T& $item) : ListExpect<T>
    {
        Session::checked();

        foreach ($this->value as const &$each) {
            if ($each == $item) {
                return $this;
            }
        }

        fail("expected the list to contain {$item}", std::src::caller(), $actual: $this->show($this->value));
        return $this;
    }

    /**
     * No item equals `$item`.
     */
    #[caller]
    public const function lacks(const T& $item) : ListExpect<T>
    {
        Session::checked();

        for (usize $k = 0; $k < $this->value->count(); $k++) {
            if ($this->value[$k] == $item) {
                fail("expected the list not to contain {$item}, found at index {$k}", std::src::caller());
                return $this;
            }
        }

        return $this;
    }

    /**
     * Every item passes `$test`. A failure names the first one that does not.
     */
    #[caller]
    public const function all(function<bool(const T&)> $test, says: const string& $what = '') : ListExpect<T>
    {
        Session::checked();

        for (usize $k = 0; $k < $this->value->count(); $k++) {
            if (!$test($this->value[$k])) {
                string $summary = "item {$k} failed the test";
                if (!$what->empty()) {
                    $summary = "item {$k} is not {$what}";
                }

                fail($summary, std::src::caller());
                return $this;
            }
        }

        return $this;
    }

    /**
     * At least one item passes `$test`.
     */
    #[caller]
    public const function any(function<bool(const T&)> $test, says: const string& $what = '') : ListExpect<T>
    {
        Session::checked();

        foreach ($this->value as const &$each) {
            if ($test($each)) {
                return $this;
            }
        }

        string $summary = 'no item passed the test';
        if (!$what->empty()) {
            $summary = "no item is {$what}";
        }

        fail($summary, std::src::caller());
        return $this;
    }

    /**
     * The items are in ascending order. Needs `<` on `T`.
     */
    #[caller]
    public const function sorted() : ListExpect<T>
    {
        Session::checked();

        for (usize $k = 1; $k < $this->value->count(); $k++) {
            if ($this->value[$k] < $this->value[$k - 1]) {
                usize $before = $k - 1;
                fail("expected ascending order, item {$k} comes before item {$before}", std::src::caller());
                return $this;
            }
        }

        return $this;
    }

    /**
     * The list holds the same items as `$want`, each as often, in any order.
     */
    #[caller]
    public const function same(const array<T>& $want) : ListExpect<T>
    {
        Session::checked();

        $used = arr::room<bool>($this->value->count());
        for (usize $k = 0; $k < $this->value->count(); $k++) {
            $used[] = false;
        }

        foreach ($want as const &$item) {
            bool $found = false;

            for (usize $k = 0; $k < $this->value->count(); $k++) {
                if (!$used[$k] && $this->value[$k] == $item) {
                    $used[$k] = true;
                    $found = true;
                    break;
                }
            }

            if (!$found) {
                fail(
                    "expected the same items in any order, {$item} is missing",
                    std::src::caller(),
                    $expected: $this->show($want),
                    $actual: $this->show($this->value)
                );
                return $this;
            }
        }

        for (usize $k = 0; $k < $this->value->count(); $k++) {
            if (!$used[$k]) {
                $item = $this->value[$k];
                fail(
                    "expected the same items in any order, {$item} is extra",
                    std::src::caller(),
                    $expected: $this->show($want),
                    $actual: $this->show($this->value)
                );
                return $this;
            }
        }

        return $this;
    }

    /**
     * `$items` as `[a, b, c]`, ending in `, ...]` once a line is full.
     */
    private const function show(const array<T>& $items) : string
    {
        string $out = '[';

        for (usize $k = 0; $k < $items->count(); $k++) {
            if ($k > 0) {
                $out->append(', ');
            }

            if ($out->size() > show::WIDTH) {
                $out->append('...');
                break;
            }

            $item = $items[$k];
            $out->append("{$item}");
        }

        $out->append(']');
        return $out;
    }
}
