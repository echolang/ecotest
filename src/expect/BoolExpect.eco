namespace ecotest;

/**
 * Checks on a `bool`. `says:` names the condition in the failure, since the expression that
 * produced it is gone by the time the check runs.
 */
public class BoolExpect
{
    /**
     * The value under test.
     */
    public const bool $value;

    /**
     * The value is `true`.
     */
    #[caller]
    public const function yes(says: const string& $what = '') : BoolExpect
    {
        Session::checked();
        if ($this->value) {
            return $this;
        }

        fail(BoolExpect::summary('true', $what), std::src::caller());
        return $this;
    }

    /**
     * The value is `false`.
     */
    #[caller]
    public const function no(says: const string& $what = '') : BoolExpect
    {
        Session::checked();
        if (!$this->value) {
            return $this;
        }

        fail(BoolExpect::summary('false', $what), std::src::caller());
        return $this;
    }

    /**
     * "expected true", or "expected ready to be true" when the check was named.
     */
    private static function summary(const string& $want, const string& $says) : string
    {
        if ($says->empty()) {
            return "expected {$want}";
        }

        return "expected {$says} to be {$want}";
    }
}
