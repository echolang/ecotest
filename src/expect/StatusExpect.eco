namespace ecotest;

/**
 * Checks on a `status<E>`: something that succeeds with no value, or fails with an `E`.
 */
public class StatusExpect<E>
{
    /**
     * The value under test.
     */
    public status<E> $value;

    /**
     * It succeeded.
     */
    #[caller]
    public function fine() : StatusExpect<E>
    {
        Session::checked();

        guard $this->value else ($e) {
            fail("expected success, got error {$e}", std::src::caller(), $actual: "{$e}");
            return $this;
        };

        return $this;
    }

    /**
     * The error, or the test stops because it succeeded.
     */
    #[caller]
    public function fails() : E
    {
        Session::checked();

        if ($this->value->has_value()) {
            stop('expected an error, got success', std::src::caller());
        }

        return $this->value->failure();
    }

    /**
     * It failed with an error equal to `$want`. Needs `==` on `E`.
     */
    #[caller]
    public function fails(const E& $want) : StatusExpect<E>
    {
        Session::checked();

        if ($this->value->has_value()) {
            fail("expected error {$want}, got success", std::src::caller(), $expected: "{$want}");
            return $this;
        }

        $e = $this->value->failure();
        if (!($e == $want)) {
            fail("expected error {$want}, got error {$e}", std::src::caller(), $expected: "{$want}", $actual: "{$e}");
        }

        return $this;
    }
}
