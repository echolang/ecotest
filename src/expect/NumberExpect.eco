namespace ecotest;

/**
 * Checks on a number. Signed widths widen to `int64` on the way in, unsigned widths including
 * `usize` to `uint64`.
 */
public class NumericExpect<T>
{
    /**
     * The value under test.
     */
    public const T $value;

    /**
     * The number equals `$want`.
     */
    #[caller]
    public const function is(T $want) : NumericExpect<T>
    {
        Session::checked();
        if ($this->value == $want) {
            return $this;
        }

        fail("expected {$want}, got {$this->value}", std::src::caller(), $expected: "{$want}", $actual: "{$this->value}");
        return $this;
    }

    /**
     * The number differs from `$other`.
     */
    #[caller]
    public const function isNot(T $other) : NumericExpect<T>
    {
        Session::checked();
        if (!($this->value == $other)) {
            return $this;
        }

        fail("expected anything but {$other}", std::src::caller());
        return $this;
    }

    /**
     * The number is greater than `$bound`.
     */
    #[caller]
    public const function above(T $bound) : NumericExpect<T>
    {
        Session::checked();
        if ($this->value > $bound) {
            return $this;
        }

        fail("expected more than {$bound}, got {$this->value}", std::src::caller(), $expected: "{$bound}", $actual: "{$this->value}");
        return $this;
    }

    /**
     * The number is less than `$bound`.
     */
    #[caller]
    public const function below(T $bound) : NumericExpect<T>
    {
        Session::checked();
        if ($this->value < $bound) {
            return $this;
        }

        fail("expected less than {$bound}, got {$this->value}", std::src::caller(), $expected: "{$bound}", $actual: "{$this->value}");
        return $this;
    }

    /**
     * The number lies in `[$low, $high]`, both ends included.
     */
    #[caller]
    public const function between(T $low, T $high) : NumericExpect<T>
    {
        Session::checked();
        if ($this->value >= $low && $this->value <= $high) {
            return $this;
        }

        fail("expected {$low} to {$high}, got {$this->value}", std::src::caller(), $expected: "{$low}..{$high}", $actual: "{$this->value}");
        return $this;
    }
}
