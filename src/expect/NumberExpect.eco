namespace ecotest;

/**
 * Checks on a signed integer. Every signed width widens to `int64` on the way in.
 */
public class NumberExpect
{
    /**
     * The value under test.
     */
    public int64 $value;

    /**
     * The number equals `$want`.
     */
    #[caller]
    public const function is(int64 $want) : NumberExpect
    {
        Session::checked();

        if ($this->value == $want) {
            return $this;
        }

        fail("expected {$want}, got {$this->value}", std::src::caller(), $expected: "{$want}", $actual: "{$this->value}", $inline: true);
        return $this;
    }

    /**
     * The number differs from `$other`.
     */
    #[caller]
    public const function isNot(int64 $other) : NumberExpect
    {
        Session::checked();

        if ($this->value != $other) {
            return $this;
        }

        fail("expected anything but {$other}", std::src::caller());
        return $this;
    }

    /**
     * The number is greater than `$bound`.
     */
    #[caller]
    public const function above(int64 $bound) : NumberExpect
    {
        Session::checked();

        if ($this->value > $bound) {
            return $this;
        }

        fail("expected more than {$bound}, got {$this->value}", std::src::caller());
        return $this;
    }

    /**
     * The number is less than `$bound`.
     */
    #[caller]
    public const function below(int64 $bound) : NumberExpect
    {
        Session::checked();

        if ($this->value < $bound) {
            return $this;
        }

        fail("expected less than {$bound}, got {$this->value}", std::src::caller());
        return $this;
    }

    /**
     * The number lies in `[$low, $high]`, both ends included.
     */
    #[caller]
    public const function between(int64 $low, int64 $high) : NumberExpect
    {
        Session::checked();

        if ($this->value >= $low && $this->value <= $high) {
            return $this;
        }

        fail("expected {$low} to {$high}, got {$this->value}", std::src::caller());
        return $this;
    }
}
