namespace ecotest;

/**
 * Checks on a number. Signed widths widen to `int64` on the way in, unsigned widths including
 * `usize` to `uint64`.
 */
public class NumericExpect<T>
{
    /**
     * The value under test.
     */
    public T $value;

    /**
     * The number equals `$want`.
     */
    #[caller]
    public const function is(T $want) : NumericExpect<T>
    {
        check($this->value == $want, Failure("expected {$want}, got {$this->value}", std::src::caller(), $expected: "{$want}", $actual: "{$this->value}"));
        return $this;
    }

    /**
     * The number differs from `$other`.
     */
    #[caller]
    public const function isNot(T $other) : NumericExpect<T>
    {
        check(!($this->value == $other), Failure("expected anything but {$other}", std::src::caller()));
        return $this;
    }

    /**
     * The number is greater than `$bound`.
     */
    #[caller]
    public const function above(T $bound) : NumericExpect<T>
    {
        check($this->value > $bound, Failure("expected more than {$bound}, got {$this->value}", std::src::caller(), $expected: "{$bound}", $actual: "{$this->value}"));
        return $this;
    }

    /**
     * The number is less than `$bound`.
     */
    #[caller]
    public const function below(T $bound) : NumericExpect<T>
    {
        check($this->value < $bound, Failure("expected less than {$bound}, got {$this->value}", std::src::caller(), $expected: "{$bound}", $actual: "{$this->value}"));
        return $this;
    }

    /**
     * The number lies in `[$low, $high]`, both ends included.
     */
    #[caller]
    public const function between(T $low, T $high) : NumericExpect<T>
    {
        check($this->value >= $low && $this->value <= $high, Failure("expected {$low} to {$high}, got {$this->value}", std::src::caller(), $expected: "{$low}..{$high}", $actual: "{$this->value}"));
        return $this;
    }
}
