namespace ecotest;

/**
 * Checks on a `Calls<T>` recorder.
 */
public class CallsExpect<T>
{
    /**
     * The recorder under test.
     */
    public Calls<T> $calls;

    /**
     * Exactly `$count` calls were recorded.
     */
    #[caller]
    public const function times(usize $count) : CallsExpect<T>
    {
        Session::checked();

        usize $got = $this->calls->count();
        if ($got != $count) {
            fail("expected {$count} calls, got {$got}", std::src::caller());
        }

        return $this;
    }

    /**
     * No call was recorded.
     */
    #[caller]
    public const function never() : CallsExpect<T>
    {
        Session::checked();

        usize $got = $this->calls->count();
        if ($got != 0) {
            fail("expected no calls, got {$got}", std::src::caller());
        }

        return $this;
    }

    /**
     * Call number `$index`, counting from 0, was made with `$want`.
     */
    #[caller]
    public const function nth(usize $index, const T& $want) : CallsExpect<T>
    {
        Session::checked();

        usize $got = $this->calls->count();
        if ($index >= $got) {
            fail("expected a call number {$index}, only {$got} were made", std::src::caller());
            return $this;
        }

        $made = $this->calls->seen[$index];
        if (!($made == $want)) {
            fail("call {$index}: expected {$want}, got {$made}", std::src::caller(), $expected: "{$want}", $actual: "{$made}");
        }

        return $this;
    }

    /**
     * Some call was made with `$want`.
     */
    #[caller]
    public const function with(const T& $want) : CallsExpect<T>
    {
        Session::checked();

        foreach ($this->calls->seen as const &$made) {
            if ($made == $want) {
                return $this;
            }
        }

        usize $got = $this->calls->count();
        fail("expected a call with {$want} among {$got} calls", std::src::caller());
        return $this;
    }
}
