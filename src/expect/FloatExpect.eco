namespace ecotest;

use ecotest::show;

/**
 * Checks on a float. `is` compares exactly; use `near` for anything computed. Values print with
 * every digit it takes to tell them apart, so `0.1 + 0.2` never reads as `0.3`.
 */
public class FloatExpect
{
    /**
     * The value under test.
     */
    public const float64 $value;

    /**
     * The number equals `$want`.
     */
    #[caller]
    public const function is(float64 $want) : FloatExpect
    {
        Session::checked();
        if ($this->value == $want) {
            return $this;
        }

        $w = show::float($want);
        $g = show::float($this->value);
        fail("expected {$w}, got {$g}", std::src::caller(), $expected: $w, $actual: $g);
        return $this;
    }

    /**
     * The number differs from `$other`.
     */
    #[caller]
    public const function isNot(float64 $other) : FloatExpect
    {
        Session::checked();
        if (!($this->value == $other)) {
            return $this;
        }

        $o = show::float($other);
        fail("expected anything but {$o}", std::src::caller());
        return $this;
    }

    /**
     * The number is greater than `$bound`.
     */
    #[caller]
    public const function above(float64 $bound) : FloatExpect
    {
        Session::checked();
        if ($this->value > $bound) {
            return $this;
        }

        $b = show::float($bound);
        $g = show::float($this->value);
        fail("expected more than {$b}, got {$g}", std::src::caller());
        return $this;
    }

    /**
     * The number is less than `$bound`.
     */
    #[caller]
    public const function below(float64 $bound) : FloatExpect
    {
        Session::checked();
        if ($this->value < $bound) {
            return $this;
        }

        $b = show::float($bound);
        $g = show::float($this->value);
        fail("expected less than {$b}, got {$g}", std::src::caller());
        return $this;
    }

    /**
     * The number lies in `[$low, $high]`, both ends included.
     */
    #[caller]
    public const function between(float64 $low, float64 $high) : FloatExpect
    {
        Session::checked();
        if ($this->value >= $low && $this->value <= $high) {
            return $this;
        }

        $l = show::float($low);
        $h = show::float($high);
        $g = show::float($this->value);
        fail("expected {$l} to {$h}, got {$g}", std::src::caller());
        return $this;
    }

    /**
     * The number is close to `$want`: off by no more than `within`, or by no more than `relative`
     * times the larger magnitude, whichever allows more. Both default to `1e-9`, so a computed
     * `1e12` passes against its exact value as a computed `0.1` does. Two infinities of one sign
     * are close; NaN is never close to anything.
     */
    #[caller]
    public const function near(
        float64 $want,
        within: float64 $within = 0.000000001,
        relative: float64 $relative = 0.000000001
    ) : FloatExpect {
        Session::checked();

        if (show::nan($this->value) || show::nan($want)) {
            $w = show::float($want);
            $g = show::float($this->value);
            fail("expected {$w} within {$within}, got {$g}: NaN is never near", std::src::caller());
            return $this;
        }

        if ($this->value == $want) {
            return $this;
        }

        float64 $off = std::math::abs($this->value - $want);
        float64 $scale = std::math::max(std::math::abs($this->value), std::math::abs($want));
        float64 $allowed = std::math::max($within, $relative * $scale);

        if ($off <= $allowed) {
            return $this;
        }

        $w = show::float($want);
        $g = show::float($this->value);
        $o = show::float($off);
        fail("expected {$w} within {$within}, got {$g} (off by {$o})", std::src::caller());
        return $this;
    }
}
