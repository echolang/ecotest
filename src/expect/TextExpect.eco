namespace ecotest;

use ecotest::{diff, show};

/**
 * Checks on a string. `is` prints a line diff when either side spans several lines.
 */
public class TextExpect
{
    /**
     * The value under test.
     */
    public string $value;

    /**
     * The text equals `$want`, byte for byte.
     */
    #[caller]
    public const function is(const string& $want) : TextExpect
    {
        Session::checked();

        if ($this->value == $want) {
            return $this;
        }

        if ($want->contains("\n") || $this->value->contains("\n")) {
            string $diff = '(- expected, + got)\n';
            $diff->append(diff::lines($want, $this->value));
            fail('text differs', std::src::caller(), $detail: $diff);
            return $this;
        }

        $w = show::text($want);
        $g = show::text($this->value);
        fail("expected {$w}, got {$g}", std::src::caller(), $expected: $w, $actual: $g);
        return $this;
    }

    /**
     * The text differs from `$other`.
     */
    #[caller]
    public const function isNot(const string& $other) : TextExpect
    {
        Session::checked();

        if ($this->value != $other) {
            return $this;
        }

        $o = show::text($other);
        fail("expected anything but {$o}", std::src::caller());
        return $this;
    }

    /**
     * The text contains `$part`.
     */
    #[caller]
    public const function has(const string& $part) : TextExpect
    {
        Session::checked();

        if ($this->value->contains($part)) {
            return $this;
        }

        $g = show::text($this->value);
        $p = show::text($part);
        fail("expected {$g} to contain {$p}", std::src::caller());
        return $this;
    }

    /**
     * The text does not contain `$part`.
     */
    #[caller]
    public const function lacks(const string& $part) : TextExpect
    {
        Session::checked();

        if (!$this->value->contains($part)) {
            return $this;
        }

        $g = show::text($this->value);
        $p = show::text($part);
        fail("expected {$g} not to contain {$p}", std::src::caller());
        return $this;
    }

    /**
     * The text begins with `$prefix`.
     */
    #[caller]
    public const function starts(const string& $prefix) : TextExpect
    {
        Session::checked();

        if ($this->value->starts($prefix)) {
            return $this;
        }

        $g = show::text($this->value);
        $p = show::text($prefix);
        fail("expected {$g} to start with {$p}", std::src::caller());
        return $this;
    }

    /**
     * The text ends with `$suffix`.
     */
    #[caller]
    public const function ends(const string& $suffix) : TextExpect
    {
        Session::checked();

        if ($this->value->ends($suffix)) {
            return $this;
        }

        $g = show::text($this->value);
        $s = show::text($suffix);
        fail("expected {$g} to end with {$s}", std::src::caller());
        return $this;
    }

    /**
     * The text has no bytes.
     */
    #[caller]
    public const function empty() : TextExpect
    {
        Session::checked();

        if ($this->value->empty()) {
            return $this;
        }

        $g = show::text($this->value);
        fail("expected empty text, got {$g}", std::src::caller());
        return $this;
    }

    /**
     * The text is `$bytes` bytes long.
     */
    #[caller]
    public const function length(usize $bytes) : TextExpect
    {
        Session::checked();

        usize $size = $this->value->size();
        if ($size == $bytes) {
            return $this;
        }

        fail("expected {$bytes} bytes, got {$size}", std::src::caller(), $actual: show::text($this->value));
        return $this;
    }

    /**
     * The text matches the test's next snapshot file. The first run writes the file; see
     * `Snapshot` for where it lives and how to accept a change.
     */
    #[caller]
    public const function snapshot() : TextExpect
    {
        Snapshot::check($this->value, std::src::caller());
        return $this;
    }
}
