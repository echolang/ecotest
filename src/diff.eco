/**
 * Line diffs for text checks. `-` lines were expected and are missing, `+` lines came instead, and
 * a few unchanged lines around each change keep the reader oriented.
 */

namespace ecotest::diff;

use ecotest::show;

/**
 * Unchanged lines shown on each side of a change.
 */
internal const usize AROUND = 2;

/**
 * Above this many line pairs the table would be too big, and the diff names the first differing
 * line instead.
 */
internal const usize LIMIT = 1000000;

/**
 * The diff between `$want` and `$got`, one marked line per row. Empty when they are equal. Past
 * `$limit` line pairs it names the first differing line instead.
 */
internal function lines(const string& $want, const string& $got, usize $limit = LIMIT) : string
{
    $a = str::split($want, "\n")->owned();
    $b = str::split($got, "\n")->owned();

    if ($a->count() * $b->count() > $limit) {
        return first($a, $b);
    }

    return render(walk($a, $b));
}

/**
 * The rows of a longest-common-subsequence walk over two line lists.
 */
private function walk(const array<string>& $a, const array<string>& $b) : array<DiffLine>
{
    usize $n = $a->count();
    usize $m = $b->count();
    usize $w = $m + 1;

    // $t[i * w + j] is the common length of a[i..] and b[j..]
    $t = arr::room<uint32>(($n + 1) * $w);
    for (usize $k = 0; $k < ($n + 1) * $w; $k++) {
        $t[] = 0;
    }

    usize $i = $n;
    while ($i > 0) {
        $i--;
        usize $j = $m;
        while ($j > 0) {
            $j--;
            if ($a[$i] == $b[$j]) {
                $t[$i * $w + $j] = $t[($i + 1) * $w + $j + 1] + 1;
            } else if ($t[($i + 1) * $w + $j] >= $t[$i * $w + $j + 1]) {
                $t[$i * $w + $j] = $t[($i + 1) * $w + $j];
            } else {
                $t[$i * $w + $j] = $t[$i * $w + $j + 1];
            }
        }
    }

    array<DiffLine> $rows = [];
    usize $x = 0;
    usize $y = 0;

    while ($x < $n && $y < $m) {
        if ($a[$x] == $b[$y]) {
            $rows[] = DiffLine(.same, $a[$x]);
            $x++;
            $y++;
        } else if ($t[($x + 1) * $w + $y] >= $t[$x * $w + $y + 1]) {
            $rows[] = DiffLine(.want, $a[$x]);
            $x++;
        } else {
            $rows[] = DiffLine(.got, $b[$y]);
            $y++;
        }
    }

    while ($x < $n) {
        $rows[] = DiffLine(.want, $a[$x]);
        $x++;
    }

    while ($y < $m) {
        $rows[] = DiffLine(.got, $b[$y]);
        $y++;
    }

    return $rows;
}

/**
 * The changed rows plus `AROUND` unchanged ones on each side, with `...` for what was left out.
 */
private function render(const array<DiffLine>& $rows) : string
{
    usize $n = $rows->count();
    $keep = arr::room<bool>($n);
    for (usize $k = 0; $k < $n; $k++) {
        $keep[] = false;
    }

    bool $changed = false;
    for (usize $k = 0; $k < $n; $k++) {
        if ($rows[$k]->mark == DiffMark::same) {
            continue;
        }

        $changed = true;
        usize $from = 0;
        if ($k > AROUND) {
            $from = $k - AROUND;
        }

        usize $to = $k + AROUND;
        for (usize $c = $from; $c <= $to && $c < $n; $c++) {
            $keep[$c] = true;
        }
    }

    if (!$changed) {
        return '';
    }

    string $out = '';
    bool $skipped = false;

    for (usize $k = 0; $k < $n; $k++) {
        if (!$keep[$k]) {
            $skipped = true;
            continue;
        }

        if ($skipped) {
            $out->append("  ...\n");
            $skipped = false;
        }

        const DiffLine& $row = $rows[$k];
        $out->append(match ($row->mark) {
            .want => '- ',
            .got => '+ ',
            .same => '  ',
        });
        $out->append(show::visible($row->text));
        $out->append("\n");
    }

    if ($skipped) {
        $out->append("  ...\n");
    }

    return $out;
}

/**
 * The first line where two long texts part, for when a full diff would cost too much.
 */
private function first(const array<string>& $a, const array<string>& $b) : string
{
    usize $k = 0;
    while ($k < $a->count() && $k < $b->count() && $a[$k] == $b[$k]) {
        $k++;
    }

    string $want = '(end)';
    if ($k < $a->count()) {
        $want = $a[$k];
    }

    string $got = '(end)';
    if ($k < $b->count()) {
        $got = $b[$k];
    }

    usize $line = $k + 1;
    $w = show::visible($want);
    $g = show::visible($got);
    return "first difference at line {$line}\n- {$w}\n+ {$g}\n";
}
