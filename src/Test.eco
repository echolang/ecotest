namespace ecotest;

/**
 * Holds failed checks until the returned value goes out of scope, then reports them all at once.
 * Bind it to a local: `$all = ecotest::soft();`.
 */
public function soft() : Soft
{
    return Soft();
}

/**
 * Attaches `$text` to every failure while the returned value lives. Bind it to a local inside a
 * loop: `$at = ecotest::context("row {$i}");`.
 */
public function context(const string& $text) : Context
{
    return Context($text);
}

/**
 * Runs `$body` and returns the checks it failed instead of failing the test, which is how a library
 * built on ecotest tests its own checks: `$failed = ecotest::caught(function() : void { expect(1)->is(2); });`. A
 * check that stops the test still stops it. Failures an enclosing `soft()` or `caught()` already
 * holds stay with that scope.
 */
public function caught(function<void()> $body) : array<Failure>
{
    Session::enterCaught();
    $body();
    return Session::leaveCaught();
}

/**
 * Records a note for this test. The ecotest tool shows it under the test in every report.
 */
public function note(const string& $text) : void
{
    emitNote($text);
}

/**
 * Records a named number for this test, such as rows read or bytes written.
 */
public function metric(const string& $name, int64 $value) : void
{
    emitMetric($name, $value);
}

/**
 * Ends the test as skipped. The process exits 0, so a plain `echoc test` counts it as passed; the
 * ecotest tool reads the `skip` event and reports it as skipped, with `$reason`. A test whose
 * `soft()` scope already holds failures is not skipped: it stops with those failures.
 */
#[caller]
public function skip(const string& $reason) : void
{
    skip($reason, at: std::src::caller());
}

/**
 * `skip` at `$at`, for a helper that skips on behalf of the test that called it.
 */
public function skip(const string& $reason, at: std::src::location $at) : void
{
    $failed = guard Session::skipping($reason, $at) else {
        echo "skipped: {$reason}";
        std::env::exit(0);
        return;
    };

    die($failed, $at);
}

/**
 * The value of the environment variable `$name`, or a skip when it is unset or empty. For tests
 * that need a live service: `$url = ecotest::needs(env: 'MYSQL_TEST_URL');`.
 */
#[caller]
public function needs(env: const string& $name) : string
{
    return needs(env: $name, at: std::src::caller());
}

/**
 * `needs` with the skip placed at `$at`, for a helper that needs the variable on behalf of the
 * test that called it.
 */
public function needs(env: const string& $name, at: std::src::location $at) : string
{
    $value = string(std::env::var($name, ''));

    if ($value->empty()) {
        skip("{$name} is not set", at: $at);
    }

    return $value;
}

/**
 * Compares `$text` with the test's next snapshot file, failing at `$at` when it changed. The first
 * run writes the file; see `Snapshot` for where it lives and how to accept a change. For a helper
 * that snapshots on behalf of the test that called it; a test writes `expect($text)->snapshot()`.
 */
public function snapshot(const string& $text, at: std::src::location $at) : void
{
    Snapshot::check($text, $at);
}
