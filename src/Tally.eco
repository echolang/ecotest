namespace ecotest;

/**
 * The count of checks a test made, written as one `checks` event when the process tears down. It
 * keeps its own copy of the event path because static teardown has no order to rely on.
 */
internal class Tally
{
    internal int64 $checks = 0;
    internal string $path = '';
    internal bool $flushed = false;

    /**
     * Writes the count once. Called on teardown, and earlier by a stop or a skip, after which
     * teardown does not run.
     */
    internal function flush() : void
    {
        if ($this->flushed || $this->path->empty()) {
            return;
        }

        $this->flushed = true;
        $event = Event('checks')->number('count', $this->checks);
        Session::append($this->path, "{$event}");
    }

    destructor()
    {
        $this->flush();
    }
}
