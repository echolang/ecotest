/**
 * How ecotest's own values print, so `"{$failure}"` is the report and `"{$event}"` the event line.
 */

namespace str;

use ecotest::show;

/**
 * The report printed when the test stops: the summary, then the expected and actual values, the
 * detail and the context, each indented under it.
 */
public function from(const ecotest::Failure& $failure) : string
{
    string $out = $failure->summary;

    if ((!$failure->expected->empty() || !$failure->actual->empty()) && !$failure->inline) {
        $out->append("\n  expected: {$failure->expected}");
        $out->append("\n       got: {$failure->actual}");
    }

    if (!$failure->detail->empty()) {
        $out->append("\n");
        $out->append(show::indent(str::rtrim($failure->detail), 2));
    }

    foreach ($failure->context as const &$scope) {
        $out->append("\n  in {$scope}");
    }

    return $out;
}

/**
 * The finished event line, without a trailing newline.
 */
public function from(const ecotest::Event& $event) : string
{
    string $out = $event->line;
    $out->append('}');
    return $out;
}
