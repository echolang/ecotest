namespace ecotest;

use ecotest::{jsonl, protocol};

/**
 * Starts an event line of `$type`.
 */
private function start(const string& $type) : string
{
    string $line = '{"v":';
    $line->append(str::from(protocol::VERSION));
    $line->append(',"type":');
    $line->append(jsonl::quote($type));
    return $line;
}

/**
 * Writes the separator and the quoted key of the next field.
 */
private function key(string& $line, const string& $name) : void
{
    $line->append(',');
    $line->append(jsonl::quote($name));
    $line->append(':');
}

private function text(string& $line, const string& $name, const string& $value) : void
{
    key($line, $name);
    $line->append(jsonl::quote($value));
}

private function number(string& $line, const string& $name, int64 $value) : void
{
    key($line, $name);
    $line->append("{$value}");
}

private function texts(string& $line, const string& $name, const array<string>& $values) : void
{
    key($line, $name);
    $line->append('[');
    for (usize $i = 0; $i < $values->count(); $i++) {
        if ($i > 0) {
            $line->append(',');
        }
        $line->append(jsonl::quote($values[$i]));
    }
    $line->append(']');
}

private function at(string& $line, const std::src::location& $at) : void
{
    text($line, 'file', string($at->file));
    number($line, 'line', $at->line as int64);
    number($line, 'column', $at->column as int64);
}

private function finish(string& $line) : void
{
    $line->append('}');
    Session::write($line);
}

/**
 * A failed check.
 */
internal function emitFail(const Failure& $f) : void
{
    $line = start(protocol::Kind::fail->value());
    text($line, 'summary', $f->summary);
    text($line, 'expected', $f->expected);
    text($line, 'actual', $f->actual);
    text($line, 'detail', $f->detail);
    texts($line, 'context', $f->context);
    at($line, $f->at);
    finish($line);
}

/**
 * A stop no check reported.
 */
internal function emitCrash(
    const string& $headline,
    const string& $message,
    const string& $file,
    int64 $line
) : void {
    $out = start(protocol::Kind::crash->value());
    text($out, 'headline', $headline);
    text($out, 'message', $message);
    text($out, 'file', $file);
    number($out, 'line', $line);
    finish($out);
}

/**
 * The test ended itself as skipped.
 */
internal function emitSkip(const string& $reason, const std::src::location& $at) : void
{
    $line = start(protocol::Kind::skip->value());
    text($line, 'reason', $reason);
    at($line, $at);
    finish($line);
}

/**
 * A note the test recorded.
 */
internal function emitNote(const string& $text) : void
{
    $line = start(protocol::Kind::note->value());
    text($line, 'text', $text);
    finish($line);
}

/**
 * A named case of the test began at `$at`; the one before it, if any, passed.
 */
internal function emitStep(const string& $name, const std::src::location& $at) : void
{
    $line = start(protocol::Kind::step->value());
    text($line, 'name', $name);
    at($line, $at);
    finish($line);
}

/**
 * A named number the test recorded.
 */
internal function emitMetric(const string& $name, int64 $value) : void
{
    $line = start(protocol::Kind::metric->value());
    text($line, 'name', $name);
    number($line, 'value', $value);
    finish($line);
}

/**
 * A timing from `bench`.
 */
internal function emitBench(const string& $label, int64 $median, int64 $slow, int64 $calls) : void
{
    $line = start(protocol::Kind::bench->value());
    text($line, 'label', $label);
    number($line, 'p50_ns', $median);
    number($line, 'p95_ns', $slow);
    number($line, 'calls', $calls);
    finish($line);
}

/**
 * How many checks the test made.
 */
internal function emitChecks(const string& $path, int64 $count) : void
{
    $line = start(protocol::Kind::checks->value());
    number($line, 'count', $count);
    $line->append('}');
    Session::append($path, $line);
}

/**
 * A snapshot file the test wrote for the first time.
 */
internal function emitSnapshotNew(const string& $path, const std::src::location& $at) : void
{
    $line = start(protocol::Kind::snapshotNew->value());
    text($line, 'path', $path);
    at($line, $at);
    finish($line);
}

/**
 * A snapshot file the test rewrote under `ECOTEST_UPDATE`.
 */
internal function emitSnapshotUpdated(const string& $path, const std::src::location& $at) : void
{
    $line = start(protocol::Kind::snapshotUpdated->value());
    text($line, 'path', $path);
    at($line, $at);
    finish($line);
}
