namespace ecotest;

use ecotest::protocol;

/**
 * One check that did not hold: a one-line summary, what was expected and what came instead,
 * an optional detail such as a diff, the context scopes that were open, and the test line that
 * made the check.
 */
public struct Failure
{
    /**
     * The one-line headline of the report.
     */
    public string $summary;

    /**
     * What the check wanted, as printed. Empty when the check names none.
     */
    public string $expected;

    /**
     * What the check got instead, as printed. Empty when the check names none.
     */
    public string $actual;

    /**
     * Extra lines under the values, such as a diff or a replay hint.
     */
    public string $detail;

    /**
     * The `context()` scopes open when the check failed, outermost first.
     */
    public array<string> $context;

    /**
     * The test line that made the check.
     */
    public std::src::location $at;

    /**
     * True when the summary already reads out both values, so the report does not repeat them
     * under it.
     */
    public bool $inline;

    public constructor(
        string $summary,
        std::src::location $at,
        string $expected = '',
        string $actual = '',
        string $detail = '',
        bool $inline = false
    ) {
        $this->summary = $summary;
        $this->at = $at;
        $this->expected = $expected;
        $this->actual = $actual;
        $this->detail = $detail;
        $this->inline = $inline;
        $this->context = [];
    }

    /**
     * The `fail` event for this failure.
     */
    public const function event() : Event
    {
        return Event(protocol::FAIL)
            ->text('summary', $this->summary)
            ->text('expected', $this->expected)
            ->text('actual', $this->actual)
            ->text('detail', $this->detail)
            ->texts('context', $this->context)
            ->flag('inline', $this->inline)
            ->at($this->at);
    }

    /**
     * Records the failure with the session: it stops the test, or is held until the enclosing
     * `soft()` scope ends.
     */
    public const function raise() : void
    {
        Session::fail($this);
    }

    /**
     * Records the failure and stops the test even inside `soft()`. For checks that return a value,
     * where there is nothing to go on with.
     */
    public const function stop() : void
    {
        Session::stop($this);
    }
}

/**
 * Builds a failure from the constructor arguments and raises it: it stops the test, or is held
 * until the enclosing `soft()` scope ends. `fail("...", std::src::caller())` in a check.
 */
internal function fail(construct Failure $failure) : void
{
    Session::fail($failure);
}
