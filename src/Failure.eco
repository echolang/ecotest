namespace ecotest;

/**
 * One check that did not hold: a one-line summary, what was expected and what came instead,
 * an optional detail such as a diff, the context scopes that were open, and the test line that
 * made the check.
 */
public struct Failure
{
    /**
     * The one-line headline of the report.
     */
    public string $summary;

    /**
     * What the check wanted, as printed. Empty when the check names none.
     */
    public string $expected;

    /**
     * What the check got instead, as printed. Empty when the check names none.
     */
    public string $actual;

    /**
     * Extra lines under the values, such as a diff or a replay hint.
     */
    public string $detail;

    /**
     * The `context()` scopes open when the check failed, outermost first.
     */
    public array<string> $context;

    /**
     * The test line that made the check.
     */
    public std::src::location $at;

    public constructor(
        string $summary,
        std::src::location $at,
        string $expected = '',
        string $actual = '',
        string $detail = ''
    ) {
        $this->summary = $summary;
        $this->at = $at;
        $this->expected = $expected;
        $this->actual = $actual;
        $this->detail = $detail;
        $this->context = [];
    }
}

/**
 * Builds a failure from the constructor arguments and raises it: it stops the test, or is held
 * until the enclosing `soft()` scope ends. `fail("...", std::src::caller())` in a check. HTTP
 * checks and matchers written on top of ecotest go through here, never through `Session`.
 */
public function fail(construct Failure $failure) : void
{
    Session::fail($failure);
}

/**
 * Counts one check and fails it when `$ok` is false.
 */
public function check(bool $ok, construct Failure $failure) : void
{
    Session::checked();
    if (!$ok) {
        Session::fail($failure);
    }
}

/**
 * Counts one check towards the test's `checks` event. A matcher that then fails through `fail`
 * uses `check` instead.
 */
public function checked() : void
{
    Session::checked();
}

/**
 * Stops the test at the failure's own line, whatever `soft()` scope is open. Failures a soft
 * scope holds are reported with it.
 */
public function stop(construct Failure $failure) : void
{
    Session::stop($failure);
}

/**
 * Writes the failure's event, after any held ones, and answers the report to stop with. For a
 * `guard ... else` that has to end in `die`.
 */
public function report(construct Failure $failure) : string
{
    return Session::report($failure);
}

/**
 * Runs `$undo` if the test stops early: a failed check, a crash or a skip. A test that ends
 * normally runs its destructors instead, so the owner calls `undefer` from there. Answers the
 * handle `undefer` takes.
 */
public function defer(function<void()> $undo) : usize
{
    return Session::defer($undo);
}

/**
 * Forgets a cleanup that `defer` registered, once its owner has cleaned up by itself.
 */
public function undefer(usize $id) : void
{
    Session::undefer($id);
}
