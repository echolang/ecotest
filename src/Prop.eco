namespace ecotest;

/**
 * Checks that `$holds` is true for `$runs` values from `$gen`. A failing value is shrunk to the
 * smallest one that still fails, and the failure names it with the seed to replay the run.
 */
#[caller]
public function forAll<T>(const Gen<T>& $gen, function<bool(const T&)> $holds, usize $runs = 200) : void
{
    $at = std::src::caller();
    Session::checked();

    uint64 $seed = seed();
    $random = Random($seed);

    for (usize $i = 0; $i < $runs; $i++) {
        $value = $gen->make($random);
        if ($holds($value)) {
            continue;
        }

        $original = $gen->show($value);
        $smallest = mv $value;
        usize $steps = 0;
        bool $moved = true;

        while ($moved && $steps < 1000) {
            $moved = false;
            $candidates = $gen->shrink($smallest);

            foreach ($candidates as const &$candidate) {
                if (!$holds($candidate)) {
                    $smallest = $candidate;
                    $steps++;
                    $moved = true;
                    break;
                }
            }
        }

        usize $run = $i + 1;
        $shown = $gen->show($smallest);
        $detail = "smallest failing value: {$shown}\nfirst failing value: {$original}\nshrunk {$steps} times; replay with ECOTEST_SEED={$seed}";

        fail("property failed on run {$run} of {$runs}", $at, $actual: $shown, $detail: $detail);
        return;
    }
}
