namespace ecotest;

use ecotest::diff;

/**
 * Snapshot files. The n-th snapshot a test takes lives at
 * `<test file dir>/__snapshots__/<file stem>/<test name>.<n>.snap`, so a snapshot moves with the
 * file and test that own it. A missing one is written and reported; `ECOTEST_UPDATE=1` rewrites
 * ones that changed; `ECOTEST_CI=1` refuses to write new ones.
 */
internal class Snapshot
{
    /**
     * How many snapshots this test process has taken, for the next file's number.
     */
    internal static usize $taken = 0;

    /**
     * Compares `$value` with the test's next snapshot file, writing it when it is new.
     */
    internal static function check(const string& $value, std::src::location $at) : void
    {
        Session::checked();

        $file = string(std::env::var('ECHO_TEST_FILE', ''));
        $name = string(std::env::var('ECHO_TEST_NAME', ''));

        if ($file->empty() || $name->empty()) {
            fail('snapshots need ECHO_TEST_FILE and ECHO_TEST_NAME, which echoc test sets', $at);
            return;
        }

        Snapshot::$taken = Snapshot::$taken + 1;
        usize $n = Snapshot::$taken;

        $root = std::env::join(Snapshot::directory($file), '__snapshots__');
        $folder = std::env::join($root, Snapshot::stem($file));
        $path = std::env::join($folder, "{$name}.{$n}.snap");

        $want = guard std::io::readfile($path) else {
            if (Snapshot::flag('ECOTEST_CI')) {
                fail("snapshot {$path} does not exist, and ECOTEST_CI forbids writing it", $at);
                return;
            }

            guard Snapshot::write($root, $folder, $path, $value) else ($e) {
                fail("cannot write snapshot {$path}: {$e}", $at);
                return;
            };
            Event('snapshot-new')->text('path', $path)->at($at)->emit();
            return;
        };

        if ($want == $value) {
            return;
        }

        if (Snapshot::flag('ECOTEST_UPDATE')) {
            guard Snapshot::write($root, $folder, $path, $value) else ($e) {
                fail("cannot write snapshot {$path}: {$e}", $at);
                return;
            };
            Event('snapshot-updated')->text('path', $path)->at($at)->emit();
            return;
        }

        $detail = "(- snapshot, + now)\n";
        $detail->append(diff::lines($want, $value));
        $detail->append("\nrerun with ECOTEST_UPDATE=1 to accept the new value");
        fail("snapshot {$name}.{$n} changed", $at, $detail: $detail);
    }

    /**
     * Writes a snapshot file and the two folders above it. A folder that cannot be made shows up
     * as the file's write error.
     */
    private static function write(
        const string& $root,
        const string& $folder,
        const string& $path,
        const string& $value
    ) : status<std::io::ioerror> {
        $made = std::io::mkdir($root);
        $made = std::io::mkdir($folder);

        guard std::io::writefile($path, $value) else ($e) {
            return .error($e);
        };

        return .ok;
    }

    /**
     * True when the environment variable `$name` is set to anything but empty or `0`.
     */
    private static function flag(const string& $name) : bool
    {
        $value = string(std::env::var($name, ''));
        return !$value->empty() && $value != '0';
    }

    /**
     * Everything before the last `/` of `$path`, or `.` when there is none.
     */
    private static function directory(const string& $path) : string
    {
        $cut = guard Snapshot::lastSlash($path) else {
            return '.';
        };

        return $path->sub(0, $cut);
    }

    /**
     * The file name of `$path` without its extension.
     */
    private static function stem(const string& $path) : string
    {
        $base = Snapshot::base($path);
        usize $dot = $base->size();
        for (usize $i = 0; $i < $base->size(); $i++) {
            if ($base->byte($i) == 46) {
                $dot = $i;
            }
        }

        return $base->sub(0, $dot);
    }

    /**
     * The file name of `$path`: everything after the last `/`, or all of it when there is none.
     */
    private static function base(const string& $path) : string
    {
        $cut = guard Snapshot::lastSlash($path) else {
            return $path;
        };

        return $path->sub($cut + 1, $path->size() - $cut - 1);
    }

    /**
     * The index of the last `/` in `$path`, or null when there is none.
     */
    private static function lastSlash(const string& $path) : usize?
    {
        usize? $cut = null;
        for (usize $i = 0; $i < $path->size(); $i++) {
            if ($path->byte($i) == 47) {
                $cut = $i;
            }
        }

        return $cut;
    }
}
